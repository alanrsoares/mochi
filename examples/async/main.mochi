// Async in mochi WITHOUT an async/await keyword. A `Task a e` is an ordinary
// prelude value (opaque lazy thunk) carrying an error channel — asynchrony and
// failure both compose through the same `|>` pipeline as everything else.
// `Task.run` hands back a Promise of the settled `Result` to JS at the edge,
// which is the only place effects actually happen. See ADR 0005, ADR 0006.

// ---- pure pipeline, no host ----
// of(20) -> +1 -> (10ms later) same -> doubled = 42. `let!` is Task bind
// (mirrors `let?` for Result); `Task.map` still pipes when you only need map.
let program = let! n = Task.of(20) |> Task.map((+ 1)) in
let! n2 = Task.delay(10, n) in Task.of(n2 + n2)

/// `mochi build main.mochi`, then `node demo.mjs` — prints `{ _tag: "Ok", value: 42 }`.
export let result = Task.run(program)

// ---- the error channel ----
// Domain effects stay thin `extern`s against a flaky fake remote. The host
// reports failures as plain strings; mochi maps them onto its own error type
// once, at the boundary.
type User = { id: number, name: string }

type ApiError =
  | NotFound(number)
  | Offline(string)

extern fetchUser : number -> Task<User, string> = "./runtime.mjs" "fetchUser"
extern fetchPlan : number -> Task<string, string> = "./runtime.mjs" "fetchPlan"

let classify = (id, reason) => reason == "404" ? NotFound(id) : Offline(reason)

// A chain is mono-`e`: `mapErr` aligns both externs on `ApiError` before `let!`
// binds them together.
let planLine = id =>
  let! user = fetchUser(id) |> Task.mapErr(classify(id)) in
  let! plan = fetchPlan(user.id) |> Task.mapErr(classify(id)) in
    Task.of("${user.name} is on the ${plan} plan")

// `recover` is bind on the ERROR track: a missing user degrades to a default,
// while an unreachable host stays failed and surfaces as `Err` at the edge.
let describe = id =>
  planLine(id)
    |> Task.recover(e => switch e {
      | NotFound(missing) => Task.of(
          "user ${show(missing)} has no plan — showing the demo one"
        )
      | Offline(why) => Task.fail(Offline(why))
    })

// `match` folds both tracks into one value, still inside a Task.
let report = id =>
  describe(id) |> Task.match(line => line, e => "unavailable: ${show(e)}")

export let found = Task.run(report(1))
export let recovered = Task.run(report(7))
export let offline = Task.run(describe(0))

// ---- fan-out (ADR 0074) ----
// Independent effects run at once and still share ONE error channel: `mapErr`
// aligns each on `ApiError` before `traverse` collects them. Results come back
// in INPUT order, never completion order.
let nameOf = id =>
  fetchUser(id) |> Task.mapErr(classify(id)) |> Task.map(u => u.name)

let roster = Task.traverse(nameOf)

export let everyone = Task.run(roster([1, 1]))

/// Fail-fast: id 7 is a 404, so the whole fan-out settles `Err` on the first
/// failure. The sibling lookup is ABANDONED — its request still completes in the
/// host, its result is simply dropped. mochi has no cancellation (ADR 0074).
export let partial = Task.run(roster([1, 7]))

/// `race` settles on the first task to SETTLE — an early `Err` wins as readily
/// as an early `Ok`. `Task.race([])` would never settle.
export let fastest = Task.run(
  Task.race([Task.delay(50, "slow"), Task.delay(1, "quick")])
)

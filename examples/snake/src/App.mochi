// Snake — re-reduced game container + mochi UI. Host seams only for APIs the
// surface cannot express yet (timer, keyboard, localStorage, canvas2d/rAF,
// fetch/WS). Board pixels sync via CanvasBoard.mochi effects → canvas.host.
// @mochi open
import { useEffect, hookDeps0 } from "@mochi/plugin-preact/hooks"
import {
  document,
  onKeyDown,
  every,
  pickRandom,
  localStorage,
  storageGet
} from "@mochi/web/dom"
import {
  defineContainer,
  useContainer,
  useSelect,
  Intent,
  defaultInterpreters
} from "@mochi/plugin-re-reduced/container"
import { CanvasBoard } from "./components/CanvasBoard"
import {
  Card,
  Kbd,
  ScoreLabel,
  ScoreValue,
  PrimaryBtn,
  GhostBtn,
  NameInput,
  OverlayTitle,
  OverlayPanel,
  WsStatus,
  WsDot,
  LeaderRow,
  RankBadge,
  PlayerName,
  PlayerScore
} from "./ui/primitives"
import {
  initGame,
  freeCells,
  changeDir,
  startGame,
  togglePause,
  step,
  isPlaying,
  isPlayingStatus,
  isGameOverStatus,
  isPausedStatus,
  statusHeadingOf,
  Ready,
  Up,
  Down,
  Left,
  Right
} from "../snake.mochi"

// Cleanup returns stay OPAQUE (`c`, not `c -> d`): extern arity is the whole
// arrow spine, so a trailing `-> c -> d` over-currys the import and calls
// become silent partial applications (keyboard/timer never attach).
/// The storage key is shared by direct reads and the container interpreter write.
let highScoreKey = "mochi_snake_highscore"

let readHighScore = () => switch storageGet(localStorage(), highScoreKey) {
  | Some(raw) => Option.unwrapOr(0, Str.toNumber(raw))
  | None => 0
}

/// One leaderboard row. Type names do not cross module boundaries yet, so the
/// shape is restated here rather than imported from the host's `ScoreEntry`.
type ScoreEntry = { name: string, score: number }

extern fetchLeaderboard : () -> Task<[ScoreEntry], string> = "./host/leaderboard.host" "fetchLeaderboardTask"
extern postScore : string -> number -> Task<[ScoreEntry], string> = "./host/leaderboard.host" "postScoreTask"
/// Returns a `useEffect` cleanup.
extern connectWs<A, B, C, D, E> : (A -> B) -> (C -> D) -> E = "./host/leaderboard.host" "connectWs"

/// A key the game answers to. Declared here rather than in a shared module: a
/// `switch` on an imported variant's constructors fails the Vite plugin's
/// per-file `compile()` path (see `snake.mochi`'s status helpers), and the
/// dispatch below is the only consumer.
type Key =
  | MoveUp
  | MoveDown
  | MoveLeft
  | MoveRight
  | TogglePlay
  | Restart

/// The binding table. Raw DOM keys are an open set, so the catch-all lives
/// *here* — which is what lets the dispatch below switch on `Key` exhaustively.
let keyOf = raw => switch raw {
  | "arrowup" | "w" => Some(MoveUp)
  | "arrowdown" | "s" => Some(MoveDown)
  | "arrowleft" | "a" => Some(MoveLeft)
  | "arrowright" | "d" => Some(MoveRight)
  | " " => Some(TogglePlay)
  | "r" => Some(Restart)
  | _ => None
}

/// A blank callsign posts as "Anonymous" — a product rule, so the host posts
/// whatever string it is handed.
let displayName = n =>
  let trimmed = Str.trim(n) in trimmed == "" ? "Anonymous" : trimmed

let COLS = 20
let ROWS = 20
let TICK_MS = 120

let gameContainer = defineContainer(
  "snake-game",
  {
    state: {
      snake: [(10, 10), (9, 10), (8, 10)],
      food: (15, 10),
      dir: Right,
      dirQueue: [],
      score: 0,
      highScore: readHighScore(),
      status: Ready,
      cols: COLS,
      rows: ROWS,
      submitted: false,
      name: "",
      connected: false,
      leaders: []
    },
    actions: on =>
      {
        up: on(s => changeDir(s, Up)),
        down: on(s => changeDir(s, Down)),
        left: on(s => changeDir(s, Left)),
        right: on(s => changeDir(s, Right)),
        start: on(s => startGame(s)),
        togglePause: on(s => togglePause(s)),
        space: on(s => isPlaying(s) ? togglePause(s) : startGame(s)),
        restart: on(s =>
          { ...initGame(COLS, ROWS, s.highScore), submitted: false }
        ),
        step: on(s => step(s, pickRandom(s.food, freeCells(s.food, s.snake)))),
        setName: on((_s, n) => { name: n }),
        setConnected: on((_s, c) => { connected: c }),
        setLeaders: on((_s, ls) => { leaders: ls }),
        submitScore: // Payloadless: the reaction below reads the name/score off the state.
        on(_s => { submitted: true })
      },
    derive: // `derive` keeps the status predicates on the container, so every consumer
    // reads one derived signal instead of re-deriving from `status`.
    s =>
      {
        playing: () => isPlayingStatus(s.status.value),
        gameOver: () => isGameOverStatus(s.status.value),
        paused: () => isPausedStatus(s.status.value)
      },
    effects: fx =>
      [
        // localStorage write, declared instead of hand-rolled in a `useEffect`.
        fx.onChange(s =>
          s.highScore.value, (value, _prev, _ctx) =>
          [Intent.storageSet(highScoreKey, value)]
        ),
        // Mount-once load: `onEnter` fires on the false→true edge only.
        fx.onEnter(_ =>
          true, ctx =>
          [
            Intent.query(
              {
                key: ["leaderboard"],
                task: fetchLeaderboard(),
                onOk: leaders => ctx.actions.setLeaders(leaders),
                onErr: _ => ctx.actions.setLeaders([])
              }
            )
          ]
        ),
        fx.onAction("submitScore", (_, ctx) =>
          [
            Intent.query(
              {
                key: ["submit-score"],
                task: postScore(
                  displayName(ctx.getState().name),
                  ctx.getState().score
                ),
                onOk: leaders => ctx.actions.setLeaders(leaders),
                onErr: _ => ctx.actions.setLeaders(ctx.getState().leaders)
              }
            )
          ]
        )
      ]
  }
)

/// Indexed map — prelude `map` is unary; leaderboard rows need their rank.
let mapIndexed = (f, xs) =>
  loop (i = 0, acc = []) {
    switch Array.get(i, xs) {
      | None => acc
      | Some(x) => recur(i + 1, [...acc, f(x, i)])
    }
  }

export let App = _ =>
  let store = useContainer(
    gameContainer,
    { interpreters: defaultInterpreters }
  ) in
  let snake = store->useSelect(s => s.snake.value) in
  let food = store->useSelect(s => s.food.value) in
  let score = store->useSelect(s => s.score.value) in
  let highScore = store->useSelect(s => s.highScore.value) in
  let status = store->useSelect(s => s.status.value) in
  let submitted = store->useSelect(s => s.submitted.value) in
  let name = store->useSelect(s => s.name.value) in
  let connected = store->useSelect(s => s.connected.value) in
  let leaders = store->useSelect(s => s.leaders.value) in
  // `$tone` below stays a ternary of literals: a helper's return (and switch
  // arms) widen string literals to `string`, which does not unify with the
  // styled-cva `$tone` literal union.
  // Two-parameter selector = read a `derive`d signal (ADR 0051).
  let playing = store->useSelect((_s, d) => d.playing.value) in
  let gameOver = store->useSelect((_s, d) => d.gameOver.value) in
  let paused = store->useSelect((_s, d) => d.paused.value) in
  // Mount one timer and read the store's live status signal on every turn.
  // This avoids coupling game progression to Preact re-render timing or a
  // derived signal's subscription lifecycle.
  let _tick = useEffect(() =>
    every(TICK_MS, () =>
      isPlayingStatus(store.$state.status.value)
        ? do {
          store.actions.step();
          ()
        }
        : ()
    )
  )(hookDeps0()) in
  // Two switches, not a nested `Some(MoveUp)`: the outer one absorbs the
  // unbound key, and the inner one has no catch-all — so adding a `Key`
  // constructor is a compile error here until it is handled.
  let _keys = useEffect(() =>
    onKeyDown(document(), raw => switch keyOf(raw) {
      | None => ()
      | Some(key) => switch key {
          | MoveUp => store.actions.up()
          | MoveDown => store.actions.down()
          | MoveLeft => store.actions.left()
          | MoveRight => store.actions.right()
          | TogglePlay => store.actions.space()
          | Restart =>
            // Restart only from the game-over screen. Reading `$derived` here keeps the
            // decision live: the handler is mounted once, so a captured `gameOver`
            // would go stale, and a reducer that inspected the state would have to
            // return the whole state — which is not a patch (see the `restart` arm).
            store.$derived.gameOver.value ? store.actions.restart() : ()
        }
    })
  )(hookDeps0()) in
  // The only surviving hand-rolled effect: a mount-once DOM/socket
  // subscription with a cleanup. The initial fetch and the localStorage write
  // are container reactions (see `effects` above); the push channel is not — it
  // has no intent shape and its teardown belongs to the component's lifetime.
  let _ws = useEffect(() =>
    connectWs(store.actions.setLeaders, store.actions.setConnected)
  )(hookDeps0()) in
    <div
      className="snake-wash h-dvh max-h-dvh overflow-hidden flex flex-col gap-4 p-4 md:p-6"
    >
      <Card
        className="flex-none flex items-center justify-between gap-4 px-5 py-3"
      >
        <div className="flex items-center gap-3">
          <img src="/logo.png" alt="Mochi" className="w-8 h-8 object-contain" />
          <div>
            <p
              className="font-display font-extrabold text-lg text-ink tracking-tight"
            >
              {"Mochi Snake"}
            </p>
            <p
              className="font-mono text-2xs text-mute uppercase tracking-label"
            >
              {"Bun.serve · WebSocket leaderboard"}
            </p>
          </div>
        </div>
        <div className="flex items-center gap-4">
          <div className="text-right">
            <ScoreLabel>{"Score"}</ScoreLabel>
            <ScoreValue>{show(score)}</ScoreValue>
          </div>
          <div className="text-right">
            <ScoreLabel>{"Best"}</ScoreLabel>
            <ScoreValue>{show(highScore)}</ScoreValue>
          </div>
          <WsStatus $connected={connected ? "on" : "off"}>
            <WsDot $connected={connected ? "on" : "off"} />
            {connected ? "Live" : "Offline"}
          </WsStatus>
        </div>
      </Card>
      <div
        className="flex-1 min-h-0 grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-4"
      >
        <Card className="relative min-h-0 flex items-center justify-center p-4">
          <CanvasBoard snake={snake} food={food} />
          <OverlayPanel $visible={playing ? "off" : "on"}>
            <OverlayTitle
              $tone={gameOver ? "gameOver" : paused ? "paused" : "ready"}
            >
              {statusHeadingOf(status)}
            </OverlayTitle>
            {gameOver
              ? <div
                className="flex flex-col items-center gap-3 w-full max-w-2xs"
              >
                <p className="font-mono text-sm text-mute">
                  {"Score: ${show(score)}"}
                </p>
                {submitted
                  ? <PrimaryBtn onClick={() => store.actions.restart()}>
                    {"Play Again"}
                  </PrimaryBtn>
                  : <div className="flex flex-col items-center gap-2 w-full">
                    <NameInput
                      placeholder="Callsign"
                      value={name}
                      onInput={e => store.actions.setName(e.target.value)}
                    />
                    <div className="flex items-center gap-2">
                      <PrimaryBtn onClick={() => store.actions.submitScore()}>
                        {"Submit Score"}
                      </PrimaryBtn>
                      <GhostBtn onClick={() => store.actions.restart()}>
                        {"Skip"}
                      </GhostBtn>
                    </div>
                  </div>}
              </div>
              : paused
              ? <div className="flex flex-col items-center gap-4 max-w-xs">
                <div
                  className="flex h-14 w-14 items-center justify-center rounded-full border-2 border-lavender-deep/30 bg-lavender/35 text-2xl font-extrabold text-lavender-deep shadow-soft"
                >
                  {"Ⅱ"}
                </div>
                <p className="font-mono text-sm text-ink/75">
                  {"Take a breath — your snake is waiting."}
                </p>
                <div className="flex flex-col items-center gap-2">
                  <PrimaryBtn onClick={() => store.actions.start()}>
                    {"Resume Game"}
                  </PrimaryBtn>
                  <p
                    className="font-mono text-2xs uppercase tracking-label text-mute"
                  >
                    {"Space to resume"}
                  </p>
                </div>
              </div>
              : <div className="flex flex-col items-center gap-4">
                <PrimaryBtn onClick={() => store.actions.start()}>
                  {"Start Game"}
                </PrimaryBtn>
              </div>}
          </OverlayPanel>
        </Card>
        <Card className="min-h-0 flex flex-col p-4 gap-3">
          <p className="font-display font-bold text-ink">{"Leaderboard"}</p>
          <ul className="flex-1 min-h-0 overflow-y-auto flex flex-col gap-1">
            {mapIndexed(
              (row, i) =>
                <LeaderRow key={show(i)} $rank={i < 3 ? "top" : "other"}>
                  <RankBadge>{"#${show(i + 1)}"}</RankBadge>
                  <PlayerName>{row.name}</PlayerName>
                  <PlayerScore>{show(row.score)}</PlayerScore>
                </LeaderRow>,
              leaders
            )}
          </ul>
        </Card>
      </div>
      <div
        className="flex-none flex items-center justify-center gap-3 font-mono text-2xs text-mute"
      >
        <Kbd>{"↑↓←→"}</Kbd>
        <span>{"move"}</span>
        <Kbd>{"Space"}</Kbd>
        <span>{"pause / start"}</span>
        <Kbd>{"R"}</Kbd>
        <span>{"restart"}</span>
      </div>
    </div>

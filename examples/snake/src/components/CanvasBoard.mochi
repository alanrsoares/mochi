// Canvas board — Mochi owns game state, animation, and every pixel. The host
// only obtains Canvas2D and schedules requestAnimationFrame.
import {
  useRef,
  useEffect,
  hookDeps2,
  setRef
} from "@mochi/plugin-preact/hooks"
import { performanceNow } from "@mochi/web/time"
import {
  beginPath,
  moveTo,
  lineTo,
  arc,
  fill,
  stroke,
  save,
  restore,
  clip,
  translate,
  roundRect,
  canvasRefSeed,
  startCanvasLoop,
  fillRect,
  setFillStyle,
  setStrokeStyle,
  setLineWidth,
  setGlobalAlpha
} from "@mochi/web/canvas"

extern type CanvasElement
extern type Context2D

type Ref<a> = { current: a }

type Board = { snake: [(number, number)], food: (number, number) }
type Motion = { changedAt: number, previous: Board, current: Board }
type Particle = { x: number, y: number, vx: number, vy: number, life: number, color: string }
type EatWatch = { len: number, food: (number, number) }
type BoardProps = { food: (number, number), snake: [(number, number)] }

let BOARD_PX = 600
let CELL_PX = 30
let MOVE_MS = 120
let HALF_BOARD_CELLS = 11
let TAU = 6.283185307179586

let interpolatePoint = ((fromX, fromY), (toX, toY), progress) =>
  (fromX + (toX - fromX) * progress, fromY + (toY - fromY) * progress)

let burstParticles : number -> number -> [Particle] = (x, y) =>
  let px = x * CELL_PX + CELL_PX / 2 in
  let py = y * CELL_PX + CELL_PX / 2 in
    [
      { x: px, y: py, vx: 4, vy: 0, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: -4, vy: 0, life: 1, color: "#EBA75C" },
      { x: px, y: py, vx: 0, vy: 4, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: 0, vy: -4, life: 1, color: "#EBA75C" },
      { x: px, y: py, vx: 3, vy: 3, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: -3, vy: 3, life: 1, color: "#EBA75C" },
      { x: px, y: py, vx: 3, vy: -3, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: -3, vy: -3, life: 1, color: "#EBA75C" }
    ]

let stepParticlesGo : [Particle] -> number -> [Particle] -> [Particle] = (particles, index, alive) => switch Array.get(index, particles) {
  | None => alive
  | Some(particle) => let next = {
      ...particle,
      x: particle.x + particle.vx,
      y: particle.y + particle.vy,
      life: particle.life - 0.05
    } in
      next.life > 0
        ? stepParticlesGo(particles, index + 1, [...alive, next])
        : stepParticlesGo(particles, index + 1, alive)
}
let stepParticles : [Particle] -> [Particle] = particles =>
  stepParticlesGo(particles, 0, [])

let updateEat : Ref<[Particle]> -> Ref<EatWatch> -> Board -> () = (particles, watch, board) =>
  let previous = watch.current in
  let _ = Array.length(board.snake) > previous.len
    ? let (x, y) = previous.food in
      setRef(particles, [...particles.current, ...burstParticles(x, y)])
    : () in
    setRef(watch, { len: Array.length(board.snake), food: board.food })

/// The simulation camera is transformed by the tiny host rAF seam. Everything
/// inside that world — grid, food, body, and face — is now Mochi Canvas code.
let drawGridX = (ctx, x, right, top, bottom) =>
  x > right
    ? ()
    : let _ = beginPath(ctx) in
    let _ = moveTo(ctx, x * CELL_PX, top * CELL_PX) in
    let _ = lineTo(ctx, x * CELL_PX, bottom * CELL_PX) in
    let _ = stroke(ctx) in drawGridX(ctx, x + 1, right, top, bottom)

let drawGridY = (ctx, y, left, right, bottom) =>
  y > bottom
    ? ()
    : let _ = beginPath(ctx) in
    let _ = moveTo(ctx, left * CELL_PX, y * CELL_PX) in
    let _ = lineTo(ctx, right * CELL_PX, y * CELL_PX) in
    let _ = stroke(ctx) in drawGridY(ctx, y + 1, left, right, bottom)

let drawGrid = (ctx, (cameraX, cameraY)) =>
  let left = floor(cameraX - HALF_BOARD_CELLS) in
  let right = ceil(cameraX + HALF_BOARD_CELLS) in
  let top = floor(cameraY - HALF_BOARD_CELLS) in
  let bottom = ceil(cameraY + HALF_BOARD_CELLS) in
  let _ = setStrokeStyle(ctx, "rgba(74, 58, 54, 0.12)") in
  let _ = setLineWidth(ctx, 1) in
  let _ = drawGridX(ctx, left, right, top, bottom) in
    drawGridY(ctx, top, left, right, bottom)

let drawFood = (ctx, (x, y)) =>
  let px = x * CELL_PX + CELL_PX / 2 in
  let py = y * CELL_PX + CELL_PX / 2 in
  let radius = CELL_PX / 2 - 3 in
  let _ = setFillStyle(ctx, "#E88BA9") in
  let _ = beginPath(ctx) in
  let _ = arc(ctx, px, py, radius, 0, TAU) in fill(ctx)

let drawEyesAt = (ctx, x, y, firstX, firstY, secondX, secondY) =>
  let px = x * CELL_PX in
  let py = y * CELL_PX in
  let _ = setFillStyle(ctx, "#4A3A36") in
  let _ = beginPath(ctx) in
  let _ = arc(ctx, px + CELL_PX * firstX, py + CELL_PX * firstY, 3, 0, TAU) in
  let _ = arc(ctx, px + CELL_PX * secondX, py + CELL_PX * secondY, 3, 0, TAU) in
    fill(ctx)

/// Eyes sit on the edge leading away from the neck, so the face follows turns.
let drawEyes = (ctx, x, y, neckX, neckY) =>
  neckX < x
    ? drawEyesAt(ctx, x, y, 0.7, 0.3, 0.7, 0.7)
    : neckX > x
    ? drawEyesAt(ctx, x, y, 0.3, 0.3, 0.3, 0.7)
    : neckY < y
    ? drawEyesAt(ctx, x, y, 0.3, 0.7, 0.7, 0.7)
    : drawEyesAt(ctx, x, y, 0.3, 0.3, 0.7, 0.3)

let drawSnakeGo = (ctx, snake, index) => switch Array.get(index, snake) {
  | None => ()
  | Some((x, y)) => let _ = setFillStyle(
      ctx,
      index == 0 ? "#D98D3E" : "rgba(235, 167, 92, 0.9)"
    ) in
    let _ = fillRect(ctx, x * CELL_PX, y * CELL_PX, CELL_PX, CELL_PX) in
    let _ = index == 0
      ? switch Array.get(1, snake) {
        | Some((neckX, neckY)) => drawEyes(ctx, x, y, neckX, neckY)
        | None => drawEyes(ctx, x, y, x - 1, y)
      }
      : () in
      drawSnakeGo(ctx, snake, index + 1)
}

let drawSnake = (ctx, snake) =>
  let _ = setStrokeStyle(ctx, "rgba(235, 167, 92, 0.9)") in
  let _ = setLineWidth(ctx, CELL_PX) in drawSnakeGo(ctx, snake, 0)

let drawBoard = (ctx, snake, _previousSnake, food, head) =>
  let _ = drawGrid(ctx, head) in
  let _ = drawFood(ctx, food) in drawSnake(ctx, snake)

let drawParticlesGo = (ctx, particles, index) => switch Array.get(index, particles) {
  | None => ()
  | Some(particle) => let _ = setFillStyle(ctx, particle.color) in
    let _ = setGlobalAlpha(ctx, particle.life) in
    let _ = beginPath(ctx) in
    let _ = arc(ctx, particle.x, particle.y, 3, 0, TAU) in
    let _ = fill(ctx) in
    let _ = setGlobalAlpha(ctx, 1) in drawParticlesGo(ctx, particles, index + 1)
}

let lastPointGo : [(number, number)] -> number -> (number, number) -> (number, number) = (snake, index, fallback) => switch Array.get(index, snake) {
  | None => fallback
  | Some(point) => lastPointGo(snake, index + 1, point)
}

let interpolateSnakeGo : [(number, number)] -> [(number, number)] -> number -> number -> (number, number) -> [(number, number)] -> [(number, number)] = (previous, current, progress, index, fallback, acc) => switch Array.get(index, current) {
  | None => acc
  | Some(point) => let from = Option.unwrapOr(
      fallback,
      Array.get(index, previous)
    ) in
      interpolateSnakeGo(
        previous,
        current,
        progress,
        index + 1,
        fallback,
        [...acc, interpolatePoint(from, point, progress)]
      )
}

let drawFrame : Ref<Motion> -> Ref<[Particle]> -> Context2D -> number -> () = (motionRef, particlesRef, ctx, time) =>
  let motion = motionRef.current in
  let elapsed = (time - motion.changedAt) / MOVE_MS in
  let progress = elapsed < 0 ? 0 : elapsed > 1 ? 1 : elapsed in
  let fallback = lastPointGo(motion.previous.snake, 0, (0, 0)) in
  let snake = interpolateSnakeGo(
    motion.previous.snake,
    motion.current.snake,
    progress,
    0,
    fallback,
    []
  ) in
  let head = Option.unwrapOr((0, 0), Array.get(0, snake)) in
  let alive = stepParticles(particlesRef.current) in
  let _ = setRef(particlesRef, alive) in
  let _ = save(ctx) in
  let _ = beginPath(ctx) in
  let _ = roundRect(ctx, 0, 0, BOARD_PX, BOARD_PX, CELL_PX / 2) in
  let _ = setFillStyle(ctx, "#F2E6D8") in
  let _ = fill(ctx) in
  let _ = clip(ctx) in
  let _ = save(ctx) in
  let (headX, headY) = head in
  let _ = translate(
    ctx,
    BOARD_PX / 2 - (headX + 0.5) * CELL_PX,
    BOARD_PX / 2 - (headY + 0.5) * CELL_PX
  ) in
  let _ = drawBoard(
    ctx,
    snake,
    motion.previous.snake,
    motion.current.food,
    head
  ) in
  let _ = drawParticlesGo(ctx, alive, 0) in let _ = restore(ctx) in restore(ctx)

export let CanvasBoard : BoardProps -> VNode = props =>
  let canvasRef = useRef(canvasRefSeed) in
  let particles = useRef([]) in
  let eatWatch = useRef({ len: Array.length(props.snake), food: props.food }) in
  let board = { snake: props.snake, food: props.food } in
  let motion = useRef(
    { previous: board, current: board, changedAt: performanceNow() }
  ) in
  let previous = motion.current in
  let _sync = setRef(
    motion,
    { previous: previous.current, current: board, changedAt: performanceNow() }
  ) in
  let _eat = useEffect(() => updateEat(particles, eatWatch, board)
  )(hookDeps2(props.snake, props.food)) in
  // The host only schedules rAF and gets Canvas2D; this closure owns each frame.
  let _draw = useEffect(() =>
    startCanvasLoop(canvasRef, (ctx, time) =>
      drawFrame(motion, particles, ctx, time)
    )
  )(hookDeps2(canvasRef, motion)) in
    <canvas
      ref={canvasRef}
      id="game-canvas"
      width={BOARD_PX}
      height={BOARD_PX}
      className="block h-auto max-h-full w-auto max-w-full rounded-[15px] border-2 border-line-strong shadow-lg"
    />
// @mochi open

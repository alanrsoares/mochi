// Canvas board — Mochi owns game state, animation, and every pixel. The host
// only obtains Canvas2D and schedules requestAnimationFrame.
import {
  useRef,
  useEffect,
  hookDeps2,
  setRef
} from "@mochi/plugin-preact/hooks"
import { performanceNow } from "@mochi/web/time"
import {
  beginPath,
  moveTo,
  lineTo,
  arc,
  fill,
  stroke,
  save,
  restore,
  clip,
  translate,
  roundRect,
  canvasRefSeed,
  startCanvasLoop,
  setFillStyle,
  setStrokeStyle,
  setLineWidth,
  setLineCap,
  setLineJoin,
  setGlobalAlpha
} from "@mochi/web/canvas"

extern type CanvasElement
extern type Context2D

type Ref<a> = { current: a }

type Board = { snake: [(number, number)], food: (number, number) }
type Motion = { changedAt: number, previous: Board, current: Board }
type Particle = { x: number, y: number, vx: number, vy: number, life: number, color: string }
type EatWatch = { len: number, food: (number, number) }
type BoardProps = { food: (number, number), snake: [(number, number)] }

let BOARD_PX = 600
let CELL_PX = 30
let MOVE_MS = 120
let HALF_BOARD_CELLS = 11
let TAU = 6.283185307179586
let VISIBLE_CELLS = 9
let EDGE_INSET = 10
let GLOW_HALF_SPAN = 24

let interpolatePoint = ((fromX, fromY), (toX, toY), progress) =>
  (fromX + (toX - fromX) * progress, fromY + (toY - fromY) * progress)

let burstParticles : number -> number -> [Particle] = (x, y) =>
  let px = x * CELL_PX + CELL_PX / 2 in
  let py = y * CELL_PX + CELL_PX / 2 in
    [
      { x: px, y: py, vx: 4, vy: 0, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: -4, vy: 0, life: 1, color: "#EBA75C" },
      { x: px, y: py, vx: 0, vy: 4, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: 0, vy: -4, life: 1, color: "#EBA75C" },
      { x: px, y: py, vx: 3, vy: 3, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: -3, vy: 3, life: 1, color: "#EBA75C" },
      { x: px, y: py, vx: 3, vy: -3, life: 1, color: "#E88BA9" },
      { x: px, y: py, vx: -3, vy: -3, life: 1, color: "#EBA75C" }
    ]

let stepParticlesGo : [Particle] -> number -> [Particle] -> [Particle] = (particles, index, alive) => switch Array.get(index, particles) {
  | None => alive
  | Some(particle) => let next = {
      ...particle,
      x: particle.x + particle.vx,
      y: particle.y + particle.vy,
      life: particle.life - 0.05
    } in
      next.life > 0
        ? stepParticlesGo(particles, index + 1, [...alive, next])
        : stepParticlesGo(particles, index + 1, alive)
}
let stepParticles : [Particle] -> [Particle] = particles =>
  stepParticlesGo(particles, 0, [])

let updateEat : Board -> Ref<[Particle]> -> Ref<EatWatch> -> () = (board, particles, watch) =>
  let previous = watch.current in
    do {
      Array.length(board.snake) > previous.len
        ? let (x, y) = previous.food in
          particles->setRef([...particles.current, ...burstParticles(x, y)])
        : ();
      watch->setRef({ len: Array.length(board.snake), food: board.food })
    }

/// The simulation camera is transformed by the tiny host rAF seam. Everything
/// inside that world — grid, food, body, and face — is now Mochi Canvas code.
let drawGridX = (ctx, x, right, top, bottom) =>
  loop (i = x) {
    i > right
      ? ()
      : do {
        ctx->beginPath();
        ctx->moveTo(i * CELL_PX, top * CELL_PX);
        ctx->lineTo(i * CELL_PX, bottom * CELL_PX);
        ctx->stroke();
        recur(i + 1)
      }
  }

let drawGridY = (ctx, y, left, right, bottom) =>
  loop (i = y) {
    i > bottom
      ? ()
      : do {
        ctx->beginPath();
        ctx->moveTo(left * CELL_PX, i * CELL_PX);
        ctx->lineTo(right * CELL_PX, i * CELL_PX);
        ctx->stroke();
        recur(i + 1)
      }
  }

let drawGrid = (ctx, (cameraX, cameraY)) =>
  let left = floor(cameraX - HALF_BOARD_CELLS) in
  let right = ceil(cameraX + HALF_BOARD_CELLS) in
  let top = floor(cameraY - HALF_BOARD_CELLS) in
  let bottom = ceil(cameraY + HALF_BOARD_CELLS) in
    do {
      ctx->setStrokeStyle("rgba(74, 58, 54, 0.12)");
      ctx->setLineWidth(1);
      ctx->drawGridX(left, right, top, bottom);
      ctx->drawGridY(top, left, right, bottom)
    }

let drawFood = (ctx, (x, y)) =>
  let px = x * CELL_PX + CELL_PX / 2 in
  let py = y * CELL_PX + CELL_PX / 2 in
  let radius = CELL_PX / 2 - 3 in
    do {
      ctx->setFillStyle("#E88BA9");
      ctx->beginPath();
      ctx->arc(px, py, radius, 0, TAU);
      ctx->fill()
    }

let drawEyesAt = (ctx, x, y, firstX, firstY, secondX, secondY) =>
  let px = x * CELL_PX in
  let py = y * CELL_PX in
    do {
      ctx->setFillStyle("#4A3A36");
      ctx->beginPath();
      ctx->arc(px + CELL_PX * firstX, py + CELL_PX * firstY, 3, 0, TAU);
      ctx->arc(px + CELL_PX * secondX, py + CELL_PX * secondY, 3, 0, TAU);
      ctx->fill()
    }

/// Eyes sit on the edge leading away from the neck, so the face follows turns.
let drawEyes = (ctx, x, y, neckX, neckY) =>
  neckX < x
    ? ctx->drawEyesAt(x, y, 0.7, 0.3, 0.7, 0.7)
    : neckX > x
    ? ctx->drawEyesAt(x, y, 0.3, 0.3, 0.3, 0.7)
    : neckY < y
    ? ctx->drawEyesAt(x, y, 0.3, 0.7, 0.7, 0.7)
    : ctx->drawEyesAt(x, y, 0.3, 0.3, 0.7, 0.3)

let drawSnakePathGo = (ctx, snake, index) => switch Array.get(index, snake) {
  | None => ()
  | Some((x, y)) => let px = (x + 0.5) * CELL_PX in
    let py = (y + 0.5) * CELL_PX in
      do {
        index == 0 ? ctx->moveTo(px, py) : ctx->lineTo(px, py);
        ctx->drawSnakePathGo(snake, index + 1)
      }
}

let drawSnakeHead = (ctx, snake) => switch Array.get(0, snake) {
  | None => ()
  | Some((x, y)) => do {
      ctx->setFillStyle("#D98D3E");
      ctx->beginPath();
      ctx->arc(
        (x + 0.5) * CELL_PX,
        (y + 0.5) * CELL_PX,
        CELL_PX / 2 - 1,
        0,
        TAU
      );
      ctx->fill();
      switch Array.get(1, snake) {
        | Some((neckX, neckY)) => ctx->drawEyes(x, y, neckX, neckY)
        | None => ctx->drawEyes(x, y, x - 1, y)
      }
    }
}

let drawSnake = (ctx, snake) => {
  ctx->setStrokeStyle("rgba(235, 167, 92, 0.9)");
  ctx->setLineWidth(CELL_PX - 3);
  ctx->setLineCap("round");
  ctx->setLineJoin("round");
  ctx->beginPath();
  ctx->drawSnakePathGo(snake, 0);
  ctx->stroke();
  ctx->drawSnakeHead(snake)
}

/// Food beyond the camera leaves a quiet dango-pink highlight on the edge it
/// crossed. A diagonal target lights both relevant edges, retaining its
/// bearing without adding an in-world object or a distracting HUD marker.
let drawFoodEdgeGlow = (ctx, (foodX, foodY), (headX, headY)) =>
  let deltaX = foodX - headX in
  let deltaY = foodY - headY in
  let visible = deltaX >= 0 - VISIBLE_CELLS && deltaX <= VISIBLE_CELLS && deltaY >= 0 - VISIBLE_CELLS && deltaY <= VISIBLE_CELLS in
    visible
      ? ()
      : let rawX = BOARD_PX / 2 + deltaX * CELL_PX in
      let rawY = BOARD_PX / 2 + deltaY * CELL_PX in
      let edgeX = rawX < EDGE_INSET + GLOW_HALF_SPAN
        ? EDGE_INSET + GLOW_HALF_SPAN
        : rawX > BOARD_PX - EDGE_INSET - GLOW_HALF_SPAN
        ? BOARD_PX - EDGE_INSET - GLOW_HALF_SPAN
        : rawX in
      let edgeY = rawY < EDGE_INSET + GLOW_HALF_SPAN
        ? EDGE_INSET + GLOW_HALF_SPAN
        : rawY > BOARD_PX - EDGE_INSET - GLOW_HALF_SPAN
        ? BOARD_PX - EDGE_INSET - GLOW_HALF_SPAN
        : rawY in
        do {
          ctx->setStrokeStyle("rgba(232, 139, 169, 0.48)");
          ctx->setLineWidth(5);
          ctx->beginPath();
          rawY <= EDGE_INSET
            ? do {
              ctx->moveTo(edgeX - GLOW_HALF_SPAN, EDGE_INSET);
              ctx->lineTo(edgeX + GLOW_HALF_SPAN, EDGE_INSET)
            }
            : rawY >= BOARD_PX - EDGE_INSET
            ? do {
              ctx->moveTo(edgeX - GLOW_HALF_SPAN, BOARD_PX - EDGE_INSET);
              ctx->lineTo(edgeX + GLOW_HALF_SPAN, BOARD_PX - EDGE_INSET)
            }
            : ();
          rawX <= EDGE_INSET
            ? do {
              ctx->moveTo(EDGE_INSET, edgeY - GLOW_HALF_SPAN);
              ctx->lineTo(EDGE_INSET, edgeY + GLOW_HALF_SPAN)
            }
            : rawX >= BOARD_PX - EDGE_INSET
            ? do {
              ctx->moveTo(BOARD_PX - EDGE_INSET, edgeY - GLOW_HALF_SPAN);
              ctx->lineTo(BOARD_PX - EDGE_INSET, edgeY + GLOW_HALF_SPAN)
            }
            : ();
          ctx->stroke()
        }

let drawBoard = (ctx, snake, _previousSnake, food, head) => {
  ctx->drawGrid(head);
  ctx->drawFood(food);
  ctx->drawSnake(snake)
}

let drawParticlesGo = (ctx, particles, index) => switch Array.get(index, particles) {
  | None => ()
  | Some(particle) => do {
      ctx->setFillStyle(particle.color);
      ctx->setGlobalAlpha(particle.life);
      ctx->beginPath();
      ctx->arc(particle.x, particle.y, 3, 0, TAU);
      ctx->fill();
      ctx->setGlobalAlpha(1);
      ctx->drawParticlesGo(particles, index + 1)
    }
}

let lastPointGo : [(number, number)] -> number -> (number, number) -> (number, number) = (snake, index, fallback) => switch Array.get(index, snake) {
  | None => fallback
  | Some(point) => snake->lastPointGo(index + 1, point)
}

let interpolateSnakeGo : [(number, number)] -> [(number, number)] -> number -> number -> (number, number) -> [(number, number)] -> [(number, number)] = (previous, current, progress, index, fallback, acc) => switch Array.get(index, current) {
  | None => acc
  | Some(point) => let from = Option.unwrapOr(
      fallback,
      Array.get(index, previous)
    ) in
      interpolateSnakeGo(
        previous,
        current,
        progress,
        index + 1,
        fallback,
        [...acc, interpolatePoint(from, point, progress)]
      )
}

let drawFrame : Context2D -> Ref<Motion> -> Ref<[Particle]> -> number -> () = (ctx, motionRef, particlesRef, time) =>
  let motion = motionRef.current in
  let elapsed = (time - motion.changedAt) / MOVE_MS in
  let progress = elapsed < 0 ? 0 : elapsed > 1 ? 1 : elapsed in
  let fallback = lastPointGo(motion.previous.snake, 0, (0, 0)) in
  let snake = interpolateSnakeGo(
    motion.previous.snake,
    motion.current.snake,
    progress,
    0,
    fallback,
    []
  ) in
  let head = Option.unwrapOr((0, 0), Array.get(0, snake)) in
  let alive = stepParticles(particlesRef.current) in
    do {
      particlesRef->setRef(alive);
      ctx->save();
      ctx->beginPath();
      ctx->roundRect(0, 0, BOARD_PX, BOARD_PX, CELL_PX / 2);
      ctx->setFillStyle("#F2E6D8");
      ctx->fill();
      ctx->clip();
      ctx->save();
      let (headX, headY) = head in
        do {
          ctx->translate(
            BOARD_PX / 2 - (headX + 0.5) * CELL_PX,
            BOARD_PX / 2 - (headY + 0.5) * CELL_PX
          );
          ctx->drawBoard(
            snake,
            motion.previous.snake,
            motion.current.food,
            head
          );
          ctx->drawParticlesGo(alive, 0);
          ctx->restore();
          ctx->drawFoodEdgeGlow(motion.current.food, head);
          ctx->restore()
        }
    }

export let CanvasBoard : BoardProps -> VNode = props =>
  let canvasRef = useRef(canvasRefSeed) in
  let particles = useRef([]) in
  let eatWatch = useRef({ len: Array.length(props.snake), food: props.food }) in
  let board = { snake: props.snake, food: props.food } in
  let motion = useRef(
    { previous: board, current: board, changedAt: performanceNow() }
  ) in
  let previous = motion.current in
  let _sync = setRef(
    motion,
    { previous: previous.current, current: board, changedAt: performanceNow() }
  ) in
  let _eat = useEffect(() => board->updateEat(particles, eatWatch)
  )(hookDeps2(props.snake, props.food)) in
  // The host only schedules rAF and gets Canvas2D; this closure owns each frame.
  let _draw = useEffect(() =>
    startCanvasLoop(canvasRef, (ctx, time) =>
      ctx->drawFrame(motion, particles, time)
    )
  )(hookDeps2(canvasRef, motion)) in
    <canvas
      ref={canvasRef}
      id="game-canvas"
      width={BOARD_PX}
      height={BOARD_PX}
      className="block h-auto max-h-full w-auto max-w-full rounded-[15px] border-2 border-line-strong shadow-lg"
    />
// @mochi open

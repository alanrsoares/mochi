// Canvas Snake Game - Pure State & Logic in Mochi
//
// Build with:
//   bun run mochi build examples/snake/snake.mochi

export type Direction =
  | Up
  | Down
  | Left
  | Right

export type Status =
  | Ready
  | Playing
  | Paused
  | GameOver

export type State = { snake: [(number, number)], food: (number, number), dir: Direction, dirQueue: [Direction], score: number, highScore: number, status: Status, cols: number, rows: number }

/// Calculate next head position based on direction
let nextHead = ((x, y), dir) => switch dir {
  | Up => (x, y - 1)
  | Down => (x, y + 1)
  | Left => (x - 1, y)
  | Right => (x + 1, y)
}

/// Prevent 180-degree immediate self-reversal
let isOpposite = (d1, d2) => switch (d1, d2) {
  | (Up, Down) => true
  | (Down, Up) => true
  | (Left, Right) => true
  | (Right, Left) => true
  | _ => false
}

/// Get the last intended direction in queue or current dir
let lastIntendedDir = state => switch Array.head(Array.reverse(state.dirQueue)) {
  | Some(d) => d
  | None => state.dir
}

/// Check if position (x, y) is out of grid bounds
let checkWallCollision = ((x, y), cols, rows) =>
  x < 0 || x >= cols || y < 0 || y >= rows

/// Check if position is contained within the snake body
let checkSelfCollision = (head, body) => Array.contains(head)(body)

/// Every cell of the board the snake does not occupy. The host then picks one
/// at random — rejection sampling in the host could not terminate once the
/// snake filled the board, and "which cells are legal" is a game rule anyway.
export let freeCells = (cols, rows, snake) =>
  range(0, cols)
    |> toArray
    |> Array.flatMap(x => range(0, rows) |> toArray |> Array.map(y => (x, y)))
    |> Array.filter(cell => !Array.contains(cell)(snake))

/// Initialize a fresh game state
export let initGame = (cols, rows, highScore) =>
  let initialSnake = [(10, 10), (9, 10), (8, 10)] in
  let initialFood = (15, 10) in
    {
      snake: initialSnake,
      food: initialFood,
      dir: Right,
      dirQueue: [],
      score: 0,
      highScore: highScore,
      status: Ready,
      cols: cols,
      rows: rows,
      submitted: false
    }

/// Queue directional input for guaranteed ordered handling
export let changeDir = (state, newDir) => switch state.status {
  | Playing => let maxQueueSize = 3 in
      Array.length(state.dirQueue) >= maxQueueSize
        ? state
        : let lastDir = lastIntendedDir(state) in
          isOpposite(lastDir, newDir) || lastDir == newDir
            ? state
            : { ...state, dirQueue: Array.append(newDir)(state.dirQueue) }
  | Ready => let lastDir = lastIntendedDir(state) in
      isOpposite(lastDir, newDir)
        ? state
        : { ...state, dir: newDir, dirQueue: [newDir] }
  | _ => state
}

/// Start or unpause the game
export let startGame = state => switch state.status {
  | Ready => { ...state, status: Playing }
  | Paused => { ...state, status: Playing }
  | _ => state
}

/// Toggle pause state
export let togglePause = state => switch state.status {
  | Playing => { ...state, status: Paused }
  | Paused => { ...state, status: Playing }
  | _ => state
}

/// Advance game state by one frame tick
export let step = (state, randomFood) => switch state.status {
  | Playing => let _ = isOpposite(state.dir, Up) in
    let currentDir = switch Array.head(state.dirQueue) {
      | Some(d) => d
      | None => state.dir
    } in
    let remainingQueue = switch state.dirQueue {
      | [_, ...tail] => tail
      | _ => state.dirQueue
    } in
    let head = Array.head(state.snake) |> Option.unwrapOr((0, 0)) in
    let newHead = nextHead(head, currentDir) in
    let hitWall = checkWallCollision(newHead, state.cols, state.rows) in
    let hitSelf = checkSelfCollision(newHead, state.snake) in
      hitWall || hitSelf
        ? let finalHighScore = max(state.score, state.highScore) in
          { ...state, status: GameOver, highScore: finalHighScore }
        : let eating = newHead == state.food in
        let newScore = eating ? state.score + 10 : state.score in
        let newHigh = max(newScore, state.highScore) in
        let rawBody = [newHead, ...state.snake] in
        let snakeLen = Array.length(state.snake) in
        let newSnake = eating ? rawBody : rawBody |> Array.take(snakeLen) in
        let newFood = eating ? randomFood : state.food in
          {
            ...state,
            snake: newSnake,
            food: newFood,
            dir: currentDir,
            dirQueue: remainingQueue,
            score: newScore,
            highScore: newHigh
          }
  | _ => state
}

/// UI-facing status helpers (App.mochi). Kept here rather than pattern-matched
/// in the importing module: the Vite plugin's per-file `compile()` path has no
/// cross-module ctor registry (only the `module.ts` graph driver does), so a
/// `switch` on an imported variant's constructors fails static checking there
/// — plain value/function imports and equality are unaffected, only pattern
/// matching is. These stay switch-based here, where `Status`'s constructors
/// are locally declared.
export let isPlayingStatus = status => switch status {
  | Playing => true
  | _ => false
}

export let isGameOverStatus = status => switch status {
  | GameOver => true
  | _ => false
}

export let statusToneOf = status => switch status {
  | Playing => "ready"
  | GameOver => "gameOver"
  | _ => "paused"
}

export let statusHeadingOf = status => switch status {
  | GameOver => "Game Over"
  | Playing => ""
  | _ => "Ready?"
}

export let isPlaying = state => isPlayingStatus(state.status)
export let isGameOver = state => isGameOverStatus(state.status)
export let statusTone = state => statusToneOf(state.status)
export let statusHeading = state => statusHeadingOf(state.status)

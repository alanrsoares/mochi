# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# Compiled `mochi build` output is always `.js`. Every source file is `.ts`,
# `.mochi`, or a hand-written/generated host runtime kept as `.mjs`, so all
# `.js` in the tree is a build artifact and safe to ignore wholesale.
*.js
!test/conformance/**/*.expect.js

# The stage-1 bootstrap binary is a reviewed emitted artifact (ADR 0090),
# not ordinary `mochi build` output. Its manifest records the exact frozen graph.
!/bootstrap/seed/
!/bootstrap/seed/**/*.ts
!/bootstrap/seed/**/*.js
!/bootstrap/seed/**/*.cjs
!/bootstrap/seed/**/*.d.mts

# bootstrap `build --emit=ts` drops `.ts` / `.d.mts` beside the `.mochi` sources
# (JS emit is already covered by `*.js` above).
/bootstrap/*.ts
/bootstrap/*.d.mts
/bootstrap/plugins/*.ts
/examples/**/*.ts
/examples/**/*.d.mts
/examples/snake/leaderboard.json

# examples/snake is a real Vite app (dogfoods the mochi Vite plugin) — its
# hand-written TS is source, not `mochi build --emit=ts` output; un-ignore it.
!/examples/snake/vite.config.ts
!/examples/snake/mochi.plugins.ts
!/examples/snake/src/**/*.ts
!/examples/snake/src/**/*.tsx

# Host TS declaration sidecars for `.mochi` modules (TS 5 `allowArbitraryExtensions`
# looks for `{name}.d.mochi.ts` beside `{name}.mochi`). Regenerated by
# `bun run gen:mochi-dts` before docs typecheck/dev/build.
**/*.d.mochi.ts


# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# planning docs / issue tracker — kept local, not tracked
docs/plan/

# editor-local config — shared instructions live in root AGENTS.md
.cursor/*

.serena/
.fixpoint-work/

# TS-backend differential test scratch (ADR 0026)
test/.tsgen/

# build --emit=ts differential scratch (ADR 0026)
test/.tsgen-graph/

# bootstrap-cli.spec.ts subprocess scratch (needs repo node_modules on the resolution path)
test/.mochi-cli-*/

.claude
test/conformance/.candidate/

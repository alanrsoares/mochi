// Typed Preact hooks seam (ADR 0015). Import from apps; register
// `preactExtension` on the project plugin list — `inferCall` pins call-site
// shapes (state/setter, ref.current, effect thunk, memo body).
//
// Extern schemes stay loose where HM would lie; the plugin tightens at calls.
// `() ->` is the nullary domain (ADR 0014). Dep lists stay opaque / packed
// via `hookDeps*` — mochi arrays are homogeneous.
export extern useState<A, B> : A -> (A, A -> B) = "preact/hooks" "useState"
export extern useEffect<C, D, E> : (() -> C) -> D -> E = "preact/hooks" "useEffect"
export extern useCallback<A, B> : A -> B -> A = "preact/hooks" "useCallback"
export extern useLayoutEffect<C, D, E> : (() -> C) -> D -> E = "preact/hooks" "useLayoutEffect"
export extern useRef<A, B> : A -> B = "preact/hooks" "useRef"
export extern useMemo<A, B> : (() -> A) -> B -> A = "preact/hooks" "useMemo"

export extern hookDeps<A, B, C, D> : A -> B -> C -> D = "./src/runtime" "hookDeps"
export extern hookDeps2<A, B, C> : A -> B -> C = "./src/runtime" "hookDeps2"
export extern hookDeps1<A, B> : A -> B = "./src/runtime" "hookDeps1"
export extern hookDeps0<A> : () -> A = "./src/runtime" "hookDeps0"

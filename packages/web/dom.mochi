/// Browser DOM bindings for Mochi applications.
///
/// Nullable browser results become `Option`; listener helpers return an effect
/// cleanup suitable for Preact's `useEffect`.

extern type Document
extern type Element
extern type InputElement
extern type Storage
extern type Frame
extern type Cleanup

export extern document : () -> Document = "@mochi/web/runtime" "document"
export extern getElementById : Document -> string -> Option<Element> = "@mochi/web/runtime" "getElementById"
export extern inputValue : InputElement -> string = "@mochi/web/runtime" "inputValue"
export extern localStorage : () -> Storage = "@mochi/web/runtime" "localStorage"
export extern storageGet : Storage -> string -> Option<string> = "@mochi/web/runtime" "storageGet"
export extern storageSet : Storage -> string -> string -> () = "@mochi/web/runtime" "storageSet"
/// Registers a keyboard listener and returns an opaque effect cleanup.
export extern onKeyDown : Document -> (string -> ()) -> Cleanup = "@mochi/web/runtime" "onKeyDown"
/// Registers an interval and returns an opaque effect cleanup.
export extern every : number -> (() -> ()) -> Cleanup = "@mochi/web/runtime" "every"
export extern pickRandom<T> : T -> [T] -> T = "@mochi/web/runtime" "pickRandom"
export extern requestFrame : (number -> ()) -> Frame = "@mochi/web/runtime" "requestFrame"
export extern cancelFrame : Frame -> () = "@mochi/web/runtime" "cancelFrame"

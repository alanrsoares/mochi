import { ok, test } from "@mochi/test"
import { compile } from "./compile.mochi"

test("well-typed source emits a binding", () => switch compile("let x = 1") {
  | Ok(js) => js |> Str.contains("const x = 1") |> ok
  | Err(_) => false |> ok
})

test("non-exhaustive switch is Err", () => switch compile("type C = A | B\nlet f = c => switch c { | A => 1 }") {
  | Err(errors) => switch Array.head(errors) {
      | Some(e) => e.message |> Str.contains("non-exhaustive") |> ok
      | None => false |> ok
    }
  | Ok(_) => false |> ok
})

test("type error is Err", () => switch compile("let x = mul(1, \"hi\")") {
  | Err(errors) => switch Array.head(errors) {
      | Some(e) => e.message |> Str.contains("unify") |> ok
      | None => false |> ok
    }
  | Ok(_) => false |> ok
})

test("compile collects independent checker errors", () => switch compile("type C = A | B\nlet f = c => switch c { | A => 1 }\nlet g = c => switch c { | B => 2 }") {
  | Err(errors) => Array.length(errors) == 2 |> ok
  | Ok(_) => false |> ok
})

test("optional record projection wraps in Option", () => switch compile("type Props = { id?: string }\nlet getId = (p: Props) => p.id") {
  | Ok(js) => js |> Str.contains("_tag: \"Some\"") |> ok
  | Err(_) => false |> ok
})

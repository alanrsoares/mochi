import { assertEq, test } from "@mochi/test"
import * as Ast from "../ast/ast.mochi"
import { recordAliasIndex } from "../codegen/typescript.mochi"
import { declarationRecs, emitDtsTextWith } from "./dts.mochi"
import { defaultOpts } from "../compile/compile.mochi"

test("host declaration spellings preserve JSX values", () =>
  assertEq(
    Ok("export declare const app: import(\"host\").Node;\n"),
    emitDtsTextWith(
      "let app = <div />",
      "@mochi/runtime",
      { ...defaultOpts, dtsTypeNames: #{ "VNode": "import(\"host\").Node" } }
    )
  ))

test("unconfigured JSX declarations retain their host-independent fallback", () =>
  assertEq(
    Ok("export declare const app: any;\n"),
    emitDtsTextWith("let app = <div />", "@mochi/runtime", defaultOpts)
  ))

let sp = { start: 0, end: 0 }
let spanFields = [
  {
    name: "start",
    nameSpan: sp,
    fieldType: Ast.TyName("number", sp),
    optional: false,
    spread: false
  },
  {
    name: "end",
    nameSpan: sp,
    fieldType: Ast.TyName("number", sp),
    optional: false,
    spread: false
  }
]
let spanAlias = { params: [], fields: spanFields, expr: None }

let printed = (stmts, aliases) =>
  let indexed = recordAliasIndex(aliases) in
  let key = Option.unwrapOr("", Array.get(0, Map.keys(indexed))) in
    Option.unwrapOr("missing", Map.get(key, declarationRecs(stmts, aliases)))

test("a declaration does not print a namespace-only record alias bare", () =>
  let aliases = #{ "Ast.Span": spanAlias } in
    do {
      assertEq(
        "Span",
        Option.unwrapOr(
          "",
          Map.get(
            Option.unwrapOr(
              "",
              Array.get(0, Map.keys(recordAliasIndex(aliases)))
            ),
            recordAliasIndex(aliases)
          )
        )
      );
      assertEq("", printed([], aliases))
    })

test("a declaration keeps a record alias this file declares", () =>
  let local = Ast.SType(
    "Span",
    sp,
    [],
    [],
    Some(spanFields),
    None,
    true,
    None,
    sp
  ) in
    assertEq(
      "Span",
      printed([local], #{ "Ast.Span": spanAlias, "Span": spanAlias })
    ))

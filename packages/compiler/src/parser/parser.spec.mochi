import { assertEq, ok, test, testEach } from "@mochi/test"
import * as Ast from "../ast/ast.mochi"
import { lex } from "../lexer/lexer.mochi"
import { parse, parseRecovering } from "./parser.mochi"

let parseSrc = src => lex(src) |> Result.flatMap(parse)

testEach("invalid fast pipes explain the ordinary pipe alternative", [
  "let value = 5 -> (+ 3)",
  "let value = 5 -> add"
], src => switch parseSrc(src) {
  | Err(e) => e.message |> Str.contains("use `|>`") |> ok
  | Ok(_) => false |> ok
})

test("a let declaration preserves its name, doc, and lambda shape", () => switch parseSrc("/// increments\nlet inc = n => n + 1") {
  | Ok([Ast.SLet("inc", _, None, Ast.ELambda([Ast.LPSpanned(Ast.LPName("n", None), [span])], _, _), false, Some("increments"), _)]) => span.start == 25 && span.end == 26
      |> ok
  | _ => false |> ok
})

// The parser KEEPS the fast pipe (`fast: true`); the arg-prepending lowering to
// `add(1, 2)` happens in infer/codegen, so the formatter can print `->` back.
test("fast pipe is retained as a node, not desugared", () => switch parseSrc("let value = 1->add(2)") {
  | Ok([Ast.SLet("value", _, None, Ast.EPipe(Ast.ENum(1, "1", _), Ast.ECall(Ast.ERef("add", _), [Ast.ENum(2, "2", _)], None, _), true, _), false, None, _)]) => true
      |> ok
  | _ => false |> ok
})

test("`|>` is retained too, and is not marked fast", () => switch parseSrc("let value = 1 |> add") {
  | Ok([Ast.SLet("value", _, None, Ast.EPipe(Ast.ENum(1, "1", _), Ast.ERef("add", _), false, _), false, None, _)]) => true
      |> ok
  | _ => false |> ok
})

test("a let-in KEEPS its `: T` annotation on the node (ADR 0044)", () => switch parseSrc("let value = let x : number = 1 in x") {
  | Ok([Ast.SLet("value", _, None, Ast.ELetIn("x", _, Some(Ast.TyName("number", _)), Ast.ENum(1, "1", _), Ast.ERef("x", _), _), false, None, _)]) => true
      |> ok
  | _ => false |> ok
})

test("an unannotated let-in carries None", () => switch parseSrc("let value = let x = 1 in x") {
  | Ok([Ast.SLet("value", _, None, Ast.ELetIn("x", _, None, _, _, _), false, None, _)]) => true
      |> ok
  | _ => false |> ok
})

test("keyword labels are valid in records and projections", () => switch parseSrc("let button = { type: \"button\" }\nlet kind = button.type") {
  | Ok([Ast.SLet("button", _, None, Ast.ERecord([{ name: "type", value: Ast.EStr("button", _) }], None, _), false, None, _), Ast.SLet("kind", _, None, Ast.EField(Ast.ERef("button", _), "type", _, _), false, None, _)]) => true
      |> ok
  | _ => false |> ok
})

test("namespace imports keep their alias and source", () => switch parseSrc("import * as Shapes from \"./shapes.mochi\"") {
  | Ok([Ast.SImportNs({ name: "Shapes", span: _ }, "./shapes.mochi", _)]) => true
      |> ok
  | _ => false |> ok
})

testEach("parse rejects malformed declarations", [
  { label: "missing let value", src: "let x =", want: "unexpected token eof" },
  {
    label: "invalid export target",
    src: "export import { x } from \"./x.mochi\"",
    want: "`export` must precede"
  }
], row => switch parseSrc(row.src) {
  | Err(e) => e.message |> Str.contains(row.want) |> ok
  | Ok(_) => false |> ok
})

// `>>` lexes as two `>` (ADR 0116). Touching, they are composition, which
// binds looser than `&&`; with a space between they are two comparisons.
let valueOf = src => switch parseSrc(src) {
  | Ok([Ast.SLet(_, _, _, value, _, _, _)]) => Some(value)
  | _ => None
}

let isLambda = e => switch e {
  | Some(Ast.ELambda(_, _, _)) => true
  | _ => false
}

testEach("touching `>` compose", [
  "let h = f >> g",
  "let h = x && f >> g",
  "let h = f >> g >> k"
], src => valueOf(src) |> isLambda |> ok)

test("`> >` with a space is not composition", () =>
  parseSrc("let h = f > > g") |> Result.isErr |> ok)

test("a single `>` is still a comparison", () => switch valueOf("let b = a > c") {
  | Some(Ast.ECall(Ast.ERef("gt", _), [_, _], _, _)) => true |> ok
  | _ => false |> ok
})

let recover = src => switch lex(src) {
  | Ok(toks) => Some(parseRecovering(toks, None))
  | Err(_) => None
}

testEach("recovery resumes at declaration boundaries", [
  {
    label: "offending token starts the next declaration",
    src: "let x let y = 2",
    message: "expected eq, got let",
    start: 6,
    end: 9,
    next: "y"
  },
  {
    label: "nested sync token is skipped",
    src: "let a = f(1 * * , g(let y = 1 in y))\nlet b = 2",
    message: "unexpected token star",
    start: 14,
    end: 15,
    next: "b"
  },
  {
    label: "trailing bad declaration reaches eof",
    src: "let a = 1\nlet b = ",
    message: "unexpected token eof",
    start: 18,
    end: 18,
    next: "<error>"
  }
], row => switch recover(row.src) {
  | Some(r) => switch (Array.get(0, r.diagnostics), Array.get(1, r.stmts)) {
      | (Some(e), Some(Ast.SLet(name, _, _, _, _, _, _))) => ok(
          e.message == row.message && e.start == row.start && e.end == row.end && name == row.next
        )
      | (Some(e), Some(Ast.SError(_))) => ok(
          e.message == row.message && e.start == row.start && e.end == row.end && row.next == "<error>"
        )
      | _ => false |> ok
    }
  | None => false |> ok
})

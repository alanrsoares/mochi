{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mochi",
  "scopeName": "source.mochi",
  "patterns": [{ "include": "#expression" }],
  "repository": {
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#jsx" },
        { "include": "#braces" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#namespaces" },
        { "include": "#function-calls" },
        { "include": "#types" },
        { "include": "#constructors" },
        { "include": "#numbers" },
        { "include": "#operators" }
      ]
    },
    "jsx": {
      "comment": "ADR 0007 — surface JSX; `<` starts a tag when followed by an ident, `/`, or `>` (fragments). Comparison `a < b` keeps a space after `<` and does not match.",
      "patterns": [
        { "include": "#jsx-fragment" },
        { "include": "#jsx-component" },
        { "include": "#jsx-html" }
      ]
    },
    "jsx-fragment": {
      "name": "meta.tag.jsx.mochi",
      "begin": "<>",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.begin.mochi" }
      },
      "end": "</>",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.end.mochi" }
      },
      "contentName": "meta.jsx.children.mochi",
      "patterns": [{ "include": "#jsx-children" }]
    },
    "jsx-component": {
      "comment": "PascalCase / dotted component — <Card>, <UI.Button>",
      "name": "meta.tag.jsx.mochi",
      "begin": "(<)([A-Z][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.mochi" },
        "2": { "name": "support.class.component.mochi" }
      },
      "end": "(/>)|(?:(</)(\\2)(>))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.mochi" },
        "2": { "name": "punctuation.definition.tag.begin.mochi" },
        "3": { "name": "support.class.component.mochi" },
        "4": { "name": "punctuation.definition.tag.end.mochi" }
      },
      "patterns": [{ "include": "#jsx-tag-body" }]
    },
    "jsx-html": {
      "comment": "lowercase host tags — <div>, <button>",
      "name": "meta.tag.jsx.mochi",
      "begin": "(<)([a-z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.mochi" },
        "2": { "name": "entity.name.tag.mochi" }
      },
      "end": "(/>)|(?:(</)(\\2)(>))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.mochi" },
        "2": { "name": "punctuation.definition.tag.begin.mochi" },
        "3": { "name": "entity.name.tag.mochi" },
        "4": { "name": "punctuation.definition.tag.end.mochi" }
      },
      "patterns": [{ "include": "#jsx-tag-body" }]
    },
    "jsx-tag-body": {
      "patterns": [
        {
          "name": "meta.tag.attributes.mochi",
          "begin": "\\s",
          "end": "(?=[/]?>)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#jsx-attribute" },
            { "include": "#jsx-expression" }
          ]
        },
        {
          "begin": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.end.mochi" }
          },
          "end": "(?=</)",
          "contentName": "meta.jsx.children.mochi",
          "patterns": [{ "include": "#jsx-children" }]
        }
      ]
    },
    "jsx-children": {
      "patterns": [
        { "include": "#jsx" },
        { "include": "#jsx-expression" },
        { "include": "#strings" },
        { "include": "#comments" },
        { "include": "#numbers" }
      ]
    },
    "jsx-attribute": {
      "patterns": [
        {
          "comment": "name=value — string or {expr}; $tone transient props (styled-cva)",
          "begin": "(\\$?[A-Za-z_][A-Za-z0-9_]*)(=)",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.mochi" },
            "2": { "name": "punctuation.separator.key-value.mochi" }
          },
          "end": "(?=[\\s/>])",
          "patterns": [{ "include": "#strings" }, { "include": "#jsx-expression" }]
        },
        {
          "comment": "boolean shorthand — disabled / $active",
          "match": "(\\$?[A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "entity.other.attribute-name.mochi"
        }
      ]
    },
    "jsx-expression": {
      "comment": "{expr} / {...spread} in attrs or children",
      "name": "meta.embedded.expression.mochi",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.mochi" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.mochi" }
      },
      "patterns": [
        {
          "name": "keyword.operator.spread.mochi",
          "match": "\\.\\.\\."
        },
        { "include": "#expression" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.mochi",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.mochi",
          "match": "//.*$"
        }
      ]
    },
    "braces": {
      "comment": "Balance {…} so ${ switch n { … } } holes close on the right brace",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.mochi" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.mochi" }
      },
      "patterns": [{ "include": "#expression" }]
    },
    "strings": {
      "comment": "String scope only on literal chunks — not on ${…} — so themes don't paint hole contents as strings (JS templates use meta.embedded.line for the same reason).",
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.double.mochi punctuation.definition.string.begin.mochi"
            }
          },
          "endCaptures": {
            "0": {
              "name": "string.quoted.double.mochi punctuation.definition.string.end.mochi"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.mochi",
              "match": "\\\\."
            },
            {
              "comment": "ADR 0023 — ${expr} holes; escape rule above eats \\${ first",
              "name": "meta.interpolation.mochi",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.interpolation.begin.mochi" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.definition.interpolation.end.mochi" }
              },
              "contentName": "meta.embedded.line.mochi",
              "patterns": [{ "include": "#expression" }]
            },
            {
              "name": "string.quoted.double.mochi",
              "match": "[^\"\\\\$]+|\\$(?!\\{)"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "let binding — highlight the bound name",
          "match": "\\b(let)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.mochi" },
            "2": { "name": "entity.name.function.mochi" }
          }
        },
        {
          "comment": "type declaration — highlight the type name",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.mochi" },
            "2": { "name": "entity.name.type.mochi" }
          }
        },
        {
          "comment": "extern declaration — highlight the external name",
          "match": "\\b(extern)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.mochi" },
            "2": { "name": "entity.name.function.mochi" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mochi",
          "match": "\\b(switch|import|export|in|when)\\b"
        },
        {
          "name": "keyword.declaration.mochi",
          "match": "\\b(let|type|extern)\\b"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "support.class.namespace.mochi",
          "match": "\\b(Array|List|Set|Map|Str|Math)\\b"
        }
      ]
    },
    "function-calls": {
      "comment": "Same shape as JS/TS: name before ( → entity.name.function",
      "patterns": [
        {
          "comment": "method call — obj.method(",
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.mochi" },
            "2": { "name": "entity.name.function.mochi" }
          }
        },
        {
          "comment": "bare call — foo(  (lowercase/underscore only; Ctors stay #constructors)",
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.mochi" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.mochi",
          "match": "\\b(float|int|string|bool|number)\\b"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "comment": "Uppercase-initial identifiers = variant constructors / types",
          "name": "entity.name.type.constructor.mochi",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mochi",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.mochi",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.mochi",
          "match": "=>"
        },
        {
          "name": "keyword.operator.bar.mochi",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.mochi",
          "match": "="
        },
        {
          "name": "punctuation.definition.sigil.mochi",
          "match": "[@#]"
        }
      ]
    }
  }
}

{
  "comments": { "lineComment": "//" },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?:\\{[^}\"']*$)|(?:<[A-Za-z][^>]*[^/]>\\s*$)",
    "decreaseIndentPattern": "^\\s*(?:\\}|</[A-Za-z][^>]*>|</>)"
  }
}

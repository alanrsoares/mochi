{
  "name": "mochi",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "mochi": "packages/cli/src/cli.ts"
  },
  "scripts": {
    "mochi": "bun packages/cli/src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns 'test/bootstrap-fixpoint-binary.spec.ts' --path-ignore-patterns 'test/bootstrap-tsc.spec.ts'",
    "test:full": "bun test",
    "build:ext": "bun scripts/build-extension.mjs",
    "loc": "bun scripts/find-long-files.ts",
    "gen:prelude": "bun scripts/gen-prelude.ts",
    "gen:prelude-defs": "bun scripts/gen-prelude-defs.ts",
    "gen:prelude-defs:check": "bun scripts/gen-prelude-defs.ts --check",
    "gen:mochi-dts": "bun scripts/gen-mochi-dts.ts",
    "gen:mochi-dts:check": "bun scripts/gen-mochi-dts.ts --check",
    "bootstrap:tsc": "bun scripts/bootstrap-tsc.ts",
    "fmt:mochi": "bun scripts/fmt.ts",
    "fmt:check": "bun scripts/fmt.ts --check",
    "fixpoint": "bun scripts/fixpoint.ts",
    "clean": "bun scripts/clean.ts",
    "prepare": "bun scripts/setup-hooks.ts",
    "example": "bun run mochi build examples/cli.mochi && bun examples/cli.js",
    "example:life": "bun run mochi build examples/life/main.mochi && bun examples/life/main.js",
    "example:snake": "bun run --filter @mochi/example-snake build && bun run --filter @mochi/example-snake server",
    "example:async": "bun run mochi build examples/async/main.mochi && bun examples/async/demo.mjs",
    "example:modules": "bun run mochi build examples/modules/main.mochi && bun examples/modules/main.js",
    "example:pipelines": "bun run mochi build examples/pipelines.mochi && bun examples/pipelines.js",
    "example:showcase": "bun run mochi build examples/example.mochi && bun examples/example.js",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:preview": "bun run --cwd apps/docs preview",
    "check": "bun scripts/tui-runner.ts check",
    "check:full": "bun scripts/tui-runner.ts check:full"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/snake"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "vite": "^8.2.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@mochi/bun": "workspace:*",
    "@mochi/cli": "workspace:*",
    "@mochi/codemod": "workspace:*",
    "@mochi/compiler": "workspace:*",
    "@mochi/dx": "workspace:*",
    "@mochi/lsp": "workspace:*",
    "@mochi/plugin-preact": "workspace:*",
    "@mochi/plugin-re-reduced": "workspace:*",
    "@mochi/plugin-styled-cva": "workspace:*",
    "@mochi/test-support": "workspace:*",
    "@mochi/vite-plugin": "workspace:*",
    "@types/bun": "latest",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "lefthook": "^2.1.10"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@onrails/maybe": "^0.2.3",
    "@onrails/pattern": "^0.3.3",
    "@onrails/result": "^0.4.0"
  }
}

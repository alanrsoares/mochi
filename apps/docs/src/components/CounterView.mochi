import { BadgeShell } from "../ui/primitives"

let CounterView = props =>
  <BadgeShell $tone="emerald">
    <button
      className="font-mono text-(--ok)/80 hover:text-(--ink) px-1"
      onClick={props.onDec}
    >
      {"−"}
    </button>
    <span className="tabular-nums min-w-6 text-center text-(--ink)">
      {props.count}
    </span>
    <button
      className="font-mono text-(--ok)/80 hover:text-(--ink) px-1"
      onClick={props.onInc}
    >
      {"+"}
    </button>
  </BadgeShell>

import { BadgeShell, CounterBtn } from "../ui/primitives"

let CounterView = props =>
  <BadgeShell $tone="emerald">
    <CounterBtn onClick={props.onDec}>{"−"}</CounterBtn>
    <span className="tabular-nums min-w-6 text-center text-ink">
      {props.count}
    </span>
    <CounterBtn onClick={props.onInc}>{"+"}</CounterBtn>
  </BadgeShell>

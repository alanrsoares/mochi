"use open"

// Hero artwork carousel — hooks in mochi (Counter pattern). Slide copy lives in
// `lib/hero-slides.mochi`; the interval/DOM timer and pointer swipe stay in
// `lib/hero-slides-fx.ts`.
import {
  useState,
  useEffect,
  useCallback,
  useRef,
  hookDeps
} from "@mochi/plugin-preact/hooks"
import { CarouselDot, CarouselImg } from "../ui/primitives"
import { HeroCarouselView } from "./HeroCarouselView"
import { heroSlides, HERO_INTERVAL_MS, SWIPE_MIN_PX } from "../lib/hero-slides"
// Cleanup return stays OPAQUE (`c`, not `c -> d`): extern arity counts the
// whole arrow spine, so `-> c -> d` would emit `_curry(3, …)` and the 2-arg
// call would be a silent partial application — the timer would only start
// when the effect CLEANUP ran, and its real cleanup would leak.
/// Returns an effect cleanup.
extern startHeroTick<A, B, C> : (A -> B) -> number -> C = "../lib/hero-slides-fx" "startHeroTick"
/// Record start X + setPointerCapture on the frame.
extern swipePointerDown<A, B, C> : A -> B -> C = "../lib/hero-slides-fx" "swipePointerDown"
/// `clientX - start`; 0 when not the primary pointer.
extern swipePointerDx<A, B> : A -> B -> number = "../lib/hero-slides-fx" "swipePointerDx"

let n = Array.length(heroSlides)

/// Indexed map — prelude `map` is unary; dots/images need the slide index.
let mapIndexed = (f, xs) =>
  loop (i = 0, acc = []) {
    switch Array.get(i, xs) {
      | None => acc
      | Some(x) => recur(i + 1, [...acc, f(x, i)])
    }
  }

export let HeroCarousel = _ =>
  let (index, setIndex) = useState(0) in
  let (paused, setPaused) = useState(false) in
  let startX = useRef(0) in
  let go = useCallback(next => setIndex((next + n) % n), []) in
  let _fx = useEffect(() =>
    paused ? _ => 0 : startHeroTick(() => go(index + 1), HERO_INTERVAL_MS)
  )(hookDeps(go, index, paused)) in
  let slide = Array.get(index, heroSlides) in
    switch slide {
      | None => <div />
      | Some(s) => <HeroCarouselView
          kicker={s.kicker}
          title={s.title}
          trackStyle={{ transform: "translateX(-${show(index * 100)}%)" }}
          onPause={() => setPaused(true)}
          onResume={() => setPaused(false)}
          onPrev={() => go(index - 1)}
          onNext={() => go(index + 1)}
          onPointerDown={e => {
            setPaused(true);
            swipePointerDown(startX, e)
          }}
          onPointerUp={e => {
            setPaused(false);
            let dx = swipePointerDx(startX, e) in
              dx < 0 - SWIPE_MIN_PX
                ? go(index + 1)
                : dx > SWIPE_MIN_PX
                ? go(index - 1)
                : setPaused(false)
          }}
          onPointerCancel={() => setPaused(false)}
          images={mapIndexed(
            (item, i) =>
              <CarouselImg
                key={item.src}
                src={item.src}
                alt={item.alt}
                draggable={false}
                loading={i == 0 ? "eager" : "lazy"}
                decoding="async"
              />,
            heroSlides
          )}
          dots={mapIndexed(
            (item, i) =>
              <CarouselDot
                key={item.src}
                role="tab"
                ariaSelected={i == index}
                ariaLabel={item.title}
                $active={i == index ? "on" : "off"}
                onClick={() => go(i)}
              />,
            heroSlides
          )}
        />
    }

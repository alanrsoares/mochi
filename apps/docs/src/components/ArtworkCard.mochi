// Artwork gallery tile — image URL + copy via props.
let ArtworkCard = props =>
  <div
    className={"bg-[#111422] border border-[#1e2436] rounded-xl overflow-hidden group "
      ++ props.span}
  >
    <img
      src={props.src}
      alt={props.alt}
      className="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
    />
    <div className="p-4 space-y-1">
      <div
        className={"font-mono text-[10px] font-bold uppercase " ++ props.tone}
      >
        {props.kicker}
      </div>
      <h3 className="font-bold text-slate-100 font-display">{props.title}</h3>
      <p className="text-xs text-slate-400">{props.body}</p>
    </div>
  </div>

// Composes styled-cva shells from primitives.mochi (ADR 0009).
import {
  CardRoot,
  CardBody,
  CardHeader,
  CardTag,
  CardSpec,
  CardTitle,
  CardDescription,
  CardFooter,
  CardArrow
} from "../ui/primitives"

let FeatureCard = props =>
  <CardRoot>
    <CardBody>
      <CardHeader>
        <CardTag>{props.tag}</CardTag>
        <CardSpec>{props.spec}</CardSpec>
      </CardHeader>
      <div>
        <CardTitle>{props.title}</CardTitle>
        <CardDescription>{props.description}</CardDescription>
      </div>
    </CardBody>
    <CardFooter>
      <span>{props.subtext}</span>
      <CardArrow>{"->"}</CardArrow>
    </CardFooter>
  </CardRoot>

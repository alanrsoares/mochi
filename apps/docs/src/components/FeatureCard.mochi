// Mochi JSX Component — Feature Card
let FeatureCard = (props) =>
  <div className="group relative p-6 bg-slate-900/60 border border-slate-800 rounded-2xl transition-all duration-300 hover:border-pink-500/50 hover:shadow-xl hover:shadow-pink-500/10 hover:-translate-y-1 backdrop-blur-xl overflow-hidden">
    <div className="absolute inset-0 bg-gradient-to-br from-pink-500/5 to-purple-500/0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
    <div className="relative z-10">
      <div className="text-3xl mb-4">{props.icon}</div>
      <h3 className="text-xl font-bold text-slate-100 mb-2 font-display">{props.title}</h3>
      <p className="text-sm text-slate-400 leading-relaxed">{props.description}</p>
    </div>
  </div>

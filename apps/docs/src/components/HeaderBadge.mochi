// Mochi JSX Component — Header Badge
let HeaderBadge = (props) =>
  <div className="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold tracking-wider text-pink-400 bg-pink-950/40 border border-pink-500/30 rounded-full shadow-lg shadow-pink-500/10 backdrop-blur-md">
    <span className="w-2 h-2 rounded-full bg-pink-400 animate-pulse"></span>
    <span>{props.label}</span>
  </div>

"use open"

import { BadgeShell, BadgePulse } from "../ui/primitives"

export type Props = { className: string, label: string }

export let HeaderBadge : Props -> VNode = props =>
  <BadgeShell $tone="rose" className={props.className}>
    <BadgePulse $tone="rose" />
    <span>{props.label}</span>
  </BadgeShell>

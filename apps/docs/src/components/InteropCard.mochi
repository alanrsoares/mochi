// Interop matrix card — presentational.
let InteropCard = props =>
  <div
    className="p-5 bg-[#0b0e17] border border-[#1b2030] rounded-xl space-y-3"
  >
    <div className={"font-mono text-xs font-bold uppercase " ++ props.tone}>
      {props.label}
    </div>
    <h3 className="font-bold text-slate-100 font-display">{props.title}</h3>
    <p className="text-xs text-slate-400 leading-relaxed font-sans">
      {props.body}
    </p>
  </div>

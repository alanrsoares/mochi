import { SyntaxBar } from "../ui/primitives"

export let SyntaxPanel = props =>
  <div className="panel overflow-hidden flex flex-col">
    <SyntaxBar $tone={props.$tone}>
      <span>{props.title}</span>
      <span className="text-3xs text-mute">{props.badge}</span>
    </SyntaxBar>
    <pre
      className="p-4 bg-foam overflow-x-auto flex-1 font-mono text-xs leading-relaxed"
    >
      {props.children}
    </pre>
  </div>

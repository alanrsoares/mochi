"use open"

import { DiagBox } from "../ui/primitives"

type Props = { diagnosticsFormatted: string, hasProblems: bool, hasRun: bool }

export let PlaygroundProblems : Props -> VNode = props =>
  props.hasProblems
    ? <DiagBox className="max-h-none">
      <div className="mb-1 font-bold">{"Compilation problems"}</div>
      {props.diagnosticsFormatted}
    </DiagBox>
    : <p className="text-mute text-sm">
      {props.hasRun
        ? "No compilation problems."
        : "Run your source to check for problems."}
    </p>

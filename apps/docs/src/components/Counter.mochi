// Live counter — container + hooks in one module. `let…in` under the
// component lambda emits sequential `const`s (Rules of Hooks). ContainerDef
// honesty + Store sketches come from `@mochi/plugin-re-reduced`.
import {
  defineContainer,
  useContainer,
  useSelect
} from "../host/re-reduced.host"
import { BadgeShell, CounterBtn } from "../ui/primitives"

let counter = defineContainer(
  "docs-counter",
  {
    state: { count: 0 },
    actions: on =>
      {
        increment: on(s => { count: s.count + 1 }),
        decrement: on(s => { count: s.count - 1 })
      }
  }
)

/// Mascot mood by mochi eaten — plain data, no host involved.
let mood = count =>
  count < 1
    ? "🐶 hungry"
    : count < 3
    ? "🐶 nom nom"
    : count < 6
    ? "🐕 happy"
    : "🦴 full!"

let Counter = _ =>
  let store = useContainer(counter) in
  let count = useSelect(store, s => s.count.value) in
    <BadgeShell $tone="emerald">
      <CounterBtn
        onClick={() => store.actions.decrement()}
        title="take one back"
      >
        {"−"}
      </CounterBtn>
      <span className="tabular-nums text-center text-ink">
        {"🍡 ${show(count)} · ${mood(count)}"}
      </span>
      <CounterBtn
        onClick={() => store.actions.increment()}
        title="feed a mochi"
      >
        {"+"}
      </CounterBtn>
    </BadgeShell>

"use open"

// Playground chrome — toolbar + body slot. Compile / hooks / refs stay in
// Playground.tsx (let-in → IIFE breaks Rules of Hooks).
// This declaration-only component is emitted independently; imported TSX UI
// components are intentionally host-provided at that boundary.
import { Icon } from "../host/icon.host"
import { StatusLabel, ToolBtn, ToolBtnSolid } from "../ui/primitives"
import { when } from "../lib/vnode"

type Props = {
  onToggleAutoRun: () -> (),
  autoRun: bool,
  onRun: () -> (),
  onFormat: () -> (),
  formatNotice: bool,
  onShare: () -> (),
  shareCopied: bool,
  compiling: bool,
  statusState: "ok" | "err",
  statusText: string,
  body: VNode
}
// Inline rather than `Status.StatusState`: a qualified type in the row makes
// the sidecar inline this alias and widen `body`, which is the open-props-bag
// regression ADR 0055 exists to prevent. Kept honest by `StatusLabel`'s own
// `$state` union — a drift here is a type error at the call site below.
export let PlaygroundView : Props -> VNode = props =>
  <div className="flex min-h-0 flex-1 flex-col bg-paper">
    <div
      className="flex shrink-0 flex-wrap items-center gap-2 border-line border-b-2 bg-peach px-3 py-2 sm:px-4"
    >
      <ToolBtn onClick={props.onToggleAutoRun} title="Toggle auto-run">
        <Icon
          name={props.autoRun ? "refresh-cw" : "pause"}
          className="size-3.5 shrink-0"
        />
        <span>{"Auto-run"}</span>
      </ToolBtn>
      <ToolBtn onClick={props.onRun} title="Run (⌘E)">
        <Icon name="play" className="size-3.5 shrink-0" />
        <span>{"Run"}</span>
        <span className="hidden text-mute sm:inline">{" (⌘E)"}</span>
      </ToolBtn>
      <ToolBtn onClick={props.onFormat} title="Format (⌘S)">
        <Icon
          name={props.formatNotice ? "check" : "align-left"}
          className="size-3.5 shrink-0"
        />
        <span>{props.formatNotice ? "Formatted" : "Format"}</span>
        <span className="hidden text-mute sm:inline">{" (⌘S)"}</span>
      </ToolBtn>
      <ToolBtnSolid onClick={props.onShare} title="Copy share link">
        <Icon
          name={props.shareCopied ? "check" : "share-2"}
          className="size-3.5 shrink-0"
        />
        <span>{props.shareCopied ? "Copied!" : "Share"}</span>
      </ToolBtnSolid>
      <div className="ml-auto flex items-center gap-1.5 font-mono text-2xs">
        {when(
          props.compiling,
          <Icon
            name="loader-2"
            className="size-3.5 shrink-0 animate-spin text-ok"
          />
        )}
        <StatusLabel $state={props.statusState}>{props.statusText}</StatusLabel>
      </div>
    </div>
    {props.body}
  </div>

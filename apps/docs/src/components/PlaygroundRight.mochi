"use open"

// Right-hand pane chrome: tab strip + pane body.
import { PresetSelect } from "../ui/primitives"

export type PlaygroundRightProps = { tabs: [VNode], pane: VNode }

export let PlaygroundRight : PlaygroundRightProps -> VNode = props =>
  <div className="flex min-h-0 min-w-0 flex-1 flex-col bg-peach">
    <div
      className="flex shrink-0 items-center gap-0.5 overflow-x-auto border-line border-b-2 px-2 scrollbar-none [&::-webkit-scrollbar]:hidden"
      role="tablist"
      ariaLabel="Output panes"
    >
      {props.tabs}
    </div>
    <div className="relative min-h-0 flex-1 overflow-auto p-3 sm:p-4">
      {props.pane}
    </div>
  </div>

export type PlaygroundSettingsProps = {
  onPreset: any -> (),
  presetOptions: [VNode]
}

export let PlaygroundSettings : PlaygroundSettingsProps -> VNode = props =>
  <div className="max-w-sm space-y-4 font-mono text-xs">
    <div>
      <label
        htmlFor="playground-preset"
        className="mb-1.5 block text-2xs text-mute"
      >
        {"Preset"}
      </label>
      <PresetSelect id="playground-preset" onChange={props.onPreset}>
        {props.presetOptions}
      </PresetSelect>
    </div>
    <p className="text-2xs text-mute leading-relaxed">
      {"⌘E run · ⌘S format · share link is a compressed ?code= payload. Right pane shows JS, typed TS, and .d.ts emit."}
    </p>
  </div>

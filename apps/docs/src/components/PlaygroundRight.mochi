"use open"

// Result workspace: persistent example control, three views, then their content.
export type PlaygroundRightProps = {
  tabs: [VNode],
  examples: VNode,
  pane: VNode,
  panelId: string,
  labelledBy: string
}

export let PlaygroundRight : PlaygroundRightProps -> VNode = props =>
  <section
    className="flex min-h-0 min-w-0 flex-1 flex-col bg-paper"
    ariaLabel="Playground results"
  >
    <div className="shrink-0 border-b border-line bg-peach px-4 py-3">
      {props.examples}
    </div>
    <div
      className="flex shrink-0 border-b border-line bg-paper px-2"
      role="tablist"
      ariaLabel="Result views"
    >
      {props.tabs}
    </div>
    <div
      id={props.panelId}
      role="tabpanel"
      tabIndex={0}
      ariaLabelledBy={props.labelledBy}
      className="relative min-h-0 flex-1 overflow-auto"
    >
      {props.pane}
    </div>
  </section>

export type PlaygroundExamplesProps = {
  onPreset: any -> (),
  presetKey: string,
  presetOptions: [VNode]
}

export let PlaygroundExamples : PlaygroundExamplesProps -> VNode = props =>
  <div className="flex flex-wrap items-center gap-x-3 gap-y-2">
    <label htmlFor="playground-preset" className="font-semibold text-sm">
      {"Example"}
    </label>
    <select
      id="playground-preset"
      value={props.presetKey}
      onChange={props.onPreset}
      className="min-w-0 flex-1 rounded-lg border border-line bg-foam px-3 py-2 text-base text-ink focus-visible:outline-2 focus-visible:outline-fur sm:text-sm"
    >
      <option value="" disabled={true}>{"Your code"}</option>
      {props.presetOptions}
    </select>
  </div>

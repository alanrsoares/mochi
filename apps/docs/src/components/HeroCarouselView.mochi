// Presentational carousel chrome. Index / timer / pause live in HeroCarousel.mochi.
import { Icon } from "../host/widgets.host"
import { CarouselNav } from "../ui/primitives"

export let HeroCarouselView = props =>
  <figure
    className="hero-carousel relative"
    onMouseEnter={props.onPause}
    onMouseLeave={props.onResume}
    onFocusCapture={props.onPause}
    onBlurCapture={props.onResume}
  >
    <div
      className="hero-carousel__frame relative aspect-video touch-pan-y select-none overflow-hidden bg-foam cursor-grab active:cursor-grabbing"
      onPointerDown={props.onPointerDown}
      onPointerUp={props.onPointerUp}
      onPointerCancel={props.onPointerCancel}
    >
      <div
        className="hero-carousel__track flex h-full transition-transform duration-500 ease-out"
        style={props.trackStyle}
      >
        {props.images}
      </div>
    </div>
    <figcaption className="mt-4 flex items-end justify-between gap-4">
      <div className="min-w-0">
        <div
          className="font-bold font-mono text-3xs text-fur-deep uppercase tracking-kicker"
        >
          {props.kicker}
        </div>
        <div
          className="mt-1 truncate font-display font-semibold text-ink text-lg tracking-tight"
        >
          {props.title}
        </div>
      </div>
      <div className="flex shrink-0 items-center gap-3">
        <CarouselNav ariaLabel="Previous artwork" onClick={props.onPrev}>
          <Icon name="chevron-left" className="size-4" />
        </CarouselNav>
        <div
          className="flex items-center gap-1.5"
          role="tablist"
          ariaLabel="Artwork slides"
        >
          {props.dots}
        </div>
        <CarouselNav ariaLabel="Next artwork" onClick={props.onNext}>
          <Icon name="chevron-right" className="size-4" />
        </CarouselNav>
      </div>
    </figcaption>
  </figure>

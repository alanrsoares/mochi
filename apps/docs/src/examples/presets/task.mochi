// A Task stays lazy until run. The preview runs a Task bound to app.
// Change the delay or the failure reason and press Run.
let lookup = found =>
  let! _ = Task.delay(300, ()) in
    found ? Task.of("Ada") : Task.fail("user not found")

let describe = task =>
  task |> Task.match(concat("Loaded: "), concat("Failed: "))

let app = Task.all([describe(lookup(true)), describe(lookup(false))])
  |> Task.map(messages => <div>{messages |> map(text => <p>{text}</p>)}</div>)

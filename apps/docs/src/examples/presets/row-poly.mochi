// greet accepts any record with name + role

let greet = person => "Hello, " ++ person.name ++ " (" ++ person.role ++ ")"

let user = { name: "Mochi", role: "Compiler", id: 42 }
let message = greet(user)

let app = <div
  className="w-full max-w-md p-4 bg-paper border-2 border-line rounded-panel font-mono text-xs text-plum"
>
  {message}
</div>

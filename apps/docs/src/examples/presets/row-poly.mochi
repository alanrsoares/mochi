// Edit the age. name and id survive without appearing in birthday's type.
let birthday = person => { ...person, age: person.age + 1 }
let before = { name: "Ada", age: 36, id: 42 }
let after = birthday(before)

let app = <div>
  <p>{"Before: " ++ show(before)}</p>
  <p>{"After: " ++ show(after)}</p>
</div>

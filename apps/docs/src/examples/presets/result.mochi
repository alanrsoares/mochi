// let? stops at the first Err. Change 40 or 10 to try another input.
let half = n => n % 2 == 0 ? Ok(n / 2) : Err("odd number")
let quarter = n => let? h = half(n) in let? q = half(h) in Ok(q)
let describe = result => switch result {
  | Ok(n) => "Quarter: " ++ show(n)
  | Err(reason) => "Stopped: " ++ reason
}

let app = <div>
  <p>{describe(quarter(40))}</p>
  <p>{describe(quarter(10))}</p>
</div>

// Tour: prelude Result — no `type Result<a, e>` (that's TS; mochi is `Result a e`).
// Twoslash `// ^?` lines are stripped by HighlightCode for inline type hints.

let unwrapOr = (res, fallback) =>
  //  ^?
  switch res { | Ok(value) => value | Err(_) => fallback }

let demo = unwrapOr(Ok(42), 0)
//  ^?

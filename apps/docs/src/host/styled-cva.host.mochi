// FFI seam — @styled-cva/react (Preact compat). Vendor plugin, not core
// (`@mochi/plugin-styled-cva` via `apps/docs/mochi.plugins.ts` — ADR 0009/0011).
//
// `tw` stays opaque (`: a`) on purpose: `tw.<tag>` is overloaded
// (`tw.div("x")` and `tw.div("x", { variants })`). Fixed-arity HM arrows would
// type 1-arg sites as partial application. The vendor plugin's inferCall +
// dtsBinding hooks recover component schemes / `$tone` unions from the call AST;
// jsxPlugin checks attrs on those components. LSP completes `$tone` lit unions
// (Wave 12 / tracer #48); factory `tw.*` members stay open-world opaque.
export extern tw : a = "@styled-cva/react" "default"

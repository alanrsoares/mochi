// FFI seam — @re-reduced/preact. Vendor plugin recovers ContainerDef in
// `.d.mochi.ts` and Store sketches in HM (`@mochi/plugin-re-reduced`,
// ADR 0010 Gap A / Waves 6–11).
//
// Factories stay opaque (`: a` / `a -> b`) at the seam; the plugin recovers
// structural products for hover + completion. Hooks stay straight-line
// `let…in` under the component lambda so codegen emits sequential `const`s
// (Rules of Hooks).
export extern defineContainer : a = "@re-reduced/preact" "defineContainer"
export extern useContainer : a -> b = "@re-reduced/preact" "useContainer"
export extern useSelect : a -> (b -> c) -> c = "@re-reduced/preact" "useSelect"

// styled-cva factories (ADR 0009). Call-form only.
import { tw } from "../host/styled-cva.host"

export let BadgeShell = tw.div(
  "inline-flex items-center gap-2 px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-wider rounded-full border-2 shadow-sm",
  {
    variants: {
      $tone: {
        rose: "text-[var(--fur-deep)] bg-[color-mix(in_oklab,var(--fur)_18%,white)] border-[color-mix(in_oklab,var(--fur)_45%,white)]",
        amber: "text-[var(--plum)] bg-[color-mix(in_oklab,var(--lavender)_35%,white)] border-[var(--lavender)]",
        emerald: "text-[var(--ok)] bg-[var(--ok-soft)] border-[color-mix(in_oklab,var(--ok)_35%,white)]"
      }
    },
    defaultVariants: { $tone: "rose" }
  }
)

export let BadgePulse = tw.span(
  "w-1.5 h-1.5 rounded-full",
  {
    variants: {
      $tone: {
        rose: "bg-[var(--fur)]",
        amber: "bg-[var(--lavender-deep)]",
        emerald: "bg-[var(--ok)]"
      }
    },
    defaultVariants: { $tone: "rose" }
  }
)

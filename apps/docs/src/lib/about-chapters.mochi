}

export let SPARK_TALK_URL = "https://www.youtube.com/watch?v=24S5u_4gx7w"

export let aboutChapters : [AboutChapter] = [
  {
    id: "spark",
    kicker: "origin",
    title: "The question that started it",
    body: [
      "I wanted to know what a language really consists of: not syntax, but the constraints that make correct code easier to write and mistakes easier to catch. How much could the compiler and its tools guarantee, instead of leaving it to documentation and discipline?",
      "There was only one way to find out: build one."
    ],
    src: cosmicTypesImg,
    alt: "Astronaut Mochi floating through type-system constellations"
  },
  {
    id: "core",
    kicker: "compiler",
    title: "Keep the compiler small",
    body: [
      "The first version was small enough to hold in my head: a lexer, a parser, Hindley–Milner inference, and a code generator for readable JavaScript.",
      "One rule held it together: failures are values. Each stage reports what went wrong instead of throwing control flow across the compiler."
    ],
    src: compilerMagicImg,
    alt: "Mochi the corgi conjuring an AST into JavaScript and TypeScript"
  },
  {
    id: "selfhost",
    kicker: "self-hosting",
    title: "Make it prove itself",
    body: [
      "Eventually, I rewrote the compiler in Mochi, compiled it to TypeScript, and let tsc --strict judge the result.",
      "Watching the error count fall from 537 to zero taught me more about the type system than any specification could. That check still runs on every push."
    ],
    src: bootstrapPartyImg,
    alt: "Corgi crowd celebrating a zero-error bootstrap build"
  },
  {
    id: "editor",
    kicker: "tooling",
    title: "Make tooling part of the language",
    body: [
      "Hover, diagnostics, and navigation draw on the compiler's own model of the program. There is no separate language-server model waiting to drift away.",
      "If the editor tells you something, it should be true. Building that in early is the decision I'm happiest with."
    ],
    src: lspInspectorImg,
    alt: "Detective Mochi inspecting types with a magnifying glass"
  },
  {
    id: "friends",
    kicker: "interop",
    title: "Work with the code you already have",
    body: [
      "Mochi is not here to replace a codebase. It is designed to join one: JSX targets any h()-shaped host, typed externs call npm packages directly, and generated .d.ts files let TypeScript consume Mochi code with its types intact.",
      "This site is the proof: it is written in Mochi and rendered by Preact."
    ],
    src: coderMascotImg,
    alt: "Mochi the corgi typing away at a keyboard"
  },
  {
    id: "name",
    kicker: "coda",
    title: "Named after the real Mochi",
    body: [
      "The easiest decision was the name. Mochi is my corgi. She has no opinion on type systems, which is probably healthy."
    ],
    src: stickersImg,
    alt: "Sticker sheet of Mochi the corgi mascot"
  }

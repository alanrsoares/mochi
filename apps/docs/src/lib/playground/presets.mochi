"use open"

extern presetPipelines : string = "../../examples/presets/pipelines.mochi?raw" "default"
extern presetJsx : string = "../../examples/presets/jsx.mochi?raw" "default"
extern presetResult : string = "../../examples/presets/result.mochi?raw" "default"
extern presetRowPoly : string = "../../examples/presets/row-poly.mochi?raw" "default"
extern presetTask : string = "../../examples/presets/task.mochi?raw" "default"

export type Preset = { name: string, code: string }

/// Data examples first; each preset has a visible result.
export let presetEntries : [(string, Preset)] = [
  ("rowPoly", { name: "Flexible records", code: presetRowPoly }),
  ("result", { name: "Result + let?", code: presetResult }),
  ("pipelines", { name: "Collections & pipelines", code: presetPipelines }),
  ("jsx", { name: "Typed JSX props", code: presetJsx }),
  ("task", { name: "Async success & failure", code: presetTask })
]

export let DEFAULT_PRESET_CODE = presetRowPoly

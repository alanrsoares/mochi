"use open"

// Mascot art served from `public/illustrations/` — plain URLs, no bundler alias.
extern BASE_URL : string = "./base-url" "BASE_URL"

let asset = concat(BASE_URL)

export let bootstrapPartyImg : string = asset(
  "illustrations/mochi_bootstrap_party.jpg"
)
export let coderMascotImg : string = asset(
  "illustrations/mochi_coder_mascot.jpg"
)
export let compilerMagicImg : string = asset(
  "illustrations/mochi_compiler_magic.jpg"
)
export let cosmicTypesImg : string = asset(
  "illustrations/mochi_cosmic_types.jpg"
)
export let lspInspectorImg : string = asset(
  "illustrations/mochi_lsp_inspector.jpg"
)
export let stickersImg : string = asset("illustrations/mochi_stickers.jpg")
export let logoImg : string = asset("logo.png")

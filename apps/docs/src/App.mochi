import { RailwayDemo } from "./components/RailwayDemo"
import { HeaderBadge } from "./components/HeaderBadge"
import { SyntaxPanel } from "./components/SyntaxPanel"
import { HeroCarousel } from "./components/HeroCarousel"
import { HighlightedCode } from "./host/widgets.host"
import {
  NavLink,
  GhostPill,
  CtaPill,
  CmdChip,
  HeroStatus,
  SectionEyebrow,
  SectionTitle,
  InteropLabel
} from "./ui/primitives"

let SiteHeader = props =>
  <header
    className="sticky top-0 z-50 border-b-2 border-line bg-paper/90 backdrop-blur-md"
  >
    <div
      className="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between"
    >
      <div className="flex items-center gap-3">
        <img
          src={props.logo}
          alt=""
          className="w-8 h-8 object-contain rounded-full"
        />
        <span
          className="text-lg font-bold font-display tracking-tight text-ink"
        >
          {"mochi"}
        </span>
        <HeaderBadge label="v0.1.0" className="hidden sm:inline-flex" />
      </div>
      <nav
        className="flex items-center gap-4 md:gap-5 font-mono text-xs text-mute"
      >
        <NavLink href={props.playgroundHref}>{"playground"}</NavLink>
        <NavLink href="#syntax" className="hidden md:inline">
          {"syntax"}
        </NavLink>
        <NavLink href="#interop" className="hidden md:inline">
          {"interop"}
        </NavLink>
        <GhostPill
          href="https://github.com/alanrsoares/mochi"
          target="_blank"
          rel="noreferrer"
          className="whitespace-nowrap"
        >
          {"GitHub ↗"}
        </GhostPill>
      </nav>
    </div>
  </header>

let Hero = props =>
  <section
    className="hero-wash relative overflow-hidden border-b-2 border-line"
  >
    <div
      className="max-w-6xl mx-auto px-6 py-14 lg:py-20 grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-center"
    >
      <div className="space-y-7 max-w-xl">
        <HeroStatus>
          <span className="text-ok">{"●"}</span>
          {"0 tsc --strict errors"}
        </HeroStatus>
        <h1
          className="text-hero sm:text-5xl lg:text-hero-lg font-extrabold font-display tracking-tight text-ink leading-hero"
        >
          {"mochi"}
          <span
            className="block mt-3 text-hero-subtitle sm:text-2xl lg:text-hero-subtitle-lg font-semibold text-mute leading-snug tracking-tight"
          >
            {"Functional programming that plays nicely with TypeScript."}
          </span>
        </h1>
        <p className="text-copy text-mute leading-relaxed max-w-md">
          {"Write clean, expressive code with pattern matching and smart type inference—compiled directly into human-readable JavaScript and strict, error-free TypeScript."}
        </p>
        <div className="flex flex-wrap gap-3 pt-1 font-mono text-xs">
          <CtaPill href={props.playgroundHref}>{"Open playground"}</CtaPill>
          <CmdChip>
            <span className="text-fur-deep font-bold">{"$"}</span>
            <span className="text-ink">{"bun run mochi app.mochi"}</span>
          </CmdChip>
        </div>
      </div>
      <HeroCarousel />
    </div>
  </section>

let SiteFooter = props =>
  <footer className="border-t-2 border-line py-8 bg-peach">
    <div
      className="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-xs text-mute"
    >
      <div className="flex items-center gap-3">
        <img
          src={props.logo}
          alt=""
          className="w-6 h-6 object-contain rounded-full"
        />
        <span>{"mochi"}</span>
      </div>
      <NavLink
        href="https://github.com/alanrsoares/mochi/blob/main/apps/docs/src/App.mochi"
        target="_blank"
        rel="noreferrer"
      >
        {"built with mochi — this page is App.mochi ↗"}
      </NavLink>
    </div>
  </footer>

let InteropRow = props =>
  <div
    className="grid grid-cols-1 sm:grid-cols-[7rem_1fr] gap-1 sm:gap-4 py-4 border-b-2 border-line last:border-0"
  >
    <InteropLabel $tone={props.$tone}>{props.label}</InteropLabel>
    <div>
      <div className="font-display font-semibold text-ink">{props.title}</div>
      <p className="mt-1 text-sm text-mute leading-relaxed">{props.body}</p>
    </div>
  </div>

let App = props =>
  <div className="site-grain min-h-screen flex flex-col bg-paper text-ink">
    <SiteHeader logo={props.logo} playgroundHref={props.playgroundHref} />
    <Hero playgroundHref={props.playgroundHref} />
    <main className="max-w-6xl mx-auto px-6 py-14 space-y-16 flex-1 w-full">
      <section id="output" className="space-y-6 scroll-mt-20">
        <div
          className="flex flex-col sm:flex-row sm:items-end justify-between gap-4"
        >
          <div className="max-w-xl">
            <SectionEyebrow>{"codegen"}</SectionEyebrow>
            <SectionTitle>{"One language, two clean outputs"}</SectionTitle>
            <p className="mt-2 text-sm text-mute leading-relaxed">
              {"Mochi emits human-readable JavaScript for runtime execution and strict TypeScript for seamless team integration."}
            </p>
          </div>
          <CtaPill href={props.playgroundHref}>{"Open playground →"}</CtaPill>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <SyntaxPanel title="mochi" badge="source" tone="fur">
            <HighlightedCode
              code={props.codeEmitSrc}
              lang="mochi"
              enableTwoslash={false}
            />
          </SyntaxPanel>
          <SyntaxPanel title="JavaScript" badge="bun run mochi" tone="plum">
            <HighlightedCode code={props.codeEmitJs} lang="js" />
          </SyntaxPanel>
          <SyntaxPanel
            title="TypeScript"
            badge="0 tsc --strict errors"
            tone="lavender"
          >
            <HighlightedCode code={props.codeEmitTs} lang="ts" />
          </SyntaxPanel>
        </div>
      </section>
      <section id="syntax" className="space-y-6 scroll-mt-20">
        <div
          className="flex flex-col sm:flex-row sm:items-end justify-between gap-3"
        >
          <div>
            <SectionEyebrow>{"syntax"}</SectionEyebrow>
            <SectionTitle>{"Language tour"}</SectionTitle>
          </div>
          <span className="font-mono text-2xs text-mute">
            {"hover for inferred types"}
          </span>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <SyntaxPanel
            title="Variants & Pattern Matching"
            badge="Result a e"
            tone="fur"
          >
            <HighlightedCode
              code={props.codeVariants}
              lang="mochi"
              enableTwoslash={true}
            />
          </SyntaxPanel>
          <SyntaxPanel
            title="Structural Records"
            badge="Inferred Record Types"
            tone="plum"
          >
            <HighlightedCode
              code={props.codeRecords}
              lang="mochi"
              enableTwoslash={true}
            />
          </SyntaxPanel>
          <SyntaxPanel
            title="First-Class JSX"
            badge="Preact / React / Hono"
            tone="lavender"
          >
            <HighlightedCode
              code={props.codeJsx}
              lang="mochi"
              enableTwoslash={true}
            />
          </SyntaxPanel>
        </div>
      </section>
      <section id="interop" className="scroll-mt-20 space-y-6">
        <div
          className="flex flex-col sm:flex-row sm:items-end justify-between gap-4"
        >
          <div>
            <SectionEyebrow>{"interop"}</SectionEyebrow>
            <SectionTitle>{"JS & React Integration"}</SectionTitle>
            <p className="mt-2 text-sm text-mute leading-relaxed max-w-xl">
              {"How Mochi connects with the JavaScript ecosystem. Define simple externs for npm packages, call hooks inside components, and export TypeScript declarations for zero-friction adoption."}
            </p>
          </div>
          <div className="flex items-center gap-3">
            <RailwayDemo />
            <span className="font-mono text-2xs text-mute">
              {"live Result railway"}
            </span>
          </div>
        </div>
        <div className="border-t-2 border-line">
          <InteropRow
            $tone="fur"
            label="runtime"
            title="Any h()-shaped host"
            body="JSX compiles directly to h(tag, props, children). Works out of the box with Preact, React, Hono, or custom UI pragmas."
          />
          <InteropRow
            $tone="lavender"
            label="npm & libs"
            title="Zero-overhead JS bindings"
            body="Declare extern functions to call npm packages or browser APIs directly with static type safety."
          />
          <InteropRow
            $tone="plum"
            label="state"
            title="React & Preact Hooks"
            body="Call hooks inside component functions seamlessly without extra wrappers or runtime overhead."
          />
          <InteropRow
            $tone="ok"
            label="bridge"
            title="TypeScript Declarations"
            body="Compiler-generated .d.ts files let any TypeScript project import Mochi modules with full type safety."
          />
        </div>
      </section>
    </main>
    <SiteFooter logo={props.logo} playgroundHref={props.playgroundHref} />
  </div>

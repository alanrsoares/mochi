import { HeaderBadge } from "./components/HeaderBadge"
import { SyntaxPanel } from "./components/SyntaxPanel"
import {
  Playground,
  HighlightedCode,
  Counter,
  HeroCarousel
} from "./host/widgets.host"

let SiteHeader = props =>
  <header
    className="sticky top-0 z-50 border-b-2 border-(--line) bg-(--paper)/90 backdrop-blur-md"
  >
    <div
      className="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between"
    >
      <div className="flex items-center gap-3">
        <img
          src={props.logo}
          alt=""
          className="w-8 h-8 object-contain rounded-full"
        />
        <span
          className="text-lg font-bold font-display tracking-tight text-(--ink)"
        >
          {"mochi"}
          <span className="text-(--fur-deep)">{".lang"}</span>
        </span>
        <HeaderBadge label="v0.1.0" />
      </div>
      <nav
        className="hidden md:flex items-center gap-5 font-mono text-xs text-[var(--mute)]"
      >
        <a
          href="#playground"
          className="hover:text-(--fur-deep) transition-colors"
        >
          {"playground"}
        </a>
        <a href="#syntax" className="hover:text-(--fur-deep) transition-colors">
          {"syntax"}
        </a>
        <a
          href="#interop"
          className="hover:text-(--fur-deep) transition-colors"
        >
          {"interop"}
        </a>
        <a
          href="https://github.com/alanrsoares/mochi"
          target="_blank"
          rel="noreferrer"
          className="px-3 py-1.5 text-(--ink) border-2 border-(--line-strong) rounded-full hover:border-[var(--fur)] hover:bg-[var(--foam)] transition-colors font-semibold"
        >
          {"GitHub ↗"}
        </a>
      </nav>
    </div>
  </header>

let Hero = props =>
  <section
    className="hero-wash relative overflow-hidden border-b-2 border-[var(--line)]"
  >
    <div
      className="max-w-6xl mx-auto px-6 py-14 lg:py-20 grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-center"
    >
      <div className="space-y-7 max-w-xl">
        <p
          className="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.14em] uppercase text-[var(--mute)] bg-[var(--foam)] border-2 border-[var(--line)] rounded-full px-3 py-1"
        >
          <span className="text-[var(--ok)]">{"●"}</span>
          {"self-host · 0 tsc --strict"}
        </p>
        <h1
          className="text-[2.6rem] sm:text-5xl lg:text-[3.35rem] font-extrabold font-display tracking-tight text-[var(--ink)] leading-[1.05]"
        >
          {"mochi"}
          <span className="text-(--fur-deep)">{".lang"}</span>
          <span
            className="block mt-3 text-[1.35rem] sm:text-2xl lg:text-[1.65rem] font-semibold text-[var(--mute)] leading-snug tracking-tight"
          >
            {"Hindley–Milner → readable JS & tsc --strict TypeScript."}
          </span>
        </h1>
        <p className="text-[0.95rem] text-(--mute) leading-relaxed max-w-md">
          {"Row-polymorphic records, parametric variants, JSX → host h(). One codegen, two backends."}
        </p>
        <div className="flex flex-wrap gap-3 pt-1 font-mono text-xs">
          <a
            href="#playground"
            className="px-5 py-2.5 bg-(--fur) hover:bg-(--fur-deep) text-white font-bold rounded-full shadow-[0_8px_24px_color-mix(in_oklab,var(--fur)_35%,transparent)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--bao)] focus-visible:outline-offset-2"
          >
            {"Open playground"}
          </a>
          <div
            className="px-4 py-2.5 border-2 border-(--line-strong) rounded-full bg-(--foam) text-(--mute) flex items-center gap-2"
          >
            <span className="text-(--fur-deep) font-bold">{"$"}</span>
            <span className="text-(--ink)">{"bun run mochi app.mochi"}</span>
          </div>
        </div>
      </div>
      <HeroCarousel />
    </div>
  </section>

let SiteFooter = props =>
  <footer className="border-t-2 border-(--line) py-8 bg-(--peach)">
    <div
      className="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 font-mono text-xs text-[var(--mute)]"
    >
      <div className="flex items-center gap-3">
        <img
          src={props.logo}
          alt=""
          className="w-6 h-6 object-contain rounded-full"
        />
        <span>{"mochi"}</span>
      </div>
      <span>{"Vite + Preact"}</span>
    </div>
  </footer>

let InteropRow = props =>
  <div
    className="grid grid-cols-1 sm:grid-cols-[7rem_1fr] gap-1 sm:gap-4 py-4 border-b-2 border-[var(--line)] last:border-0"
  >
    <div
      className={"font-mono text-[11px] font-bold uppercase tracking-wider "
        ++ props.tone}
    >
      {props.label}
    </div>
    <div>
      <div className="font-display font-semibold text-(--ink)">
        {props.title}
      </div>
      <p className="mt-1 text-sm text-(--mute) leading-relaxed">{props.body}</p>
    </div>
  </div>

let App = props =>
  <div
    className="site-grain min-h-screen flex flex-col bg-[var(--paper)] text-[var(--ink)]"
  >
    <SiteHeader logo={props.logo} />
    <Hero />
    <main className="max-w-6xl mx-auto px-6 py-14 space-y-16 flex-1 w-full">
      <section id="playground" className="scroll-mt-20"><Playground /></section>
      <section id="syntax" className="space-y-6 scroll-mt-20">
        <div
          className="flex flex-col sm:flex-row sm:items-end justify-between gap-3"
        >
          <div>
            <div
              className="font-mono text-[11px] text-[var(--fur-deep)] font-bold uppercase tracking-[0.18em]"
            >
              {"syntax"}
            </div>
            <h2
              className="mt-2 text-2xl font-extrabold font-display tracking-tight text-[var(--ink)]"
            >
              {"Language tour"}
            </h2>
          </div>
          <span className="font-mono text-[11px] text-[var(--mute)]">
            {"hover for inferred types"}
          </span>
        </div>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <SyntaxPanel
            title="Variants"
            badge="Result<a, e>"
            tone="text-[var(--fur-deep)]"
          >
            <HighlightedCode
              code={props.codeVariants}
              lang="mochi"
              enableTwoslash={true}
            />
          </SyntaxPanel>
          <SyntaxPanel
            title="Rows"
            badge="{ r | name: Str }"
            tone="text-[var(--plum)]"
          >
            <HighlightedCode
              code={props.codeRecords}
              lang="mochi"
              enableTwoslash={true}
            />
          </SyntaxPanel>
          <SyntaxPanel
            title="JSX → h()"
            badge="h(tag, props, children)"
            tone="text-[var(--lavender-deep)]"
          >
            <HighlightedCode
              code={props.codeJsx}
              lang="mochi"
              enableTwoslash={true}
            />
          </SyntaxPanel>
        </div>
      </section>
      <section id="interop" className="scroll-mt-20 space-y-6">
        <div
          className="flex flex-col sm:flex-row sm:items-end justify-between gap-4"
        >
          <div>
            <div
              className="font-mono text-[11px] text-[var(--fur-deep)] font-bold uppercase tracking-[0.18em]"
            >
              {"interop"}
            </div>
            <h2
              className="mt-2 text-2xl font-extrabold font-display tracking-tight text-[var(--ink)]"
            >
              {"Host bindings"}
            </h2>
          </div>
          <div className="flex items-center gap-3">
            <Counter />
            <span className="font-mono text-[11px] text-[var(--mute)]">
              {"re-reduced live"}
            </span>
          </div>
        </div>
        <div className="border-t-2 border-[var(--line)]">
          <InteropRow
            tone="text-[var(--fur-deep)]"
            label="Preact"
            title="Shared h()"
            body="Preact's h(tag, props, children) matches JSX desugar. No adapter."
          />
          <InteropRow
            tone="text-[var(--lavender-deep)]"
            label="styled-cva"
            title="UI factories in .mochi"
            body="extern tw; call-form tw.div(…) and $tone variants."
          />
          <InteropRow
            tone="text-[var(--plum)]"
            label="re-reduced"
            title="Signal state"
            body="defineContainer in .mochi; hooks in TSX — let…in → IIFE breaks Rules of Hooks."
          />
          <InteropRow
            tone="text-[var(--ok)]"
            label="TypeScript"
            title=".d.mochi.ts"
            body="Generated declarations for TS hosts importing .mochi modules."
          />
        </div>
      </section>
    </main>
    <SiteFooter logo={props.logo} />
  </div>

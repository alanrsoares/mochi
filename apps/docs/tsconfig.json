{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@mochi/compiler": [
        "../../packages/compiler/src/index.ts"
      ],
      "@mochi/compiler/*": [
        "../../src/*"
      ],
      "@mochi/dx": [
        "../../packages/dx/src/index.ts"
      ],
      "@mochi/dx/*": [
        "../../packages/dx/src/*"
      ],
      "@mochi/vite-plugin": [
        "../../packages/vite-plugin/src/index.ts"
      ],
      "@mochi/root/*": [
        "../../*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*"
  ]
}

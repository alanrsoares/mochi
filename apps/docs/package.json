{
  "name": "@mochi/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/gen-mochi-dts.ts && bunx --bun vite",
    "build": "bun ../../scripts/gen-mochi-dts.ts && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "gen:emit": "bun ../../scripts/gen-docs-emit.ts",
    "check": "bun ../../scripts/gen-mochi-dts.ts && tsc --noEmit && bun test src && bunx --bun vite build"
  },
  "dependencies": {
    "@mochi/compiler": "workspace:*",
    "@onrails/pattern": "^0.3.3",
    "@onrails/result": "^0.4.0",
    "@mochi/dx": "workspace:*",
    "@mochi/plugin-preact": "workspace:*",
    "@mochi/plugin-re-reduced": "workspace:*",
    "@mochi/plugin-styled-cva": "workspace:*",
    "@mochi/vite-plugin": "workspace:*",
    "@preact/signals": "^2.11.1",
    "@re-reduced/preact": "^0.2.3",
    "@styled-cva/react": "^0.7.1",
    "gsap": "^3.15.0",
    "lucide-preact": "^1.34.0",
    "preact": "^10.29.8",
    "prettier": "3"
  },
  "devDependencies": {
    "@mochi/test-support": "workspace:*",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/path-browserify": "^1.0.3",
    "path-browserify": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}

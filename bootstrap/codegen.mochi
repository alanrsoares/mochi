// bootstrap/codegen.mochi — the mochi codegen pass, in mochi. Ported from
// src/codegen.ts (the spec); test/bootstrap-codegen.spec.ts diffs emitted JS
// against the TS codegen on every .mochi file in the repo — including this one.
//
// Shape notes vs TS original:
// - AST declared again here (bootstrap/parser.mochi's shape/tags — same
//   convention as check.mochi/infer.mochi): until modules arrive, each bootstrap
//   file's runtime `_tag`s must match by hand, not by import.
// - `ctorKeys` (TS module-level mutable Map) becomes `GCtx = { keys, ns }`,
//   threaded through every generator/pattern-compiler function. `ns` is
//   `namespaceRuntime` (`Ns.member` -> JS identifier).
// - `exprRefs`'s mutable `Set` accumulator becomes an explicit
//   threaded/returned immutable Set.
// - `namespaceRuntime` / `preludeJsDefs` / `runtimeDeps` are NOT
//   reimplemented — the differential-test harness passes the real
//   src/prelude.ts tables in as Map arguments (one prelude, not forked —
//   docs/PATH_TO_BOOTSTRAP.md §6). Only `builtinTypeDecls`' ctor keys
//   (Some/None/Ok/Err — 4 entries) are small/stable enough to hardcode
//   directly, matching infer.mochi's precedent for `builtinTypeDecls`.
// - TS `for`/`forEach`/`flatMap` loops become tail-recursive `Array.get(i,
//   xs)` cursor loops (matches check.mochi/infer.mochi's established idiom).

import * as Ast from "./ast.mochi"

import { keysOf, ctorKeysFromStmts, seedBuiltinCtorKeys } from "./ctors.mochi"
// One chunk of a "…${a}…" interpolation (ADR 0023): a literal run, or a
// hole expression. TS: an untagged `string | Expr` union — mochi has no raw
// unions, so this is a proper variant (mirrors parser.mochi's own copy).

// --- GenOpts: the TS backend's knobs on the shared codegen (ADR 0026 / 0090) ---
//
// TS's `GenCtx` carries these inline; here they are one record folded into the
// threaded ctx, so every generator keeps its `ctx->` shape. All hooks are
// `Option<fn>` (TS's `| null`): `jsGenOpts` leaves every one `None` and the JS
// backend's output stays byte-for-byte identical — test/bootstrap-codegen.spec.ts
// and the fixpoint guard that.

/// What a typed ctor factory carries (TS's `CtorFactoryTs`).
type CtorFactoryTs = {
  generics: string,
  paramTypes: [string],
  ret: string,
  retMono: string
}

/// A lambda's generic head plus one annotation per collapsed param (`None` =
/// leave it bare, i.e. generic or JS mode).
type ParamAnnots = { generics: string, params: [Option<string>] }

// Each hook mirrors the same-named field on TS's `GenCtx`:
// - `annotateLet` — type suffix for a top-level `let` (`": (x: A) => A"`).
// - `annotateCtor` — typing for one variant ctor's factory.
// - `annotateParams` — per-param annotations for the lambda at a span, given
//   its collapsed arity (ADR 0028 / 0032).
// - `annotateEmpty` — concrete type for an EMPTY collection literal or a
//   nullary ctor (ADR 0035 / 0039).
// - `annotateLetin` — monomorphic type for a `let x = v in …` IIFE param.
// - `annotateCall` — type to cast an applied parametric ctor call to (ADR 0043).
// - `guardBaseType` — the type a guard-form arm's predicate narrows FROM (ADR 0031).
// - `flattenPipe` — lower `a |> f(x)` to `f(x, a)`, so tsc infers from all args
//   at once.
// - `tupleHelper` — emit `_tuple(a, b)` instead of `[a, b]` (ADR 0036).
// - `moduleExt` — relative-import suffix: `".js"` for JS, `""` for TS.
/// Structural stand-ins for a ctor and its fields. NOT `Ast.Ctor`: naming the
/// imported alias makes the record nominal across the module boundary, and the
/// frozen stage-1 seed cannot expand a cross-module record alias against an
/// open row (ADR 0046 landed after it was frozen). Declared here, these expand
/// locally and still unify structurally with the real AST values.
type CtorFieldLike = { name: Option<string>, fieldType: Ast.TypeExpr }

type CtorLike = { name: string, fields: [CtorFieldLike] }

type GenOpts = {
  annotateLet: Option<string -> Ast.Expr -> Option<string> >,
  annotateCtor: Option<Ast.Stmt -> CtorLike -> Option<CtorFactoryTs> >,
  annotateParams: Option<Ast.Span -> number -> ParamAnnots>,
  annotateEmpty: Option<Ast.Expr -> Option<string> >,
  annotateLetin: Option<Ast.Expr -> Option<string> >,
  annotateCall: Option<Ast.Expr -> Option<string> >,
  guardBaseType: Option<Ast.Expr -> Option<string> >,
  flattenPipe: bool,
  tupleHelper: bool,
  preserveInfix: bool,
  preserveJsx: bool,
  moduleExt: string,
  docs: bool
}

/// Everything threaded through the generators: the `GenOpts` knobs, flattened,
/// plus the ctor field-key registry, the namespace runtime table, and the
/// value-reference set. Declared and annotated at every `ctx` parameter for the
/// reason scc.mochi pins `TSt` (ADR 0044) — each generator generalizes the
/// record's open tail on its own, so the emitted TS reprinted the whole shape
/// once per function instead of naming it.
type GCtx = {
  keys: Map<string, [string]>,
  ns: Map<string, Map<string, string> >,
  annotateLet: Option<string -> Ast.Expr -> Option<string> >,
  annotateCtor: Option<Ast.Stmt -> CtorLike -> Option<CtorFactoryTs> >,
  annotateParams: Option<Ast.Span -> number -> ParamAnnots>,
  annotateEmpty: Option<Ast.Expr -> Option<string> >,
  annotateLetin: Option<Ast.Expr -> Option<string> >,
  annotateCall: Option<Ast.Expr -> Option<string> >,
  guardBaseType: Option<Ast.Expr -> Option<string> >,
  flattenPipe: bool,
  tupleHelper: bool,
  preserveInfix: bool,
  preserveJsx: bool,
  moduleExt: string,
  valueRefs: Set<string>,
  docs: bool
}

/// The JS backend's knobs: no annotation, no rewriting, `.js` siblings.
/// Annotated so the emitted TS keeps the hook types instead of widening the
/// bare `None`s to `Option<unknown>` (ADR 0044).
export let jsGenOpts : GenOpts = {
  annotateLet: None,
  annotateCtor: None,
  annotateParams: None,
  annotateEmpty: None,
  annotateLetin: None,
  annotateCall: None,
  guardBaseType: None,
  flattenPipe: false,
  tupleHelper: false,
  preserveInfix: false,
  preserveJsx: false,
  moduleExt: ".js",
  docs: true
}

/// Apply a one-argument `Option<fn>` hook, flattening "no hook" and "hook
/// declined" into the same `None` — TS's `ctx.hook?.(x) ?? null`.
let hook1 = (h, x) => switch h { | None => None | Some(f) => f(x) }

/// `hook1` for the two-argument hooks.
let hook2 = (h, x, y) => switch h { | None => None | Some(f) => f(x, y) }

/// `new Map<K, V>()` when annotated, `new Map()` otherwise.
let emptyNsCtor = (con, ann) => switch ann {
  | None => "new ${con}()"
  | Some(t) => "new ${t}()"
}

/// Uppercase-initial name — a constructor, not an ordinary binding.
/// A record field name emits BARE only when it is a valid JS identifier;
/// anything else (`data-testid`, `aria-label`) must be quoted or the object
/// literal is a syntax error. Mirrors the oracle's `/^[$A-Za-z_][\w$]*$/`.
let isIdentStart = c =>
  c >= 65 && c <= 90 || (c >= 97 && c <= 122) || c == 95 || c == 36

let isIdentPart = c => isIdentStart(c) || (c >= 48 && c <= 57)

let identPartsFrom = (s, i) => switch Str.codeAt(i, s) {
  | None => true
  | Some(c) => isIdentPart(c) && identPartsFrom(s, i + 1)
}

let isJsIdent = s => switch Str.codeAt(0, s) {
  | None => false
  | Some(c) => isIdentStart(c) && identPartsFrom(s, 1)
}

let isUpperStart = s =>
  Str.codeAt(0, s) |> Option.exists(n => n >= 65 && n <= 90)

/// A 0-field ctor reference (`None`), per this program's ctor-key table.
let isNullaryCtor = (name, keys) =>
  Map.get(name, keys) |> Option.exists(ks => Array.length(ks) == 0)

/// Callee that is a bare uppercase ref — gates the applied-ctor cast.
let isCtorRef = fn => switch fn {
  | Ast.ERef(name, _) => isUpperStart(name)
  | _ => false
}

/// `name: T` when annotated, bare name otherwise.
let suffixOr = (name, ann) => switch ann {
  | None => name
  | Some(t) => "${name}: ${t}"
}

/// No annotations at all — the JS backend's shape for every lambda.
let bareParamAnnots : ParamAnnots = { generics: "", params: [] }

let paramAnnotsFor = (h, sp, arity) => switch h {
  | None => bareParamAnnots
  | Some(f) => f(sp, arity)
}

/// Zip collapsed params with their annotations; a missing or `None` entry
/// leaves the param bare (generic position, or JS mode).
let annotatedParams = (cparams, annots, i) => switch Array.get(i, cparams) {
  | None => []
  | Some(p) => Array.prepend(
      suffixOr(genParam(p), Option.unwrapOr(None, Array.get(i, annots))),
      annotatedParams(cparams, annots, i + 1)
    )
}

/// `expr as T` when annotated, bare otherwise.
let castOr = (js, ann) => switch ann {
  | None => js
  | Some(t) => "(${js} as ${t})"
}

// --- small generic helpers (duplicated per bootstrap file, same as check.mochi/infer.mochi) ---

let bindRuntime = monad =>
  monad == "Option"
    ? "_Option_flatMap"
    : monad == "Result"
    ? "_Result_flatMap"
    : "_Task_andThen"

let allOfFrom = (f, xs, i) => switch Array.get(i, xs) {
  | None => true
  | Some(x) => f(x) ? allOfFrom(f, xs, i + 1) : false
}

let allOf = (f, xs) => allOfFrom(f, xs, 0)

let someOfFrom = (f, xs, i) => switch Array.get(i, xs) {
  | None => false
  | Some(x) => f(x) ? true : someOfFrom(f, xs, i + 1)
}
let someOf = (f, xs) => someOfFrom(f, xs, 0)

// Encode a decoded mochi string VALUE back as a JS string literal. The
// lexer only ever decodes \\ \" \n \t (src/lexer.ts scanString — \r is NOT
// decoded: it falls through to a literal "r"), so no mochi string value can
// contain any other escape-worthy character — this is a complete encoder for
// anything this compiler could have produced, and it must byte-match
// `JSON.stringify` on that same restricted alphabet.
let escChar = c => switch c {
  | "\\" => "\\\\"
  | "\"" => "\\\""
  | "\n" => "\\n"
  | "\t" => "\\t"
  | _ => c
}
let jsStringLit = s => "\"${Str.join("", Str.chars(s) |> map(escChar))}\""

// Re-escape a decoded literal chunk for a JS template literal: backslashes
// first (else the escapes we're about to insert double-escape), then the
// two chars that would otherwise reopen JS template syntax.
let escTemplateLoop = (chars, i0, acc0) =>
  loop (i = i0, acc = acc0) {
    switch Array.get(i, chars) {
      | None => acc
      | Some("\\") => recur(i + 1, "${acc}\\\\")
      | Some("`") => recur(i + 1, "${acc}\\`")
      | Some("$") when Array.get(i + 1, chars) |> Option.contains("{") => recur(
          i + 2,
          "${acc}\\\${"
        )
      | Some(c) => recur(i + 1, "${acc}${c}")
    }
  }
let escapeTemplateLiteral = s => escTemplateLoop(Str.chars(s), 0, "")

// --- ctor field-key registry (GCtx.keys) ---------------------------------

// `keysOf` (a ctor's runtime field keys) lives in ctors.mochi — the shared
// constructor-knowledge module — so factory, pattern destructure, and the
// TS pass all derive from one source.

let keyAt = (ctx: GCtx, ctor, i) => switch Map.get(ctor, ctx.keys) {
  | Some(ks) => Option.unwrapOr("_${show(i)}", Array.get(i, ks))
  | None => "_${show(i)}"
}

// `Ns.member` access on a namespace ref (`List.map`) -> the JS identifier
// its runtime is defined under, None if it isn't namespace access.
let nsRuntimeId = (ctx: GCtx, target, name) => switch target {
  | Ast.ERef(refName, _) => switch Map.get(refName, ctx.ns) {
      | Some(members) => Map.get(name, members)
      | None => None
    }
  | _ => None
}

// `Set.empty` / `Map.empty` / `List.empty` lower to the same runtime as
// `#{}` / `@{}` (ADR 0080). Not namespaceRuntime ids — inline constructors.
/// `Set.empty` / `Map.empty` / `List.empty` lower to the same runtime as
/// `@{}` / `#{}` (ADR 0080). `ann` is the resolved element typing when the TS
/// backend supplies one — a bare `new Set()` infers `Set<never>` (ADR 0035).
let emptyNsEmit = (target, name, ann) => switch target {
  | Ast.ERef(refName, _) => name == "empty"
      ? refName == "Set"
        ? Some(emptyNsCtor("Set", ann))
        : refName == "Map"
        ? Some(emptyNsCtor("Map", ann))
        : refName == "List"
        ? Some("_list(function* () {})")
        : None
      : None
  | _ => None
}

// Collapse `(x) => (y) => e` (curried lambdas), `(x, y) => e`, or a mix
// into one flat parameter list plus a final body. mochi types treat
// `(x, y) => e` and `x => y => e` identically (`a -> b -> c`), so it's
// sound to lower a multi-arg function into a single `_curry`-wrapped JS
// function instead of nested closures (CRITIQUE §4.4).
// A trailing labeled group is ONE JS parameter (`$lab`, then `$lab1`, … for a
// curried chain); `genLabeledFill` destructures it back into the body's names,
// filling defaults there rather than at the call site (ADR 0098 §2).
let isLabeledParam = p => switch p {
  | Ast.LPLabeled(_, _, _, _) => true
  | Ast.LPSpanned(inner, _) => isLabeledParam(inner)
  | _ => false
}

let splitLamParams = (params, positional, labeled) => switch params {
  | [] => (positional, labeled)
  | [p, ...rest] => isLabeledParam(p)
      ? splitLamParams(rest, positional, Array.append(p, labeled))
      : splitLamParams(rest, Array.append(p, positional), labeled)
}

let absorbParams = (params, acc, fills, labN) =>
  let (positional, labeled) = splitLamParams(params, [], []) in
  let acc1 = Array.concat(acc, positional) in
    switch labeled {
      | [] => (acc1, fills, labN)
      | _ => let labVar = labN == 0 ? "$lab" : "$lab${show(labN)}" in
          (
            Array.append(Ast.LPName(labVar, None), acc1),
            Array.append({ labVar, labs: labeled }, fills),
            labN + 1
          )
    }

let collapseLambdaFrom = (params, body, acc, fills, labN) =>
  let (acc1, fills1, labN1) = absorbParams(params, acc, fills, labN) in
    switch body {
      | Ast.ELambda(params2, body2, _) => collapseLambdaFrom(
          params2,
          body2,
          acc1,
          fills1,
          labN1
        )
      | _ => (acc1, body, fills1)
    }

let collapseLambda = (params, body) =>
  collapseLambdaFrom(params, body, [], [], 0)

// ---- expressions -----------------------------------------------------------

/// The numeric calls whose saturated runtime behavior is exactly JavaScript's
/// infix behavior. `eq` is structural and `mod` is true modulo, so neither
/// belongs here.
let tsInfix = (ctx: GCtx, fn, args) =>
  !ctx.preserveInfix
    ? None
    : switch (fn, args) {
      | (Ast.ERef(name, _), [left, right]) => switch name {
          | "add" => Some("(${ctx->genExpr(left)} + ${ctx->genExpr(right)})")
          | "sub" => Some("(${ctx->genExpr(left)} - ${ctx->genExpr(right)})")
          | "mul" => Some("(${ctx->genExpr(left)} * ${ctx->genExpr(right)})")
          | "div" => Some("(${ctx->genExpr(left)} / ${ctx->genExpr(right)})")
          | "lt" => Some("(${ctx->genExpr(left)} < ${ctx->genExpr(right)})")
          | "lte" => Some("(${ctx->genExpr(left)} <= ${ctx->genExpr(right)})")
          | "gt" => Some("(${ctx->genExpr(left)} > ${ctx->genExpr(right)})")
          | "gte" => Some("(${ctx->genExpr(left)} >= ${ctx->genExpr(right)})")
          | _ => None
        }
      | _ => None
    }

let jsxHasSpread = children => switch children {
  | [] => false
  | [Ast.SESpread(_), ..._] => true
  | [_, ...rest] => jsxHasSpread(rest)
}

let jsxAttrs = (ctx: GCtx, fields, spread) =>
  let head = switch spread {
    | None => ""
    | Some(value) => " {...${ctx->genExpr(value)}}"
  } in
    "${head}${Str.join("", fields |> map(f => switch f.value { | Ast.EBool(true, _) => " ${f.name}" | value => " ${f.name}={${ctx->genExpr(value)}}" }))}"

/// Re-fold only the parser's provenance-tagged `h(tag, props, children)`.
/// A source-written `h(...)` remains a call, and child spreads retain that
/// call form because JSX has no equivalent spread-child syntax.
let tsxArgs = (ctx: GCtx, args) => switch args {
  | [tag, Ast.ERecord(fields, spread, _), Ast.EArr(children, _)] => jsxHasSpread(
      children
    )
      ? None
      : let fragment = switch tag {
        | Ast.EStr("Fragment", _) => true
        | _ => false
      } in
      let name = fragment
        ? ""
        : switch tag {
          | Ast.EStr(value, _) => value
          | _ => ctx->genMember(tag)
        } in
      let attrs = jsxAttrs(ctx, fields, spread) in
        Array.length(children) == 0 && !fragment
          ? Some("<${name}${attrs} />")
          : let body = Str.join(
            "",
            children
              |> map(child => switch child {
                | Ast.SEExpr(value) => "{${ctx->genExpr(value)}}"
                | Ast.SESpread(_) => ""
              })
          ) in
            fragment
              ? Some("<>${body}</>")
              : Some("<${name}${attrs}>${body}</${name}>")
  | _ => None
}

let tsxCall = (ctx: GCtx, fn, args, origin) =>
  !ctx.preserveJsx
    ? None
    : switch origin {
      | Some("jsx") => switch fn {
          | Ast.ERef("h", _) => tsxArgs(ctx, args)
          | _ => None
        }
      | _ => None
    }

let genExpr = (ctx: GCtx, e) => switch e {
  | Ast.ENum(_, raw, _) => raw
  | Ast.EUnit(_) => "undefined"
  | Ast.EBool(value, _) => value ? "true" : "false"
  | Ast.EStr(value, _) => jsStringLit(value)
  | Ast.ERef(name, _) =>
    // A parametric nullary ctor (`None`) infers `Option<never>`, which won't
    // flow where a concrete `Option<C>` is expected — annotate it in place (TS
    // backend, ADR 0039). Gated on a 0-field ctor so plain value refs are
    // untouched; the hook itself declines unless the type is fully concrete.
    castOr(
      name,
      isNullaryCtor(name, ctx.keys) ? hook1(ctx.annotateEmpty, e) : None
    )
  | Ast.ECall(fn, args, origin, _) =>
    // An applied parametric ctor (`Ok("")`) leaves the type param its argument
    // does not determine free, so tsc widens it to `unknown`. Cast the call to
    // its resolved type (ADR 0043). Gated on an uppercase callee — a ctor.
    switch tsxCall(ctx, fn, args, origin) {
      | Some(jsx) => jsx
      | None => switch tsInfix(ctx, fn, args) {
          | Some(infix) => infix
          | None => let inner = "${ctx->genCallee(fn)}(${Str.join(", ", args |> map(a => ctx->genExpr(a)))})" in
              castOr(inner, isCtorRef(fn) ? hook1(ctx.annotateCall, e) : None)
        }
    }
  | Ast.ELambda(params, body, sp) => let (cparams, cbody, fills) = collapseLambda(
      params,
      body
    ) in
    let bound = fillNames(fills, paramNameSet(cparams, 0, Set.fromArray([]))) in
    // TS backend: annotate each param from the lambda's inferred curried type
    // (ADR 0028), else strict tsc infers `any`. `sp` is the OUTER (un-collapsed)
    // lambda's span, which carries the full `A -> B -> …` type; the hook peels
    // it per collapsed param. A generic binding's value lambda also scopes its
    // letters on the arrow here (ADR 0032) so its params can name them.
    let annots = paramAnnotsFor(
      ctx.annotateParams,
      sp,
      Array.length(cparams)
    ) in
    let arrow = "${annots.generics}(${Str.join(", ", annotatedParams(cparams, annots.params, 0))}) => ${ctx->genLambdaBodyIn(cbody, bound, ctx->genFillDecls(fills))}" in
      // Curried type, JS impl: arity >= 2 lowers to a `_curry`-wrapped
      // function so any call grouping works (CRITIQUE §4.4). Arity 1 needs none.
      Array.length(cparams) >= 2
        ? "_curry(${show(Array.length(cparams))}, ${arrow})"
        : arrow
  | Ast.ELetIn(name, _, _, value, body, _) =>
    // let x = v in b -> an IIFE binding x: `((x) => b)(v)`. Non-recursive, so
    // plain arg-application is enough; nested let-ins chain as curried IIFEs.
    // Annotating the param flows contextual types into `v`'s empty collections
    // through the IIFE, which arg-based inference alone cannot do (ADR 0035).
    let param = suffixOr(name, hook1(ctx.annotateLetin, value)) in
      "((${param}) => ${ctx->genLambdaBody(body)})(${ctx->genExpr(value)})"
  | Ast.ELetBind(param, _, monad, value, body, _) =>
    // let? / let! p = v in b -> `_Option_flatMap` / `_Result_flatMap` /
    // `_Task_andThen`((p) => b)(v). `let?` monad is Result or Option after
    // infer dispatch (ADR 0079); `let!` is Task.
    // Under `flattenPipe` (TS backend) both args go in ONE grouping, so tsc
    // infers `p`'s type from `v` in the all-at-once overload; the curried split
    // leaves `p` unconstrained. Equivalent under `_curry`.
    let rt = bindRuntime(monad) in
    let f = "(${genParam(param)}) => ${ctx->genLambdaBody(body)}" in
    let v = ctx->genExpr(value) in
      ctx.flattenPipe ? "${rt}(${f}, ${v})" : "${rt}(${f})(${v})"
  | Ast.EPipe(left, right, fast, sp) =>
    // A fast pipe IS a call (ADR 0069) — lower it and take the ordinary call
    // path, so argument order lives in `Ast.pipeCall` alone.
    fast
      ? switch right {
        | Ast.ECall(rfn, rargs, origin, _) => ctx->genExpr(
            Ast.ECall(rfn, Array.prepend(left, rargs), origin, sp)
          )
        | _ => ctx->genExpr(Ast.ECall(right, [left], None, sp))
      }
      :
        // `a |> f` -> `f(a)`. Under `flattenPipe` (the TS backend) a pipe into a
        // call APPENDS the argument — `a |> f(x)` -> `f(x, a)` — so tsc infers the
        // type arguments once; otherwise it stays curried as `f(x)(a)`.
        switch right {
          | Ast.ECall(rfn, rargs, _, _) when ctx.flattenPipe => "${ctx->genCallee(rfn)}(${Str.join(", ", Array.append(left, rargs) |> map(a => ctx->genExpr(a)))})"
          | _ => "${ctx->genCallee(right)}(${ctx->genExpr(left)})"
        }
  | Ast.EDo(exprs, _) => ctx->genDo(exprs)
  | Ast.ETernary(cond, thenE, elseE, _) => "(${ctx->genExpr(cond)} ? ${ctx->genExpr(thenE)} : ${ctx->genExpr(elseE)})"
  | Ast.EMatch(scrutinee, arms, _) => ctx->genMatch(scrutinee, arms)
  | Ast.ELoop(params, body, _) =>
    // Expression-position loop wraps in an IIFE; directly under a lambda body
    // the bare-block form is used instead (genLambdaBodyIn) — ADR 0056.
    "(() => { ${ctx->genLoopBlock(params, body)} })()"
  | Ast.ERecur(args, _) =>
    // Only reachable inside a loop-tail switch arm (checkLoops): a step value.
    "_recur(${Str.join(", ", args |> map(a => ctx->genExpr(a)))})"
  | Ast.ERecord(fields, spread, _) =>
    // `{ ...base, f: v }` (ADR 0021) -> native JS object spread; `parts.length
    // === 0` (bare `{}`) is only possible with no spread and no fields.
    let fieldStrs = Str.join(
      ", ",
      fields
        |> map(f =>
          "${isJsIdent(f.name) ? f.name : jsStringLit(f.name)}: ${ctx->genExpr(f.value)}")
    ) in
      switch spread {
        | None => Array.length(fields) == 0 ? "{}" : "{ ${fieldStrs} }"
        | Some(s) => let spreadStr = "...${ctx->genExpr(s)}" in
            Array.length(fields) == 0
              ? "{ ${spreadStr} }"
              : "{ ${spreadStr}, ${fieldStrs} }"
      }
  | Ast.EField(target, name, optional, _) => switch emptyNsEmit(target, name, hook1(ctx.annotateEmpty, e)) {
      | Some(js) => js
      | None => switch ctx->nsRuntimeId(target, name) {
          | Some(rt) => rt
          | None => let member = "${ctx->genMember(target)}.${name}" in
              optional
                ? "((v) => v != null ? { _tag: \"Some\", value: v } : { _tag: \"None\" })(${member})"
                : member
        }
    }
  | Ast.ETuple(elements, _) =>
    // A tuple erases to a JS array `[a, b]` (like ReScript); the type system
    // keeps it distinct from an mochi Array, the runtime shares the shape. TS
    // emit wraps it in `_tuple(…)` so tsc infers a tuple, not a widened array
    // (ADR 0036); the JS backend keeps the bare literal (byte-identical).
    let elems = Str.join(", ", elements |> map(el => ctx->genExpr(el))) in
      ctx.tupleHelper ? "_tuple(${elems})" : "[${elems}]"
  | Ast.EArr(elements, _) =>
    // Empty `[]` infers `never[]` — annotate with the resolved element type so
    // it flows where a concrete array is expected (ADR 0035).
    let body = "[${Str.join(", ", elements |> map(el => ctx->genSeqSlot(el)))}]" in
      castOr(
        body,
        Array.length(elements) == 0 ? hook1(ctx.annotateEmpty, e) : None
      )
  | Ast.EList(elements, _) => ctx->genList(elements)
  | Ast.ESet(elements, _) => "new Set([${Str.join(", ", elements |> map(el => ctx->genSeqSlot(el)))}])"
  | Ast.EMap(entries, _) =>
    // Empty `#{}` infers `Map<unknown, unknown>` — emit `new Map<K, V>()` with
    // the resolved key/value types instead (ADR 0035).
    switch Array.length(entries) == 0 ? hook1(ctx.annotateEmpty, e) : None {
      | Some(t) => "new ${t}()"
      | None => "new Map([${Str.join(", ", entries |> map(en => "[${ctx->genExpr(en.key)}, ${ctx->genExpr(en.value)}]"))}])"
    }
  | Ast.EInterp(parts, _) =>
    // "…${x}…" (ADR 0023) → a native JS template literal — emitted JS reads
    // exactly like the source.
    let body = Str.join(
      "",
      parts
        |> map(p => switch p {
          | Ast.IPLit(value) => escapeTemplateLiteral(value)
          | Ast.IPExpr(ex) => "\${${ctx->genExpr(ex)}}"
        })
    ) in
      "`${body}`"
}

let genDo = (ctx: GCtx, exprs) => "(() => { ${ctx->genDoSteps(exprs)} })()"
let genDoSteps = (ctx: GCtx, exprs) => switch exprs {
  | [last] => "return ${ctx->genExpr(last)};"
  | [first, ...rest] => "${ctx->genExpr(first)}; ${ctx->genDoSteps(rest)}"
  | [] => "throw new Error(\"empty do block\");"
}

let genSeqSlot = (ctx: GCtx, el) => switch el {
  | Ast.SEExpr(ex) => ctx->genExpr(ex)
  | Ast.SESpread(ex) => "...${ctx->genExpr(ex)}"
}

// A `@{...}` literal -> a lazy iterable. Spreads `yield*` another List.
let genList = (ctx: GCtx, elements) =>
  let yields = Str.join(
    " ",
    elements
      |> map(el => switch el {
        | Ast.SEExpr(ex) => "yield (${ctx->genExpr(ex)});"
        | Ast.SESpread(ex) => "yield* (${ctx->genExpr(ex)});"
      })
  ) in
    "_list(function* () {${yields == "" ? "" : " ${yields} "}})"

// A lambda parameter lowers to JS: a name, or native object destructuring.
let genParam = p => switch p {
  | Ast.LPSpanned(inner, _) => genParam(inner)
  | Ast.LPName(name, _) => name
  | Ast.LPTuple(names) => "[${Str.join(", ", names)}]"
  | Ast.LPRecord(fields) => "{ ${Str.join(", ", fields)} }"
  | Ast.LPLabeled(name, _, _, _) =>
    // `collapseLambda` already replaced a labeled group with its `$lab` name,
    // so this is unreachable there; `let?` shares this printer.
    name
}

// A lambda in callee position must be parenthesized: `((x) => ...)(arg)`.
let genCallee = (ctx: GCtx, e) => switch e {
  | Ast.ELambda(_, _, _) => "(${ctx->genExpr(e)})"
  | _ => ctx->genExpr(e)
}

// A record or lambda in member-target position needs parens: `({...}).x`.
let genMember = (ctx: GCtx, e) => switch e {
  | Ast.ERecord(_, _, _) => "(${ctx->genExpr(e)})"
  | Ast.ELambda(_, _, _) => "(${ctx->genExpr(e)})"
  | _ => ctx->genExpr(e)
}

// A record literal as a concise arrow body must be parenthesized, else JS
// parses `=> { ... }` as a statement block: `=> ({ x: 1 })`.
// ---- loop / recur (ADR 0056) ------------------------------------------------

let seqElemExpr = el => switch el {
  | Ast.SEExpr(e) => e
  | Ast.SESpread(e) => e
}

// Does this subtree contain a recur belonging to the CURRENT loop? Nested
// loops own their recurs; lambda/letbind bodies are hard boundaries.
let hasRecur = e => switch e {
  | Ast.ERecur(_, _) => true
  | Ast.ELoop(_, _, _) => false
  | Ast.ELambda(_, _, _) => false
  | Ast.ELetBind(_, _, _, _, _, _) => false
  | Ast.EInterp(parts, _) => someOf(
      p => switch p { | Ast.IPExpr(x) => hasRecur(x) | Ast.IPLit(_) => false },
      parts
    )
  | Ast.ECall(fn, args, _, _) => hasRecur(fn) || someOf(hasRecur, args)
  | Ast.ELetIn(_, _, _, value, body, _) => hasRecur(value) || hasRecur(body)
  | Ast.EPipe(left, right, _, _) => hasRecur(left) || hasRecur(right)
  | Ast.EDo(exprs, _) => someOf(hasRecur, exprs)
  | Ast.ETernary(cond, thenE, elseE, _) => hasRecur(
      cond
    ) || (hasRecur(thenE) || hasRecur(elseE))
  | Ast.EMatch(scrutinee, arms, _) => hasRecur(
      scrutinee
    ) || someOf(
      a =>
        switch a.guard {
          | Some(g) => hasRecur(g)
          | None => false
        } || hasRecur(a.body),
      arms
    )
  | Ast.ERecord(fields, spread, _) => switch spread {
      | Some(sp) => hasRecur(sp)
      | None => false
    } || someOf(f => hasRecur(f.value), fields)
  | Ast.EField(target, _, _, _) => hasRecur(target)
  | Ast.ETuple(elements, _) => someOf(hasRecur, elements)
  | Ast.EArr(elements, _) => someOf(el => hasRecur(seqElemExpr(el)), elements)
  | Ast.EList(elements, _) => someOf(el => hasRecur(seqElemExpr(el)), elements)
  | Ast.ESet(elements, _) => someOf(el => hasRecur(seqElemExpr(el)), elements)
  | Ast.EMap(entries, _) => someOf(
      en => hasRecur(en.key) || hasRecur(en.value),
      entries
    )
  | _ => false
}

// Will this loop body need the _recur/_done step protocol? Only when a switch
// sits in tail position with a recur inside.
let loopNeedsStep = e => switch e {
  | Ast.ETernary(_, thenE, elseE, _) => loopNeedsStep(
      thenE
    ) || loopNeedsStep(elseE)
  | Ast.ELetIn(_, _, _, _, body, _) => loopNeedsStep(body)
  | Ast.EDo(exprs, _) => loopNeedsStep(lastDoExpr(exprs))
  | Ast.EMatch(_, _, _) => hasRecur(e)
  | _ => false
}

let lastDoExpr = exprs => switch exprs {
  | [last] => last
  | [_, ...rest] => lastDoExpr(rest)
  | [] => Ast.EUnit({ start: 0, end: 0 })
}

// Rewrite a loop-tail switch so every arm yields a step value: recur tails
// already emit `_recur(...)` (genExpr), value tails wrap in `_done(...)`.
let wrapStepTails = (e, sp) => switch e {
  | Ast.ERecur(_, _) => e
  | Ast.ETernary(cond, thenE, elseE, tsp) => Ast.ETernary(
      cond,
      wrapStepTails(thenE, sp),
      wrapStepTails(elseE, sp),
      tsp
    )
  | Ast.ELetIn(name, nameSpan, annot, value, body, lsp) => Ast.ELetIn(
      name,
      nameSpan,
      annot,
      value,
      wrapStepTails(body, sp),
      lsp
    )
  | Ast.EDo(exprs, dsp) => Ast.EDo(wrapDoStepTail(exprs, sp), dsp)
  | Ast.EMatch(scrutinee, arms, msp) => Ast.EMatch(
      scrutinee,
      arms
        |> map(a =>
          {
            pattern: a.pattern,
            guard: a.guard,
            body: wrapStepTails(a.body, sp)
          }),
      msp
    )
  | _ => Ast.ECall(Ast.ERef("_done", sp), [e], None, sp)
}

let wrapDoStepTail = (exprs, sp) => switch exprs {
  | [last] => [wrapStepTails(last, sp)]
  | [first, ...rest] => [first, ...wrapDoStepTail(rest, sp)]
  | [] => []
}

let loopParamNames = params => Str.join(", ", params |> map(p => p.name))

// Lower one loop-body tail to statements inside `while (true)`.
let genLoopTail = (ctx: GCtx, e, params) => switch e {
  | Ast.ERecur(args, _) => switch (params, args) {
      | ([p], [a]) => "${p.name} = ${ctx->genExpr(a)}; continue;"
      | (_, _) => "[${loopParamNames(params)}] = [${Str.join(", ", args |> map(a => ctx->genExpr(a)))}]; continue;"
    }
  | Ast.ETernary(cond, thenE, elseE, _) => hasRecur(e)
      ? "if (${ctx->genExpr(cond)}) { ${ctx->genLoopTail(thenE, params)} } else { ${ctx->genLoopTail(elseE, params)} }"
      : "return ${ctx->genExpr(e)};"
  | Ast.ELetIn(name, _, _, value, body, _) => hasRecur(e)
      ?
        // A let-in in loop-tail position stays a JS block rather than flattening
        // into the loop body: consecutive `let _ = … in` effects and shadowing
        // rebinds would otherwise redeclare the same `const`. It takes the same
        // ADR 0035 annotation the IIFE form does.
        "{ const ${suffixOr(name, hook1(ctx.annotateLetin, value))} = ${ctx->genExpr(value)}; ${ctx->genLoopTail(body, params)} }"
      : "return ${ctx->genExpr(e)};"
  | Ast.EDo(exprs, _) => hasRecur(e)
      ? "{ ${ctx->genDoLoopTail(exprs, params)} }"
      : "return ${ctx->genExpr(e)};"
  | Ast.EMatch(_, _, sp) => hasRecur(e)
      ? let step = ctx->genExpr(wrapStepTails(e, sp)) in
      let rebind = switch params {
        | [p] => "${p.name} = _step.args[0];"
        | _ => "[${loopParamNames(params)}] = _step.args;"
      } in
        "const _step = ${step}; if (_step._tag === ${jsStringLit("recur")}) { ${rebind} continue; } return _step.value;"
      : "return ${ctx->genExpr(e)};"
  | _ => "return ${ctx->genExpr(e)};"
}

let genDoLoopTail = (ctx: GCtx, exprs, params) => switch exprs {
  | [last] => ctx->genLoopTail(last, params)
  | [first, ...rest] => "${ctx->genExpr(first)}; ${ctx->genDoLoopTail(rest, params)}"
  | [] => "return undefined;"
}

// The statement body of a lowered loop: param `let`s + `while (true)`.
let genLoopBlock = (ctx: GCtx, params, body) =>
  let decls = Str.join(
    " ",
    params
      |> map(p =>
        "let ${suffixOr(p.name, hook1(ctx.annotateLetin, p.init))} = ${ctx->genExpr(p.init)};")
  ) in
    "${decls} while (true) { ${ctx->genLoopTail(body, params)} }"

let loopParamFree = (params, i, seen) => switch Array.get(i, params) {
  | None => true
  | Some(p) => Set.has(p.name, seen)
      ? false
      : loopParamFree(params, i + 1, seen)
}

let genLambdaBody = (ctx: GCtx, e) => switch e {
  | Ast.ERecord(_, _, _) => "(${ctx->genExpr(e)})"
  | _ => ctx->genExpr(e)
}

// Every JS binding a lambda parameter introduces — a `const` may not reuse one.
let paramNames = p => switch p {
  | Ast.LPSpanned(inner, _) => paramNames(inner)
  | Ast.LPName(name, _) => [name]
  | Ast.LPTuple(names) => names
  | Ast.LPRecord(fields) => fields
  | Ast.LPLabeled(name, _, _, _) => [name]
}

// One `const` per label, reading the collapsed `$lab` record. A default is
// filled HERE, in the callee, so `f()` and a plain record argument both work;
// `~x?` with no default surfaces as `Option` to match the inferred type.
let genLabeledFill = (ctx: GCtx, labVar, lab) => switch lab {
  | Ast.LPSpanned(inner, _) => ctx->genLabeledFill(labVar, inner)
  | Ast.LPLabeled(name, _, optional, defaultValue) => let access = "(${labVar} ?? {}).${name}" in
      switch defaultValue {
        | Some(d) => "const ${name} = ${access} != null ? ${access} : ${ctx->genExpr(d)};"
        | None => optional
            ? "const ${name} = ${access} != null ? { _tag: \"Some\", value: ${access} } : { _tag: \"None\" };"
            : "const ${name} = ${access};"
      }
  | _ => ""
}

let genFillDecls = (ctx: GCtx, fills) => switch fills {
  | [] => ""
  | _ => "${Str.join(" ", fills |> map(g => Str.join(" ", g.labs |> map(lab => ctx->genLabeledFill(g.labVar, lab)))))} "
}

let fillNames = (fills, acc) => switch fills {
  | [] => acc
  | [g, ...rest] => fillNames(
      rest,
      Array.reduce(
        (s, lab) => switch lab {
          | Ast.LPSpanned(inner, _) => switch inner {
              | Ast.LPLabeled(name, _, _, _) => Set.add(name, s)
              | _ => s
            }
          | Ast.LPLabeled(name, _, _, _) => Set.add(name, s)
          | _ => s
        },
        acc,
        g.labs
      )
    )
}

let addNames = (names, i, acc) => switch Array.get(i, names) {
  | None => acc
  | Some(n) => addNames(names, i + 1, Set.add(n, acc))
}

let paramNameSet = (params, i, acc) => switch Array.get(i, params) {
  | None => acc
  | Some(p) => paramNameSet(params, i + 1, addNames(paramNames(p), 0, acc))
}

// Collect a `let x = v in ...` chain as sequential `const` declarations.
// `let-in` is non-recursive and shadowing keeps the outer value, so the chain
// stops at the first link a `const` would capture: one whose name is already
// bound (by the arrow's params or an earlier link), or a non-lambda value whose
// own name it mentions. Lambda values are locally recursive (ADR 0067).
let letBlockLoop = (ctx: GCtx, e, seen, decls) => switch e {
  | Ast.ELetIn(name, _, _, value, body, _) => Set.has(
      name,
      seen
    ) || switch value {
      | Ast.ELambda(_, _, _) => false
      | _ => Set.has(name, ctx->exprRefs(value, Set.fromArray([])))
    }
      ? (decls, e, seen)
      : ctx->letBlockLoop(
        body,
        Set.add(name, seen),
        Array.append(
          "const ${suffixOr(name, hook1(ctx.annotateLetin, value))} = ${ctx->genExpr(value)};",
          decls
        )
      )
  | _ => (decls, e, seen)
}

// A let-chain directly under a lambda lowers to a block body of `const`s
// rather than nested IIFEs, so the emitted JS reads like the source instead
// of nesting one closure per binding. Whatever the chain stopped at falls
// back to the IIFE form, which scopes it correctly.
// `prefix` is the labeled-fill `const` run (ADR 0098 §2), already
// space-terminated, or "" — it forces a block body wherever it is non-empty.
let genLambdaBodyIn = (ctx: GCtx, e, bound, prefix) =>
  let (decls, rest, seen) = ctx->letBlockLoop(e, bound, []) in
    Array.length(decls) == 0
      ? switch e {
        | Ast.ELoop(params, body, _) =>
          // A loop directly under a lambda emits as the arrow's block body — no
          // IIFE. Param names clashing with the arrow's own params would be a JS
          // redeclaration, so those fall through to the IIFE form (ADR 0056).
          loopParamFree(params, 0, bound)
            ? "{ ${prefix}${ctx->genLoopBlock(params, body)} }"
            : prefix == ""
            ? ctx->genLambdaBody(e)
            : "{ ${prefix}return ${ctx->genLambdaBody(e)}; }"
        | _ => prefix == ""
            ? ctx->genLambdaBody(e)
            : "{ ${prefix}return ${ctx->genLambdaBody(e)}; }"
      }
      : let block = Str.join(" ", decls) in
        switch rest {
          | Ast.ELoop(params, body, _) => loopParamFree(params, 0, seen)
              ? "{ ${prefix}${block} ${ctx->genLoopBlock(params, body)} }"
              : "{ ${prefix}${block} return ${ctx->genExpr(rest)}; }"
          | _ => "{ ${prefix}${block} return ${ctx->genExpr(rest)}; }"
        }

// ---- match -> @onrails/pattern chain ---------------------------------------
// We target @onrails/pattern (pairs with @onrails/result + @onrails/maybe).
// Each arm lowers to a single `.with(...)`.

// A pattern always matches (-> `.otherwise`) when it binds without narrowing:
// wildcard, plain name, or a record whose every field just binds.
let isCatchAll = p => switch p {
  | Ast.PAs(pat, _, _, _) => isCatchAll(pat)
  | Ast.PWild(_) => true
  | Ast.PUnit(_) =>
    // `()` is irrefutable: `unit` has exactly one inhabitant, so the type decides.
    true
  | Ast.PBind(_, _) => true
  | Ast.PRecord(fields, _) => allOf(f => isCatchAll(f.pat), fields)
  | Ast.PTuple(elems, _) =>
    // a tuple always matches — position does the work (irrefutable product).
    allOf(isCatchAll, elems)
  | Ast.PArr(elems, rest, _) =>
    // [...all] / @{...all} — a bare rest with no fixed head matches anything.
    Array.length(elems) == 0 && Option.isSome(rest)
  | Ast.PList(elems, rest, _) => Array.length(elems) == 0 && Option.isSome(rest)
  | _ => false
}

let isPList = p => switch p { | Ast.PList(_, _, _) => true | _ => false }

// ---- general pattern compiler ----------------------------------------------
// Nested patterns can't lower to matcher objects: @onrails/pattern's matcher
// compares object values shallowly (`!==`), so `{ value: { _tag: "Sm" } }`
// never matches. A nesting arm instead lowers to the guard form — the same
// one array/tuple arms already use — `.with((_v) => conds, (slot) => body)`.
// `patConds` renders the refutable tests against a path expression; `patSlot`
// renders the JS destructuring target that binds names ("" = a hole, nothing
// binds beneath). Lazy `plist` never reaches either: nested occurrences are
// rejected by check.ts, top-level arms go through `genListMatch`.

// `{ key: sub }` entry, punned when the bound name IS the key.
let keyedSlot = (key, sub) => sub == key ? key : "${key}: ${sub}"

let pctorEntries = (ctx: GCtx, ctor, args, i) => switch Array.get(i, args) {
  | None => []
  | Some(a) => let s = ctx->patSlot(a) in
    let restEntries = ctx->pctorEntries(ctor, args, i + 1) in
      s == ""
        ? restEntries
        : Array.prepend(keyedSlot(ctx->keyAt(ctor, i), s), restEntries)
}

let precordEntries = (ctx: GCtx, fields, i) => switch Array.get(i, fields) {
  | None => []
  | Some(f) => let s = ctx->patSlot(f.pat) in
    let restEntries = ctx->precordEntries(fields, i + 1) in
      s == "" ? restEntries : Array.prepend(keyedSlot(f.label, s), restEntries)
}

let patSlot = (ctx: GCtx, p) => switch p {
  | Ast.PAs(pat, name, _, _) => let inner = ctx->patSlot(pat) in
      inner == "" ? name : "${inner}, ${name}"
  | Ast.PBind(name, _) => name
  | Ast.PWild(_) => ""
  | Ast.PUnit(_) => ""
  | Ast.PLit(_, _, _) => ""
  | Ast.PBool(_, _) => ""
  | Ast.PStr(_, _) => ""
  | Ast.PList(_, _, _) => ""
  | Ast.PCtor(ctor, args, _, _) => let entries = ctx->pctorEntries(
      ctor,
      args,
      0
    ) in
      Array.length(entries) == 0 ? "" : "{ ${Str.join(", ", entries)} }"
  | Ast.PRecord(fields, _) => let entries = ctx->precordEntries(fields, 0) in
      Array.length(entries) == 0 ? "" : "{ ${Str.join(", ", entries)} }"
  | Ast.PTuple(elems, _) => let slots = elems |> map(el => ctx->patSlot(el)) in
      someOf(s => s != "", slots) ? "[${Str.join(", ", slots)}]" : ""
  | Ast.PArr(elems, rest, _) => let slots = elems
      |> map(el => ctx->patSlot(el)) in
    let slots2 = switch rest {
      | Some(Ast.PBind(name, _)) => Array.append("...${name}", slots)
      | _ => slots
    } in
      someOf(s => s != "", slots2) ? "[${Str.join(", ", slots2)}]" : ""
  | Ast.POr(alts, _) =>
    // The first alt's destructure serves the whole arm — every alt binds the
    // same names at the same positions (enforced by check.mochi).
    switch Array.head(alts) {
      | Some(first) => ctx->patSlot(first)
      | None => ""
    }
}

let pctorConds = (ctx: GCtx, ctor, args, i, path) => switch Array.get(i, args) {
  | None => []
  | Some(a) => Array.concat(
      ctx->patConds(a, "${path}.${ctx->keyAt(ctor, i)}"),
      ctx->pctorConds(ctor, args, i + 1, path)
    )
}
let precordConds = (ctx: GCtx, fields, i, path) => switch Array.get(i, fields) {
  | None => []
  | Some(f) => Array.concat(
      ctx->patConds(f.pat, "${path}.${f.label}"),
      ctx->precordConds(fields, i + 1, path)
    )
}
let ptupleConds = (ctx: GCtx, elems, i, path) => switch Array.get(i, elems) {
  | None => []
  | Some(el) => Array.concat(
      ctx->patConds(el, "${path}[${show(i)}]"),
      ctx->ptupleConds(elems, i + 1, path)
    )
}
let parrConds = (ctx: GCtx, elems, i, path) => switch Array.get(i, elems) {
  | None => []
  | Some(el) => Array.concat(
      ctx->patConds(el, "${path}[${show(i)}]"),
      ctx->parrConds(elems, i + 1, path)
    )
}

let patConds = (ctx: GCtx, p, path) => switch p {
  | Ast.PAs(pat, _, _, _) => ctx->patConds(pat, path)
  | Ast.PWild(_) => []
  | Ast.PUnit(_) =>
    // `PUnit` needs no test: `unit` has exactly one inhabitant, so the type alone decides.
    []
  | Ast.PBind(_, _) => []
  | Ast.PList(_, _, _) => []
  | Ast.PLit(_, _, _) => ["${path} === ${litValue(p)}"]
  | Ast.PBool(_, _) => ["${path} === ${litValue(p)}"]
  | Ast.PStr(_, _) => ["${path} === ${litValue(p)}"]
  | Ast.PCtor(ctor, args, _, _) => Array.prepend(
      "${path}._tag === ${jsStringLit(ctor)}",
      ctx->pctorConds(ctor, args, 0, path)
    )
  | Ast.PRecord(fields, _) => ctx->precordConds(fields, 0, path)
  | Ast.PTuple(elems, _) =>
    // No length guard — tuple arity is guaranteed by the type.
    ctx->ptupleConds(elems, 0, path)
  | Ast.PArr(elems, rest, _) => Array.prepend(
      "${path}.length ${Option.isSome(rest) ? ">=" : "==="} ${show(Array.length(elems))}",
      ctx->parrConds(elems, 0, path)
    )
  | Ast.POr(alts, _) =>
    // Each alt's own conds &&-join into one guard; the alts ||-join into one.
    let altCond = alt =>
      let conds = ctx->patConds(alt, path) in
        Array.length(conds) == 0
          ? "true"
          : Str.join(" && ", conds |> map(c => "(${c})")) in
      [Str.join(" || ", alts |> map(alt => "(${altCond(alt)})"))]
}

// The handler parameter for a catch-all pattern: bind the name, destructure a
// record's/tuple's binds, or ignore the value.
let catchAllParam = (ctx: GCtx, p) => switch p {
  | Ast.PArr(_, rest, _) =>
    // `[...all]` / `@{...all}` binds the whole collection to the rest name —
    // NOT a destructure: `[...all]` would copy the array and force a lazy List.
    switch rest { | Some(Ast.PBind(name, _)) => "(${name})" | _ => "()" }
  | Ast.PList(_, rest, _) => switch rest {
      | Some(Ast.PBind(name, _)) => "(${name})"
      | _ => "()"
    }
  | _ => let slot = ctx->patSlot(p) in slot == "" ? "()" : "(${slot})"
}

// A switch is a "lazy-List match" when it has a narrowing `@{}`/`@{h,...t}`
// arm (a lone `@{...all}` is a catch-all, not narrowing). check.ts guarantees
// such a switch is exactly the empty + single-head-cons pair, so it lowers directly.
let isListMatch = arms =>
  someOf(a => isPList(a.pattern) && !isCatchAll(a.pattern), arms)

// A lazy tail/rest: replay the still-buffered elements from index `from`,
// then drain whatever's left in the iterator. `_list` makes it re-iterable + lazy.
let listTail = from =>
  "_list(function* () { for (let _i = "
    ++ show(from)
    ++ "; _i < _b.length; _i++) yield _b[_i]; "
    ++ "if (!_done) { let _s; while (!(_s = _it.next()).done) yield _s.value; } })"

let listArmGuards = (ctx: GCtx, elems, i) => switch Array.get(i, elems) {
  | None => []
  | Some(el) => Array.concat(
      ctx->patConds(el, "_b[${show(i)}]"),
      ctx->listArmGuards(elems, i + 1)
    )
}
let listArmBinds = (ctx: GCtx, elems, i) => switch Array.get(i, elems) {
  | None => ([], [])
  | Some(el) => let (restParams, restArgs) = ctx->listArmBinds(elems, i + 1) in
    let slot = ctx->patSlot(el) in
      slot == ""
        ? (restParams, restArgs)
        : (
          Array.prepend(slot, restParams),
          Array.prepend("_b[${show(i)}]", restArgs)
        )
}

// One narrowing lazy-List arm -> an `if (cond) return call;`. A fixed arm
// `@{a, b}` must see n+1 pulls to prove length exactly n; a cons arm
// `@{h, ...t}` needs n pulls (length >= n) and binds its tail to a lazy List
// over the rest. Element sub-patterns guard/bind via the general compiler
// against the buffer (`_b[i]` is already pulled, nested tests force nothing extra).
let genListArm = (ctx: GCtx, p, body) => switch p {
  | Ast.PList(elems, rest, _) => let n = Array.length(elems) in
    let guards = ctx->listArmGuards(elems, 0) in
    let head = Option.isSome(rest)
      ? "_pull(${show(n)})"
      : "!_pull(${show(n + 1)}) && _b.length === ${show(n)}" in
    let cond = Str.join(" && ", Array.prepend(head, guards)) in
    let (params0, args0) = ctx->listArmBinds(elems, 0) in
    let (params, args) = switch rest {
      | Some(Ast.PBind(name, _)) => (
          Array.append(name, params0),
          Array.append(listTail(n), args0)
        )
      | _ => (params0, args0)
    } in
      "  if (${cond}) return ((${Str.join(", ", params)}) => ${ctx->genLambdaBody(body)})(${Str.join(", ", args)});"
  | _ => ""
}

let listMatchLoop = (ctx: GCtx, arms, i) => switch Array.get(i, arms) {
  | None => (
      [],
      "(() => { throw new Error(\"non-exhaustive lazy-list switch\"); })()"
    )
  | Some(a) => isPList(a.pattern) && !isCatchAll(a.pattern)
      ? let (restLines, fallback) = ctx->listMatchLoop(arms, i + 1) in
        (Array.prepend(ctx->genListArm(a.pattern, a.body), restLines), fallback)
      : isCatchAll(a.pattern)
      ? let restName = switch a.pattern {
        | Ast.PList(_, Some(Ast.PBind(name, _)), _) => Some(name)
        | _ => None
      } in
      let fallback = switch restName {
        | Some(name) => "((${name}) => ${ctx->genLambdaBody(a.body)})(${listTail(0)})"
        | None => ctx->genExpr(a.body)
      } in
        ([], fallback)
      : ctx->listMatchLoop(arms, i + 1)
}

// A lazy-List switch -> an IIFE that pulls just enough elements to decide
// each arm, buffering them so later arms can re-examine a prefix without
// re-forcing the iterator — @onrails/pattern isn't length-indexable.
// check.ts proved totality.
let genListMatch = (ctx: GCtx, scrutinee, arms) =>
  let (armLines, fallback) = ctx->listMatchLoop(arms, 0) in
    "((_it) => { const _b = []; let _done = false; "
      ++ "const _pull = (_n) => { while (_b.length < _n && !_done) { const _s = _it.next(); "
      ++ "if (_s.done) _done = true; else _b.push(_s.value); } return _b.length >= _n; };\n"
      ++ Str.join("\n", armLines)
      ++ "\n  return "
      ++ fallback
      ++ ";\n})("
      ++ ctx->genExpr(scrutinee)
      ++ "[Symbol.iterator]())"

let matchArmsLoop = (ctx: GCtx, arms, i, base) => switch Array.get(i, arms) {
  | None => ([], None)
  | Some(a) => let (restLines, restCatch) = ctx->matchArmsLoop(
      arms,
      i + 1,
      base
    ) in
      switch a.guard {
        | Some(g) =>
          // A guarded arm narrows regardless of its pattern (the guard can be
          // false), so it always takes guard form — even `_ when g`.
          (
            Array.prepend(
              "  ${ctx->genGuardArm(a.pattern, a.body, Some(g), base)}",
              restLines
            ),
            restCatch
          )
        | None => isCatchAll(a.pattern)
            ? (restLines, Some((a.pattern, a.body)))
            : (
              Array.prepend(
                "  ${ctx->genWithArm(a.pattern, a.body, base)}",
                restLines
              ),
              restCatch
            )
      }
}

/// Any eager-array arm? Decides the ADR 0038 close-out below.
let hasArrArm = arms =>
  someOf(
    a => switch a.pattern { | Ast.PArr(_, _, _) => true | _ => false },
    arms
  )

let genMatch = (ctx: GCtx, scrutinee, arms) =>
  isListMatch(arms)
    ? ctx->genListMatch(scrutinee, arms)
    :
      // The concrete type a guard-form arm's predicate narrows FROM; `None` in
      // JS mode or for a generic scrutinee, which leaves the bare guard form.
      let base = hook1(ctx.guardBaseType, scrutinee) in
      let (armLines, catchAll) = ctx->matchArmsLoop(arms, 0, base) in
      let tail = switch catchAll {
        | Some((p, body)) => "  .otherwise(${ctx->catchAllParam(p)} => ${ctx->genLambdaBody(body)})"
        | None => Option.isSome(ctx.guardBaseType) && hasArrArm(arms)
            ?
              // TS backend (ADR 0038): an eager-array match with no catch-all is
              // the `[]` + `[h, ...t]` length partition check.mochi proved total.
              // Its guard arms test `.length` — they do not narrow `A[]`
              // structurally, so `.exhaustive()` still sees `A[]` leftover and
              // types as `NonExhaustiveError<A[]>` (TS2322). Close with a
              // throwing `.otherwise` instead: its `never` return is assignable
              // to the declared type, and the branch is dead. JS mode keeps
              // `.exhaustive()` — emitted JS stays byte-identical.
              "  .otherwise(() => { throw new Error(\"non-exhaustive match\"); })"
            : "  .exhaustive()"
      } in
        Str.join(
          "\n",
          Array.concat(
            Array.prepend("match(${ctx->genExpr(scrutinee)})", armLines),
            [tail]
          )
        )

let litValue = p => switch p {
  | Ast.PStr(v, _) => jsStringLit(v)
  | Ast.PLit(_, raw, _) => raw
  | Ast.PBool(v, _) => v ? "true" : "false"
  | _ => ""
}

// ---- type-predicate targets (ADR 0031) -------------------------------------
//
// `@onrails/pattern`'s `Narrow` only refines a handler's input for an `x is U`
// guard, not a plain boolean one — so a nested-pattern handler would otherwise
// see the whole union. `patTarget` builds that `U`, narrowing `base` the same
// way the arm's structural tests do.

/// A field's refined type when its sub-pattern narrows it, else `None` — a
/// bind/wildcard/literal needs no narrowing and keeps its declared type.
let fieldRefine = (ctx: GCtx, p, fieldBase) => switch p {
  | Ast.PCtor(_, _, _, _) => Some(ctx->patTarget(p, fieldBase))
  | Ast.PRecord(_, _) => let t = ctx->patTarget(p, fieldBase) in
      t == fieldBase ? None : Some(t)
  | _ => None
}

let ctorRefines = (ctx: GCtx, args, keys, member, i) => switch Array.get(i, args) {
  | None => []
  | Some(a) => let rest = ctx->ctorRefines(args, keys, member, i + 1) in
    let key = Option.unwrapOr("_${show(i)}", Array.get(i, keys)) in
      switch ctx->fieldRefine(a, "${member}[${jsStringLit(key)}]") {
        | Some(sub) => Array.prepend("${jsStringLit(key)}: ${sub}", rest)
        | None => rest
      }
}

let recordRefines = (ctx: GCtx, fields, base, i) => switch Array.get(i, fields) {
  | None => []
  | Some(f) => let rest = ctx->recordRefines(fields, base, i + 1) in
      switch ctx->fieldRefine(f.pat, "${base}[${jsStringLit(f.label)}]") {
        | Some(sub) => Array.prepend("${jsStringLit(f.label)}: ${sub}", rest)
        | None => rest
      }
}

/// A tuple slot is indexed positionally, so each element has its own base.
let tupleSlotBase = (base, i) => "(${base})[${show(i)}]"

let tupleTargets = (ctx: GCtx, elems, base, i) => switch Array.get(i, elems) {
  | None => []
  | Some(el) => let slotBase = tupleSlotBase(base, i) in
      Array.prepend(
        Option.unwrapOr(slotBase, ctx->fieldRefine(el, slotBase)),
        ctx->tupleTargets(elems, base, i + 1)
      )
}

let tupleRefines = (ctx: GCtx, elems, base, i) => switch Array.get(i, elems) {
  | None => false
  | Some(el) => Option.isSome(
      ctx->fieldRefine(el, tupleSlotBase(base, i))
    ) || ctx->tupleRefines(elems, base, i + 1)
}

/// Array elements all share one element base (`T[number]`).
let arrTargets = (ctx: GCtx, elems, elemBase, i) => switch Array.get(i, elems) {
  | None => []
  | Some(el) => Array.prepend(
      Option.unwrapOr(elemBase, ctx->fieldRefine(el, elemBase)),
      ctx->arrTargets(elems, elemBase, i + 1)
    )
}

let arrRefines = (ctx: GCtx, elems, elemBase, i) => switch Array.get(i, elems) {
  | None => false
  | Some(el) => Option.isSome(
      ctx->fieldRefine(el, elemBase)
    ) || ctx->arrRefines(elems, elemBase, i + 1)
}

/// Refine `base` by everything the pattern structurally tests. An or-pattern
/// keeps the base — per-alternative narrowing would need a union target.
let patTarget = (ctx: GCtx, p, base) => switch p {
  | Ast.PAs(pat, _, _, _) => ctx->patTarget(pat, base)
  | Ast.PCtor(ctor, args, _, _) => let member = "Extract<${base}, { _tag: ${jsStringLit(ctor)} }>" in
    let keys = Option.unwrapOr([], Map.get(ctor, ctx.keys)) in
    let refines = ctx->ctorRefines(args, keys, member, 0) in
      Array.length(refines) == 0
        ? member
        : "${member} & { ${Str.join("; ", refines)} }"
  | Ast.PRecord(fields, _) => let refines = ctx->recordRefines(
      fields,
      base,
      0
    ) in
      Array.length(refines) == 0
        ? base
        : "${base} & { ${Str.join("; ", refines)} }"
  | Ast.PTuple(elems, _) => !(ctx->tupleRefines(elems, base, 0))
      ? base
      : "[${Str.join(", ", ctx->tupleTargets(elems, base, 0))}]"
  | Ast.PArr(elems, restOpt, _) => let elemBase = "(${base})[number]" in
      !(ctx->arrRefines(elems, elemBase, 0))
        ? base
        : let heads = Str.join(", ", ctx->arrTargets(elems, elemBase, 0)) in
          switch restOpt {
            | Some(_) => "[${heads}, ...${base}]"
            | None => "[${heads}]"
          }
  | _ => base
}

// General arm: predicate + destructuring handler, built by the pattern
// compiler. Handles arbitrary nesting (`Sm(Sm(n))`, `Ok((a, b))`, ctors
// inside tuples/arrays) and `when` guards. A guard runs after the
// structural tests (&&-short-circuit); the pattern's binds are rebound
// from `_v` by the same destructuring slot handler uses.
let genGuardArm = (ctx: GCtx, p, body, guardOpt, base) =>
  // TS mode tests a widened `_g` copy so the boolean body does not fight
  // `_v`'s narrowed type; JS mode tests `_v` directly.
  let root = Option.isSome(base) ? "_g" : "_v" in
  let conds0 = ctx->patConds(p, root) in
  let slot = switch p {
    | Ast.PAs(pat, _, _, _) => ctx->patSlot(pat)
    | _ => ctx->patSlot(p)
  } in
  let conds = switch guardOpt {
    | Some(g) => switch p {
        | Ast.PAs(_, name, _, _) => Array.append(
            slot == ""
              ? "((${name}) => ${ctx->genExpr(g)})(${root})"
              : "((${name}) => ((${slot}) => ${ctx->genExpr(g)})(${name}))(${root})",
            conds0
          )
        | _ => Array.append(
            slot == ""
              ? "(${ctx->genExpr(g)})"
              : "((${slot}) => ${ctx->genExpr(g)})(${root})",
            conds0
          )
      }
    | None => conds0
  } in
  let test = Array.length(conds) == 0 ? "true" : Str.join(" && ", conds) in
  let handler = switch p {
    | Ast.PAs(_, name, _, _) => "(${name}) => ${slot == "" ? ctx->genLambdaBody(body) : "((${slot}) => ${ctx->genLambdaBody(body)})(${name})"}"
    | _ => "${slot == "" ? "()" : "(${slot})"} => ${ctx->genLambdaBody(body)}"
  } in
    // Emit a type predicate ONLY when it actually refines (target /= base): a
    // whole-value pattern with no field narrowing (`[]`, `_ when g`) gains
    // nothing from `_v is base`, and would trip TS2677 when `base` is a
    // row-polymorphic `{…} & R` param — the closed `base` string is not
    // assignable to the open param type. The plain boolean guard leaves `_v` at
    // its declared (open) type (ADR 0031 / 0034).
    switch base {
      | None => ".with((_v) => ${test}, ${handler})"
      | Some(b) => let target = ctx->patTarget(p, b) in
          target == b
            ? ".with((_v) => { const _g: any = _v; return ${test}; }, ${handler})"
            : ".with((_v): _v is ${target} => { const _g: any = _v; return ${test}; }, ${handler})"
    }

// Sub-pattern flat matcher-object form can express: bind, wildcard, or a
// primitive literal (the matcher compares values with `!==`, so only
// primitives are meaningful there). Anything deeper routes to guard form.
let isFlatSub = p => switch p {
  | Ast.PAs(_, _, _, _) => false
  | Ast.PBind(_, _) => true
  | Ast.PWild(_) => true
  | Ast.PLit(_, _, _) => true
  | Ast.PBool(_, _) => true
  | Ast.PStr(_, _) => true
  | _ => false
}

let recordLits = (fields, i) => switch Array.get(i, fields) {
  | None => []
  | Some(f) => let rest = recordLits(fields, i + 1) in
      switch f.pat {
        | Ast.PLit(_, _, _) => Array.prepend(
            "${f.label}: ${litValue(f.pat)}",
            rest
          )
        | Ast.PBool(_, _) => Array.prepend(
            "${f.label}: ${litValue(f.pat)}",
            rest
          )
        | Ast.PStr(_, _) => Array.prepend(
            "${f.label}: ${litValue(f.pat)}",
            rest
          )
        | _ => rest
      }
}

let ctorArgParts = (ctx: GCtx, ctor, args, i) => switch Array.get(i, args) {
  | None => ([], [])
  | Some(a) => let (restBinds, restLits) = ctx->ctorArgParts(
      ctor,
      args,
      i + 1
    ) in
    let key = ctx->keyAt(ctor, i) in
      switch a {
        | Ast.PBind(name, _) => (
            Array.prepend(keyedSlot(key, name), restBinds),
            restLits
          )
        | Ast.PLit(_, _, _) => (
            restBinds,
            Array.prepend("${key}: ${litValue(a)}", restLits)
          )
        | Ast.PBool(_, _) => (
            restBinds,
            Array.prepend("${key}: ${litValue(a)}", restLits)
          )
        | Ast.PStr(_, _) => (
            restBinds,
            Array.prepend("${key}: ${litValue(a)}", restLits)
          )
        | _ => (restBinds, restLits)
      }
}

let genWithArm = (ctx: GCtx, p, body, base) => switch p {
  | Ast.PAs(_, _, _, _) => ctx->genGuardArm(p, body, None, base)
  | Ast.PArr(_, _, _) =>
    // Array/tuple/or arms always take guard form (not matcher-object-able).
    ctx->genGuardArm(p, body, None, base)
  | Ast.PTuple(_, _) => ctx->genGuardArm(p, body, None, base)
  | Ast.POr(_, _) => ctx->genGuardArm(p, body, None, base)
  | Ast.PLit(_, _, _) => ".with(${litValue(p)}, () => ${ctx->genLambdaBody(body)})"
  | Ast.PBool(_, _) => ".with(${litValue(p)}, () => ${ctx->genLambdaBody(body)})"
  | Ast.PStr(_, _) => ".with(${litValue(p)}, () => ${ctx->genLambdaBody(body)})"
  | Ast.PRecord(fields, _) => allOf(f => isFlatSub(f.pat), fields)
      ? let lits = recordLits(fields, 0) in
      let slot = ctx->patSlot(p) in
        ".with({ ${Str.join(", ", lits)} }, ${slot == "" ? "()" : "(${slot})"} => ${ctx->genLambdaBody(body)})"
      : ctx->genGuardArm(p, body, None, base)
  | Ast.PCtor(ctor, args, _, _) =>
    // pctor flat fast path keeps readable matcher-object form.
    allOf(isFlatSub, args)
      ? let (binds, litFields) = ctx->ctorArgParts(ctor, args, 0) in
      let patObj = Str.join(
        ", ",
        Array.prepend("_tag: ${jsStringLit(ctor)}", litFields)
      ) in
      let param = Array.length(binds) == 0
        ? "()"
        : "({ ${Str.join(", ", binds)} })" in
        ".with({ ${patObj} }, ${param} => ${ctx->genLambdaBody(body)})"
      : ctx->genGuardArm(p, body, None, base)
  | _ => ctx->genGuardArm(p, body, None, base)
}

// ---- statements -------------------------------------------------------------

// A variant decl has no runtime type in JS — it lowers to constructor
// factories only. Nullary -> a tagged value; n-ary -> a tagging function.
// The discriminant key is `_tag`, matching the @onrails ecosystem
// convention (@onrails/result, @onrails/maybe), so type guards (isOk/isSome/…)
// recognize mochi values at the JS boundary.
/// `k0: T0, k1: T1` — a typed factory's parameter list.
let typedCtorParams = (keys, paramTypes, i) => switch Array.get(i, keys) {
  | None => []
  | Some(k) => Array.prepend(
      "${k}: ${Option.unwrapOr("unknown", Array.get(i, paramTypes))}",
      typedCtorParams(keys, paramTypes, i + 1)
    )
}

let genCtor = (c, ts) =>
  let tag = jsStringLit(c.name) in
    Array.length(c.fields) == 0
      ? switch ts {
        | Some(t) =>
          // Annotate the nullary const so `_tag` stays the literal (`"Leaf"`)
          // instead of widening to `string` — else it will not match the union.
          "const ${c.name}: ${t.retMono} = { _tag: ${tag} };"
        | None => "const ${c.name} = { _tag: ${tag} };"
      }
      : let keys = keysOf(c.fields) in
      let params = Str.join(", ", keys) in
      let impl = "(${params}) => ({ _tag: ${tag}, ${params} })" in
        Array.length(c.fields) >= 2
          ?
            // Multi-field: curried so partial application works (CRITIQUE
            // §4.4). The typed form casts `_curry`'s `any` to the public
            // signature — the impl's params stay `any`, so no generic-scope
            // gymnastics.
            let curried = "_curry(${show(Array.length(c.fields))}, ${impl})" in
              switch ts {
                | Some(t) => "const ${c.name} = ${curried} as ${t.generics}(${Str.join(", ", typedCtorParams(keys, t.paramTypes, 0))}) => ${t.ret};"
                | None => "const ${c.name} = ${curried};"
              }
          :
            // Single-field: a typed arrow scopes its own generics.
            switch ts {
              | Some(t) => "const ${c.name} = ${t.generics}(${Str.join(", ", typedCtorParams(keys, t.paramTypes, 0))}): ${t.ret} => ({ _tag: ${tag}, ${params} });"
              | None => "const ${c.name} = ${impl};"
            }

let genCtorsFrom = (s, ctors, h, refs, exported, i) => switch Array.get(i, ctors) {
  | None => []
  | Some(c) => let rest = genCtorsFrom(s, ctors, h, refs, exported, i + 1) in
      // Exported variants are a public runtime API — emit every factory.
      // Locals: a pattern `| TLet =>` only matches `_tag`, so skip the const
      // unless the ctor is referenced as a value (`tok == TGt`, `jxExpectTok(TEof)`).
      exported || Set.has(c.name, refs)
        ? Array.prepend(genCtor(c, hook2(h, s, c)), rest)
        : rest
}

let genType = (ctx: GCtx, s) => switch s {
  | Ast.SType(_, _, ctors, _, _, exported, _, _) => Str.join(
      "\n",
      genCtorsFrom(s, ctors, ctx.annotateCtor, ctx.valueRefs, exported, 0)
    )
  | _ => ""
}

/// Top-level arrow spine length (`a -> b -> c` → 2).
let typeExprArity = te => switch te {
  | Ast.TyArrow(_, to, _) => 1 + typeExprArity(to)
  | _ => 0
}

/// `$a0, $a1, …` — must stay byte-for-byte aligned with TS codegen.
let externArgs = n =>
  loop (i = 0, acc = "") {
    i >= n
      ? acc
      : recur(i + 1, acc == "" ? "$a${show(i)}" : "${acc}, $a${show(i)}")
  }

/// `($a0)($a1)…` — one argument per call, for a `curried` host (ADR 0064).
let externApplied = n =>
  loop (i = 0, acc = "") { i >= n ? acc : recur(i + 1, "${acc}($a${show(i)})") }

/// extern → ESM import. Arity ≥ 2 wraps the host in `_curry` (ADR 0005 / #24).
/// `imported == "default"` emits a default import (ADR 0009 / styled-cva).
let genExtern = s => switch s {
  | Ast.SExtern(name, _, _, typeExpr, modName, imported, curried, _, _, _) => Str.startsWith(
      "mochi:global:",
      modName
    )
      ? let target = Str.slice(13, Str.length(modName), modName) in
      let base = "globalThis[${jsStringLit(target)}]" in
        "const ${name} = ${imported == "" ? base : "${base}[${jsStringLit(imported)}]"};"
      : Str.startsWith("mochi:get:", modName)
      ? let target = Str.slice(10, Str.length(modName), modName) in
        "const ${name} = ($receiver) => $receiver[${jsStringLit(target)}];"
      : Str.startsWith("mochi:set:", modName)
      ? let target = Str.slice(10, Str.length(modName), modName) in
        "const ${name} = _curry(2, ($receiver, $value) => ($receiver[${jsStringLit(target)}] = $value));"
      : Str.startsWith("mochi:new:", modName)
      ? let target = Str.slice(10, Str.length(modName), modName) in
      let arity = typeExprArity(typeExpr) in
      let args = externArgs(arity) in
        imported != ""
          ? let raw = Str.concat("$", name) in
          let importLine = "import { ${imported} as ${raw} } from ${jsStringLit(target)};" in
          let ctor = "new ${raw}(${args})" in
            arity == 0
              ? "${importLine}\nconst ${name} = () => ${ctor};"
              : "${importLine}\nconst ${name} = _curry(${show(arity)}, (${args}) => ${ctor});"
          : arity == 0
          ? "const ${name} = () => new globalThis[${jsStringLit(target)}]();"
          : "const ${name} = _curry(${show(arity)}, (${args}) => new globalThis[${jsStringLit(target)}](${args}));"
      : Str.startsWith("mochi:send:", modName)
      ? let target = Str.slice(11, Str.length(modName), modName) in
      let arity = typeExprArity(typeExpr) in
      let args = externArgs(arity - 1) in
      let fn = args == ""
        ? "($receiver) => $receiver[${jsStringLit(target)}]()"
        : "($receiver, ${args}) => $receiver[${jsStringLit(target)}](${args})" in
        arity < 2
          ? "const ${name} = ${fn};"
          : "const ${name} = _curry(${show(arity)}, ${fn});"
      : imported == "default"
      ? "import ${name} from ${jsStringLit(modName)};"
      : let arity = typeExprArity(typeExpr) in
        arity <= 1
          ? let spec = imported == name ? name : "${imported} as ${name}" in
            "import { ${spec} } from ${jsStringLit(modName)};"
          : let raw = Str.concat("$", name) in
          // A `curried` host is already `a => b => c` (ADR 0064), so the flat impl
          // mochi curries must apply it one argument at a time.
          let flat = curried
            ? "(${externArgs(arity)}) => ${raw}${externApplied(arity)}"
            : raw in
            "import { ${imported} as ${raw} } from ${jsStringLit(modName)};\nconst ${name} = _curry(${show(arity)}, ${flat});"
  | _ => ""
}

let stripAlExt = s =>
  Str.endsWith(".mochi", s) ? Str.slice(0, Str.length(s) - 6, s) : s

/// Relative `./` / `../` get `ext` (`.js` for the JS backend, `""` for TS —
/// tsc resolves the extensionless sibling); bare package specs keep their
/// name, since a suffix would break package `exports` (ADR 0015).
let rewriteImportPath = (from, ext) =>
  let bare = stripAlExt(from) in
    Str.startsWith("./", bare) || Str.startsWith("../", bare)
      ? "${bare}${ext}"
      : bare

// import { a, b } from "./mod"  ->  compiled sibling `./mod.js`. Source paths
// name an `.mochi` module (with or without extension); output targets `.js`.
// Bare package specs keep their name (ADR 0015).
// import * as Alias from "./mod" -> ESM namespace import (ADR 0002).
let genImport = (s, ext) => switch s {
  | Ast.SImport(names, from, _) => let nameList = Str.join(
      ", ",
      names |> map(n => n.name)
    ) in
    let path = rewriteImportPath(from, ext) in
      "import { ${nameList} } from ${jsStringLit(path)};"
  | Ast.SImportNs(alias, from, _) => let path = rewriteImportPath(from, ext) in
      "import * as ${alias.name} from ${jsStringLit(path)};"
  | _ => ""
}

let exportLine = l => "export ${l}"

let jsDocLine = l =>
  Str.length(l) > 0 ? " * ${Str.replace("*/", "*\\/", l)}" : " *"

export let jsDoc = docOpt => switch docOpt {
  | None => ""
  | Some(doc) => let lines = Str.split("\n", doc) |> map(jsDocLine) in
      "/**\n${Str.join("\n", lines)}\n */\n"
}

let genStmt = (ctx: GCtx, s) => switch s {
  | Ast.SError(sp) =>
    // Unreachable by construction: the railway stops on parse diagnostics, so a
    // Program reaching codegen has no error nodes (ADR 0045 decision 6). Codegen is
    // pure here (no throw), so the invariant is emitted as a loud runtime throw
    // rather than a placeholder — silently-wrong output is worse than a bug report.
    "throw new Error(\"codegen invariant: error node reached codegen at ${show(sp.start)}\");"
  | Ast.SImport(_, _, _) => genImport(s, ctx.moduleExt)
  | Ast.SImportNs(_, _, _) => genImport(s, ctx.moduleExt)
  | Ast.SType(_, _, _, _, _, exported, _, _) => let decls = genType(ctx, s) in
      decls == ""
        ? "" // record alias, or every ctor is pattern-only
        : exported
        ? Str.join("\n", Str.split("\n", decls) |> map(exportLine))
        : decls
  | Ast.SExtern(name, _, _, _, _, _, _, exported, doc, _) =>
    // An extern is itself an import; re-export the local binding when exported.
    let docComment = ctx.docs ? jsDoc(doc) : "" in
      exported
        ? "${docComment}${genExtern(s)}\nexport { ${name} };"
        : "${docComment}${genExtern(s)}"
  | Ast.SLet(name, _, _, value, exported, doc, _) => let doExport = exported && !Str.startsWith(
      "$",
      name
    ) in // never export destructure temps
    let docComment = ctx.docs && !Str.startsWith("$", name) ? jsDoc(doc) : "" in
      // TS backend annotates; the JS backend leaves the binding bare.
      "${docComment}${doExport ? "export " : ""}const ${name}${Option.unwrapOr("", hook2(ctx.annotateLet, name, value))} = ${ctx->genExpr(value)};"
  | Ast.SExpr(value, _) => "${ctx->genExpr(value)};"
}

// Need `@onrails/pattern` import? Only if a match lowers to a `match()`
// chain. A lazy-List switch lowers to a plain IIFE instead, so a program that
// only ever destructures Lists imports nothing.
let usesMatchLibArm = a =>
  switch a.guard {
    | Some(g) => usesMatchLib(g)
    | None => false
  } || usesMatchLib(a.body)

let usesMatchLib = e => switch e {
  | Ast.ENum(_, _, _) => false
  | Ast.EUnit(_) => false
  | Ast.EBool(_, _) => false
  | Ast.EStr(_, _) => false
  | Ast.ERef(_, _) => false
  | Ast.ECall(fn, args, _, _) => usesMatchLib(fn) || someOf(usesMatchLib, args)
  | Ast.ELambda(_, body, _) => usesMatchLib(body)
  | Ast.ELetIn(_, _, _, value, body, _) => usesMatchLib(
      value
    ) || usesMatchLib(body)
  | Ast.ELetBind(_, _, _, value, body, _) => usesMatchLib(
      value
    ) || usesMatchLib(body)
  | Ast.EPipe(left, right, _, _) => usesMatchLib(left) || usesMatchLib(right)
  | Ast.EDo(exprs, _) => someOf(usesMatchLib, exprs)
  | Ast.ETernary(cond, thenE, elseE, _) => usesMatchLib(
      cond
    ) || (usesMatchLib(thenE) || usesMatchLib(elseE))
  | Ast.EMatch(scrutinee, arms, _) => !isListMatch(
      arms
    ) || (usesMatchLib(scrutinee) || someOf(usesMatchLibArm, arms))
  | Ast.ELoop(params, body, _) => someOf(
      p => usesMatchLib(p.init),
      params
    ) || usesMatchLib(body)
  | Ast.ERecur(args, _) => someOf(usesMatchLib, args)
  | Ast.ERecord(fields, spread, _) => switch spread {
      | Some(s) => usesMatchLib(s)
      | None => false
    } || someOf(f => usesMatchLib(f.value), fields)
  | Ast.EField(target, _, _, _) => usesMatchLib(target)
  | Ast.ETuple(elements, _) => someOf(usesMatchLib, elements)
  | Ast.EArr(elements, _) => someOf(
      el =>
        usesMatchLib(switch el { | Ast.SEExpr(e) => e | Ast.SESpread(e) => e }),
      elements
    )
  | Ast.EList(elements, _) => someOf(
      el =>
        usesMatchLib(switch el { | Ast.SEExpr(e) => e | Ast.SESpread(e) => e }),
      elements
    )
  | Ast.ESet(elements, _) => someOf(
      el =>
        usesMatchLib(switch el { | Ast.SEExpr(e) => e | Ast.SESpread(e) => e }),
      elements
    )
  | Ast.EMap(entries, _) => someOf(
      en => usesMatchLib(en.key) || usesMatchLib(en.value),
      entries
    )
  | Ast.EInterp(parts, _) => someOf(
      p => switch p {
        | Ast.IPLit(_) => false
        | Ast.IPExpr(ex) => usesMatchLib(ex)
      },
      parts
    )
}

// A name referenced anywhere in an expression. Coarse — counts locally
// shadowed uses too, but only ever consulted against prelude names, never
// worth shadowing, so the over-count is harmless.
let loopInitRefsFrom = (ctx: GCtx, params, i, acc) => switch Array.get(i, params) {
  | None => acc
  | Some(p) => ctx->loopInitRefsFrom(params, i + 1, ctx->exprRefs(p.init, acc))
}

let exprRefsListFrom = (ctx: GCtx, xs, i, acc) => switch Array.get(i, xs) {
  | None => acc
  | Some(x) => ctx->exprRefsListFrom(xs, i + 1, ctx->exprRefs(x, acc))
}
let exprRefsInterpPartsFrom = (ctx: GCtx, parts, i, acc) => switch Array.get(i, parts) {
  | None => acc
  | Some(p) => ctx->exprRefsInterpPartsFrom(
      parts,
      i + 1,
      switch p {
        | Ast.IPLit(_) => acc
        | Ast.IPExpr(ex) => ctx->exprRefs(ex, acc)
      }
    )
}
let exprRefsArmsFrom = (ctx: GCtx, arms, i, acc) => switch Array.get(i, arms) {
  | None => acc
  | Some(a) => let acc1 = switch a.guard {
      | Some(g) => ctx->exprRefs(g, acc)
      | None => acc
    } in
      ctx->exprRefsArmsFrom(arms, i + 1, ctx->exprRefs(a.body, acc1))
}
let exprRefsFieldsFrom = (ctx: GCtx, fields, i, acc) => switch Array.get(i, fields) {
  | None => acc
  | Some(f) => ctx->exprRefsFieldsFrom(
      fields,
      i + 1,
      ctx->exprRefs(f.value, acc)
    )
}
let exprRefsEntriesFrom = (ctx: GCtx, entries, i, acc) => switch Array.get(i, entries) {
  | None => acc
  | Some(en) => ctx->exprRefsEntriesFrom(
      entries,
      i + 1,
      ctx->exprRefs(en.value, ctx->exprRefs(en.key, acc))
    )
}

let exprRefs = (ctx: GCtx, e, acc) => switch e {
  | Ast.ENum(_, _, _) => acc
  | Ast.EUnit(_) => acc
  | Ast.EBool(_, _) => acc
  | Ast.EStr(_, _) => acc
  | Ast.ERef(name, _) => Set.add(name, acc)
  | Ast.ECall(fn, args, _, _) => ctx->exprRefsListFrom(
      args,
      0,
      ctx->exprRefs(fn, acc)
    )
  | Ast.ELambda(params, body, _) => let (cparams, cbody, fills) = collapseLambda(
      params,
      body
    ) in
    let acc2 = Array.length(cparams) >= 2
      ? Set.add("_curry", acc)
      : acc in // arity >= 2 lowers `_curry(...)`
    // A labeled default is emitted inside the body, so its refs count too.
    let acc3 = Array.reduce(
      (a, g) =>
        Array.reduce(
          (b, lab) => switch lab {
            | Ast.LPSpanned(Ast.LPLabeled(_, _, _, Some(d)), _) => ctx->exprRefs(
                d,
                b
              )
            | Ast.LPLabeled(_, _, _, Some(d)) => ctx->exprRefs(d, b)
            | _ => b
          },
          a,
          g.labs
        ),
      acc2,
      fills
    ) in
      ctx->exprRefs(cbody, acc3)
  | Ast.ELetIn(_, _, _, value, body, _) => ctx->exprRefs(
      body,
      ctx->exprRefs(value, acc)
    )
  | Ast.ELetBind(_, _, monad, value, body, _) => ctx->exprRefs(
      body,
      ctx->exprRefs(value, Set.add(bindRuntime(monad), acc))
    )
  | Ast.EPipe(left, right, _, _) => ctx->exprRefs(
      right,
      ctx->exprRefs(left, acc)
    )
  | Ast.EDo(exprs, _) => ctx->exprRefsListFrom(exprs, 0, acc)
  | Ast.ETernary(cond, thenE, elseE, _) => ctx->exprRefs(
      elseE,
      ctx->exprRefs(thenE, ctx->exprRefs(cond, acc))
    )
  | Ast.EMatch(scrutinee, arms, _) => let acc1 = ctx->exprRefs(
      scrutinee,
      acc
    ) in
    let acc2 = someOf(
      a => switch a.pattern {
        | Ast.PList(_, Some(Ast.PBind(_, _)), _) => true
        | _ => false
      },
      arms
    )
      ? Set.add("_list", acc1)
      : acc1 in
      ctx->exprRefsArmsFrom(arms, 0, acc2)
  | Ast.ERecord(fields, spread, _) => ctx->exprRefsFieldsFrom(
      fields,
      0,
      switch spread { | Some(s) => ctx->exprRefs(s, acc) | None => acc }
    )
  | Ast.EField(target, name, _, _) => switch emptyNsEmit(target, name, None) {
      | Some(_) => switch target {
          | Ast.ERef("List", _) => Set.add("_list", acc)
          | _ => acc
        }
      | None => switch ctx->nsRuntimeId(target, name) {
          | Some(rt) => Set.add(
              rt,
              acc
            ) // its runtime deps get pulled in by preludePreamble's closure
          | None => ctx->exprRefs(target, acc)
        }
    }
  | Ast.ELoop(params, body, _) =>
    // A switch in tail position with a recur lowers via the step protocol.
    let acc1 = loopNeedsStep(body)
      ? Set.add("_recur", Set.add("_done", acc))
      : acc in
    let acc2 = ctx->loopInitRefsFrom(params, 0, acc1) in
      ctx->exprRefs(body, acc2)
  | Ast.ERecur(args, _) => ctx->exprRefsListFrom(args, 0, acc)
  | Ast.ETuple(elements, _) => ctx->exprRefsListFrom(elements, 0, acc)
  | Ast.EArr(elements, _) => ctx->exprRefsListFrom(
      elements
        |> map(el => switch el { | Ast.SEExpr(e) => e | Ast.SESpread(e) => e }),
      0,
      acc
    )
  | Ast.EList(elements, _) => ctx->exprRefsListFrom(
      elements
        |> map(el => switch el { | Ast.SEExpr(e) => e | Ast.SESpread(e) => e }),
      0,
      Set.add("_list", acc)
    ) // `@{...}` literal calls List core runtime
  | Ast.ESet(elements, _) => ctx->exprRefsListFrom(
      elements
        |> map(el => switch el { | Ast.SEExpr(e) => e | Ast.SESpread(e) => e }),
      0,
      acc
    )
  | Ast.EMap(entries, _) => ctx->exprRefsEntriesFrom(entries, 0, acc)
  | Ast.EInterp(parts, _) => ctx->exprRefsInterpPartsFrom(parts, 0, acc)
}

// Names a module binds at top scope — anything here would shadow a
// prelude builtin, so its runtime def must NOT be inlined (else a duplicate
// `const` is a JS SyntaxError, e.g. a user `let hypot = …`).
let boundNamesFrom = (stmts, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(s) => boundNamesFrom(
      stmts,
      i + 1,
      switch s {
        | Ast.SLet(name, _, _, _, _, _, _) => Set.add(name, acc)
        | Ast.SExtern(name, _, _, _, _, _, _, _, _, _) => Set.add(name, acc)
        | Ast.SType(_, _, ctors, _, _, _, _, _) => Set.union(
            acc,
            Set.fromArray(ctors |> map(c => c.name))
          )
        | Ast.SImport(names, _, _) => Set.union(
            acc,
            Set.fromArray(names |> map(n => n.name))
          )
        | Ast.SImportNs(alias, _, _) => Set.add(alias.name, acc)
        | Ast.SError(_) =>
          // An unparsable region binds nothing (ADR 0045).
          acc
        | Ast.SExpr(_, _) => acc
      }
    )
}
let boundNames = stmts => boundNamesFrom(stmts, 0, Set.fromArray([]))

/// Names referenced in let/expr values — not patterns. `| TLet =>` does not
/// count, so a local unused ctor factory can be dropped.
let collectValueRefs = (ctx: GCtx, stmts, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(s) => ctx->collectValueRefs(
      stmts,
      i + 1,
      switch s {
        | Ast.SLet(_, _, _, value, _, _, _) => ctx->exprRefs(value, acc)
        | Ast.SExpr(value, _) => ctx->exprRefs(value, acc)
        | _ => acc
      }
    )
}

let refsForStmt = (ctx: GCtx, s) => switch s {
  | Ast.SLet(_, _, _, value, _, _, _) => ctx->exprRefs(value, Set.fromArray([]))
  | Ast.SExpr(value, _) => ctx->exprRefs(value, Set.fromArray([]))
  | Ast.SType(_, _, ctors, _, _, exported, _, _) =>
    // A multi-field constructor lowers to `_curry(...)` in genType (which
    // exprRefs never walks), so seed the dep here — but only for factories
    // that will actually be emitted (exported, or used as a value).
    someOf(
      c =>
        Array.length(
          c.fields
        ) >= 2 && (exported || Set.has(c.name, ctx.valueRefs)),
      ctors
    )
      ? Set.add("_curry", Set.fromArray([]))
      : Set.fromArray([])
  | Ast.SExtern(_, _, _, typeExpr, _, _, _, _, _, _) =>
    // Multi-arg externs wrap the host import in `_curry` (genExtern).
    typeExprArity(typeExpr) >= 2
      ? Set.add("_curry", Set.fromArray([]))
      : Set.fromArray([])
  | _ => Set.fromArray([])
}
let collectRefsFrom = (ctx: GCtx, stmts, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(s) => ctx->collectRefsFrom(
      stmts,
      i + 1,
      Set.union(acc, ctx->refsForStmt(s))
    )
}

// Transitively pull in each referenced def's runtime deps (`range` -> `_list`,
// `_Map_get` -> Some/None, …). A forward cursor over a push-only worklist
// drains the growing frontier without an in-place `.pop()`.
let addDepsFrom = (deps, j, refs, queue) => switch Array.get(j, deps) {
  | None => (refs, queue)
  | Some(d) => Set.has(d, refs)
      ? addDepsFrom(deps, j + 1, refs, queue)
      : addDepsFrom(deps, j + 1, Set.add(d, refs), Array.append(d, queue))
}
let closeRefsFrom = (queue, i, refs, runtimeDeps) => switch Array.get(i, queue) {
  | None => refs
  | Some(r) => let deps = Option.unwrapOr([], Map.get(r, runtimeDeps)) in
    let (refs2, queue2) = addDepsFrom(deps, 0, refs, queue) in
      closeRefsFrom(queue2, i + 1, refs2, runtimeDeps)
}

// The prelude runtime a program needs inlined: every builtin it references
// and does not itself define, emitted in prelude declaration order for determinism.
/// The runtime helper names a program actually references, transitively closed
/// over `runtimeDeps` and minus anything the program binds itself. The JS
/// backend inlines their defs (`preludePreamble`); the TS backend imports them
/// from the typed runtime instead (ADR 0026 / 0075), so both start here.
let runtimeRefNames = (ctx: GCtx, stmts, jsDefs, runtimeDeps) =>
  let refs0 = ctx->collectRefsFrom(stmts, 0, Set.fromArray([])) in
  let refs = closeRefsFrom(Set.toArray(refs0), 0, refs0, runtimeDeps) in
  let bound = boundNames(stmts) in
    Map.keys(jsDefs) |> filter(n => Set.has(n, refs) && !Set.has(n, bound))

let preludePreamble = (ctx: GCtx, stmts, jsDefs, runtimeDeps) =>
  let names = ctx->runtimeRefNames(stmts, jsDefs, runtimeDeps) in
  let defs = names |> map(n => Map.getOr("", n, jsDefs)) in
    Array.length(defs) == 0 ? "" : "${Str.join("\n", defs)}\n\n"

// ---- top-level entry --------------------------------------------------------

let genStmtAllFrom = (ctx: GCtx, stmts, i) => switch Array.get(i, stmts) {
  | None => []
  | Some(s) => Array.prepend(ctx->genStmt(s), ctx->genStmtAllFrom(stmts, i + 1))
}

/// `useRuntime`: inline the prelude builtins the program uses, so the emitted
/// module runs standalone. `ns`/`jsDefs`/`runtimeDeps` are the TS prelude's
/// `namespaceRuntime`/`preludeJsDefs`/`runtimeDeps` tables, converted to
/// mochi Maps — the same tables the TS codegen consults, not a fork of them.
/// Emit one program under explicit backend options. The JS backend calls
/// `codegen` (all hooks `None`); the TS backend supplies annotation hooks and
/// the `flattenPipe` / `tupleHelper` / `moduleExt` switches (ADR 0026 / 0090).
export let codegenWith = (stmts, imported, useRuntime, ns, jsDefs, runtimeDeps, opts) =>
  let keys0 = ctorKeysFromStmts(stmts, imported) in
  let keys = seedBuiltinCtorKeys(stmts, keys0) in
  let ctx0 = {
    keys,
    ns,
    annotateLet: opts.annotateLet,
    annotateCtor: opts.annotateCtor,
    annotateParams: opts.annotateParams,
    annotateEmpty: opts.annotateEmpty,
    annotateLetin: opts.annotateLetin,
    annotateCall: opts.annotateCall,
    guardBaseType: opts.guardBaseType,
    flattenPipe: opts.flattenPipe,
    tupleHelper: opts.tupleHelper,
    preserveInfix: opts.preserveInfix,
    preserveJsx: opts.preserveJsx,
    moduleExt: opts.moduleExt,
    valueRefs: Set.fromArray([]),
    docs: opts.docs
  } in
  let valueRefs = collectValueRefs(ctx0, stmts, 0, Set.fromArray([])) in
  let ctx = { ...ctx0, valueRefs } in
  let needsMatch = someOf(
    s => switch s {
      | Ast.SLet(_, _, _, value, _, _, _) => usesMatchLib(value)
      | Ast.SExpr(value, _) => usesMatchLib(value)
      | _ => false
    },
    stmts
  ) in
  let header = needsMatch
    ? "import { match } from \"@onrails/pattern\";\n\n"
    : "" in
  let preamble = useRuntime
    ? ctx->preludePreamble(stmts, jsDefs, runtimeDeps)
    : "" in
  let body = Str.join("\n", ctx->genStmtAllFrom(stmts, 0)) in
    "${header}${preamble}${body}\n"

/// The runtime helpers a program references, for the TS backend's
/// `import { … } from "@mochi/runtime"` line. Builds the same ctx `codegenWith`
/// does, so the two agree on ctor keys and namespace ids.
export let runtimeDepNames = (stmts, imported, ns, jsDefs, runtimeDeps) =>
  let keys = stmts->seedBuiltinCtorKeys(ctorKeysFromStmts(stmts, imported)) in
  let ctx0 = {
    keys,
    ns,
    annotateLet: None,
    annotateCtor: None,
    annotateParams: None,
    annotateEmpty: None,
    annotateLetin: None,
    annotateCall: None,
    guardBaseType: None,
    flattenPipe: false,
    tupleHelper: false,
    preserveInfix: false,
    preserveJsx: false,
    moduleExt: ".js",
    valueRefs: Set.fromArray([]),
    docs: false
  } in
  let valueRefs = collectValueRefs(ctx0, stmts, 0, Set.fromArray([])) in
    runtimeRefNames({ ...ctx0, valueRefs }, stmts, jsDefs, runtimeDeps)

/// The JS backend: no annotations, `.js` siblings — byte-identical to the
/// output before `codegenWith` existed.
export let codegen = (stmts, imported, useRuntime, ns, jsDefs, runtimeDeps) =>
  stmts->codegenWith(imported, useRuntime, ns, jsDefs, runtimeDeps, jsGenOpts)

// Ticket 0013 (part a) — module-graph loader. Resolve the import graph of `.mochi`
// files reachable from an entry, depth-first, and yield the modules in
// DEPENDENCY ORDER (a module lands after everything it imports), detecting
// import cycles. Sync throughout: the host IO returns `Result` directly (ticket
// 0001), so there is no ResultAsync here — unlike `src/module.ts`, whose async
// file reads force its loader half into a ResultAsync.
//
// Cross-module scheme/registry threading and the actual compileGraph land in
// parts (b) and (c); this half only parses and orders.
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"
import { checkWith } from "./check.mochi"
import { exportedRegistry, exportedCtorKeys } from "./ctors.mochi"
import {
  inferProgramImports,
  inferProgramImportsTypes,
  exportedSchemes
} from "./infer.mochi"
import { codegen } from "./codegen.mochi"
import { emitTsModule, externModuleDts } from "./codegen-ts.mochi"

// Prelude tables from the generated shim (as in compile.mochi). Threaded opaquely
// into inferProgramImports / codegen; module.mochi never inspects them.
extern builtins : Map<string, a> = "./prelude.gen.mjs" "builtins"
extern namespaces : Map<string, Map<string, a> > = "./prelude.gen.mjs" "namespaces"
extern namespaceRuntime : Map<string, Map<string, string> > = "./prelude.gen.mjs" "namespaceRuntime"
extern preludeJsDefs : Map<string, string> = "./prelude.gen.mjs" "preludeJsDefs"
extern runtimeDeps : Map<string, [string]> = "./prelude.gen.mjs" "runtimeDeps"

// Stmt/Pattern ctors via namespace import (ADR 0002) — only SImport/SImportNs are
// destructured here; other stmts flow opaquely to the passes.
import * as Ast from "./ast.mochi"

// One loaded module: its canonical path and parsed statements.
type Loaded = { path: string, stmts: [Stmt] }

// A driver error, shaped like the compiler's `CErr`; the graph phase has no
// meaningful span, so both offsets are 0 (matching src/module.ts).
type MErr = { message: string, start: number, end: number }

extern readFile : string -> Result<string, string> = "./host.mjs" "readFile"
extern resolveImport : string -> string -> string = "./host.mjs" "resolveImport"
extern absPath : string -> string = "./host.mjs" "absPath"

let mErr = message => { message, start: 0, end: 0 }
let atPath = (path, e) =>
  { message: "module '${path}': ${e.message}", start: e.start, end: e.end }

// Lex + parse a source file to statements. No check/infer — both need the whole
// graph's exports resolved first, which only happens in a later part.
let parseModule = lex >> Result.flatMap(parse)

// The `from` specs of a module's import statements, in source order.
let importFromsFrom = (stmts, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(s) => switch s {
      | Ast.SImport(_, from, _) => importFromsFrom(
          stmts,
          i + 1,
          Array.append(from, acc)
        )
      | Ast.SImportNs(_, from, _) => importFromsFrom(
          stmts,
          i + 1,
          Array.append(from, acc)
        )
      | _ => importFromsFrom(stmts, i + 1, acc)
    }
}
let importFroms = stmts => importFromsFrom(stmts, 0, [])

// The DFS accumulator: `state` marks each path "loading" (on the stack, so
// re-entry is a cycle) or "done"; `order` collects modules in dependency order.
type Acc = { state: Map<string, string>, order: [Loaded] }

// Visit one module: mark it loading, parse it, recurse into its deps, then mark
// it done and append it to `order`. First Err short-circuits. A path already
// "loading" is a cycle; already "done" is a no-op.
let visit = (path, acc) => switch Map.get(path, acc.state) {
  | Some("done") => Ok(acc)
  | Some("loading") => Err(mErr("import cycle through '${path}'"))
  | _ => let acc1 = {
      state: Map.set(path, "loading", acc.state),
      order: acc.order
    } in
      switch readFile(path) {
        | Err(_) => Err(mErr("cannot read module '${path}'"))
        | Ok(src) => switch parseModule(src) {
            | Err(e) => Err(e)
            | Ok(stmts) => switch visitAll(importFroms(stmts), path, acc1) {
                | Err(e) => Err(e)
                | Ok(acc2) => Ok(
                    {
                      state: Map.set(path, "done", acc2.state),
                      order: Array.append({ path, stmts }, acc2.order)
                    }
                  )
              }
          }
      }
}

// Visit each dep spec, resolved against `importer`, threading the accumulator.
let visitAll = (froms, importer, acc) => switch froms {
  | [] => Ok(acc)
  | [from, ...rest] => switch visit(resolveImport(importer, from), acc) {
      | Err(e) => Err(e)
      | Ok(acc1) => visitAll(rest, importer, acc1)
    }
}

/// loadGraph : string -> Result [Loaded] MErr
/// Load every module reachable from `entry`, in dependency order.
export let loadGraph = entry =>
  let? acc = absPath(entry)->visit({ state: #{}, order: [] }) in Ok(acc.order)

// --- part (b): compile the loaded graph -------------------------------------
// Each module checks + infers + codegens with the prelude PLUS everything its
// imports resolve to: their export SCHEMES (inference), their variant REGISTRY
// (cross-module exhaustiveness), and their ctor field KEYS (destructuring). A
// missing export is reported against the import site. Mirrors src/module.ts's
// compileGraph — sync, since loadGraph already did the IO.

// The registry shape, named locally so `emptyReg` can be annotated (ADR 0044) —
// its empty maps would otherwise infer `Map k v` and, threaded into the generic
// `resolveImportsFrom`, leave the registry map types unpinned (a `tsc --strict`
// error on the emitted `.ts`). Structural aliases (ADR 0005), so this unifies
// with check.mochi's `Registry` without a cross-module type import.
type CtorInfo = { owner: string, arity: number }
type Registry = { ctors: Map<string, CtorInfo>, types: Map<string, [string]> }

let emptyReg : Registry = { ctors: #{}, types: #{} }

// Map has no bulk merge, so fold `from`'s keys into `into` (later source wins).
let mergeInto = (keys, from, into) => switch keys {
  | [] => into
  | [k, ...rest] => mergeInto(
      rest,
      from,
      switch Map.get(k, from) {
        | Some(v) => Map.set(k, v, into)
        | None => into
      }
    )
}

let mergeMap = (from, into) => mergeInto(Map.keys(from), from, into)

// --- qualified type names (C5 slice d, ADR 0046) --------------------------
// A module hands its importers the set of type names it EXPORTS, plus its OWN
// alias scope, so a transparent record alias expands in the module that
// DECLARED it. Mirrors src/module.ts's `qualScopeOf`/`exportedTypeNames`.

let exportedTypeNames = stmts =>
  stmts
    |> Array.flatMap(s => switch s {
      | Ast.SType(name, _, _, _, _, true, _, _) => [name]
      | _ => []
    })
    |> Set.fromArray

// Local record aliases, keyed by name — the `aliases` map schemes.mochi
// expands through. Mirrors infer.mochi's `aliasMapFrom` seed.
let aliasesOf = stmts =>
  stmts
    |> Array.reduce(
      (acc, s) => switch s {
        | Ast.SType(name, params, _, Some(fields), _, _, _, _) => acc
            |> Map.set(name, { params, fields, expr: None })
        | Ast.SType(name, params, _, _, Some(te), _, _, _) => acc
            |> Map.set(name, { params, fields: [], expr: Some(te) })
        | _ => acc
      },
      #{}
    )

// src/module.ts nests the dep's FULL type scope here (`scope.quals`), so a
// qualified name written inside the dep's own alias expands too. The bootstrap
// mirror is one hop: `{ types, aliases }`, no nested `quals`. Making it
// recursive needs a named recursive record type over `Ast.AliasField` — a
// cross-module TYPE name, i.e. the feature this very slice is building. Unwind
// once d-3 lands (the "shared-module workaround" the C5 ticket asks about);
// until then a qualified name nested inside an imported record alias lowers
// nominally instead of expanding, which only differs under row unification.
let qualScopeOf = stmts =>
  { types: stmts->exportedTypeNames(), aliases: stmts->aliasesOf() }

// Seed one named constructor into the importer. Sibling ctors stay out of the
// ctor map; the owning type's full list still lands so exhaustiveness is sound.
// A second Empty from a different owner is duplicate constructor (ADR 0082).
let withNamedCtor = (name, info, depReg, depKeys, res) =>
  {
    imports: res.imports,
    nsImports: res.nsImports,
    reg: {
      ctors: Map.set(name, info, res.reg.ctors),
      types: switch Map.get(info.owner, depReg.types) {
        | Some(cs) => Map.set(info.owner, cs, res.reg.types)
        | None => res.reg.types
      }
    },
    keys: switch depKeys |> Map.get(name) {
      | Some(ks) => res.keys |> Map.set(name, ks)
      | None => res.keys
    },
    quals: res.quals
  }

let takeNamedCtor = (name, span, depReg, depKeys, res) => switch Map.get(name, depReg.ctors) {
  | None => Ok(res)
  | Some(info) => switch Map.get(name, res.reg.ctors) {
      | Some(prior) => prior.owner != info.owner
          ? Err(
            {
              message: "duplicate constructor '${name}'",
              start: span.start,
              end: span.end
            }
          )
          : Ok(withNamedCtor(name, info, depReg, depKeys, res))
      | None => Ok(withNamedCtor(name, info, depReg, depKeys, res))
    }
}

// Namespace import: ctors live under `Alias.Ctor`; type map stays bare.
let prefixCtorsInto = (keys, alias, from, into) => switch keys {
  | [] => into
  | [k, ...rest] => prefixCtorsInto(
      rest,
      alias,
      from,
      switch Map.get(k, from) {
        | Some(v) => Map.set("${alias}.${k}", v, into)
        | None => into
      }
    )
}

// Pull each imported name's scheme out of the dep's published exports, folding
// into `res.imports`. A name the dep does not export errors at the name's span.
let resolveNames = (names, from, depExports, depReg, depKeys, res) => switch names {
  | [] => Ok(res)
  | [n, ...rest] => switch Map.get(n.name, depExports) {
      | None => Err(
          {
            message: "'${from}' has no export '${n.name}'",
            start: n.span.start,
            end: n.span.end
          }
        )
      | Some(sc) => switch takeNamedCtor(n.name, n.span, depReg, depKeys, { imports: Map.set(n.name, sc, res.imports), nsImports: res.nsImports, reg: res.reg, keys: res.keys, quals: res.quals }) {
          | Err(e) => Err(e)
          | Ok(res1) => resolveNames(
              rest,
              from,
              depExports,
              depReg,
              depKeys,
              res1
            )
        }
    }
}

// Fold a module's import statements into resolved { imports, nsImports, reg,
// keys }: named imports bring only the ctors they list; `import * as` registers
// ctors under `Alias.Ctor` (ADR 0082). Field keys still merge under the bare
// ctor name so destructure emit stays `Circle`, not `S.Circle`.
let resolveImportsFrom = (ctx, stmts, i, path, res) => switch Array.get(i, stmts) {
  | None => Ok(res)
  | Some(Ast.SImport(names, from, _)) => let dp = resolveImport(path, from) in
    let depExports = Map.getOr(#{}, dp, ctx.exportsByPath) in
    let depReg = Map.getOr(emptyReg, dp, ctx.regByPath) in
    let depKeys = Map.getOr(#{}, dp, ctx.keysByPath) in
      switch resolveNames(names, from, depExports, depReg, depKeys, res) {
        | Err(e) => Err(e)
        | Ok(res1) => ctx->resolveImportsFrom(stmts, i + 1, path, res1)
      }
  | Some(Ast.SImportNs(alias, from, _)) => let dp = resolveImport(path, from) in
    let depExports = Map.getOr(#{}, dp, ctx.exportsByPath) in
    let depReg = Map.getOr(emptyReg, dp, ctx.regByPath) in
    let depKeys = Map.getOr(#{}, dp, ctx.keysByPath) in
      ctx->resolveImportsFrom(
        stmts,
        i + 1,
        path,
        {
          imports: res.imports,
          nsImports: Map.set(alias.name, depExports, res.nsImports),
          reg: {
            ctors: prefixCtorsInto(
              Map.keys(depReg.ctors),
              alias.name,
              depReg.ctors,
              res.reg.ctors
            ),
            types: mergeMap(depReg.types, res.reg.types)
          },
          keys: mergeMap(depKeys, res.keys),
          quals: // …and every exported TYPE of the dep becomes namable as `Alias.T`.
          // Absent from `qualsByPath` (a dep that failed to publish) leaves the
          // alias unmapped, which check.mochi reads as "not graph-compiled" and
          // stays silent — same fallback as src/module.ts.
          switch Map.get(dp, ctx.qualsByPath) {
            | Some(q) => Map.set(alias.name, q, res.quals)
            | None => res.quals
          }
        }
      )
  | Some(_) => ctx->resolveImportsFrom(stmts, i + 1, path, res)
}

// Compile one module: resolve imports, check (with imported registry), infer
// (with imported schemes), codegen (with imported ctor keys), then publish this
// module's own exports/registry/keys into the ctx for later dependents.
let compileOne = (ctx, loaded: Loaded) => switch ctx->resolveImportsFrom(loaded.stmts, 0, loaded.path, { imports: #{}, nsImports: #{}, reg: emptyReg, keys: #{}, quals: #{} }) {
  | Err(e) => Err(atPath(loaded.path, e))
  | Ok(res) => switch checkWith(loaded.stmts, res.reg, res.quals) {
      | Err(e) => Err(atPath(loaded.path, e))
      | Ok(_) => switch inferProgramImports(loaded.stmts, builtins, namespaces, true, res.imports, res.nsImports, res.quals, None) {
          | Err(e) => Err(atPath(loaded.path, e))
          | Ok(env) => let js = codegen(
              loaded.stmts,
              res.keys,
              true,
              namespaceRuntime,
              preludeJsDefs,
              runtimeDeps
            ) in
              Ok(
                {
                  exportsByPath: Map.set(
                    loaded.path,
                    exportedSchemes(loaded.stmts, env),
                    ctx.exportsByPath
                  ),
                  regByPath: Map.set(
                    loaded.path,
                    exportedRegistry(loaded.stmts),
                    ctx.regByPath
                  ),
                  keysByPath: Map.set(
                    loaded.path,
                    exportedCtorKeys(loaded.stmts),
                    ctx.keysByPath
                  ),
                  qualsByPath: Map.set(
                    loaded.path,
                    qualScopeOf(loaded.stmts),
                    ctx.qualsByPath
                  ),
                  outputs: [...ctx.outputs, { path: loaded.path, js }]
                }
              )
        }
    }
}

// Compile the whole ordered graph, threading the ctx; first Err short-circuits.
let compileAll = (ctx, graph) => switch graph {
  | [] => Ok(ctx.outputs)
  | [m, ...rest] => switch ctx->compileOne(m) {
      | Err(e) => Err(e)
      | Ok(ctx1) => ctx1->compileAll(rest)
    }
}

/// compileGraph : [Loaded] -> Result [ModuleOutput] MErr
/// Spelled out (not point-free `compileAll(ctx0)`): the TS backend types a
/// multi-param function uncurried, so a partial application is a tsc error.
export let compileGraph = graph =>
  compileAll(
    {
      exportsByPath: #{},
      regByPath: #{},
      keysByPath: #{},
      qualsByPath: #{},
      outputs: []
    },
    graph
  )

/// buildModules : string -> Result [ModuleOutput] MErr
/// Resolve the graph then compile it — one sync railway (host IO is sync).
export let buildModules = entry =>
  let? graph = entry->loadGraph() in graph->compileGraph()

// --- part (d): the typed-TypeScript graph driver (ADR 0090) -----------------
// The same railway as compileGraph, but each module emits typed `.ts` instead of
// `.js`. Three things a single-file `compileTs` never needs show up here:
//
//   1. inference must KEEP its span -> type table across the graph, so the
//      driver calls `inferProgramImportsTypes` rather than the env-only view;
//   2. a type declared in one module and referenced in another needs an
//      `import type` line, computed from the EMITTED text (a type name can
//      surface through an annotation with no AST reference to find);
//   3. every `extern` host module needs a sidecar `.d.ts` / `.d.mts`, or the
//      emitted `import` of it is a tsc TS2307.
//
// Mirrors src/module.ts's `compileGraphTs`.

extern relSpec : string -> string -> string = "./host.mjs" "relSpec"
extern externDtsPath : string -> string -> string = "./host.mjs" "externDtsPath"

// A TS identifier character — the poor man's `\b`, since mochi has no regex.
let isIdentChar = c => switch Str.codeAt(0, c) {
  | None => false
  | Some(n) => n >= 48 && n <= 57 || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || n == 36
}

// A run flanking an occurrence: empty means the occurrence sat at the very
// start (or end) of the text, which is a boundary too.
let endsAtBoundary = part =>
  Str.length(part) == 0
    ? true
    : !isIdentChar(Option.unwrapOr("", Str.get(Str.length(part) - 1, part)))

let startsAtBoundary = part =>
  Str.length(part) == 0
    ? true
    : !isIdentChar(Option.unwrapOr("", Str.get(0, part)))

// `\bname\b` without a regex: split ONCE on the name, then test the characters
// flanking each occurrence. `Rest` must not match inside `Restriction`, and a
// per-index scan over every emitted module for every candidate name is the
// quadratic version of this.
let occursAsWordFrom = (parts, i) => switch Array.get(i, parts) {
  | None => false
  | Some(after) => (Array.get(i - 1, parts)
      |> Option.mapOr(false, endsAtBoundary)) && startsAtBoundary(after)
      ? true
      : occursAsWordFrom(parts, i + 1)
}

let occursAsWord = (name, text) => occursAsWordFrom(Str.split(name, text), 1)

// The name an import clause entry BINDS — `x as y` binds `y`.
let importedBinding = spec =>
  let parts = Str.split(" as ", spec) in
    Str.trim(Option.unwrapOr(spec, Array.get(Array.length(parts) - 1, parts)))

let bindingsInLine = (line, acc) => switch Array.get(1, Str.split("{", line)) {
  | None => acc
  | Some(rest) => switch Array.get(0, Str.split("}", rest)) {
      | None => acc
      | Some(names) => Str.split(",", names)
          |> Array.reduce((a, n) => Set.add(importedBinding(n), a), acc)
    }
}

// Names already bound by a VALUE import in the emitted text. Re-importing one as
// a type is a TS2300 duplicate identifier, so those are skipped below.
let valueImported = ts =>
  ts
    |> Str.split("\n")
    |> filter(Str.startsWith("import {"))
    |> Array.reduce((acc, line) => bindingsInLine(line, acc), Set.fromArray([]))

// Every top-level `type` name in the graph -> the module that declares it. Type
// names are globally visible, so one flat table serves every importer.
let ownTypesInto = (stmts, path, acc) =>
  stmts
    |> Array.reduce(
      (a, s) => switch s {
        | Ast.SType(name, _, _, _, _, _, _, _) => a |> Map.set(name, path)
        | _ => a
      },
      acc
    )

let typeOwnerOf = graph =>
  graph |> Array.reduce((acc, m) => ownTypesInto(m.stmts, m.path, acc), #{})

let localTypeNames = stmts =>
  stmts
    |> Array.flatMap(s => switch s {
      | Ast.SType(name, _, _, _, _, _, _, _) => [name]
      | _ => []
    })
    |> Set.fromArray

// Group the wanted type names by the spec of their declaring module. A name is
// wanted when another module declares it, no value import already binds it, and
// it actually occurs in the emitted text.
let groupByOwner = (names, ctx) =>
  names
    |> Array.reduce(
      (acc, name) =>
        let owner = ctx.typeOwner |> Map.getOr("", name) in
          owner == ctx.importer || Set.has(
            name,
            ctx.localTypes
          ) || Set.has(name, ctx.bound) || !occursAsWord(name, ctx.ts)
            ? acc
            : let spec = relSpec(ctx.importer, owner) in
              acc
                |> Map.set(spec, Array.append(name, Map.getOr([], spec, acc))),
      #{}
    )

/// `import type { … }` lines for every non-local type name the EMITTED text
/// references, grouped by declaring module. Builtin variants never appear in
/// `typeOwner` — the emitter inlines their decls instead (ADR 0031).
let crossModuleTypeImports = (ts, importer, localTypes, typeOwner) =>
  let byOwner = groupByOwner(
    Map.keys(typeOwner),
    { ts, importer, localTypes, typeOwner, bound: valueImported(ts) }
  ) in
    Map.keys(byOwner)
      |> map(spec =>
        "import type { ${Str.join(", ", Array.sort(Map.getOr([], spec, byOwner)))} } from \"${spec}\";")

// Bucket this module's externs by the sidecar path they belong in. A `mochi:`
// module lowers inline — a JS convention, not a host import — so it has no
// sidecar to declare. Duplicates are fine here: two mochi bindings may alias one
// host export, and `externModuleDts` dedupes on `imported` when it renders.
let externBindingsInto = (stmts, path, env, acc) =>
  stmts
    |> Array.reduce(
      (a, s) => switch s {
        | Ast.SExtern(name, _, _, _, hostModule, imported, curried, _, _, _) => Str.startsWith(
            "mochi:",
            hostModule
          )
            ? a
            : switch Map.get(name, env) {
              | None => a
              | Some(sc) => let dp = externDtsPath(path, hostModule) in
                  a
                    |> Map.set(
                      dp,
                      Array.append(
                        { imported, scheme: sc, curried },
                        Map.getOr([], dp, a)
                      )
                    )
            }
        | _ => a
      },
      acc
    )

// Compile one module to typed TS: the same resolve/check/infer prefix as
// `compileOne`, then emit, then prepend the `import type` lines the emitted text
// turned out to need.
let compileOneTs = (ctx, loaded) => switch ctx->resolveImportsFrom(loaded.stmts, 0, loaded.path, { imports: #{}, nsImports: #{}, reg: emptyReg, keys: #{}, quals: #{} }) {
  | Err(e) => Err(atPath(loaded.path, e))
  | Ok(res) => switch checkWith(loaded.stmts, res.reg, res.quals) {
      | Err(e) => Err(atPath(loaded.path, e))
      | Ok(_) => switch inferProgramImportsTypes(loaded.stmts, builtins, namespaces, true, res.imports, res.nsImports, res.quals, None) {
          | Err(e) => Err(atPath(loaded.path, e))
          | Ok(r) => let body = emitTsModule(
              loaded.stmts,
              r.env,
              r.types,
              r.letParams,
              // Keep dependency aliases in scope for TS rendering. Inference
              // expands record aliases to rows, so without this accumulated
              // index a type imported from an earlier module prints inline
              // instead of as the alias that module declared.
              mergeMap(r.aliases, ctx.aliases),
              res.keys,
              [],
              namespaceRuntime,
              preludeJsDefs,
              runtimeDeps,
              ctx.runtimeImport
            ) in
            let lines = crossModuleTypeImports(
              body,
              loaded.path,
              localTypeNames(loaded.stmts),
              ctx.typeOwner
            ) in
            let ts = Array.length(lines) == 0
              ? body
              : "${Str.join("\n", lines)}\n\n${body}" in
              Ok(
                {
                  exportsByPath: Map.set(
                    loaded.path,
                    exportedSchemes(loaded.stmts, r.env),
                    ctx.exportsByPath
                  ),
                  regByPath: Map.set(
                    loaded.path,
                    exportedRegistry(loaded.stmts),
                    ctx.regByPath
                  ),
                  keysByPath: Map.set(
                    loaded.path,
                    exportedCtorKeys(loaded.stmts),
                    ctx.keysByPath
                  ),
                  qualsByPath: Map.set(
                    loaded.path,
                    qualScopeOf(loaded.stmts),
                    ctx.qualsByPath
                  ),
                  aliases: mergeMap(r.aliases, ctx.aliases),
                  typeOwner: ctx.typeOwner,
                  runtimeImport: ctx.runtimeImport,
                  externs: externBindingsInto(
                    loaded.stmts,
                    loaded.path,
                    r.env,
                    ctx.externs
                  ),
                  outputs: [...ctx.outputs, { path: loaded.path, js: ts }]
                }
              )
        }
    }
}

// A builtin ctor's field types never name a user alias, so the sidecars render
// under an EMPTY alias scope. Built through `aliasesOf` rather than written as a
// bare `#{}`, which generalizes and leaves the emitted TS a `Map<string,
// unknown>` against `externModuleDts`'s pinned parameter (ADR 0044).
let noAliases = aliasesOf([])

// The sidecar declaration files, one per host module the graph externs from.
// Appended after every module, so a host imported by several modules collects
// all of their bindings into one file.
let externOutputs = externs =>
  Map.keys(externs)
    |> map(dp =>
      { path: dp, js: externModuleDts(Map.getOr([], dp, externs), noAliases) })

let compileAllTs = (ctx, graph) => switch graph {
  | [] => Ok(Array.concat(ctx.outputs, externOutputs(ctx.externs)))
  | [m, ...rest] => switch ctx->compileOneTs(m) {
      | Err(e) => Err(e)
      | Ok(ctx1) => ctx1->compileAllTs(rest)
    }
}

/// compileGraphTs : [Loaded] -> string -> Result [ModuleOutput] MErr
/// Emit the whole ordered graph as typed TypeScript (ADR 0090). Outputs are the
/// `.mochi` module paths (the writer swaps the extension) followed by the extern
/// sidecars, which already carry their own `.d.ts` / `.d.mts` extension.
export let compileGraphTs = (graph, runtimeImport) =>
  compileAllTs(
    {
      exportsByPath: #{},
      regByPath: #{},
      keysByPath: #{},
      qualsByPath: #{},
      aliases: #{},
      typeOwner: typeOwnerOf(graph),
      runtimeImport,
      externs: #{},
      outputs: []
    },
    graph
  )

/// buildModulesTs : string -> string -> Result [ModuleOutput] MErr
export let buildModulesTs = (entry, runtimeImport) =>
  let? graph = entry->loadGraph() in graph->compileGraphTs(runtimeImport)

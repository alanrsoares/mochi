import { assertEq, ok, test, testEach } from "@mochi/test"
import { check } from "./check.mochi"
import { inferProgram, inferProgramTypes } from "./infer.mochi"
import { showType } from "./types.mochi"
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"

extern builtins : Map<string, a> = "./prelude.gen.mjs" "builtins"
extern namespaces : Map<string, Map<string, a>> = "./prelude.gen.mjs" "namespaces"

let slim = e => { message: e.message, start: e.start, end: e.end }

// Inference collects every type error (ADR 0004 §3); most cases only look at
// the first.
let firstOf = es =>
  Array.get(0, es) |> Option.unwrapOr({ message: "<none>", start: 0, end: 0 })

/// Every diagnostic a source ends in, slimmed. A lex / parse / check failure
/// stops the railway, so it is the only one.
let inferErrs = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.flatMap(check)
    |> Result.mapErr(e => [slim(e)])
    |> Result.flatMap(stmts =>
      inferProgram(stmts, builtins, namespaces, false)
        |> Result.mapErr(es => es |> map(slim)))

let inferSrc = src => inferErrs(src) |> Result.mapErr(firstOf)

testEach("inference accepts well-typed programs", [
  {
    label: "polymorphic identity",
    src: "let id = value => value\nlet n = id(1)\nlet s = id(\"ok\")"
  },
  {
    label: "row-polymorphic field",
    src: "let getName = value => value.name\nlet name = getName({ name: \"mochi\", version: 1 })"
  },
  {
    label: "exhaustive variant",
    src: "type Option a = Some(value: a) | None\nlet withDefault = value => switch value { | Some(n) => n | None => 0 }"
  },
  {
    label: // ADR 0044: the annotation pins the binding, so the literal keeps the
    // union instead of widening to `string`.
    "let-in binding annotation",
    src: "let pick = (tone: \"rose\" | \"amber\") => tone\nlet r = let t : \"rose\" | \"amber\" = \"rose\" in pick(t)"
  }
], row => switch inferSrc(row.src) {
  | Ok(_) => true |> ok
  | Err(_) => false |> ok
})

testEach("inference rejects type conflicts", [
  {
    label: "number used as a function",
    src: "let value = 1\nlet result = value(2)",
    want: "unify"
  },
  {
    label: "incompatible match arms",
    src: "let f = value => switch value { | true => 1 | false => \"no\" }",
    want: "unify"
  },
  {
    label: "wrong builtin argument",
    src: "let value = mul(1, \"no\")",
    want: "unify"
  },
  {
    label: "let-in value contradicts its annotation",
    src: "let r = let x : number = \"no\" in x",
    want: "unify"
  },
  {
    label: // `generalizeOver` must still see a lambda parameter the `let` captures.
    "let-in keeps a captured parameter monomorphic",
    src: "let f = x => let y = x in (add(y, 1), not(y))",
    want: "unify"
  },
  {
    label: // …and the enclosing top-level group, bound monomorphically until it
    // generalizes. Its name is not a local binder.
    "let-in keeps the enclosing group's name monomorphic",
    src: "let h = n => let k = h in (k(1), k(\"s\"))",
    want: "unify"
  }
], row => switch inferSrc(row.src) {
  | Err(e) => e.message |> Str.contains(row.want) |> ok
  | Ok(_) => false |> ok
})

// ADR 0004 §3: one diagnostic per failing top-level `let` / expression
// statement, not just the first. A failed `let` stays bound to an
// unconstrained var, so a later use of it adds no error of its own.
testEach("inference reports every failing top-level binding", [
  ("let a = add(1, true)\nlet b = mul(\"x\", 2)", 2),
  ("let bad = add(true, add(false, 1))", 1),
  ("let a = add(1, true)\nlet b = add(a, 1)", 1),
  ("let a = add(1, true)\nadd(1, 2)\nadd(\"x\", 1)", 3)
], ((src, want)) => switch inferErrs(src) {
  | Err(es) => assertEq(want, Array.length(es))
  | Ok(_) => false |> ok
})

test("collected type errors keep source order and spans", () => switch inferErrs("let a = add(1, true)\nlet b = mul(\"x\", 2)") {
  | Err(es) => assertEq(
      [
        { message: "cannot unify number with bool", start: 15, end: 19 },
        { message: "cannot unify number with \"x\"", start: 33, end: 36 }
      ],
      es
    )
  | Ok(_) => false |> ok
})

// ---- recorded span -> type metadata (ADR 0090) ----

let typesOf = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.flatMap(check)
    |> Result.flatMap(stmts =>
      inferProgramTypes(stmts, builtins, namespaces, false)
        |> Result.mapErr(es => firstOf(es |> map(slim))))
    |> Result.map(r => r.types)

let lastOf = xs => Array.get(Array.length(xs) - 1, xs)

/// Later records win when two nodes share a span, so take the LAST match.
let findAt = (start, end, types) =>
  types
    |> Array.filter(r => r.span.start == start && r.span.end == end)
    |> lastOf
    |> Option.map(r => showType(r.ty))

let typeAt = (src, start, end) =>
  typesOf(src)
    |> Result.unwrapOr([])
    |> findAt(start, end)
    |> Option.unwrapOr("<none>")

test("inference records a literal's type at its span", () =>
  assertEq("number", typeAt("let n = 1", 8, 9)))

test("recorded types are zonked against the final substitution", () =>
  // `id`'s result is a fresh var at the call site; only the FINAL state
  // resolves it to `number`.
  assertEq("number", typeAt("let id = value => value\nlet n = id(1)", 32, 37)))

test("inference records every node, not just top-level bindings", () => switch typesOf("let f = value => add(value, 1)") {
  | Ok(types) => Array.length(types) > 4 |> ok
  | Err(_) => false |> ok
})

// ---- binder records (ADR 0119) ----

/// The binder recorded at exactly `start..end`, as `kind name: type`.
let binderAt = (src, start, end) =>
  typesOf(src)
    |> Result.unwrapOr([])
    |> Array.filter(r => r.span.start == start && r.span.end == end)
    |> Array.flatMap(r => switch r.sym {
      | Some(s) => ["${s.kind} ${s.name}: ${showType(r.ty)}"]
      | None => []
    })
    |> lastOf
    |> Option.unwrapOr("<none>")

testEach("a binder's name span carries its symbol", [
  ("let n = 1", 4, 5, "let n: number"),
  ("let f = (x: number) => x", 9, 10, "parameter x: number"),
  ("let f = ((a, b)) => add(a, b)", 10, 11, "parameter a: number"),
  ("let f = (~k = 1) => k", 10, 11, "parameter k: number"),
  ("let n = let y = 1 in y", 12, 13, "let y: number"),
  ("let g = r => r.q + 1", 13, 16, "property q: number"),
  (
    "let n = switch Some(1) { | Some(v) as o => v | None => 0 }",
    32,
    33,
    "parameter v: number"
  ),
  ("let n = loop (i = 0) { i }", 14, 15, "let i: number")
], ((src, start, end, want)) => assertEq(want, binderAt(src, start, end)))

test("a top-level let's binder carries its doc", () => switch typesOf("/// the answer\nlet n = 42") {
  | Ok(types) => types
      |> Array.flatMap(r => switch r.sym { | Some(s) => [s.doc] | None => [] })
      |> Array.get(0)
      |> Option.flatMap(d => d)
      |> assertEq(Some("the answer"))
  | Err(_) => false |> ok
})

test("unbound name suggests a close binding", () => switch lex("let count = 1\nlet n = coun") |> Result.flatMap(parse) |> Result.flatMap(check) {
  | Err(_) => false |> ok
  | Ok(stmts) => switch inferProgram(stmts, builtins, namespaces, false) {
      | Ok(_) => false |> ok
      | Err(es) => switch Array.get(0, es) {
          | Some(e) => switch (e.help, Array.get(0, e.suggestions)) {
              | (Some("did you mean 'count'?"), Some(s)) => s.replaceWith == "count"
                  |> ok
              | _ => false |> ok
            }
          | None => false |> ok
        }
    }
})

let inferOpen = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.flatMap(check)
    |> Result.flatMap(stmts =>
      inferProgram(stmts, builtins, namespaces, true)
        |> Result.mapErr(es => firstOf(es |> map(slim))))

test("open mode rejects a ref outside its binder", () => switch inferOpen("let go = () => {\n  let n = 1 in f(n);\n  g(n)\n}") {
  | Err(e) => e.message == "'n' is not in scope here" |> ok
  | Ok(_) => false |> ok
})

test("open mode still accepts a host global", () => switch inferOpen("let read = () => localStorage") {
  | Ok(_) => true |> ok
  | Err(_) => false |> ok
})

// ---- generalized env schemes ----

/// The final env's scheme for `name`, printed without hover's literal widening.
let schemeOf = (src, name) =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.flatMap(check)
    |> Result.flatMap(stmts =>
      inferProgramTypes(stmts, builtins, namespaces, false)
        |> Result.mapErr(es => firstOf(es |> map(slim))))
    |> Result.map(r =>
      r.env
        |> Map.get(name)
        |> Option.map(s => showType(s.ty))
        |> Option.unwrapOr("<none>"))
    |> Result.unwrapOr("<err>")

testEach("a string literal's scheme widens only when unannotated", [
  ("let m : \"hi\" = \"hi\"", "m", "\"hi\""),
  ("let w = \"hi\"", "w", "string")
], ((src, name, want)) => assertEq(want, schemeOf(src, name)))

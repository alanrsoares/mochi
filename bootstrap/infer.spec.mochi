import { assertEq, ok, test, testEach } from "@mochi/test"
import { check } from "./check.mochi"
import { inferProgram, inferProgramTypes } from "./infer.mochi"
import { showType } from "./types.mochi"
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"

extern builtins : Map<string, a> = "./prelude.gen.mjs" "builtins"
extern namespaces : Map<string, Map<string, a> > = "./prelude.gen.mjs" "namespaces"

let inferSrc = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.flatMap(check)
    |> Result.flatMap(stmts => inferProgram(stmts, builtins, namespaces, false))

testEach("inference accepts well-typed programs", [
  {
    label: "polymorphic identity",
    src: "let id = value => value\nlet n = id(1)\nlet s = id(\"ok\")"
  },
  {
    label: "row-polymorphic field",
    src: "let getName = value => value.name\nlet name = getName({ name: \"mochi\", version: 1 })"
  },
  {
    label: "exhaustive variant",
    src: "type Option a = Some(value: a) | None\nlet withDefault = value => switch value { | Some(n) => n | None => 0 }"
  },
  {
    label: // ADR 0044: the annotation pins the binding, so the literal keeps the
    // union instead of widening to `string`.
    "let-in binding annotation",
    src: "let pick = (tone: \"rose\" | \"amber\") => tone\nlet r = let t : \"rose\" | \"amber\" = \"rose\" in pick(t)"
  }
], row => switch inferSrc(row.src) {
  | Ok(_) => true |> ok
  | Err(_) => false |> ok
})

testEach("inference rejects type conflicts", [
  {
    label: "number used as a function",
    src: "let value = 1\nlet result = value(2)",
    want: "unify"
  },
  {
    label: "incompatible match arms",
    src: "let f = value => switch value { | true => 1 | false => \"no\" }",
    want: "unify"
  },
  {
    label: "wrong builtin argument",
    src: "let value = mul(1, \"no\")",
    want: "unify"
  },
  {
    label: "let-in value contradicts its annotation",
    src: "let r = let x : number = \"no\" in x",
    want: "unify"
  }
], row => switch inferSrc(row.src) {
  | Err(e) => e.message |> Str.contains(row.want) |> ok
  | Ok(_) => false |> ok
})

// ---- recorded span -> type metadata (ADR 0090) ----

let typesOf = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.flatMap(check)
    |> Result.flatMap(stmts =>
      inferProgramTypes(stmts, builtins, namespaces, false))
    |> Result.map(r => r.types)

let lastOf = xs => Array.get(Array.length(xs) - 1, xs)

/// Later records win when two nodes share a span, so take the LAST match.
let findAt = (start, end, types) =>
  types
    |> Array.filter(r => r.span.start == start && r.span.end == end)
    |> lastOf
    |> Option.map(r => showType(r.ty))

let typeAt = (src, start, end) =>
  typesOf(src)
    |> Result.unwrapOr([])
    |> findAt(start, end)
    |> Option.unwrapOr("<none>")

test("inference records a literal's type at its span", () =>
  assertEq("number", typeAt("let n = 1", 8, 9)))

test("recorded types are zonked against the final substitution", () =>
  // `id`'s result is a fresh var at the call site; only the FINAL state
  // resolves it to `number`.
  assertEq("number", typeAt("let id = value => value\nlet n = id(1)", 32, 37)))

test("inference records every node, not just top-level bindings", () => switch typesOf("let f = value => add(value, 1)") {
  | Ok(types) => Array.length(types) > 4 |> ok
  | Err(_) => false |> ok
})

import { assertEq, ok, test, testEach } from "@mochi/test"
import { codegen, codegenWith, jsGenOpts } from "./codegen.mochi"
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"
import { SError } from "./ast.mochi"
import * as Ast from "./ast.mochi"

test("an error node emits an explicit codegen invariant failure", () =>
  codegen(
    [SError({ start: 0, end: 3 })],
    #{},
    true,
    namespaceRuntime,
    preludeJsDefs,
    runtimeDeps
  )
    |> Str.contains("codegen invariant")
    |> ok)

extern namespaceRuntime : Map<string, Map<string, string>> = "./prelude.gen.mjs" "namespaceRuntime"
extern preludeJsDefs : Map<string, string> = "./prelude.gen.mjs" "preludeJsDefs"
extern runtimeDeps : Map<string, [string]> = "./prelude.gen.mjs" "runtimeDeps"

let genSrc = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.map(stmts =>
      codegen(stmts, #{}, true, namespaceRuntime, preludeJsDefs, runtimeDeps))

let optionalSpan = { start: 0, end: 0 }
let optionalPayload = Ast.PBind("value", optionalSpan)
let optionalSome = payload =>
  {
    pattern: Ast.PCtor("Some", [payload], None, optionalSpan),
    guard: None,
    body: Ast.ERef("value", optionalSpan)
  }
let optionalNone = {
  pattern: Ast.PCtor("None", [], None, optionalSpan),
  guard: None,
  body: Ast.ENum(0, "0", optionalSpan)
}
let optionalProgram = arms =>
  [
    Ast.SLet(
      "out",
      optionalSpan,
      None,
      Ast.EMatch(
        Ast.EField(Ast.ERef("row", optionalSpan), "value", true, optionalSpan),
        arms,
        optionalSpan
      ),
      false,
      None,
      optionalSpan
    )
  ]

testEach("optional match fusion preserves its eligibility boundary", [
  {
    label: "Some first",
    arms: [optionalSome(optionalPayload), optionalNone],
    keys: #{},
    fused: true
  },
  {
    label: "None first",
    arms: [optionalNone, optionalSome(optionalPayload)],
    keys: #{},
    fused: true
  },
  {
    label: "local constructor layout",
    arms: [optionalSome(optionalPayload), optionalNone],
    keys: #{ "Some": ["_0"] },
    fused: false
  },
  {
    label: "qualified constructor",
    arms: [
      {
        ...optionalSome(optionalPayload),
        pattern: Ast.PCtor(
          "Some",
          [optionalPayload],
          Some("Local"),
          optionalSpan
        )
      },
      optionalNone
    ],
    keys: #{},
    fused: false
  },
  {
    label: "nested payload pattern",
    arms: [
      optionalSome(Ast.PTuple([optionalPayload], optionalSpan)),
      optionalNone
    ],
    keys: #{},
    fused: false
  },
  {
    label: "catch-all binding",
    arms: [
      optionalSome(optionalPayload),
      { ...optionalNone, pattern: Ast.PBind("rest", optionalSpan) }
    ],
    keys: #{},
    fused: false
  }
], row =>
  codegen(
    optionalProgram(row.arms),
    row.keys,
    false,
    namespaceRuntime,
    preludeJsDefs,
    runtimeDeps
  )
    |> Str.contains("if ($optional != null)")
    |> assertEq(row.fused))

testEach("codegen emits runtime forms", [
  {
    label: "recur temporaries avoid open-world references",
    src: "let run = loop (i = 0, acc = 0) { i >= 1 ? acc : recur(i + 1, $recur0) }",
    want: "const $recur0$ = add(i, 1); const $recur1 = $recur0;"
  },
  {
    label: "direct recur evaluates all arguments before scalar assignments",
    src: "let run = loop (a = 1, b = 2) { a > 2 ? b : recur(b, a + b) }",
    want: "{ const $recur0 = b; const $recur1 = add(a, b); a = $recur0; b = $recur1; continue; }"
  },
  {
    label: "tuple wildcards become destructuring holes",
    src: "let pick = ((a, _, _)) => a",
    want: "const pick = ([a, , ,]) => a;"
  },
  {
    label: "leading tuple wildcards preserve named positions",
    src: "let pick = ((_, _, a)) => a",
    want: "const pick = ([, , a]) => a;"
  },
  {
    label: "curried multi-argument lambda",
    src: "let addPair = (a, b) => add(a, b)",
    want: "const addPair = _curry(2, (a, b) => add(a, b));"
  },
  {
    label: "record update",
    src: "let base = { x: 1 }\nlet next = { ...base, x: 2 }",
    want: "const next = { ...base, x: 2 };"
  },
  {
    label: "lazy list",
    src: "let values = @{1, 2}",
    want: "const values = _list(function* () { yield (1); yield (2); });"
  },
  {
    label: "native map",
    src: "let values = #{ \"a\": 1 }",
    want: "const values = new Map([[\"a\", 1]]);"
  },
  // The parser retains `->` as a node now, so the arg-prepending lowering lives
  // here and in infer.mochi. Pin the emitted order: the piped value comes FIRST.
  {
    label: "fast pipe prepends the piped value",
    src: "let value = 1->add(2)",
    want: "const value = add(1, 2);"
  },
  {
    label: "`|>` stays data-last",
    src: "let value = 1 |> negate",
    want: "const value = negate(1);"
  }
], row => switch genSrc(row.src) {
  | Ok(js) => js |> Str.contains(row.want) |> ok
  | Err(_) => false |> ok
})

testEach("the JS backend lowers every match without @onrails/pattern", [
  {
    label: "variant switch",
    src: "type Light = Red | Green\nlet show = light => switch light { | Red => 1 | Green => 2 }",
    want: "((_v) => _v._tag === \"Red\"\n    ? (1)\n    : _v._tag === \"Green\"\n    ? (2)"
  },
  {
    label: "nested pattern",
    src: "type Box = Full(value: Option<number>) | Empty\nlet f = b => switch b { | Full(Some(n)) => n | _ => 0 }",
    want: "_v._tag === \"Full\" && _v.value._tag === \"Some\"\n    ? (({ value: { value: n } }) => (n))(_v)\n    : (0)"
  },
  { label: "plain binding", src: "let value = 1", want: "const value = 1;" }
], row => switch genSrc(row.src) {
  | Ok(js) => ok(
      Str.contains(row.want, js) && !Str.contains("@onrails/pattern", js)
    )
  | Err(_) => false |> ok
})

// ---- GenOpts: the TS backend's knobs on the shared codegen (ADR 0026 / 0090) ----
//
// The all-`None` JS path is guarded by the runtime conformance cases and the
// fixpoint; these cases prove each hook actually fires and that its text
// lands in the right syntactic slot.

/// Every hook answers unconditionally, so one source exercises all of them.
let stubOpts = {
  ...jsGenOpts,
  annotateLet: Some((name, _) => name == "pair" ? Some(": Pair") : None),
  annotateParams: Some((_, arity) =>
    { generics: arity >= 2 ? "<A, B>" : "", params: [Some("A"), Some("B")] }),
  annotateEmpty: Some(_ => Some("Map<string, number>")),
  annotateLetin: Some(_ => Some("number")),
  annotateCall: Some(_ => Some("Result<number, string>")),
  flattenPipe: true,
  tupleHelper: true,
  moduleExt: ""
}

/// A ctor factory typing, keyed off field count so all three emission shapes
/// (nullary const, single-field arrow, multi-field cast) are exercised.
let ctorOpts = {
  ...jsGenOpts,
  annotateCtor: Some((_, c) =>
    Some(
      {
        generics: Array.length(c.fields) >= 2 ? "<A>" : "",
        paramTypes: ["A", "B"],
        ret: "Shape<A>",
        retMono: "Shape<never>"
      }
    ))
}

/// A fixed scrutinee base, so the predicate targets are predictable.
let guardOpts = { ...jsGenOpts, guardBaseType: Some(_ => Some("Shape")) }

let genWith = (opts, src) =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.map(stmts =>
      codegenWith(
        stmts,
        #{},
        true,
        namespaceRuntime,
        preludeJsDefs,
        runtimeDeps,
        opts
      ))

let emitted = (opts, src) => genWith(opts, src) |> Result.unwrapOr("<error>")

testEach("GenOpts hooks reach their emission site", [
  {
    label: "annotateLet suffixes the binding",
    src: "let pair = 1",
    want: "const pair: Pair = 1;"
  },
  {
    label: "annotateParams annotates params and scopes generics",
    src: "let addPair = (a, b) => add(a, b)",
    want: "_curry(2, <A, B>(a: A, b: B) =>"
  },
  {
    label: "annotateEmpty pins an empty map literal",
    src: "let table = #{}",
    want: "new Map<string, number>()"
  },
  {
    label: "annotateLetin annotates the IIFE param",
    src: "let value = let inner = 1 in inner",
    want: "((inner: number) =>"
  },
  {
    label: "annotateCall casts an applied ctor",
    src: "let value = Ok(1)",
    want: "(Ok(1) as Result<number, string>)"
  },
  {
    label: "tupleHelper wraps a tuple literal",
    src: "let pt = (1, 2)",
    want: "_tuple(1, 2)"
  },
  {
    label: "flattenPipe appends the piped argument",
    src: "let n = 1 |> add(2)",
    want: "add(2, 1)"
  },
  {
    label: "moduleExt drops the sibling extension",
    src: "import { thing } from \"./dep.mochi\"\nlet n = thing",
    want: "from \"./dep\""
  }
], row => emitted(stubOpts, row.src) |> Str.contains(row.want) |> ok)

testEach("the JS backend leaves every hook slot bare", [
  { label: "no let annotation", src: "let pair = 1", want: "const pair = 1;" },
  {
    label: "bare lambda params",
    src: "let addPair = (a, b) => add(a, b)",
    want: "_curry(2, (a, b) =>"
  },
  { label: "bare empty map", src: "let table = #{}", want: "new Map([])" },
  {
    label: "bare IIFE param",
    src: "let value = let inner = 1 in inner",
    want: "((inner) =>"
  },
  {
    label: "uncast ctor call",
    src: "let value = Ok(1)",
    want: "const value = Ok(1);"
  },
  {
    label: "bare tuple literal",
    src: "let pt = (1, 2)",
    want: "const pt = [1, 2];"
  },
  { label: "curried pipe", src: "let n = 1 |> add(2)", want: "add(2)(1)" },
  {
    label: "sibling keeps .js",
    src: "import { thing } from \"./dep.mochi\"\nlet n = thing",
    want: "from \"./dep.js\""
  }
], row => emitted(jsGenOpts, row.src) |> Str.contains(row.want) |> ok)

test("codegen matches codegenWith under the JS options", () =>
  assertEq(
    emitted(jsGenOpts, "let addPair = (a, b) => add(a, b)"),
    genSrc("let addPair = (a, b) => add(a, b)") |> Result.unwrapOr("<error>")
  ))

testEach("annotateCtor types each factory shape", [
  {
    label: "nullary ctor gets a const annotation",
    src: "type Shape a = Dot\nlet d = Dot",
    want: "const Dot: Shape<never> = { _tag: \"Dot\" };"
  },
  {
    label: "single-field ctor gets a typed arrow",
    src: "type Shape a = Wrap(value: a)\nlet w = Wrap(1)",
    want: "const Wrap = (value: A): Shape<A> => ({ _tag: \"Wrap\", value });"
  },
  {
    label: "multi-field ctor casts the curried impl",
    src: "type Shape a = Pair(left: a, right: a)\nlet p = Pair",
    want: "as <A>(left: A, right: B) => Shape<A>;"
  }
], row => emitted(ctorOpts, row.src) |> Str.contains(row.want) |> ok)

testEach("the JS backend leaves ctor factories untyped", [
  {
    label: "nullary",
    src: "type Shape a = Dot\nlet d = Dot",
    want: "const Dot = { _tag: \"Dot\" };"
  },
  {
    label: "single-field",
    src: "type Shape a = Wrap(value: a)\nlet w = Wrap(1)",
    want: "const Wrap = (value) => ({ _tag: \"Wrap\", value });"
  },
  {
    label: "multi-field",
    src: "type Shape a = Pair(left: a, right: a)\nlet p = Pair",
    want: "const Pair = _curry(2, (left, right) => ({ _tag: \"Pair\", left, right }));"
  }
], row => emitted(jsGenOpts, row.src) |> Str.contains(row.want) |> ok)

testEach("guardBaseType casts an arm its own tests do not narrow", [
  {
    label: "nested ctor arm casts to its Extract target",
    src: "type Shape = Wrap(value: Shape) | Dot\nlet f = s => switch s { | Wrap(Wrap(inner)) => inner | Wrap(x) => x | Dot => Dot }",
    want: "(({ value: { value: inner } }) => (inner))((_v as Extract<Shape, { _tag: \"Wrap\" }> & { \"value\": Extract<Extract<Shape, { _tag: \"Wrap\" }>[\"value\"], { _tag: \"Wrap\" }> }))"
  },
  {
    label: "a discriminant test narrows on its own",
    src: "type Shape = Wrap(value: Shape) | Dot\nlet f = s => switch s { | Wrap(x) => x | Dot => Dot }",
    want: "? (({ value: x }) => (x))(_v)"
  },
  {
    label: "a guard runs under the same view as the body",
    src: "type Shape = Wrap(value: Shape) | Dot\nlet f = s => switch s { | Wrap(Wrap(inner)) when true => inner | _ => s }",
    want: "&& (({ value: { value: inner } }) => (true))((_v as Extract<Shape"
  },
  {
    label: "eager-array match closes with a throw check.mochi proved dead (ADR 0038)",
    src: "let f = xs => switch xs { | [] => 0 | [h, ...t] => h }",
    want: ": (() => { throw new Error(\"non-exhaustive match\"); })())(xs)"
  }
], row => emitted(guardOpts, row.src) |> Str.contains(row.want) |> ok)

/// A scrutinee whose type the backend cannot name.
let genericOpts = { ...jsGenOpts, guardBaseType: Some(_ => None) }

testEach("a nested arm on an unnamed scrutinee type keeps the match() chain", [
  {
    label: "nested arm falls back",
    src: "type Shape = Wrap(value: Shape) | Dot\nlet f = s => switch s { | Wrap(Wrap(inner)) => inner | _ => s }",
    want: "import { match } from \"@onrails/pattern\";"
  },
  {
    label: "shallow arms stay ternaries",
    src: "type Shape = Wrap(value: Shape) | Dot\nlet f = s => switch s { | Wrap(x) => x | Dot => Dot }",
    want: "((_v) => _v._tag === \"Wrap\""
  }
], row => emitted(genericOpts, row.src) |> Str.contains(row.want) |> ok)

test("guardBaseType leaves the JS scrutinee root untouched", () =>
  assertEq(
    false,
    emitted(
      jsGenOpts,
      "type Shape = Dot | Line\nlet f = s => switch s { | Dot => 1 | Line => 2 }"
    )
      |> Str.contains("_g")
  ))

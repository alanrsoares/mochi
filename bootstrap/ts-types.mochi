// TypeScript type rendering for the self-hosted TS backend (ADR 0090).
// This is deliberately below emission: it owns the HM Type -> TS grammar used
// by both typed source and future declarations, while codegen owns syntax.
//
// Every renderer takes a `TsEnv` (ADR 0092): generic letters plus a record
// alias index. A record alias is STRUCTURAL (ADR 0005), so `typeExprToType` has
// already expanded it away by the time a Ty reaches here; the index maps a
// canonical row shape back to the name the module declared, which is what keeps
// the emit from re-printing one record type at hundreds of sites. `plainEnv`
// renders fully structurally.

import {
  TyVar,
  TyCon,
  TyFn,
  TyRecord,
  TySingleton,
  TyOneOf,
  RowEmpty,
  RowVar,
  RowExtend,
  isUnit
} from "./types.mochi"
import { widenLits } from "./schemes.mochi"

/// The rendering environment: generic letters for type AND row vars, plus the
/// record alias index. ONE record rather than two threaded arguments — every
/// emitted function is curried and `curriedOverloads` writes a signature per
/// composition of its arity (ADR 0037), so a second argument DOUBLES the
/// overload block of every renderer carrying it. Annotated at each use so the
/// row stays closed and folds to `TsEnv` rather than printing `{ vars: … } & R`.
export type TsEnv = { vars: Map<number, string>, recs: Map<string, string> }

export let tsEnv = (vars, recs) => { vars, recs }

/// Pinned (ADR 0044): a bare `#{}` generalizes to `Map<unknown, unknown>`, which
/// `_Curry`'s exact argument prefixes reject where the old overload block let it
/// through.
let noVars : Map<number, string> = #{}

let noRecs : Map<string, string> = #{}

/// Letters but no index — the many call sites with no module scope to fold in.
export let plainEnv = vars => tsEnv(vars, noRecs)

/// Index but no letters: a fully concrete type has no generic head to name.
export let recsEnv = recs => tsEnv(noVars, recs)

let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

/// `A`, `B`, … then `T26`, `T27`, … past the alphabet.
export let letterAt = i => Option.unwrapOr("T${show(i)}", Str.get(i, letters))

/// Generic names for both type and row variables. The fresh supply is shared,
/// so the two lists have no colliding ids.
export let genericNames = sc =>
  genericNamesFrom(Array.concat(sc.vars, sc.rvars), 0, #{})

let genericNamesFrom = (ids, i, names) => switch Array.get(i, ids) {
  | None => names
  | Some(id) => genericNamesFrom(ids, i + 1, Map.set(id, letterAt(i), names))
}

let primitiveTs = name => switch name {
  | "number" => "number"
  | "int" => "number"
  | "float" => "number"
  | "string" => "string"
  | "bool" => "boolean"
  | "unit" => "undefined"
  | _ => name
}

let namesOf = (ts, env: TsEnv) =>
  Str.join(", ", ts |> map(t => tsOfRaw(t, env)))

let nominal = (name, args, env: TsEnv) =>
  Array.length(args) == 0 ? primitiveTs(name) : "${name}<${namesOf(args, env)}>"

let tsRowFields = (row, env: TsEnv) => switch row {
  | RowEmpty => ([], None)
  | RowVar(id) => ([], Some(id))
  | RowExtend(label, fieldType, optional, rest) => let (fields, tail) = tsRowFields(
      rest,
      env
    ) in
      (
        Array.prepend(
          "${label}${optional ? "?" : ""}: ${tsOfRaw(fieldType, env)}",
          fields
        ),
        tail
      )
}

/// Fields of a CLOSED row, each rendered with NO index. `None` for an open row:
/// `{ … } & R` is not the alias, only its prefix, so it has no name to take.
let shapeFieldsFrom = (row, vars) => switch row {
  | RowEmpty => Some([])
  | RowVar(_) => None
  | RowExtend(label, fieldType, optional, rest) => shapeFieldsFrom(rest, vars)
      |> Option.map(fs =>
        Array.prepend(
          "${label}${optional ? "?" : ""}: ${tsOf(fieldType, plainEnv(vars))}",
          fs
        ))
}

/// The index key for a row. Sorted, because a row carries fields in the order
/// `unify` extended it: the same record type reaches `tsRow` as both
/// `{ ty; rvars; vars }` and `{ vars; rvars; ty }`, and both must key alike.
/// Rendered index-free so building the index and looking a row up in it can
/// never disagree about a nested field's spelling.
export let rowShapeKey = (row, vars) =>
  shapeFieldsFrom(row, vars) |> Option.map(fs => Str.join("; ", Array.sort(fs)))

/// The declared name for a row, when the emitting module declared one. The
/// empty-index short-circuit keeps the key off the hot path for the many call
/// sites that render with no index at all.
let aliasNameFor = (row, env) =>
  Map.size(env.recs) == 0
    ? None
    : rowShapeKey(row, env.vars)
      |> Option.flatMap(k => switch Map.get(k, env.recs) {
        | Some("") => None
        | Some(name) => Some(name)
        | None => None
      })

let tsRow = (row, env: TsEnv) => switch aliasNameFor(row, env) {
  | Some(alias) => alias
  | None => let (fields, tail) = tsRowFields(row, env) in
    let body = Array.length(fields) == 0
      ? "{}"
      : "{ ${Str.join("; ", fields)} }" in
      switch tail {
        | None => body
        | Some(id) => switch Map.get(id, env.vars) {
            | None => body
            | Some(name) => Array.length(fields) == 0
                ? name
                : "(${body} & ${name})"
          }
      }
}

let tsArrow = (fromT, toT, env: TsEnv) =>
  isUnit(fromT)
    ? "() => ${tsOfRaw(toT, env)}"
    : tsArrowParams(fromT, toT, env, 0, [])

let tsArrowParams = (fromT, toT, env: TsEnv, i, params) =>
  let params1 = Array.append(
    "${Str.fromCode(97 + i)}: ${tsOfRaw(fromT, env)}",
    params
  ) in
    switch toT {
      | TyFn(nextFrom, nextTo) when !isUnit(nextFrom) => tsArrowParams(
          nextFrom,
          nextTo,
          env,
          i + 1,
          params1
        )
      | _ => "(${Str.join(", ", params1)}) => ${tsOfRaw(toT, env)}"
    }

/// Render an already-zonked HM type into strict TypeScript syntax. Bare
/// singleton types widen at this boundary just as the TS backend does.
export let tsOf = (t, env: TsEnv) => tsOfRaw(widenLits(t), env)

let tsOfRaw = (t, env: TsEnv) => switch t {
  | TyVar(id) => Option.unwrapOr("unknown", Map.get(id, env.vars))
  | TyCon("Array", [elem]) => let inner = tsOfRaw(elem, env) in
      switch elem {
        | TyFn(_, _) => "(${inner})[]"
        | TyOneOf(_) => "(${inner})[]"
        | _ => "${inner}[]"
      }
  | TyCon("List", [elem]) => "Iterable<${tsOfRaw(elem, env)}>"
  | TyCon("Task", [value, error]) => "() => Promise<Result<${tsOfRaw(value, env)}, ${tsOfRaw(error, env)}>>"
  | TyCon("tuple", elems) => "[${namesOf(elems, env)}]"
  | TyCon(name, args) => nominal(name, args, env)
  | TyFn(fromT, toT) => tsArrow(fromT, toT, env)
  | TyRecord(row) => tsRow(row, env)
  | TySingleton("string", value) => "\"${value}\""
  | TySingleton(_, value) => value
  | TyOneOf(members) => Str.join(" | ", members |> map(m => tsOfRaw(m, env)))
}

/// A scheme variable prints as `A`, `B`, … then `T26`. A nominal type named
/// `Tok` is not one of those letters, so it must not be treated as a hole.
let isDigitChar = ch => switch Str.codeAt(0, ch) {
  | Some(n) => n >= 48 && n <= 57
  | None => false
}

let isUpperChar = ch => switch Str.codeAt(0, ch) {
  | Some(n) => n >= 65 && n <= 90
  | None => false
}

let allDigitsFrom = (s, i) =>
  i >= Str.length(s)
    ? i > 1
    : isDigitChar(Str.slice(i, i + 1, s)) && allDigitsFrom(s, i + 1)

let isTypeLetter = s =>
  Str.length(s) == 1
    ? isUpperChar(s)
    : Str.length(s) > 1 && Str.slice(0, 1, s) == "T" && allDigitsFrom(s, 1)

let depthStep = (s, i, depth) =>
  let ch = Str.slice(i, i + 1, s) in
    ch == "<" || ch == "{" || ch == "(" || ch == "["
      ? depth + 1
      : ch == "}" || ch == ")" || ch == "]"
      ? depth - 1
      : ch == ">" && (i == 0 || Str.slice(i - 1, i, s) != "=")
      ? depth - 1
      : depth

let hasSuffix = (suf, s) =>
  let n = Str.length(suf) in
  let m = Str.length(s) in m >= n && Str.slice(m - n, m, s) == suf

/// Split on `sep` only at bracket depth 0, so a nested `{ end: number; start: number }`
/// stays one field.
let splitTop = (sep, s) => splitTopAt(sep, s, 0, 0, 0, [])

let splitTopAt = (sep, s, i, depth, start, acc) =>
  i >= Str.length(s)
    ? Array.append(Str.slice(start, Str.length(s), s), acc)
    : let n = Str.length(sep) in
      depth == 0 && i + n <= Str.length(s) && Str.slice(i, i + n, s) == sep
        ? splitTopAt(
          sep,
          s,
          i + n,
          0,
          i + n,
          Array.append(Str.slice(start, i, s), acc)
        )
        : splitTopAt(sep, s, i + 1, depthStep(s, i, depth), start, acc)

let findTop = (ch, s, i, depth) =>
  i >= Str.length(s)
    ? None
    : depth == 0 && Str.slice(i, i + 1, s) == ch
    ? Some(i)
    : findTop(ch, s, i + 1, depthStep(s, i, depth))

let bindLetter = (letter, concrete, subst) => switch Map.get(letter, subst) {
  | None => Some(Map.set(letter, concrete, subst))
  | Some(prev) => prev == concrete ? Some(subst) : None
}

let agreeList = (useTs, aliasTs, subst, i) =>
  Array.length(useTs) != Array.length(aliasTs)
    ? None
    : i >= Array.length(useTs)
    ? Some(subst)
    : switch Array.get(i, useTs) {
      | None => None
      | Some(u) => switch Array.get(i, aliasTs) {
          | None => None
          | Some(a) => switch typesAgree(u, a, subst) {
              | None => None
              | Some(subst1) => agreeList(useTs, aliasTs, subst1, i + 1)
            }
        }
    }

let peelApp = s => switch findTop("<", s, 0, 0) {
  | None => None
  | Some(i) => hasSuffix(">", s) && i > 0
      ? Some(
        {
          name: Str.slice(0, i, s),
          args: Str.slice(i + 1, Str.length(s) - 1, s)
        }
      )
      : None
}

let wrapped = (open, close, s) =>
  Str.startsWith(open, s) && hasSuffix(close, s) && Str.length(s) >= 2

let innerOf = s => Str.slice(1, Str.length(s) - 1, s)

let stripParens = s =>
  wrapped("(", ")", s) ? Str.slice(1, Str.length(s) - 1, s) : s

let agreeArray = (useT, aliasT, subst) =>
  hasSuffix("[]", useT) && hasSuffix("[]", aliasT)
    ? typesAgree(
      stripParens(Str.slice(0, Str.length(useT) - 2, useT)),
      stripParens(Str.slice(0, Str.length(aliasT) - 2, aliasT)),
      subst
    )
    : None

let agreeApp = (useT, aliasT, subst) => switch peelApp(useT) {
  | None => None
  | Some(u) => switch peelApp(aliasT) {
      | None => None
      | Some(a) => u.name == a.name
          ? agreeList(splitTop(", ", u.args), splitTop(", ", a.args), subst, 0)
          : None
    }
}

let splitLabel = s => switch findTop(":", s, 0, 0) {
  | None => None
  | Some(i) => Some(
      { label: Str.slice(0, i, s), ty: Str.slice(i + 1, Str.length(s), s) }
    )
}

let fieldAgree = (useF, aliasF, subst) => switch splitLabel(useF) {
  | None => None
  | Some(u) => switch splitLabel(aliasF) {
      | None => None
      | Some(a) => Str.trim(u.label) == Str.trim(a.label)
          ? typesAgree(Str.trim(u.ty), Str.trim(a.ty), subst)
          : None
    }
}

let fieldsAgree = (useFs, aliasFs, subst) =>
  agreeFields(useFs, aliasFs, subst, 0)

let agreeFields = (useFs, aliasFs, subst, i) =>
  Array.length(useFs) != Array.length(aliasFs)
    ? None
    : i >= Array.length(useFs)
    ? Some(subst)
    : switch Array.get(i, useFs) {
      | None => None
      | Some(u) => switch Array.get(i, aliasFs) {
          | None => None
          | Some(a) => switch fieldAgree(u, a, subst) {
              | None => None
              | Some(subst1) => agreeFields(useFs, aliasFs, subst1, i + 1)
            }
        }
    }

let agreeBrace = (useT, aliasT, subst) =>
  wrapped("{", "}", useT) && wrapped("{", "}", aliasT)
    ? fieldsAgree(
      splitTop("; ", innerOf(useT)),
      splitTop("; ", innerOf(aliasT)),
      subst
    )
    : None

let agreeTuple = (useT, aliasT, subst) =>
  wrapped("[", "]", useT) && wrapped("[", "]", aliasT)
    ? agreeList(
      splitTop(", ", innerOf(useT)),
      splitTop(", ", innerOf(aliasT)),
      subst,
      0
    )
    : None

let agreeUnion = (useT, aliasT, subst) =>
  let us = splitTop(" | ", useT) in
  let als = splitTop(" | ", aliasT) in
    Array.length(us) > 1 && Array.length(us) == Array.length(als)
      ? agreeList(us, als, subst, 0)
      : None

let firstSome = (a, b) => switch a { | Some(_) => a | None => b }

/// `useT` matches `aliasT` exactly, or by binding a scheme letter (`A`, `T26`)
/// to the alias's concrete spelling. The binding has to be consistent: `A`
/// cannot be `number` in one field and `string` in another.
let typesAgree = (useT, aliasT, subst) =>
  useT == aliasT
    ? Some(subst)
    : isTypeLetter(useT)
    ? bindLetter(useT, aliasT, subst)
    : firstSome(
      agreeArray(useT, aliasT, subst),
      firstSome(
        agreeApp(useT, aliasT, subst),
        firstSome(
          agreeBrace(useT, aliasT, subst),
          firstSome(
            agreeTuple(useT, aliasT, subst),
            agreeUnion(useT, aliasT, subst)
          )
        )
      )
    )

/// One alias explains this closed row. Two aliases (a `{ x: A, y: B }` that
/// matches both a numeric point and a string point) explain nothing — folding
/// either name would be a guess.
let uniqueSubst = (useKey, keys, i, found) => switch Array.get(i, keys) {
  | None => found
  | Some(k) => switch fieldsAgree(splitTop("; ", useKey), splitTop("; ", k), #{}) {
      | None => uniqueSubst(useKey, keys, i + 1, found)
      | Some(subst) => switch found {
          | None => uniqueSubst(useKey, keys, i + 1, Some(subst))
          | Some(_) => uniqueSubst(useKey, keys, i + 1, Some(#{ "*": "" }))
        }
    }
}

let substOf = (useKey, env) => switch uniqueSubst(useKey, Map.keys(env.recs), 0, None) {
  | None => None
  | Some(subst) => Map.has("*", subst) ? None : Some(subst)
}

let idForLetter = (letter, ids, vars, i) => switch Array.get(i, ids) {
  | None => None
  | Some(id) => switch Map.get(id, vars) {
      | Some(name) => name == letter
          ? Some(id)
          : idForLetter(letter, ids, vars, i + 1)
      | None => idForLetter(letter, ids, vars, i + 1)
    }
}

/// A variable pinned to two different concrete types is dropped. Printing it
/// as either one would make the other occurrence not assignable.
let notePin = (id, concrete, st) =>
  Set.has(id, st.bad)
    ? st
    : switch Map.get(id, st.pins) {
      | None => { pins: Map.set(id, concrete, st.pins), bad: st.bad }
      | Some(prev) => prev == concrete
          ? st
          : { pins: Map.delete(id, st.pins), bad: Set.add(id, st.bad) }
    }

let mergeSubst = (letters, subst, vars, ids, st, i) => switch Array.get(i, letters) {
  | None => st
  | Some(letter) => switch Map.get(letter, subst) {
      | None => mergeSubst(letters, subst, vars, ids, st, i + 1)
      | Some(concrete) => switch idForLetter(letter, ids, vars, 0) {
          | None => mergeSubst(letters, subst, vars, ids, st, i + 1)
          | Some(id) => mergeSubst(
              letters,
              subst,
              vars,
              ids,
              notePin(id, concrete, st),
              i + 1
            )
        }
    }
}

let emptyPins = { pins: #{}, bad: Set.fromArray([]) }

let considerClosed = (row, env, st) => switch rowShapeKey(row, env.vars) {
  | None => st
  | Some(key) => switch Map.get(key, env.recs) {
      | Some(_) => st
      | None => switch substOf(key, env) {
          | None => st
          | Some(subst) => mergeSubst(
              Map.keys(subst),
              subst,
              env.vars,
              Map.keys(env.vars),
              st,
              0
            )
        }
    }
}

let pinInTys = (ts, env, st, i) => switch Array.get(i, ts) {
  | None => st
  | Some(t) => pinInTys(ts, env, pinInTy(t, env, st), i + 1)
}

let pinInRow = (row, env, st) => switch row {
  | RowExtend(_, ft, _, rest) => pinInRow(rest, env, pinInTy(ft, env, st))
  | _ => st
}

let pinInTy = (t, env, st) => switch t {
  | TyRecord(row) => pinInRow(row, env, considerClosed(row, env, st))
  | TyFn(a, b) => pinInTy(b, env, pinInTy(a, env, st))
  | TyCon(_, args) => pinInTys(args, env, st, 0)
  | TyOneOf(ms) => pinInTys(ms, env, st, 0)
  | _ => st
}

/// Variables a unique in-scope record alias explains, as concrete type text.
/// Open rows are skipped: `{ start: A, end: B } & R` is not the alias. An
/// exact key needs no pin — `aliasNameFor` already prints the name.
let pinAliasVars = (t, env) => pinInTy(t, env, emptyPins).pins

let overlayPins = (ids, pins, names, i) => switch Array.get(i, ids) {
  | None => names
  | Some(id) => switch Map.get(id, pins) {
      | Some(concrete) => overlayPins(
          ids,
          pins,
          Map.set(id, concrete, names),
          i + 1
        )
      | None => overlayPins(ids, pins, names, i + 1)
    }
}

let headLetters = (names, pins) =>
  let letters = Map.keys(names)
    |> filter(id => !Map.has(id, pins))
    |> map(id => Option.unwrapOr("", Map.get(id, names))) in
    Array.length(letters) == 0 ? "" : "<${Str.join(", ", letters)}>"

/// Render a scheme with record-alias pins applied (ADR 0106). The same
/// substitution covers every occurrence of a variable, so a parameter and the
/// return cannot disagree about it. `head` omits pinned letters — they are
/// concrete type text now, not parameters. `pins` is the id → text map a
/// non-function binding can print with, leaving every unpinned var `unknown`.
export let schemeRender = (sc, recs) =>
  let names = genericNames(sc) in
  let pins = pinAliasVars(sc.ty, tsEnv(names, recs)) in
    {
      env: tsEnv(overlayPins(Map.keys(pins), pins, names, 0), recs),
      head: headLetters(names, pins),
      pins
    }

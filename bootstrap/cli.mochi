// Ticket 0006 / 0013 — the shipped `mochic` entry point. Two modes:
//
//   mochic <file.mochi>        single-file, open-world (compile.mochi) — imports in
//                           the source are left unresolved; writes one sibling
//                           `.js`; a failure prints `path:line:col: message`.
//   mochic build <entry.mochi> multi-file: resolve the import graph from `entry`,
//                           compile every module in dependency order with real
//                           cross-module inference + exhaustiveness (module.mochi),
//                           and write a `.js` beside each `.mochi`.
//
// Runs as emitted JS under Bun; the only npm deps are @onrails/{pattern,result}.
import { compile, compileTs } from "./compile.mochi"
import { formatProgram } from "./format.mochi"
import { lex } from "./lexer.mochi"
import { parseRecovering } from "./parser.mochi"
import { emitDtsText } from "./dts.mochi"
import { buildModules, buildModulesTs } from "./module.mochi"

type Diag = { message: string, start: number, end: number }

extern readFile : string -> Result<string, string> = "./host.mjs" "readFile"
extern writeFile : string -> string -> Result<string, string> = "./host.mjs" "writeFile"
extern argv : [string] = "./host.mjs" "argv"
extern isCliEntry : () -> bool = "./host.mjs" "isCliEntry"
extern print : string -> string = "./host.mjs" "print"
extern emit : string -> string = "./host.mjs" "emit"
extern die : string -> a = "./host.mjs" "die"
extern formatError : string -> string -> Diag -> string = "./host.mjs" "formatError"

// "foo.mochi" -> "foo.js"  (drops the 6-char `.mochi` suffix).
export let outPath = path => "${Str.slice(0, Str.length(path) - 6, path)}.js"

// "foo.mochi" -> "foo.ts" — the typed-emit sibling (ADR 0090).
export let tsOutPath = path => "${Str.slice(0, Str.length(path) - 6, path)}.ts"

// "foo.mochi" -> "foo.d.mochi.ts" — the sidecar `allowArbitraryExtensions` resolves.
export let dtsOutPath = path =>
  "${Str.slice(0, Str.length(path) - 6, path)}.d.mochi.ts"

// `mochic fmt` (ADR 0025). The recovering parse never fails (ADR 0045), so lex
// is the only error channel here — an unparsable region round-trips verbatim
// rather than costing the whole file its formatting. Mirrors `@mochi/dx`'s
// `format`, minus the plugin `format` hooks, which stay a TS-host seam.
export let formatSrc = src =>
  let? toks = src->lex() in
    Ok(formatProgram(parseRecovering(toks, None).stmts, src))

// The formatted text, or the file's first lex error rendered `path:line:col:`.
export let fmtText = path =>
  let? src = path->readFile() in
    src->formatSrc() |> Result.mapErr(e => path->formatError(src, e))

// Format one file: to stdout by default, back over the source under `--write`.
export let fmtOne = (path, write) =>
  let? out = path->fmtText() in
    write
      ? writeFile(path, out) |> Result.map(p => print("wrote ${p}"))
      : Ok(emit(out))

// Single-file build: open-world compile, one written `.js`. Every arm of the
// railway carries a string error (readFile's, or compile's via formatError).
export let buildOne = path =>
  let? src = path->readFile() in
  let? js = src->compile() |> Result.mapErr(e => path->formatError(src, e)) in
    outPath(path)->writeFile(js)

// Single-file typed emit: one written `.ts` (ADR 0090). Same railway as
// `buildOne`, but through the TypeScript backend.
export let buildOneTs = (path, runtimeImport) =>
  let? src = path->readFile() in
  let? ts = compileTs(src, runtimeImport)
    |> Result.mapErr(e => path->formatError(src, e)) in
    tsOutPath(path)->writeFile(ts)

export let buildOneDts = (path, runtimeImport) =>
  let? src = path->readFile() in
  let? dts = emitDtsText(src, runtimeImport)
    |> Result.mapErr(e => path->formatError(src, e)) in
    dtsOutPath(path)->writeFile(dts)

// Write each compiled module's JS beside its source, logging as it goes. A
// write failure short-circuits with the host's string error.
export let writeAll = outs =>
  loop (remaining = outs) {
    switch remaining {
      | [] => Ok("")
      | [o, ...rest] => switch writeFile(o.path->outPath(), o.js) {
          | Err(e) => Err(e)
          | Ok(w) => let _printed = print("  wrote ${w}") in recur(rest)
        }
    }
  }

// Typed-emit writer. A module output keeps its `.mochi` path (swapped to `.ts`
// here); an extern sidecar (`host.d.mts`) is already a real declaration path and
// is written as-is.
let tsWritePath = (path, body) =>
  Str.endsWith(".mochi", path)
    ? Str.startsWith("/** @jsx h */", body)
      ? "${Str.slice(0, Str.length(path) - 6, path)}.tsx"
      : tsOutPath(path)
    : path

export let writeAllTs = outs =>
  loop (remaining = outs) {
    switch remaining {
      | [] => Ok("")
      | [o, ...rest] => switch writeFile(tsWritePath(o.path, o.js), o.js) {
          | Err(e) => Err(e)
          | Ok(w) => let _printed = print("  wrote ${w}") in recur(rest)
        }
    }
  }

// Multi-file TYPED build (ADR 0090): the stage-1 graph. Same shape as
// `buildMulti`, but through the TypeScript backend, so it also drops one
// declaration sidecar per extern host module.
export let buildMultiTs = (entry, runtimeImport) =>
  buildModulesTs(entry, runtimeImport)
    |> Result.mapErr(e => e.message)
    |> Result.flatMap(writeAllTs)

// Multi-file build: resolve + compile the graph, then write all outputs. The
// driver's diagnostic (a graph/type/exhaustiveness error) has no single source
// file to anchor a line:col against, so we surface its message (as src/cli.ts's
// build does — span parity across modules is a later refinement).
export let buildMulti = entry =>
  buildModules(entry)
    |> Result.mapErr(e => e.message)
    |> Result.flatMap(writeAll)

/// Invoke only when Bun executes cli.js / cli.ts directly. Importing it from a
/// colocated unit spec must expose the helpers above without exiting the test process.
/// `_`-prefixed because the name exists to hold an effect, not to be read — mochi
/// has no top-level expression statement (ADR 0094).
let _runEntry = isCliEntry(())
  ? switch Array.get(0, argv) {
    | None => die(
        "usage: mochic <file.mochi>  |  mochic fmt [--write] <file.mochi>  |  mochic ts <file.mochi>  |  mochic dts <file.mochi>  |  mochic build [--emit=ts] <entry.mochi>"
      )
    | Some("fmt") => let write = switch Array.get(1, argv) {
        | Some("--write") => true
        | _ => false
      } in
        switch Array.get(write ? 2 : 1, argv) {
          | None => die("usage: mochic fmt [--write] <file.mochi>")
          | Some(path) => switch fmtOne(path, write) {
              | Ok(_) => ""
              | Err(msg) => die(msg)
            }
        }
    | Some("ts") => switch Array.get(1, argv) {
        | None => die("usage: mochic ts <file.mochi>")
        | Some(path) => switch buildOneTs(path, "@mochi/runtime") {
            | Ok(out) => print("wrote ${out}")
            | Err(msg) => die(msg)
          }
      }
    | Some("dts") => switch Array.get(1, argv) {
        | None => die("usage: mochic dts <file.mochi>")
        | Some(path) => switch buildOneDts(path, "@mochi/runtime") {
            | Ok(out) => print("wrote ${out}")
            | Err(msg) => die(msg)
          }
      }
    | Some("build") => switch Array.get(1, argv) {
        | None => die("usage: mochic build [--emit=ts] <entry.mochi>")
        | Some("--emit=ts") => switch Array.get(2, argv) {
            | None => die("usage: mochic build --emit=ts <entry.mochi>")
            | Some(entry) => switch buildMultiTs(entry, "@mochi/runtime") {
                | Ok(_) => print("build ok")
                | Err(msg) => die(msg)
              }
          }
        | Some(entry) => switch buildMulti(entry) {
            | Ok(_) => print("build ok")
            | Err(msg) => die(msg)
          }
      }
    | Some(path) => switch buildOne(path) {
        | Ok(out) => print("wrote ${out}")
        | Err(msg) => die(msg)
      }
  }
  : ""

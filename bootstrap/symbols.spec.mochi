import { assertEq, ok, test } from "@mochi/test"
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"
import { index, indexWith } from "./symbols.mochi"

let indexed = src => lex(src) |> Result.flatMap(parse) |> Result.map(index)

test("symbol index keeps shadowed local lets distinct", () => switch indexed("let x = 1\nlet f = let x = 2 in x\nx") {
  | Ok(occurrences) => Array.length(
      occurrences
    ) == 5 && (occurrences
      |> Array.get(2)
      |> Option.map(o => o.defStart == 22 && o.start == 22)
      |> Option.unwrapOr(
        false
      )) && (occurrences
      |> Array.get(3)
      |> Option.map(o => o.defStart == 22 && o.start == 31)
      |> Option.unwrapOr(
        false
      )) && (occurrences
      |> Array.get(4)
      |> Option.map(o => o.defStart == 4 && o.start == 33)
      |> Option.unwrapOr(false))
      |> ok
  | _ => false |> ok
})

test("pattern bindings cover only their match arm", () => switch indexed("let x = 1\nswitch x { | y => y }\nx") {
  | Ok(occurrences) => assertEq(5, Array.length(occurrences))
  | Err(_) => assertEq(true, false)
})

test("lambda parameter uses resolve to the parameter declaration", () => switch indexed("let x = 1\nlet f = x => x\nx") {
  | Ok(occurrences) => occurrences
      |> Array.get(2)
      |> Option.map(o => o.name == "x" && o.defStart == 18 && o.start == 18)
      |> Option.unwrapOr(false)
      |> ok
  | Err(_) => false |> ok
})

test("a let? binder resolves its body uses to itself", () => switch indexed("let f = o => let? v = o in Some(v)") {
  | Ok(occurrences) => occurrences
      |> Array.filter(o => o.name == "v")
      |> Array.map(o => (o.role, o.defStart, o.start))
      |> assertEq([("def", 18, 18), ("use", 18, 32)])
  | Err(_) => false |> ok
})

let noOrigins = { values: #{}, types: #{}, ctors: #{} }
let noPrelude = { origins: noOrigins, members: #{} }

let spacedWhere = (origins, prelude, keep, src) =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.map(stmts =>
      indexWith("/m.mochi", origins, prelude, stmts).occurrences)
    |> Result.map(occs =>
      occs
        |> Array.filter(keep)
        |> Array.map(o => (o.space, o.role, o.defPath, o.defStart, o.start)))

let spaced = (origins, prelude, src) =>
  spacedWhere(origins, prelude, _ => true, src)

test("types and ctors index in their own spaces", () =>
  assertEq(
    Ok(
      [
        ("type", "def", "/m.mochi", 5, 5),
        ("ctor", "def", "/m.mochi", 9, 9),
        ("value", "def", "/m.mochi", 15, 15),
        ("type", "use", "/m.mochi", 5, 18),
        ("ctor", "use", "/m.mochi", 9, 22)
      ]
    ),
    spaced(noOrigins, noPrelude, "type T = A\nlet x: T = A")
  ))

test("an imported name resolves to its export site", () =>
  let origins = {
    values: #{ "f": { path: "/dep.mochi", start: 4, end: 5 } },
    types: #{},
    ctors: #{}
  } in
    assertEq(
      Ok(
        [
          ("value", "use", "/dep.mochi", 4, 9),
          ("value", "use", "/dep.mochi", 4, 32)
        ]
      ),
      spaced(origins, noPrelude, "import { f } from \"./dep.mochi\"\nf(1)")
    ))

test("the first site of a field name is its def, later sites use it", () =>
  assertEq(
    Ok(
      [
        ("field", "def", "/m.mochi", 10, 10),
        ("field", "use", "/m.mochi", 10, 27)
      ]
    ),
    spacedWhere(
      noOrigins,
      noPrelude,
      o => o.space == "field",
      "let r = { x: 1 }\nlet y = r.x"
    )
  ))

test("a prelude namespace member resolves to the prelude, not a field", () =>
  let prelude = {
    origins: { values: #{}, types: #{}, ctors: #{} },
    members: #{
      "Array.map": { path: "mochi:/prelude.mochi", start: 7, end: 10 }
    }
  } in
    assertEq(
      Ok([("value", "use", "mochi:/prelude.mochi", 7, 14)]),
      spacedWhere(noOrigins, prelude, o => o.role == "use", "let m = Array.map")
    ))

// ---- scope frames (ADR 0120) ----

/// Each local scope as `start-end: names`, in the order the walk closes them.
let framesOf = src =>
  lex(src)
    |> Result.flatMap(parse)
    |> Result.map(stmts =>
      indexWith("/m.mochi", noOrigins, noPrelude, stmts).frames
        |> Array.map(f =>
          "${show(f.start)}-${show(f.end)}: ${Str.join(",", Array.sort(Map.keys(f.binds)))}"))
    |> Result.unwrapOr([])

test("a lambda's frame spans the lambda and holds its params", () =>
  assertEq(["8-19: a,b"], framesOf("let f = (a, b) => a")))

test("a let … in frame spans only its body", () =>
  assertEq(["21-22: y"], framesOf("let n = let y = 1 in y")))

test("inner frames close before the scopes around them", () =>
  assertEq(["26-27: y", "8-27: x"], framesOf("let f = x => let y = x in y")))

test("a scope that binds nothing leaves no frame", () =>
  assertEq([], framesOf("let f = () => 1")))

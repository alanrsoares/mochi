import { assertEq, testEach } from "@mochi/test"
import * as Ast from "./ast.mochi"
import { patConds, patSlot, patTarget } from "./codegen-pattern.mochi"

let span = { start: 0, end: 0 }
let bind = name => Ast.PBind(name, span)
let wild = Ast.PWild(span)
let some = pat => Ast.PCtor("Some", [pat], None, span)
let keys = #{ "Some": ["value"], "Box": ["payload"], "Other": ["value"] }

// The same structural interface serves ternaries, matcher guards, and elements
// pulled by lazy-List arms. No expression emitter or annotation hooks needed.
testEach("structural pattern plans", [
  {
    label: "nested labelled constructors",
    pat: Ast.PCtor("Box", [some(bind("n"))], None, span),
    conds: ["root._tag === \"Box\"", "root.payload._tag === \"Some\""],
    slot: "{ payload: { value: n } }"
  },
  {
    label: "unknown constructor keys use positions",
    pat: Ast.PCtor("Pair", [wild, bind("right")], None, span),
    conds: ["root._tag === \"Pair\""],
    slot: "{ _1: right }"
  },
  {
    label: "record labels are punned",
    pat: Ast.PRecord(
      [{ label: "name", labelSpan: span, pat: bind("name") }],
      span
    ),
    conds: [],
    slot: "{ name }"
  },
  {
    label: "tuple tests have no length check and preserve holes",
    pat: Ast.PTuple([wild, some(bind("n")), wild], span),
    conds: ["root[1]._tag === \"Some\""],
    slot: "[, { value: n }, ]"
  },
  {
    label: "array head with rest",
    pat: Ast.PArr([some(bind("n"))], Some(bind("tail")), span),
    conds: ["root.length >= 1", "root[0]._tag === \"Some\""],
    slot: "[{ value: n }, ...tail]"
  },
  {
    label: "exact array length",
    pat: Ast.PArr([Ast.PBool(true, span)], None, span),
    conds: ["root.length === 1", "root[0] === true"],
    slot: ""
  },
  {
    label: "or alternatives use aligned first slot",
    pat: Ast.POr(
      [some(bind("n")), Ast.PCtor("Other", [bind("n")], None, span)],
      span
    ),
    conds: ["((root._tag === \"Some\")) || ((root._tag === \"Other\"))"],
    slot: "{ value: n }"
  },
  {
    label: "whole-value alias retains nested slot",
    pat: Ast.PAs(some(bind("n")), "whole", span, span),
    conds: ["root._tag === \"Some\""],
    slot: "{ value: n }, whole"
  },
  {
    label: "decoded strings are escaped",
    pat: Ast.PStr("a\n\t\"\\", span),
    conds: ["root === \"a\\n\\t\\\"\\\\\""],
    slot: ""
  },
  { label: "unit is irrefutable", pat: Ast.PUnit(span), conds: [], slot: "" }
], row => {
  assertEq(row.conds, patConds(keys, row.pat, "root"));
  assertEq(row.slot, patSlot(keys, row.pat))
})

testEach("pattern type refinement", [
  {
    pat: some(bind("n")),
    base: "Option<number>",
    target: "Extract<Option<number>, { _tag: \"Some\" }>"
  },
  {
    pat: Ast.PTuple([some(bind("n")), wild], span),
    base: "Pair",
    target: "[Extract<(Pair)[0], { _tag: \"Some\" }>, (Pair)[1]]"
  },
  {
    pat: Ast.PArr([some(bind("n"))], Some(bind("tail")), span),
    base: "Values",
    target: "[Extract<(Values)[number], { _tag: \"Some\" }>, ...Values]"
  },
  {
    pat: Ast.PRecord(
      [{ label: "item", labelSpan: span, pat: some(bind("n")) }],
      span
    ),
    base: "Record",
    target: "Record & { \"item\": Extract<Record[\"item\"], { _tag: \"Some\" }> }"
  },
  {
    pat: Ast.POr([some(bind("n")), some(bind("n"))], span),
    base: "Option<number>",
    target: "Option<number>"
  },
  { pat: Ast.PTuple([bind("n"), wild], span), base: "Pair", target: "Pair" }
], row => assertEq(row.target, patTarget(keys, row.pat, row.base)))

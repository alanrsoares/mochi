// bootstrap/codegen-ts.mochi — the TypeScript backend, in mochi (ADR 0026 / 0090).
//
// Not a fresh emitter: it drives the ONE shared codegen through the `GenOpts`
// hooks (codegen.mochi) with types supplied by `inferProgramTypes`
// (infer.mochi) and rendered by `tsOf` (ts-types.mochi). Values come from
// codegen, types come from here, and the two meet at the hook boundary.
//
// This file owns the DECLARATION layer: a `type` decl becomes an exported
// tagged union matching the runtime `_tag` shape, and a record alias becomes an
// exported object type. Ports src/dts/dts.ts's `typeDecl` / `aliasTsDecl` /
// `unionGenericNames`; the annotation hooks land in a later slice.

import * as Ast from "./ast.mochi"

import {
  mkSt,
  freshVar,
  tVar,
  TyVar,
  TyCon,
  TyFn,
  TyRecord,
  TySingleton,
  TyOneOf,
  RowEmpty,
  RowVar,
  RowExtend,
  isUnit
} from "./types.mochi"
import { typeExprToType, collect, emptyVarSets } from "./schemes.mochi"
import { builtinTypeDecls, keysOf } from "./ctors.mochi"
import { codegenWith, jsDoc, jsGenOpts, runtimeDepNames } from "./codegen.mochi"
import { inferProgramTypes, exprSpan } from "./infer.mochi"
import {
  genericNames,
  letterAt,
  plainEnv,
  recsEnv,
  rowShapeKey,
  tsEnv,
  tsOf
} from "./ts-types.mochi"

/// Type params are bound POSITIONALLY: the i-th param is var `i`, rendered as
/// the i-th letter. Both maps are built from one index so a field type and the
/// declaration head always agree on a param's letter.
let paramVarsFrom = (params, i) => switch Array.get(i, params) {
  | None => #{}
  | Some(p) => Map.set(p, tVar(i), paramVarsFrom(params, i + 1))
}

let paramNamesFrom = (params, i) => switch Array.get(i, params) {
  | None => #{}
  | Some(_) => Map.set(i, letterAt(i), paramNamesFrom(params, i + 1))
}

/// `<A, B>` for a parameterised decl, `""` for a nullary one.
let genericHead = (params, i, acc) => switch Array.get(i, params) {
  | None => Array.length(acc) == 0 ? "" : "<${Str.join(", ", acc)}>"
  | Some(_) => genericHead(params, i + 1, Array.append(letterAt(i), acc))
}

/// A ctor field's type is a full TypeExpr (ADR 0015). Lower it to a Ty first —
/// params bound positionally, aliases left nominal — then render through `tsOf`,
/// so the TS grammar has exactly one encoder.
let fieldTs = (te, params, aliases: Map<string, AliasInfo>, recs) =>
  let vars = paramVarsFrom(params, 0) in
  let names = paramNamesFrom(params, 0) in
  let (t, _vars, _st) = typeExprToType(
    te,
    vars,
    mkSt(Array.length(params)),
    aliases,
    Set.fromArray([])
  ) in
    tsOf(t, tsEnv(names, recs))

/// Keys come from `keysOf` (the same projection the runtime shape uses, so a
/// declared field name and its emitted key can never drift); this loop only
/// ever reads `fieldType`.
let ctorFieldsFrom = (fields: [Ast.CtorField], keys, params, aliases: Map<string, AliasInfo>, recs, i) => switch Array.get(i, fields) {
  | None => []
  | Some(fld) => Array.prepend(
      "${Option.unwrapOr("_${show(i)}", Array.get(i, keys))}: ${fieldTs(fld.fieldType, params, aliases, recs)}",
      ctorFieldsFrom(fields, keys, params, aliases, recs, i + 1)
    )
}

/// One ctor's runtime shape: the `_tag` discriminant plus its fields.
let ctorVariant = (c: Ast.Ctor, params, aliases: Map<string, AliasInfo>, recs) =>
  let fields = ctorFieldsFrom(
    c.fields,
    keysOf(c.fields),
    params,
    aliases,
    recs,
    0
  ) in
    Array.length(fields) == 0
      ? "{ _tag: \"${c.name}\" }"
      : "{ _tag: \"${c.name}\"; ${Str.join("; ", fields)} }"

let ctorVariantsFrom = (ctors: [Ast.Ctor], params, aliases: Map<string, AliasInfo>, recs, i) => switch Array.get(i, ctors) {
  | None => []
  | Some(c) => Array.prepend(
      "  | ${ctorVariant(c, params, aliases, recs)}",
      ctorVariantsFrom(ctors, params, aliases, recs, i + 1)
    )
}

/// A `type` decl -> an exported tagged union matching the runtime shape.
export let typeDecl = (name, params, ctors: [Ast.Ctor], aliases: Map<string, AliasInfo>, recs) =>
  let head = "${name}${genericHead(params, 0, [])}" in
    "export type ${head} =\n${Str.join("\n", ctorVariantsFrom(ctors, params, aliases, recs, 0))};"

let aliasFieldsFrom = (fields: [Ast.AliasField], params, aliases: Map<string, AliasInfo>, recs, i) => switch Array.get(i, fields) {
  | None => []
  | Some(f) => Array.prepend(
      "${f.name}${f.optional ? "?" : ""}: ${fieldTs(f.fieldType, params, aliases, recs)}",
      aliasFieldsFrom(fields, params, aliases, recs, i + 1)
    )
}

/// A record alias (`type Point = { x: number, y: number }`) -> an exported
/// object type. Structural, so it renders through the same `tsOf` encoder.
export let recordAliasDecl = (name, params, fields: [Ast.AliasField], aliases: Map<string, AliasInfo>, recs) =>
  let head = "${name}${genericHead(params, 0, [])}" in
  let body = aliasFieldsFrom(fields, params, aliases, recs, 0) in
    Array.length(body) == 0
      ? "export type ${head} = {};"
      : "export type ${head} = { ${Str.join("; ", body)} };"

/// A transparent type alias (`type Id = number`) -> the aliased type directly.
export let aliasTsDecl = (name, params, template, aliases: Map<string, AliasInfo>, recs) =>
  let head = "${name}${genericHead(params, 0, [])}" in
    "export type ${head} = ${fieldTs(template, params, aliases, recs)};"

/// An opaque `extern type` has no structure to print: a unique-symbol brand
/// keeps it nominal and unforgeable on the TS side.
export let opaqueTypeDecl = name =>
  "declare const ${name}: unique symbol;\nexport type ${name} = { readonly [${name}]: never };"

/// Union the letter maps of several schemes — ids are globally unique, so a
/// later scheme never clobbers an earlier one's letter (ADR 0042).
let mergeInto = (keys, src, acc, i) => switch Array.get(i, keys) {
  | None => acc
  | Some(k) => mergeInto(
      keys,
      src,
      switch Map.get(k, src) { | Some(v) => Map.set(k, v, acc) | None => acc },
      i + 1
    )
}

let unionNamesFrom = (schemes, i, acc) => switch Array.get(i, schemes) {
  | None => acc
  | Some(sc) => let names = genericNames(sc) in
      unionNamesFrom(schemes, i + 1, mergeInto(Map.keys(names), names, acc, 0))
}

export let unionGenericNames = schemes => unionNamesFrom(schemes, 0, #{})

// ---- type-level predicates -------------------------------------------------

/// Every type AND row var in a (zonked) type is a key of `names`. Unlike
/// `freeInType` (type vars only) this also inspects a record's trailing row
/// var, so an open record `{ … } & R` counts as fully in scope only when `R`
/// too carries a letter — the precondition for rendering the tail rather than
/// dropping it. An empty `names` therefore means "fully concrete".
let allVarsIn = (t, names) => switch t {
  | TyVar(id) => Option.isSome(Map.get(id, names))
  | TyCon(_, args) => allVarsInAll(args, names, 0)
  | TyFn(fromT, toT) => allVarsIn(fromT, names) && allVarsIn(toT, names)
  | TyRecord(row) => allVarsInRow(row, names)
  | TySingleton(_, _) => true
  | TyOneOf(members) => allVarsInAll(members, names, 0)
}

let allVarsInAll = (ts, names, i) => switch Array.get(i, ts) {
  | None => true
  | Some(t) => allVarsIn(t, names) && allVarsInAll(ts, names, i + 1)
}

let allVarsInRow = (row, names) => switch row {
  | RowEmpty => true
  | RowVar(id) => Option.isSome(Map.get(id, names))
  | RowExtend(_, fieldType, _, rest) => allVarsIn(
      fieldType,
      names
    ) && allVarsInRow(rest, names)
}

/// No `names` in scope, so this is true exactly when the type is fully concrete.
let isConcrete = t => allVarsIn(t, #{})

// ---- annotation hooks ------------------------------------------------------

/// TS type for an EMPTY literal (`#{}` / `[]` / `@{}` / `Set.empty`). Such a
/// seed infers `Map<unknown, unknown>` / `never[]` / `Set<never>`, which will
/// not flow into a concretely-typed position (ADR 0035). `names` carries an
/// enclosing generic binding's letters (ADR 0042), so a seed whose element type
/// is one of those renders as the letter instead of being skipped; with no such
/// scope only a fully concrete type renders, since a free var would become
/// `unknown` — no better than tsc's own guess.
export let emptyCollTs = (t, env) =>
  allVarsIn(t, env.vars) ? Some(tsOf(t, env)) : None

/// TS type for an APPLIED parametric ctor call (`Ok(x)`), else `None`. A ctor's
/// argument pins only the params it mentions; a phantom one (`Ok`'s error type)
/// stays free and widens to `unknown`, which then fails to unify with a sibling
/// match arm (ADR 0043). Fully-concrete applied cons only — a nullary con or a
/// free var would render no better than tsc manages alone.
export let ctorCallTs = (t, recs) => switch t {
  | TyCon(_, args) => Array.length(args) == 0 || !isConcrete(t)
      ? None
      : Some(tsOf(t, recsEnv(recs)))
  | _ => None
}

/// A match scrutinee's concrete TS type — the base a guard-form arm's predicate
/// narrows FROM (ADR 0031). Concrete only: a scrutinee with free vars cannot
/// name its generics in value position (TS2304), so those keep the bare boolean
/// guard and their handlers keep the polymorphic tail.
export let guardParamTs = (t, recs) =>
  isConcrete(t) ? Some(tsOf(t, recsEnv(recs))) : None

/// Peel one arrow per collapsed lambda param, annotating each (ADR 0028).
/// A param whose vars are ALL in scope renders with those letters (ADR 0042);
/// otherwise only a fully concrete param renders, because a generic binding's
/// letters live on the const's TYPE head and naming one in a value position
/// would be an out-of-scope TS2304.
let lambdaParamsFrom = (t, arity, env, i) =>
  i >= arity
    ? []
    : switch t {
      | TyFn(fromT, toT) => Array.prepend(
          allVarsIn(fromT, env.vars)
            ? Some(tsOf(fromT, env))
            : isConcrete(fromT)
            ? Some(tsOf(fromT, recsEnv(env.recs)))
            : None,
          lambdaParamsFrom(toT, arity, env, i + 1)
        )
      | _ => Array.prepend(None, lambdaParamsFrom(t, arity, env, i + 1))
    }

export let lambdaParamTypesTs = (lamType, arity, env) =>
  lambdaParamsFrom(lamType, arity, env, 0)

/// Every param annotated with the scheme's OWN letters, scoped by a generic
/// head on the arrow itself (ADR 0032). This closes the polymorphic
/// higher-order tail ADR 0028 leaves open: `lambdaParamTypesTs` skips generic
/// params precisely because their letters are out of scope in the value
/// expression, so `_curry` erased them to `any`. Scoping the SAME letters on
/// the lambda brings them into value scope. `None` when the binding is not
/// generic — the concrete-only path already covers it.
let genericParamsFrom = (t, arity, env, i) =>
  i >= arity
    ? []
    : switch t {
      | TyFn(fromT, toT) => Array.prepend(
          Some(tsOf(fromT, env)),
          genericParamsFrom(toT, arity, env, i + 1)
        )
      | _ => Array.prepend(None, genericParamsFrom(t, arity, env, i + 1))
    }

export let genericLambdaParams = (sc, arity, recs) =>
  let names = genericNames(sc) in
  let env = tsEnv(names, recs) in
    Map.size(names) == 0
      ? None
      : Some(
        {
          generics: "<${Str.join(", ", Map.values(names))}>",
          params: genericParamsFrom(sc.ty, arity, env, 0)
        }
      )

/// The typing for one variant ctor's factory (`GenOpts.annotateCtor`).
/// `retMono` pins every param to `never` so a NULLARY ctor's const keeps its
/// literal `_tag` instead of widening to `string`.
let neverArgs = (params, i, acc) => switch Array.get(i, params) {
  | None => acc
  | Some(_) => neverArgs(params, i + 1, Array.append("never", acc))
}

let ctorParamTypes = (fields: [Ast.CtorField], params, aliases: Map<string, AliasInfo>, recs, i) => switch Array.get(i, fields) {
  | None => []
  | Some(fld) => Array.prepend(
      fieldTs(fld.fieldType, params, aliases, recs),
      ctorParamTypes(fields, params, aliases, recs, i + 1)
    )
}

export let ctorFactoryTs = (typeName, params, c: Ast.Ctor, aliases: Map<string, AliasInfo>, recs) =>
  let head = genericHead(params, 0, []) in
  let monos = neverArgs(params, 0, []) in
    {
      generics: head,
      paramTypes: ctorParamTypes(c.fields, params, aliases, recs, 0),
      ret: "${typeName}${head}",
      retMono: Array.length(monos) == 0
        ? typeName
        : "${typeName}<${Str.join(", ", monos)}>"
    }

// ---- binding types (ADR 0026 / 0037) ---------------------------------------

/// A lambda param's declared NAME (destructuring params take a positional
/// placeholder — the type is what matters here, not the binder shape).
let paramDeclName = (p, i) => switch p {
  | Ast.LPName(name, _) => name
  | _ => "_${show(i)}"
}

/// Every ordered composition of `n` — `3` gives [1,1,1], [1,2], [2,1], [3].
/// Longest first, so the flat all-at-once signature is emitted LAST.
let compositions = n => n == 0 ? [[]] : compositionsFrom(n, 1)

let compositionsFrom = (n, k) =>
  k > n
    ? []
    : Array.concat(
      compositions(n - k) |> map(Array.prepend(k)),
      compositionsFrom(n, k + 1)
    )

/// Slice `params` into consecutive groups of the given sizes.
let sliceGroups = (params, groups, i, at) => switch Array.get(i, groups) {
  | None => []
  | Some(g) => Array.prepend(
      Array.take(g, Array.drop(at, params)),
      sliceGroups(params, groups, i + 1, at + g)
    )
}

/// Fold the trailing groups into a curried tail: `(c) => (d) => R`.
let curriedTail = (slices, i, acc) =>
  i < 1
    ? acc
    : curriedTail(
      slices,
      i - 1,
      "(${Str.join(", ", Option.unwrapOr([], Array.get(i, slices)))}) => ${acc}"
    )

let overloadSig = (head, params, ret, groups) =>
  let slices = sliceGroups(params, groups, 0, 0) in
  let tail = curriedTail(slices, Array.length(slices) - 1, ret) in
    "${head}(${Str.join(", ", Option.unwrapOr([], Array.get(0, slices)))}): ${tail};"

/// A curry-compatible function type. The JS backend curries every arity->=2
/// function through `_curry`, so a call site may partially apply in ANY
/// grouping — `f(a, b)`, `f(a)(b)`, `f(a, b)(c)`. One flat `(a, b) => R` rejects
/// all but the all-at-once form, so emit an OVERLOAD per composition of the
/// arity (ADR 0037). `head` scopes generics INSIDE each call signature, so it is
/// threaded here rather than prepended by the caller.
export let curriedOverloads = (head, params, ret) =>
  Array.length(params) <= 1
    ? "${head}(${Str.join(", ", params)}) => ${ret}"
    : "{ ${Str.join(" ", Array.sortBy(g => 0 - Array.length(g), compositions(Array.length(params))) |> map(overloadSig(head, params, ret)))} }"

/// A declared type alias as the printer reads it: its parameters, plus EITHER a
/// record body (`fields`) or a transparent template (`expr`). Declared here as
/// well as in schemes.mochi rather than shared through an import — a local
/// record alias expands, so both copies unify structurally (ADR 0044).
type AliasInfo = {
  params: [string],
  fields: [Ast.AliasField],
  expr: Option<Ast.TypeExpr>
}

/// The CONCRETE curry-compatible function type. Same contract as
/// `curriedOverloads` — every partial-application grouping `_curry` accepts must
/// typecheck — but expressed once as `_Curry<[params], ret>` instead of one
/// signature per composition of the arity. A monomorphic arity-n binding cost
/// 2^(n-1) lines; this costs one (ADR 0093). Only CONCRETE bindings can use it:
/// `infer` erases a generic head, so a generic binding keeps the nested arrow.
export let curriedFnType = (params, ret) =>
  Array.length(params) <= 1
    ? "(${Str.join(", ", params)}) => ${ret}"
    : "_Curry<[${Str.join(", ", params)}], ${ret}>"

/// Walk the value's lambda spine and the type's arrow spine together,
/// collecting one rendered `name: T` per param. A zero-param lambda consumes
/// the `unit` arrow the JS side erases.
let flatParamsFrom = (t, value, env, n, acc) => switch value {
  | Ast.ELambda(params, body, _) => Array.length(params) == 0
      ? let next = switch t {
        | TyFn(fromT, toT) when isUnit(fromT) => toT
        | _ => t
      } in
        flatParamsFrom(next, body, env, n, acc)
      : let (t1, n1, acc1) = takeParams(t, params, env, 0, n, acc) in
        flatParamsFrom(t1, body, env, n1, acc1)
  | _ => (acc, tsOf(t, env))
}

let takeParams = (t, params, env, i, n, acc) => switch Array.get(i, params) {
  | None => (t, n, acc)
  | Some(p) => switch t {
      | TyFn(fromT, toT) => takeParams(
          toT,
          params,
          env,
          i + 1,
          n + 1,
          Array.append("${paramDeclName(p, n)}: ${tsOf(fromT, env)}", acc)
        )
      | _ => (t, n, acc)
    }
}

/// Arity-aware nested form: one arrow peeled per param, recursing into the body
/// so a curried definition keeps its shape.
let declType = (t, value, env) => switch value {
  | Ast.ELambda(params, body, _) => Array.length(params) == 0
      ? let next = switch t {
        | TyFn(fromT, toT) when isUnit(fromT) => toT
        | _ => t
      } in
        "() => ${declType(next, body, env)}"
      : let (t1, _n, ps) = takeParams(t, params, env, 0, 0, []) in
        "(${Str.join(", ", ps)}) => ${declType(t1, body, env)}"
  | _ => tsOf(t, env)
}

/// The TS type of a binding, WITHOUT the `const name:` wrapper — the piece the
/// declaration writer and the TS backend share.
///
/// A CONCRETE function emits partial-application overloads so `_curry`'d calls
/// typecheck (ADR 0037). A GENERIC one keeps the nested arrow: overloads there
/// wreck tsc's callback contextual typing and type-argument inference. A
/// non-function polymorphic binding has nowhere to bind generics, so its
/// escaped vars fall back to `unknown`.
export let bindingTsType = (sc, value, recs) =>
  let names = genericNames(sc) in
  let env = tsEnv(names, recs) in
  let head = Map.size(names) == 0
    ? ""
    : "<${Str.join(", ", Map.values(names))}>" in
    switch value {
      | Ast.ELambda(_, _, _) => head == ""
          ? let (params, ret) = flatParamsFrom(sc.ty, value, env, 0, []) in
            curriedFnType(params, ret)
          : "${head}${declType(sc.ty, value, env)}"
      | _ => tsOf(sc.ty, recsEnv(recs))
    }

// ---- module assembly -------------------------------------------------------

/// Per-node types are keyed by span text, so a lookup is one Map hit.
let spanKey = sp => "${show(sp.start)}:${show(sp.end)}"

let typeAtFrom = (types, i, acc) => switch Array.get(i, types) {
  | None => acc
  | Some(r) => typeAtFrom(types, i + 1, Map.set(spanKey(r.span), r.ty, acc))
}

/// Later records win when two nodes share a span — `zonkRecorded` already put
/// them in source order, so a plain left fold gets that for free.
export let typeAtTable = types => typeAtFrom(types, 0, #{})

/// Every `con` name a type mentions — used to decide which builtin variant
/// decls a module has to carry so its own references resolve.
let consInTy = (t, acc) => switch t {
  | TyCon("Task", [value, error]) =>
    // `Task a e` renders as `() => Promise<Result<a, e>>` (ts-types.mochi) with no
    // `Result` con anywhere in the semantic type, so record it explicitly or its
    // decl never gets emitted.
    consInTy(error, consInTy(value, Set.add("Result", Set.add("Task", acc))))
  | TyCon(name, args) => consInAll(args, Set.add(name, acc), 0)
  | TyFn(fromT, toT) => consInTy(toT, consInTy(fromT, acc))
  | TyRecord(row) => consInRow(row, acc)
  | TyOneOf(members) => consInAll(members, acc, 0)
  | _ => acc
}

let consInAll = (ts, acc, i) => switch Array.get(i, ts) {
  | None => acc
  | Some(t) => consInAll(ts, consInTy(t, acc), i + 1)
}

let consInRow = (row, acc) => switch row {
  | RowExtend(_, fieldType, _, rest) => consInRow(
      rest,
      consInTy(fieldType, acc)
    )
  | _ => acc
}

let declaredTypeNames = (stmts, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(Ast.SType(name, _, _, _, _, _, _, _)) => declaredTypeNames(
      stmts,
      i + 1,
      Set.add(name, acc)
    )
  | Some(_) => declaredTypeNames(stmts, i + 1, acc)
}

let referencedCons = (stmts, env, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(Ast.SLet(name, _, _, _, _, _, _)) => referencedCons(
      stmts,
      env,
      i + 1,
      Str.startsWith("$", name)
        ? acc
        : switch Map.get(name, env) {
          | Some(sc) => consInTy(sc.ty, acc)
          | None => acc
        }
    )
  | Some(_) => referencedCons(stmts, env, i + 1, acc)
}

/// Builtin variant TYPES a module references but does not itself declare, so
/// those references resolve (`Option<number>` from `Map.get`, etc). They ride
/// an `import type` off the runtime rather than a decl per module — the same
/// trade `_Curry` takes (ADR 0093), and these are two decls x every file in a
/// graph. A module declaring its own `Result` keeps it and takes no import.
///
/// `wanted` is the scheme scan; a guard predicate can name a builtin it missed,
/// since it looks at binding types, not match-scrutinee types — `match(opt)` on
/// an `Option<Stmt>` never surfaces `Option`. The body text covers that (ADR 0031).
let builtinTypeNamesFor = (declared, wanted, body, i) => switch Array.get(i, builtinTypeDecls) {
  | None => []
  | Some(bt) => let rest = builtinTypeNamesFor(declared, wanted, body, i + 1) in
      !Set.has(
        bt.name,
        declared
      ) && (Set.has(bt.name, wanted) || Str.contains(bt.name, body))
        ? Array.prepend(bt.name, rest)
        : rest
}

/// A declared record alias lowered back to the row its USES carry. ADR 0005
/// expands a record alias at `typeExprToType`, so this reproduces exactly what
/// inference will have put in the type table for a value of that alias.
let aliasRowOf = (fields: [Ast.AliasField], aliases: Map<string, AliasInfo>, i) => switch Array.get(i, fields) {
  | None => RowEmpty
  | Some(f) => let (t, _vars, _st) = typeExprToType(
      f.fieldType,
      #{},
      mkSt(0),
      aliases,
      Set.fromArray([])
    ) in
      RowExtend(f.name, t, f.optional, aliasRowOf(fields, aliases, i + 1))
}

let aliasShapeKey = (fields: [Ast.AliasField], aliases: Map<string, AliasInfo>) =>
  rowShapeKey(aliasRowOf(fields, aliases, 0), #{})

/// Every record alias IN SCOPE, keyed by canonical row shape (ADR 0092). Built
/// from the merged alias map rather than this module's own `SType`s, so a dep's
/// alias counts too: `crossModuleTypeImports` derives `import type` lines from
/// the emitted TEXT, so naming one here is exactly what makes its import appear.
///
/// Nullary only — a parameterised alias would have to match a row up to
/// substitution.
///
/// A dep reached through `import * as Ast` seeds only the QUALIFIED key
/// `"Ast.Span"` (infer.mochi's `qualAliasSeed`), so index under the last
/// segment: a type crosses a module boundary under its bare name, which is both
/// what the dep's own header declares and what `groupByOwner` matches on.
let bareName = name =>
  let parts = Str.split(".", name) in
    Option.unwrapOr(name, Array.get(Array.length(parts) - 1, parts))

let indexAlias = (key, name, aliases: Map<string, AliasInfo>, acc) => switch Map.get(key, aliases) {
  | None => acc
  | Some(info) => switch info.expr {
      | Some(_) => acc
      | None => Array.length(info.params) != 0 || Array.length(info.fields) == 0
          ? acc
          : switch aliasShapeKey(info.fields, aliases) {
            | Some(k) => Map.set(k, name, acc)
            | None => acc
          }
    }
}

let recordAliasIndexFrom = (keys, aliases: Map<string, AliasInfo>, i, acc) => switch Array.get(i, keys) {
  | None => acc
  | Some(key) => recordAliasIndexFrom(
      keys,
      aliases,
      i + 1,
      indexAlias(key, bareName(key), aliases, acc)
    )
}

export let recordAliasIndex = aliases =>
  recordAliasIndexFrom(Array.sort(Map.keys(aliases)), aliases, 0, #{})

/// The index an alias's OWN body renders against — itself removed, so it cannot
/// come out as `export type Span = Span;`.
let withoutOwnShape = (fields: [Ast.AliasField], params, aliases: Map<string, AliasInfo>, recs) => switch Array.get(0, params) {
  | Some(_) => recs
  | None => switch aliasShapeKey(fields, aliases) {
      | Some(k) => Map.delete(k, recs)
      | None => recs
    }
}

let typeHeaderFrom = (stmts, aliases: Map<string, AliasInfo>, recs, i) => switch Array.get(i, stmts) {
  | None => []
  | Some(Ast.SType(name, params, ctors, alias, aliasType, _, doc, _)) => let rest = typeHeaderFrom(
      stmts,
      aliases,
      recs,
      i + 1
    ) in
    let docComment = jsDoc(doc) in
      switch alias {
        | Some(fields) => Array.prepend(
            // Its OWN entry is dropped, or the alias would render as itself
            // (`export type Span = Span;`). Sibling aliases stay, so one alias
            // whose field is another's shape still names it.
            "${docComment}${recordAliasDecl(name, params, fields, aliases, withoutOwnShape(fields, params, aliases, recs))}",
            rest
          )
        | None => switch aliasType {
            | Some(te) => Array.prepend(
                "${docComment}${aliasTsDecl(name, params, te, aliases, recs)}",
                rest
              )
            | None => Array.length(ctors) == 0
                ? Array.prepend(
                  "declare const ${name}: unique symbol;\n${docComment}type ${name} = { readonly [${name}]: never };",
                  rest
                )
                : Array.prepend(
                  "${docComment}${typeDecl(name, params, ctors, aliases, recs)}",
                  rest
                )
          }
      }
  | Some(_) => typeHeaderFrom(stmts, aliases, recs, i + 1)
}

/// Generic top-level function bindings, keyed by their value-lambda span ->
/// scheme (ADR 0032). Such a lambda gets a generic head plus ALL params
/// annotated, so its polymorphic inner params name the letters instead of being
/// erased to `any` by `_curry`. Row vars count too: a row-polymorphic binding
/// with no type vars still needs the head so its open-row params emit
/// `{…} & R` rather than a closed record dropping the tail (ADR 0034).
let genericLambdasFrom = (stmts, env, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(Ast.SLet(name, _, _, value, _, _, _)) => genericLambdasFrom(
      stmts,
      env,
      i + 1,
      switch value {
        | Ast.ELambda(_, _, sp) when !Str.startsWith("$", name) => switch Map.get(name, env) {
            | Some(sc) => Array.length(
                sc.vars
              ) > 0 || Array.length(sc.rvars) > 0
                ? Map.set(spanKey(sp), sc, acc)
                : acc
            | None => acc
          }
        | _ => acc
      }
    )
  | Some(_) => genericLambdasFrom(stmts, env, i + 1, acc)
}

/// Spans of every lambda AND every empty-collection literal (`#{}` / `[]` /
/// `@{}` / `Set.empty`) in an expression subtree, root included (ADR 0042).
/// A generic binding's `<A, B>` head lexically scopes its whole body, so each
/// of these nodes may name those letters: an inner lambda param renders the
/// letter instead of `unknown`, and an empty seed renders `Map<string, A>`
/// instead of inferring `Map<unknown, unknown>`. The binding's OWN value-lambda
/// span is collected too, but `annotateParams` resolves that one through
/// `genericLams` first, so the extra entry is harmless.
let scopedSpans = e => switch e {
  | Ast.ELambda(_, body, sp) => Array.prepend(sp, scopedSpans(body))
  | Ast.ECall(fn, args, _, _) => Array.concat(
      scopedSpans(fn),
      scopedSpansAt(args, 0)
    )
  | Ast.ELetIn(_, _, value, body, _) => Array.concat(
      scopedSpans(value),
      scopedSpans(body)
    )
  | Ast.ELetBind(_, _, _, value, body, _) => Array.concat(
      scopedSpans(value),
      scopedSpans(body)
    )
  | Ast.EPipe(left, right, _) => Array.concat(
      scopedSpans(left),
      scopedSpans(right)
    )
  | Ast.EDo(exprs, _) => scopedSpansAt(exprs, 0)
  | Ast.ETernary(cond, thenE, elseE, _) => Array.concat(
      scopedSpans(cond),
      Array.concat(scopedSpans(thenE), scopedSpans(elseE))
    )
  | Ast.EMatch(scrutinee, arms, _) => Array.concat(
      scopedSpans(scrutinee),
      scopedSpansInArms(arms, 0)
    )
  | Ast.ERecord(fields, spread, _) => Array.concat(
      scopedSpansInFields(fields, 0),
      switch spread { | Some(s) => scopedSpans(s) | None => [] }
    )
  | Ast.EField(target, name, sp) =>
    // `Set.empty` / `Map.empty` / `List.empty` is a seed like `@{}` / `#{}`.
    let rest = scopedSpans(target) in
      name == "empty" && isRefExpr(target) ? Array.prepend(sp, rest) : rest
  | Ast.ETuple(elements, _) => scopedSpansAt(elements, 0)
  | Ast.EArr(elements, sp) => scopedSpansInSeq(elements, sp)
  | Ast.EList(elements, sp) => scopedSpansInSeq(elements, sp)
  | Ast.ESet(elements, sp) => scopedSpansInSeq(elements, sp)
  | Ast.EMap(entries, sp) => let inner = scopedSpansInEntries(entries, 0) in
      Array.length(entries) == 0 ? Array.prepend(sp, inner) : inner
  | Ast.ELoop(params, body, _) => Array.concat(
      scopedSpansInLoop(params, 0),
      scopedSpans(body)
    )
  | Ast.ERecur(args, _) => scopedSpansAt(args, 0)
  | Ast.EInterp(parts, _) => scopedSpansInParts(parts, 0)
  | _ =>
    // num / bool / str / unit / ref — no nested expressions.
    []
}

let isRefExpr = e => switch e { | Ast.ERef(_, _) => true | _ => false }

let scopedSpansAt = (exprs, i) => switch Array.get(i, exprs) {
  | None => []
  | Some(e) => Array.concat(scopedSpans(e), scopedSpansAt(exprs, i + 1))
}

let scopedSpansInArms = (arms, i) => switch Array.get(i, arms) {
  | None => []
  | Some(a) => Array.concat(
      switch a.guard { | Some(g) => scopedSpans(g) | None => [] },
      Array.concat(scopedSpans(a.body), scopedSpansInArms(arms, i + 1))
    )
}

let scopedSpansInFields = (fields, i) => switch Array.get(i, fields) {
  | None => []
  | Some(f) => Array.concat(
      scopedSpans(f.value),
      scopedSpansInFields(fields, i + 1)
    )
}

let scopedSpansInEntries = (entries, i) => switch Array.get(i, entries) {
  | None => []
  | Some(en) => Array.concat(
      scopedSpans(en.key),
      Array.concat(scopedSpans(en.value), scopedSpansInEntries(entries, i + 1))
    )
}

let scopedSpansInElems = (elements, i) => switch Array.get(i, elements) {
  | None => []
  | Some(Ast.SEExpr(e)) => Array.concat(
      scopedSpans(e),
      scopedSpansInElems(elements, i + 1)
    )
  | Some(Ast.SESpread(e)) => Array.concat(
      scopedSpans(e),
      scopedSpansInElems(elements, i + 1)
    )
}

/// An EMPTY `[]` / `@{}` / `#{}` is itself annotatable; a populated one only
/// carries its elements' nested nodes.
let scopedSpansInSeq = (elements, sp) =>
  let inner = scopedSpansInElems(elements, 0) in
    Array.length(elements) == 0 ? Array.prepend(sp, inner) : inner

let scopedSpansInLoop = (params, i) => switch Array.get(i, params) {
  | None => []
  | Some(p) => Array.concat(
      scopedSpans(p.init),
      scopedSpansInLoop(params, i + 1)
    )
}

let scopedSpansInParts = (parts, i) => switch Array.get(i, parts) {
  | None => []
  | Some(Ast.IPExpr(e)) => Array.concat(
      scopedSpans(e),
      scopedSpansInParts(parts, i + 1)
    )
  | Some(_) => scopedSpansInParts(parts, i + 1)
}

let scopedNamesAt = (spans, i, names, acc) => switch Array.get(i, spans) {
  | None => acc
  | Some(sp) => scopedNamesAt(
      spans,
      i + 1,
      names,
      Map.set(spanKey(sp), names, acc)
    )
}

/// Each annotatable node nested in a GENERIC binding's value body -> that
/// binding's letter map (ADR 0042). Scoped PER binding, never a global union:
/// letters are positional, so the same var id can be `A` under one scheme and
/// `C` under another, and a nested node must use exactly the assignment of the
/// head it renders under.
let scopedNamesFrom = (stmts, env, i, acc) => switch Array.get(i, stmts) {
  | None => acc
  | Some(Ast.SLet(name, _, _, value, _, _, _)) => scopedNamesFrom(
      stmts,
      env,
      i + 1,
      switch value {
        | Ast.ELambda(_, _, _) when !Str.startsWith("$", name) => switch Map.get(name, env) {
            | Some(sc) => Array.length(
                sc.vars
              ) > 0 || Array.length(sc.rvars) > 0
                ? scopedNamesAt(
                  scopedSpans(value),
                  0,
                  unionGenericNames([sc]),
                  acc
                )
                : acc
            | None => acc
          }
        | _ => acc
      }
    )
  | Some(_) => scopedNamesFrom(stmts, env, i + 1, acc)
}

/// The TS-backend options: every hook resolved against this module's inference
/// metadata. This is where `inferProgramTypes` and `codegenWith` actually meet.
export let tsGenOpts = (stmts, env, types, letParams, aliases: Map<string, AliasInfo>) =>
  let typeAt = typeAtTable(types) in
  let letParamAt = typeAtTable(letParams) in
  let genericLams = genericLambdasFrom(stmts, env, 0, #{}) in
  let scopedNames = scopedNamesFrom(stmts, env, 0, #{}) in
  let recs = recordAliasIndex(aliases) in
  let typeOf = e => Map.get(spanKey(exprSpan(e)), typeAt) in
  // ADR 0042: a node inside a generic binding renders under that binding's
  // letters; elsewhere only concrete types render (a free var would be `unknown`).
  let envAt = key => switch Map.get(key, scopedNames) {
    | Some(vars) => tsEnv(vars, recs)
    | None => recsEnv(recs)
  } in
    {
      ...jsGenOpts,
      annotateLet: Some((name, value) =>
        Str.startsWith("$", name)
          ? None
          : switch value {
            | Ast.ELambda(_, _, _) => switch Map.get(name, env) {
                | Some(sc) => Some(": ${bindingTsType(sc, value, recs)}")
                | None => None
              }
            | _ =>
              // A non-lambda binding has nowhere to bind generics, so a
              // POLYMORPHIC one is better left to tsc. One used at a single
              // concrete type is in `letParams` (ADR 0035): annotate it, so the
              // empty collections inside its value get a element type instead
              // of tsc's `never`/`unknown`.
              Map.get(spanKey(exprSpan(value)), letParamAt)
                |> Option.flatMap(t => emptyCollTs(t, recsEnv(recs)))
                |> Option.map(ts => ": ${ts}")
          }),
      annotateCtor: Some((s, c) => switch s {
        | Ast.SType(name, params, _, _, _, _, _, _) => Some(
            ctorFactoryTs(name, params, c, aliases, recs)
          )
        | _ => None
      }),
      annotateParams: Some((sp, arity) => switch Map.get(spanKey(sp), genericLams) {
        | Some(sc) => Option.unwrapOr(
            { generics: "", params: [] },
            genericLambdaParams(sc, arity, recs)
          )
        | None => {
            generics: "",
            params: switch Map.get(spanKey(sp), typeAt) {
              | Some(t) => lambdaParamTypesTs(t, arity, envAt(spanKey(sp)))
              | None => []
            }
          }
      }),
      annotateEmpty: Some(e =>
        let key = spanKey(exprSpan(e)) in
          Map.get(key, typeAt)
            |> Option.flatMap(t => emptyCollTs(t, envAt(key)))),
      annotateLetin: // A `let x = v in …` (and a lowered loop param) whose value is
      // polymorphic but used at ONE concrete type: annotate the IIFE param so
      // tsc contextually types the empty collections inside `v` (ADR 0035).
      // Keyed by VALUE span, which is what `infer`'s `letParams` records.
      Some(value =>
        Map.get(spanKey(exprSpan(value)), letParamAt)
          |> Option.flatMap(t => emptyCollTs(t, recsEnv(recs)))),
      annotateCall: Some(e =>
        typeOf(e) |> Option.flatMap(t => ctorCallTs(t, recs))),
      guardBaseType: Some(e =>
        typeOf(e) |> Option.flatMap(t => guardParamTs(t, recs))),
      flattenPipe: true,
      tupleHelper: true,
      moduleExt: ""
    }

/// Emit one module's typed TS: type header, then any cross-module imports, then
/// the runtime import, then the codegen body with per-binding / per-ctor
/// annotations and pipe flattening.
///
/// `imported` / `importLines` are the GRAPH seam (TS's `TsEmitContext`): a
/// single file passes `#{}` / `[]`, a module in a graph passes its deps' ctor
/// field keys (so destructuring an imported ctor emits the right names) and the
/// `import type { … }` lines its driver computed from the emitted text.
export let emitTsModule = (stmts, env, types, letParams, aliases: Map<string, AliasInfo>, imported, importLines, ns, jsDefs, runtimeDeps, runtimeImport) =>
  let declared = declaredTypeNames(stmts, 0, Set.fromArray([])) in
  let wanted = referencedCons(stmts, env, 0, Set.fromArray([])) in
  let recs = recordAliasIndex(aliases) in
  let typeHeader = typeHeaderFrom(stmts, aliases, recs, 0) in
  let body = codegenWith(
    stmts,
    imported,
    false,
    ns,
    jsDefs,
    runtimeDeps,
    tsGenOpts(stmts, env, types, letParams, aliases)
  ) in
  // `_tuple` is a TS-emit device with no AST reference for the dep scan to
  // find (ADR 0036), so pull it in from the emitted text.
  let deps0 = runtimeDepNames(stmts, imported, ns, jsDefs, runtimeDeps) in
  let deps = Str.contains("_tuple(", body)
    ? Array.append("_tuple", deps0)
    : deps0 in
  let runtimeLine = Array.length(deps) == 0
    ? ""
    : "import { ${Str.join(", ", Array.sort(deps))} } from \"${runtimeImport}\";" in
  let header = typeHeader in
  // `_Curry` and the builtin variants live in the runtime, not inline: a decl
  // per module cost ~13 lines x every file in a graph. They are TYPES, so they
  // ride their own `import type` line, not the value import (ADR 0093).
  let typeDeps = Array.concat(
    Str.contains("_Curry<", "${Str.join("\n", header)}\n${body}")
      ? ["_Curry"]
      : [],
    builtinTypeNamesFor(declared, wanted, body, 0)
  ) in
  let typeImportLine = Array.length(typeDeps) == 0
    ? ""
    : "import type { ${Str.join(", ", Array.sort(typeDeps))} } from \"${runtimeImport}\";" in
    Str.join(
      "\n\n",
      Array.filter(
        part => part != "",
        [
          Str.join("\n", header),
          Str.join("\n", importLines),
          typeImportLine,
          runtimeLine,
          body
        ]
      )
    )
      ++ "\n"

// ---- extern host declarations (ADR 0026 / 0064) ----------------------------
//
// A graph module `extern`s bindings out of real JS hosts (`host.mjs`,
// `prelude.gen.mjs`). Those hosts carry no mochi-visible declaration, so an
// emitted `.ts` importing one is a tsc TS2307 "cannot find module" unless a
// sidecar `.d.ts` / `.d.mts` is emitted beside it. Ports src/dts/dts.ts's
// `externModuleDts` / `curriedHostType`.

/// Free TYPE vars in FIRST-OCCURRENCE order. Not `freeInType`: its Sets lose the
/// order letters are assigned in, and it also collects row vars, which a bare
/// type has no head to bind — a record's trailing row var is skipped here and
/// the declaration prints the closed body.
let freeIdsIn = (t, acc) => switch t {
  | TyVar(id) => Array.contains(id, acc) ? acc : Array.append(id, acc)
  | TyCon(_, args) => args->freeIdsInAll(acc)
  | TyFn(fromT, toT) => toT->freeIdsIn(fromT->freeIdsIn(acc))
  | TyRecord(row) => row->freeIdsInRow(acc)
  | TySingleton(_, _) => acc
  | TyOneOf(members) => members->freeIdsInAll(acc)
}

let freeIdsInAll = (ts, acc) =>
  ts |> Array.reduce((a, t) => freeIdsIn(t, a), acc)

let freeIdsInRow = (row, acc) => switch row {
  | RowExtend(_, fieldType, _, rest) => rest->freeIdsInRow(
      freeIdsIn(fieldType, acc)
    )
  | _ => acc
}

/// id -> letter, positionally. Accumulator-first so `Map.values` comes back in
/// index order — the generic head and the rendered params must agree.
let lettersFor = (ids, i, acc) => switch Array.get(i, ids) {
  | None => acc
  | Some(id) => lettersFor(ids, i + 1, Map.set(id, letterAt(i), acc))
}

/// id -> `any`. A VALUE extern is a const: it has no generic head to bind its
/// escaped vars to, and the host is untyped JS, so `any` is the honest boundary.
let anyFor = ids =>
  ids |> Array.reduce((acc, id) => Map.set(id, "any", acc), #{})

let genericHeadOf = (ids, names) =>
  Array.length(ids) == 0 ? "" : "<${Str.join(", ", Map.values(names))}>"

/// Arrows on the spine — the extern's declared arity.
let arrowCount = t => switch t {
  | TyFn(_, toT) => 1 + arrowCount(toT)
  | _ => 0
}

/// Peel `arity` arrows into `a: T`, `b: T`, … — the same positional naming
/// `tsArrow` uses, so a declaration and a call site read alike.
let hostParams = (t, arity, names, i) =>
  i >= arity
    ? []
    : switch t {
      | TyFn(fromT, toT) => Array.prepend(
          "${Str.fromCode(97 + i)}: ${tsOf(fromT, plainEnv(names))}",
          hostParams(toT, arity, names, i + 1)
        )
      | _ => []
    }

let hostReturn = (t, arity, i) =>
  i >= arity
    ? t
    : switch t { | TyFn(_, toT) => hostReturn(toT, arity, i + 1) | _ => t }

/// `(a: A) => (b: B) => R` — a CURRIED host's own shape (ADR 0064). Unlike
/// `flatHostType` there are no partial-application overloads to offer: `_curry`
/// is built AROUND this host, not exported by it, so it takes exactly one
/// argument per call. Folded right-to-left, hence the reverse.
let curriedHostType = (t, arity) =>
  let ids = freeIdsIn(t, []) in
  let names = lettersFor(ids, 0, #{}) in
    "${genericHeadOf(ids, names)}${hostParams(t, arity, names, 0) |> Array.reverse |> Array.reduce((acc, p) => "(${p}) => ${acc}", tsOf(hostReturn(t, arity, 0), plainEnv(names)))}"

/// An UNCURRIED function host gets the same overloaded signature a runtime
/// builtin does, so both `f(a)(b)` and `f(a, b)` call sites resolve (ADR 0037).
let flatHostType = (t, arity) =>
  let ids = freeIdsIn(t, []) in
  let names = lettersFor(ids, 0, #{}) in
  let head = genericHeadOf(ids, names) in
    arity == 0
      ? "${head}${tsOf(t, plainEnv(names))}"
      : curriedOverloads(
        head,
        hostParams(t, arity, names, 0),
        tsOf(hostReturn(t, arity, 0), plainEnv(names))
      )

/// One `export declare const` for a host binding. `e` is
/// `{ imported, scheme, curried }` — `imported` is the JS export name the
/// emitted `import { … }` binds, not the mochi-side name.
let externDecl = e =>
  let t = e.scheme.ty in
  let n = arrowCount(t) in
    n >= 1 && e.curried
      ? "export declare const ${e.imported}: ${curriedHostType(t, n)};"
      : n == 0
      ? "export declare const ${e.imported}: ${tsOf(t, plainEnv(anyFor(freeIdsIn(t, []))))};"
      : "export declare const ${e.imported}: ${flatHostType(t, n)};"

/// One extern host module's declaration file. Referenced builtin variants are
/// inlined, so the sidecar is self-contained and needs no import of its own.
/// `dedupeBy` keeps the FIRST of two mochi bindings aliasing one host export —
/// a repeated `export declare const` is a TS2323.
export let externModuleDts = (externs, aliases: Map<string, AliasInfo>) =>
  let wanted = externs
    |> Array.reduce(
      (acc, e) => consInTy(e.scheme.ty, acc),
      Set.fromArray([])
    ) in
    Str.join(
      "\n",
      Array.concat(
        builtinTypeDecls
          |> filter(bt => Set.has(bt.name, wanted))
          |> map(bt => typeDecl(bt.name, bt.params, bt.ctors, aliases, #{})),
        externs |> Array.dedupeBy(e => e.imported) |> map(externDecl)
      )
    )
      ++ "\n"

import { assertEq, test } from "@mochi/test"
import * as Ast from "./ast.mochi"
import { recordAliasIndex } from "./codegen-ts.mochi"
import { declarationRecs } from "./dts.mochi"

let sp = { start: 0, end: 0 }
let spanFields = [
  { name: "start", fieldType: Ast.TyName("number", sp), optional: false },
  { name: "end", fieldType: Ast.TyName("number", sp), optional: false }
]
let spanAlias = { params: [], fields: spanFields, expr: None }

let printed = (stmts, aliases) =>
  let indexed = recordAliasIndex(aliases) in
  let key = Option.unwrapOr("", Array.get(0, Map.keys(indexed))) in
    Option.unwrapOr("missing", Map.get(key, declarationRecs(stmts, aliases)))

test("a declaration does not print a namespace-only record alias bare", () =>
  let aliases = #{ "Ast.Span": spanAlias } in
    do {
      assertEq(
        "Span",
        Option.unwrapOr(
          "",
          Map.get(
            Option.unwrapOr(
              "",
              Array.get(0, Map.keys(recordAliasIndex(aliases)))
            ),
            recordAliasIndex(aliases)
          )
        )
      );
      assertEq("", printed([], aliases))
    })

test("a declaration keeps a record alias this file declares", () =>
  let local = Ast.SType(
    "Span",
    [],
    [],
    Some(spanFields),
    None,
    true,
    None,
    sp
  ) in
    assertEq(
      "Span",
      printed([local], #{ "Ast.Span": spanAlias, "Span": spanAlias })
    ))

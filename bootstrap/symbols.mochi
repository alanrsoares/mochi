// bootstrap/symbols.mochi — lexical def/use index for the self-host.
//
// A binding is identified by its space and declaration Location (path + span),
// never only by `name`. That makes shadowed lets distinct and is the invariant
// editor rename and highlighting need. Every binder carries an exact name span:
// lets, externs, types, ctors, `let … in`, parameters (through `LPSpanned`),
// `let?`/`let!` binders, pattern binds, loop params and record field names.
//
// Implements four symbol spaces, imported names
// resolved to their export sites through `origins`, and builtins resolved to
// the host's virtual prelude through `prelude`. symbols.spec.mochi and the DX
// façade specs pin the behavior directly.
import * as Ast from "./ast.mochi"
import { exprSpan, patSpan } from "./infer.mochi"

/// A declaration site: the file it lives in and its name span.
export type Loc = { path: string, start: number, end: number }

/// One def or use of a binding. `space` is "value", "type", "ctor" or "field".
export type SymOccurrence = {
  name: string,
  space: string,
  defPath: string,
  defStart: number,
  defEnd: number,
  start: number,
  end: number,
  role: string
}

/// Export sites of a module, keyed by name in each space. A variant's ctors
/// are also values: an import list names them like any value.
export type Origins = {
  values: Map<string, Loc>,
  types: Map<string, Loc>,
  ctors: Map<string, Loc>
}

/// The host's virtual prelude: builtin defs, plus namespace members keyed
/// `Ns.member` (`Array.map`).
export type SymPrelude = { origins: Origins, members: Map<string, Loc> }

/// One lexical scope below module scope: the value binders it introduces,
/// live across `start..end` (a lambda, a `let … in` body, an arm, …).
/// Completion overlays these on module scope, widest first (ADR 0120).
export type ScopeFrame = { start: number, end: number, binds: Map<string, Loc> }

/// A file's index. `top` holds its module-scope bindings, imports included;
/// `fields` the record field names it declares or first mentions; `frames`
/// every local scope, inner scopes before the scopes that enclose them.
export type SymIndex = {
  occurrences: [SymOccurrence],
  top: Origins,
  fields: Map<string, Loc>,
  frames: [ScopeFrame]
}

/// Single-file value occurrence, as `index` reports it.
export type Occurrence = {
  name: string,
  defStart: number,
  defEnd: number,
  start: number,
  end: number,
  role: string
}

type SymEnv = {
  path: string,
  top: Origins,
  prelude: SymPrelude,
  locals: Map<string, Loc>
}

/// A walk's occurrences, the field table after it, and the scopes it met.
/// Field names are one file-wide table: the first site is the def, every
/// later site a use.
type Walked = {
  occs: [SymOccurrence],
  fields: Map<string, Loc>,
  frames: [ScopeFrame]
}

/// A pattern or parameter walk also yields the scope its binders extend.
type BoundScope = {
  env: SymEnv,
  occs: [SymOccurrence],
  fields: Map<string, Loc>,
  frames: [ScopeFrame]
}

let emptyOrigins : Origins = { values: #{}, types: #{}, ctors: #{} }

let occ = (name: string, space: string, def: Loc, span: Ast.Span, role: string) =>
  {
    name,
    space,
    defPath: def.path,
    defStart: def.start,
    defEnd: def.end,
    start: span.start,
    end: span.end,
    role
  }

let locOf = (env: SymEnv, span: Ast.Span) =>
  { path: env.path, start: span.start, end: span.end }

let upperStart = s => switch Str.codeAt(0, s) {
  | Some(c) => c >= 65 && c <= 90
  | None => false
}

let parked = Str.startsWith("$")

let orElse = (first: Option<Loc>, second: () -> Option<Loc>) => switch first {
  | Some(loc) => Some(loc)
  | None => second()
}

let lookup = (env: SymEnv, space: string, name: string) => switch space {
  | "value" => orElse(Map.get(
      name,
      env.locals
    ), () =>
      orElse(Map.get(
        name,
        env.top.values
      ), () => Map.get(name, env.prelude.origins.values)))
  | "type" => orElse(Map.get(
      name,
      env.top.types
    ), () => Map.get(name, env.prelude.origins.types))
  | _ => orElse(Map.get(
      name,
      env.top.ctors
    ), () => Map.get(name, env.prelude.origins.ctors))
}

let use = (env: SymEnv, space: string, name: string, span: Ast.Span) => switch lookup(env, space, name) {
  | Some(def) => [occ(name, space, def, span, "use")]
  | None => []
}

let walked : [SymOccurrence] -> Map<string, Loc> -> Walked = (occs, fields) =>
  { occs, fields, frames: [] }

let none = (fields: Map<string, Loc>) => walked([], fields)

/// Run `rest` on the field table `first` leaves, and join their occurrences.
let andThen = (first: Walked, rest: Map<string, Loc> -> Walked) =>
  let second = rest(first.fields) in
    {
      occs: Array.concat(first.occs, second.occs),
      fields: second.fields,
      frames: Array.concat(first.frames, second.frames)
    }

let prefixed = (occs: [SymOccurrence], w: Walked) =>
  { occs: Array.concat(occs, w.occs), fields: w.fields, frames: w.frames }

let sameLoc = (a: Option<Loc>, b: Option<Loc>) => switch (a, b) {
  | (Some(x), Some(y)) => x.start == y.start && x.end == y.end && x.path == y.path
  | (None, None) => true
  | _ => false
}

/// The value binders `inner` holds that `outer` does not (or rebinds).
let newBinds = (outer: SymEnv, inner: SymEnv) =>
  Map.keys(inner.locals)
    |> Array.reduce(
      (acc, name) =>
        sameLoc(
          Map.get(name, outer.locals),
          Map.get(name, inner.locals)
        ) || parked(name)
          ? acc
          : switch Map.get(name, inner.locals) {
            | Some(def) => Map.set(name, def, acc)
            | None => acc
          },
      #{}
    )

/// Close a scope: record the binders `inner` added over `outer` as a frame
/// live across `sp`, after the frames nested inside it.
let framed = (outer: SymEnv, inner: SymEnv, sp: Ast.Span, w: Walked) =>
  let binds = newBinds(outer, inner) in
    Map.size(binds) == 0
      ? w
      : {
        occs: w.occs,
        fields: w.fields,
        frames: Array.append({ start: sp.start, end: sp.end, binds }, w.frames)
      }

let touchField = (env: SymEnv, name: string, span: Ast.Span, fields: Map<string, Loc>) => switch Map.get(name, fields) {
  | Some(def) => walked([occ(name, "field", def, span, "use")], fields)
  | None => let def = locOf(env, span) in
      walked([occ(name, "field", def, span, "def")], Map.set(name, def, fields))
}

/// Bind a local value in `env`'s innermost scope.
let bindLocal = (env: SymEnv, name: string, span: Ast.Span) =>
  let def = locOf(env, span) in
    {
      env: {
        path: env.path,
        top: env.top,
        prelude: env.prelude,
        locals: Map.set(name, def, env.locals)
      },
      occ: occ(name, "value", def, span, "def")
    }

let bound : SymEnv -> [SymOccurrence] -> Map<string, Loc> -> BoundScope = (env, occs, fields) =>
  { env, occs, fields, frames: [] }

/// `bound`, keeping the frames of an expression walked on the way (a default).
let boundWith = (env: SymEnv, occs: [SymOccurrence], w: Walked) =>
  { env, occs, fields: w.fields, frames: w.frames }

let bindName = (env: SymEnv, name: string, span: Ast.Span, fields: Map<string, Loc>) =>
  let b = bindLocal(env, name, span) in bound(b.env, [b.occ], fields)

/// Continue a binder walk: `rest` sees the scope and field table `first` left.
let boundThen = (first: BoundScope, rest: SymEnv -> Map<string, Loc> -> BoundScope) =>
  let second = rest(first.env, first.fields) in
    {
      env: second.env,
      occs: Array.concat(first.occs, second.occs),
      fields: second.fields,
      frames: Array.concat(first.frames, second.frames)
    }

let bindNames = (env: SymEnv, names: [string], spans: [Ast.Span], i: number, fields: Map<string, Loc>) => switch (Array.get(i, names), Array.get(i, spans)) {
  | (Some(name), Some(span)) => boundThen(bindName(
      env,
      name,
      span,
      fields
    ), (e, fs) => bindNames(e, names, spans, i + 1, fs))
  | _ => bound(env, [], fields)
}

// --- type expressions ---

let walkTypes = (env: SymEnv, types: [Ast.TypeExpr], i: number) => switch Array.get(i, types) {
  | None => []
  | Some(t) => Array.concat(walkType(env, t), walkTypes(env, types, i + 1))
}

let walkType = (env: SymEnv, t: Ast.TypeExpr) => switch t {
  | Ast.TyName(name, span) => upperStart(name)
      ? use(env, "type", name, span)
      : []
  | Ast.TyArrow(from, to, _) => Array.concat(
      walkType(env, from),
      walkType(env, to)
    )
  | Ast.TyApp(ctor, args, span) => Array.concat(
      use(env, "type", ctor, span),
      walkTypes(env, args, 0)
    )
  | Ast.TyTuple(elems, _) => walkTypes(env, elems, 0)
  | Ast.TyList(elem, _) => walkType(env, elem)
  | Ast.TyQual(alias, name, nameSpan, args, _) =>
    // Indexed under the qualified name, which nothing binds: resolving it back
    // to the aliased module's declaration is a later slice.
    Array.concat(
      use(env, "type", "${alias}.${name}", nameSpan),
      walkTypes(env, args, 0)
    )
  | Ast.TyLit(_, _) => []
  | Ast.TyUnion(members, _) => walkTypes(env, members, 0)
}

let walkAnnot = (env: SymEnv, annot: Option<Ast.TypeExpr>) => switch annot {
  | Some(t) => walkType(env, t)
  | None => []
}

// --- parameters and patterns ---

let bindParam = (env: SymEnv, param: Ast.LamParam, fields: Map<string, Loc>) => switch param {
  | Ast.LPSpanned(Ast.LPName(name, annot), [span]) => let annotOccs = walkAnnot(
      env,
      annot
    ) in
      parked(name)
        ? bound(env, annotOccs, fields)
        : let b = bindLocal(env, name, span) in
          bound(b.env, Array.append(b.occ, annotOccs), fields)
  | Ast.LPSpanned(Ast.LPLabeled(name, annot, _, defaultValue), [span]) => let annotOccs = walkAnnot(
      env,
      annot
    ) in
    let dflt = switch defaultValue {
      | Some(e) => walkExpr(env, e, fields)
      | None => none(fields)
    } in
    let before = Array.concat(annotOccs, dflt.occs) in
      parked(name)
        ? boundWith(env, before, dflt)
        : let b = bindLocal(env, name, span) in
          boundWith(b.env, Array.append(b.occ, before), dflt)
  | Ast.LPSpanned(Ast.LPTuple(names), spans) => bindNames(
      env,
      names,
      spans,
      0,
      fields
    )
  | Ast.LPSpanned(Ast.LPRecord(names), spans) => bindNames(
      env,
      names,
      spans,
      0,
      fields
    )
  | Ast.LPName(_, annot) =>
    // Synthetic parameters carry no span and no user-visible name.
    bound(env, walkAnnot(env, annot), fields)
  | Ast.LPLabeled(_, annot, _, defaultValue) => let dflt = switch defaultValue {
      | Some(e) => walkExpr(env, e, fields)
      | None => none(fields)
    } in
      boundWith(env, Array.concat(walkAnnot(env, annot), dflt.occs), dflt)
  | _ => bound(env, [], fields)
}

let bindParams = (env: SymEnv, params: [Ast.LamParam], i: number, fields: Map<string, Loc>) => switch Array.get(i, params) {
  | None => bound(env, [], fields)
  | Some(param) => boundThen(bindParam(
      env,
      param,
      fields
    ), (e, fs) => bindParams(e, params, i + 1, fs))
}

let walkPatOpt = (env: SymEnv, pat: Option<Ast.Pattern>, fields: Map<string, Loc>) => switch pat {
  | Some(p) => walkPat(env, p, fields)
  | None => bound(env, [], fields)
}

let walkPats = (env: SymEnv, pats: [Ast.Pattern], i: number, fields: Map<string, Loc>) => switch Array.get(i, pats) {
  | None => bound(env, [], fields)
  | Some(p) => boundThen(walkPat(
      env,
      p,
      fields
    ), (e, fs) => walkPats(e, pats, i + 1, fs))
}

let walkPatFields = (env: SymEnv, pfs: [Ast.PatField], i: number, fields: Map<string, Loc>) => switch Array.get(i, pfs) {
  | None => bound(env, [], fields)
  | Some(pf) => let label = touchField(env, pf.label, pf.labelSpan, fields) in
      boundThen(boundThen(bound(
        env,
        label.occs,
        label.fields
      ), (e, fs) =>
        walkPat(e, pf.pat, fs)), (e, fs) => walkPatFields(e, pfs, i + 1, fs))
}

let walkPat = (env: SymEnv, pat: Ast.Pattern, fields: Map<string, Loc>) => switch pat {
  | Ast.PAs(inner, name, nameSpan, _) => boundThen(walkPat(
      env,
      inner,
      fields
    ), (e, fs) => bindName(e, name, nameSpan, fs))
  | Ast.PBind(name, span) => name == "_"
      ? bound(env, [], fields)
      : bindName(env, name, span, fields)
  | Ast.PCtor(ctor, args, _, span) => boundThen(bound(
      env,
      use(env, "ctor", ctor, span),
      fields
    ), (e, fs) => walkPats(e, args, 0, fs))
  | Ast.PRecord(pfs, _) => walkPatFields(env, pfs, 0, fields)
  | Ast.PTuple(elems, _) => walkPats(env, elems, 0, fields)
  | Ast.PArr(elems, rest, _) => boundThen(walkPats(
      env,
      elems,
      0,
      fields
    ), (e, fs) => walkPatOpt(e, rest, fs))
  | Ast.PList(elems, rest, _) => boundThen(walkPats(
      env,
      elems,
      0,
      fields
    ), (e, fs) => walkPatOpt(e, rest, fs))
  | Ast.POr(alts, _) =>
    // Every alternative binds the same names; the first introduces them, the
    // rest only contribute their ctor and field uses.
    switch alts {
      | [first, ...rest] => boundThen(walkPat(
          env,
          first,
          fields
        ), (e, fs) =>
          let uses = walkPatUsesList(e, rest, 0, fs) in
            bound(e, uses.occs, uses.fields))
      | [] => bound(env, [], fields)
    }
  | _ => bound(env, [], fields)
}

let walkPatUsesList = (env: SymEnv, pats: [Ast.Pattern], i: number, fields: Map<string, Loc>) => switch Array.get(i, pats) {
  | None => none(fields)
  | Some(p) => andThen(walkPatUses(
      env,
      p,
      fields
    ), fs => walkPatUsesList(env, pats, i + 1, fs))
}

let walkPatUsesOpt = (env: SymEnv, pat: Option<Ast.Pattern>, fields: Map<string, Loc>) => switch pat {
  | Some(p) => walkPatUses(env, p, fields)
  | None => none(fields)
}

let walkPatFieldUses = (env: SymEnv, pfs: [Ast.PatField], i: number, fields: Map<string, Loc>) => switch Array.get(i, pfs) {
  | None => none(fields)
  | Some(pf) => andThen(andThen(touchField(
      env,
      pf.label,
      pf.labelSpan,
      fields
    ), fs =>
      walkPatUses(
        env,
        pf.pat,
        fs
      )), fs => walkPatFieldUses(env, pfs, i + 1, fs))
}

/// A pattern walk that records uses (ctors, fields) but binds nothing.
let walkPatUses = (env: SymEnv, pat: Ast.Pattern, fields: Map<string, Loc>) => switch pat {
  | Ast.PAs(inner, _, _, _) => walkPatUses(env, inner, fields)
  | Ast.PCtor(ctor, args, _, span) => prefixed(
      use(env, "ctor", ctor, span),
      walkPatUsesList(env, args, 0, fields)
    )
  | Ast.PRecord(pfs, _) => walkPatFieldUses(env, pfs, 0, fields)
  | Ast.PTuple(elems, _) => walkPatUsesList(env, elems, 0, fields)
  | Ast.PArr(elems, rest, _) => andThen(walkPatUsesList(
      env,
      elems,
      0,
      fields
    ), fs => walkPatUsesOpt(env, rest, fs))
  | Ast.PList(elems, rest, _) => andThen(walkPatUsesList(
      env,
      elems,
      0,
      fields
    ), fs => walkPatUsesOpt(env, rest, fs))
  | Ast.POr(alts, _) => walkPatUsesList(env, alts, 0, fields)
  | _ => none(fields)
}

// --- expressions ---

let walkExprs = (env: SymEnv, exprs: [Ast.Expr], i: number, fields: Map<string, Loc>) => switch Array.get(i, exprs) {
  | None => none(fields)
  | Some(e) => andThen(walkExpr(
      env,
      e,
      fields
    ), fs => walkExprs(env, exprs, i + 1, fs))
}

let walkSeqs = (env: SymEnv, elems: [Ast.SeqElem], i: number, fields: Map<string, Loc>) => switch Array.get(i, elems) {
  | None => none(fields)
  | Some(Ast.SEExpr(e)) => andThen(walkExpr(
      env,
      e,
      fields
    ), fs => walkSeqs(env, elems, i + 1, fs))
  | Some(Ast.SESpread(e)) => andThen(walkExpr(
      env,
      e,
      fields
    ), fs => walkSeqs(env, elems, i + 1, fs))
}

let walkInterp = (env: SymEnv, parts: [Ast.InterpPart], i: number, fields: Map<string, Loc>) => switch Array.get(i, parts) {
  | None => none(fields)
  | Some(Ast.IPLit(_)) => walkInterp(env, parts, i + 1, fields)
  | Some(Ast.IPExpr(e)) => andThen(walkExpr(
      env,
      e,
      fields
    ), fs => walkInterp(env, parts, i + 1, fs))
}

let walkRecordFields = (env: SymEnv, rfs: [Ast.Field], i: number, fields: Map<string, Loc>) => switch Array.get(i, rfs) {
  | None => none(fields)
  | Some(f) => andThen(andThen(touchField(
      env,
      f.name,
      f.nameSpan,
      fields
    ), fs =>
      walkExpr(env, f.value, fs)), fs => walkRecordFields(env, rfs, i + 1, fs))
}

let walkEntries = (env: SymEnv, entries, i: number, fields: Map<string, Loc>) => switch Array.get(i, entries) {
  | None => none(fields)
  | Some(entry) => andThen(andThen(walkExpr(
      env,
      entry.key,
      fields
    ), fs =>
      walkExpr(
        env,
        entry.value,
        fs
      )), fs => walkEntries(env, entries, i + 1, fs))
}

let walkArms = (env: SymEnv, arms, i: number, fields: Map<string, Loc>) => switch Array.get(i, arms) {
  | None => none(fields)
  | Some(arm) => let pat = walkPat(env, arm.pattern, fields) in
    let guard = switch arm.guard {
      | Some(g) => walkExpr(pat.env, g, pat.fields)
      | None => none(pat.fields)
    } in
    let body = andThen(prefixed(
      pat.occs,
      guard
    ), fs => walkExpr(pat.env, arm.body, fs)) in
    // Pattern binds are live across the guard and the body.
    let armSpan = {
      start: patSpan(arm.pattern).start,
      end: exprSpan(arm.body).end
    } in
      andThen(framed(
        env,
        pat.env,
        armSpan,
        body
      ), fs => walkArms(env, arms, i + 1, fs))
}

let walkLoopInits = (env: SymEnv, params, i: number, fields: Map<string, Loc>) => switch Array.get(i, params) {
  | None => none(fields)
  | Some(param) => andThen(walkExpr(
      env,
      param.init,
      fields
    ), fs => walkLoopInits(env, params, i + 1, fs))
}

let bindLoopParams = (env: SymEnv, params, i: number, fields: Map<string, Loc>) => switch Array.get(i, params) {
  | None => bound(env, [], fields)
  | Some(param) => boundThen(bindName(
      env,
      param.name,
      param.nameSpan,
      fields
    ), (e, fs) => bindLoopParams(e, params, i + 1, fs))
}

/// An adjacent run of lambda `let … in`s: one recursive scope (ADR 0067).
type LetRun = {
  binders: [(string, Ast.Span, Option<Ast.TypeExpr>, Ast.Expr)],
  tail: Ast.Expr
}

let letRun = (e: Ast.Expr, acc) => switch e {
  | Ast.ELetIn(name, nameSpan, annot, value, body, _) => switch value {
      | Ast.ELambda(_, _, _) => letRun(
          body,
          Array.append((name, nameSpan, annot, value), acc)
        )
      | _ => { binders: acc, tail: e }
    }
  | _ => { binders: acc, tail: e }
}

let bindRun = (env: SymEnv, binders, i: number, fields: Map<string, Loc>) => switch Array.get(i, binders) {
  | None => bound(env, [], fields)
  | Some((name, nameSpan, _, _)) => boundThen(bindName(
      env,
      name,
      nameSpan,
      fields
    ), (e, fs) => bindRun(e, binders, i + 1, fs))
}

let walkRunValues = (env: SymEnv, binders, i: number, fields: Map<string, Loc>) => switch Array.get(i, binders) {
  | None => none(fields)
  | Some((_, _, annot, value)) => andThen(prefixed(
      walkAnnot(env, annot),
      walkExpr(env, value, fields)
    ), fs => walkRunValues(env, binders, i + 1, fs))
}

let walkLetRun = (env: SymEnv, run: LetRun, fields: Map<string, Loc>) =>
  let scope = bindRun(env, run.binders, 0, fields) in
    // The frame is the tail's span: the run's own values see the
    // binders (they are recursive) but completion inside them does not.
    framed(
      env,
      scope.env,
      exprSpan(run.tail),
      prefixed(
        scope.occs,
        andThen(walkRunValues(
          scope.env,
          run.binders,
          0,
          scope.fields
        ), fs => walkExpr(scope.env, run.tail, fs))
      )
    )

let fieldNameSpan = (span: Ast.Span, name: string) =>
  { start: span.end - Str.length(name), end: span.end }

let walkFieldAccess = (env: SymEnv, target: Ast.Expr, name: string, span: Ast.Span, fields: Map<string, Loc>) =>
  let nameSpan = fieldNameSpan(span, name) in
  let member = switch target {
    | Ast.ERef(ns, _) => Map.get("${ns}.${name}", env.prelude.members)
    | _ => None
  } in
    andThen(walkExpr(env, target, fields), fs => switch member {
      | Some(def) =>
        // `Result.map` and friends: a prelude namespace member, not a field.
        walked([occ(name, "value", def, nameSpan, "use")], fs)
      | None => touchField(env, name, nameSpan, fs)
    })

let walkExpr = (env: SymEnv, expr: Ast.Expr, fields: Map<string, Loc>) => switch expr {
  | Ast.ERef(name, span) => parked(name)
      ? none(fields)
      : upperStart(name) && lookup(env, "ctor", name) != None
      ? walked(use(env, "ctor", name, span), fields)
      : walked(use(env, "value", name, span), fields)
  | Ast.EInterp(parts, _) => walkInterp(env, parts, 0, fields)
  | Ast.ECall(fn, args, _, _) => andThen(walkExpr(
      env,
      fn,
      fields
    ), fs => walkExprs(env, args, 0, fs))
  | Ast.ELambda(params, body, sp) => let scope = bindParams(
      env,
      params,
      0,
      fields
    ) in
    let inner = walkExpr(scope.env, body, scope.fields) in
      framed(
        env,
        scope.env,
        sp,
        {
          occs: Array.concat(scope.occs, inner.occs),
          fields: inner.fields,
          frames: Array.concat(scope.frames, inner.frames)
        }
      )
  | Ast.ELetIn(name, nameSpan, annot, value, body, _) => switch value {
      | Ast.ELambda(_, _, _) => walkLetRun(env, letRun(expr, []), fields)
      | _ => let v = walkExpr(env, value, fields) in
        let scope = bindName(env, name, nameSpan, v.fields) in
        let inner = framed(
          env,
          scope.env,
          exprSpan(body),
          walkExpr(scope.env, body, scope.fields)
        ) in
          {
            occs: Array.concat(
              Array.concat(
                v.occs,
                Array.concat(walkAnnot(env, annot), scope.occs)
              ),
              inner.occs
            ),
            fields: inner.fields,
            frames: Array.concat(v.frames, inner.frames)
          }
    }
  | Ast.ELetBind(param, _, _, value, body, _) => let v = walkExpr(
      env,
      value,
      fields
    ) in
    let scope = bindParam(env, param, v.fields) in
    let inner = framed(
      env,
      scope.env,
      exprSpan(body),
      walkExpr(scope.env, body, scope.fields)
    ) in
      {
        occs: Array.concat(Array.concat(v.occs, scope.occs), inner.occs),
        fields: inner.fields,
        frames: Array.concat(Array.concat(v.frames, scope.frames), inner.frames)
      }
  | Ast.ELoop(params, body, _) => let inits = walkLoopInits(
      env,
      params,
      0,
      fields
    ) in
    let scope = bindLoopParams(env, params, 0, inits.fields) in
    let inner = framed(
      env,
      scope.env,
      exprSpan(body),
      walkExpr(scope.env, body, scope.fields)
    ) in
      {
        occs: Array.concat(Array.concat(inits.occs, scope.occs), inner.occs),
        fields: inner.fields,
        frames: Array.concat(inits.frames, inner.frames)
      }
  | Ast.ERecur(args, _) => walkExprs(env, args, 0, fields)
  | Ast.EPipe(left, right, _, _) => andThen(walkExpr(
      env,
      left,
      fields
    ), fs => walkExpr(env, right, fs))
  | Ast.EDo(exprs, _) => walkExprs(env, exprs, 0, fields)
  | Ast.ETernary(cond, thenE, elseE, _) => walkExprs(
      env,
      [cond, thenE, elseE],
      0,
      fields
    )
  | Ast.EMatch(scrutinee, arms, _) => andThen(walkExpr(
      env,
      scrutinee,
      fields
    ), fs => walkArms(env, arms, 0, fs))
  | Ast.ERecord(rfs, spread, _) => switch spread {
      | Some(base) => andThen(walkExpr(
          env,
          base,
          fields
        ), fs => walkRecordFields(env, rfs, 0, fs))
      | None => walkRecordFields(env, rfs, 0, fields)
    }
  | Ast.EField(target, name, _, span) => walkFieldAccess(
      env,
      target,
      name,
      span,
      fields
    )
  | Ast.ETuple(elements, _) => walkExprs(env, elements, 0, fields)
  | Ast.EArr(elements, _) => walkSeqs(env, elements, 0, fields)
  | Ast.EList(elements, _) => walkSeqs(env, elements, 0, fields)
  | Ast.ESet(elements, _) => walkSeqs(env, elements, 0, fields)
  | Ast.EMap(entries, _) => walkEntries(env, entries, 0, fields)
  | _ => none(fields)
}

// --- module scope ---

/// Module-scope bindings as the top-level walk leaves them.
type TopScope = {
  top: Origins,
  occs: [SymOccurrence],
  fields: Map<string, Loc>
}

let withValue = (o: Origins, name: string, def: Loc) =>
  { values: Map.set(name, def, o.values), types: o.types, ctors: o.ctors }
let withType = (o: Origins, name: string, def: Loc) =>
  { values: o.values, types: Map.set(name, def, o.types), ctors: o.ctors }
let withCtor = (o: Origins, name: string, def: Loc) =>
  { values: o.values, types: o.types, ctors: Map.set(name, def, o.ctors) }

let topThen = (first: TopScope, occs: [SymOccurrence], top: Origins, fields: Map<string, Loc>) =>
  { top, occs: Array.concat(first.occs, occs), fields }

/// An imported name resolves to its export site when `origins` has it: a ctor
/// (also seeded as a value, for non-call uses), then a value, then a type.
/// Unresolved, the import itself is the def.
let bindImport = (env: SymEnv, origins: Origins, acc: TopScope, name: string, span: Ast.Span) => switch (Map.get(name, origins.ctors), Map.get(name, origins.values), Map.get(name, origins.types)) {
  | (Some(def), _, _) => topThen(
      acc,
      [occ(name, "ctor", def, span, "use")],
      withValue(withCtor(acc.top, name, def), name, def),
      acc.fields
    )
  | (None, Some(def), _) => topThen(
      acc,
      [occ(name, "value", def, span, "use")],
      withValue(acc.top, name, def),
      acc.fields
    )
  | (None, None, Some(def)) => topThen(
      acc,
      [occ(name, "type", def, span, "use")],
      withType(acc.top, name, def),
      acc.fields
    )
  | _ => let def = locOf(env, span) in
      topThen(
        acc,
        [occ(name, "value", def, span, "def")],
        withValue(acc.top, name, def),
        acc.fields
      )
}

let bindImports = (env: SymEnv, origins: Origins, acc: TopScope, names, i: number) => switch Array.get(i, names) {
  | None => acc
  | Some(n) => bindImports(
      env,
      origins,
      bindImport(env, origins, acc, n.name, n.span),
      names,
      i + 1
    )
}

let bindCtors = (env: SymEnv, acc: TopScope, ctors: [Ast.Ctor], i: number) => switch Array.get(i, ctors) {
  | None => acc
  | Some(c) => let def = locOf(env, c.span) in
      bindCtors(
        env,
        topThen(
          acc,
          [occ(c.name, "ctor", def, c.span, "def")],
          withCtor(acc.top, c.name, def),
          acc.fields
        ),
        ctors,
        i + 1
      )
}

let touchAliasFields = (env: SymEnv, acc: TopScope, afs: [Ast.AliasField], i: number) => switch Array.get(i, afs) {
  | None => acc
  | Some(f) => let w = touchField(env, f.name, f.nameSpan, acc.fields) in
      touchAliasFields(env, topThen(acc, w.occs, acc.top, w.fields), afs, i + 1)
}

let bindTopValue = (env: SymEnv, acc: TopScope, name: string, span: Ast.Span) =>
  let def = locOf(env, span) in
    topThen(
      acc,
      [occ(name, "value", def, span, "def")],
      withValue(acc.top, name, def),
      acc.fields
    )

let bindTopLevels = (env: SymEnv, origins: Origins, stmts: [Ast.Stmt], i: number, acc: TopScope) => switch Array.get(i, stmts) {
  | None => acc
  | Some(stmt) => bindTopLevels(
      env,
      origins,
      stmts,
      i + 1,
      switch stmt {
        | Ast.SImportNs(alias, _, _) => bindTopValue(
            env,
            acc,
            alias.name,
            alias.span
          )
        | Ast.SImport(names, _, _) => bindImports(env, origins, acc, names, 0)
        | Ast.SType(name, nameSpan, _, ctors, alias, _, _, _, _) => let def = locOf(
            env,
            nameSpan
          ) in
          let withCtors = bindCtors(
            env,
            topThen(
              acc,
              [occ(name, "type", def, nameSpan, "def")],
              withType(acc.top, name, def),
              acc.fields
            ),
            ctors,
            0
          ) in
            // Alias fields first, so `p.x` resolves to the alias's `x`.
            switch alias {
              | Some(afs) => touchAliasFields(env, withCtors, afs, 0)
              | None => withCtors
            }
        | Ast.SLet(name, nameSpan, _, _, _, _, _) => parked(name)
            ? acc
            : bindTopValue(env, acc, name, nameSpan)
        | Ast.SExtern(name, nameSpan, _, _, _, _, _, _, _, _) => bindTopValue(
            env,
            acc,
            name,
            nameSpan
          )
        | _ => acc
      }
    )
}

let ctorFieldTypes = (ctors: [Ast.Ctor]) =>
  ctors |> Array.flatMap(c => c.fields |> Array.map(f => f.fieldType))

let walkStmt = (env: SymEnv, stmt: Ast.Stmt, fields: Map<string, Loc>) => switch stmt {
  | Ast.SLet(_, _, annot, value, _, _, _) => prefixed(
      walkAnnot(env, annot),
      walkExpr(env, value, fields)
    )
  | Ast.SExpr(value, _) => walkExpr(env, value, fields)
  | Ast.SExtern(_, _, _, typeExpr, _, _, _, _, _, _) => walked(
      walkType(env, typeExpr),
      fields
    )
  | Ast.SType(_, _, _, ctors, alias, aliasType, _, _, _) => let aliasTypes = switch alias {
      | Some(afs) => afs |> Array.map(f => f.fieldType)
      | None => []
    } in
      walked(
        Array.concat(
          walkTypes(env, Array.concat(ctorFieldTypes(ctors), aliasTypes), 0),
          walkAnnot(env, aliasType)
        ),
        fields
      )
  | _ => none(fields)
}

let walkStmts = (env: SymEnv, stmts: [Ast.Stmt], i: number, fields: Map<string, Loc>) => switch Array.get(i, stmts) {
  | None => none(fields)
  | Some(stmt) => andThen(walkStmt(
      env,
      stmt,
      fields
    ), fs => walkStmts(env, stmts, i + 1, fs))
}

/// indexWith : string -> Origins -> SymPrelude -> [Stmt] -> SymIndex
/// Occurrences come in walk order: module-scope binders first, then bodies.
export let indexWith = (path: string, origins: Origins, prelude: SymPrelude, stmts: [Ast.Stmt]) =>
  let env0 = { path, top: emptyOrigins, prelude, locals: #{} } in
  let tops = bindTopLevels(
    env0,
    origins,
    stmts,
    0,
    { top: emptyOrigins, occs: [], fields: #{} }
  ) in
  let body = walkStmts(
    { path, top: tops.top, prelude, locals: #{} },
    stmts,
    0,
    tops.fields
  ) in
    {
      occurrences: Array.concat(tops.occs, body.occs),
      top: tops.top,
      fields: body.fields,
      frames: body.frames
    }

// --- export sites ---

let originsFrom = (path: string, stmts: [Ast.Stmt], i: number, acc: Origins) => switch Array.get(i, stmts) {
  | None => acc
  | Some(Ast.SLet(name, nameSpan, _, _, true, _, _)) => originsFrom(
      path,
      stmts,
      i + 1,
      withValue(acc, name, { path, start: nameSpan.start, end: nameSpan.end })
    )
  | Some(Ast.SExtern(name, nameSpan, _, _, _, _, _, true, _, _)) => originsFrom(
      path,
      stmts,
      i + 1,
      withValue(acc, name, { path, start: nameSpan.start, end: nameSpan.end })
    )
  | Some(Ast.SType(name, nameSpan, _, ctors, _, _, true, _, _)) => originsFrom(
      path,
      stmts,
      i + 1,
      ctors
        |> Array.reduce(
          (o, c: Ast.Ctor) =>
            let at = { path, start: c.span.start, end: c.span.end } in
              withValue(withCtor(o, c.name, at), c.name, at),
          withType(
            acc,
            name,
            { path, start: nameSpan.start, end: nameSpan.end }
          )
        )
    )
  | Some(_) => originsFrom(path, stmts, i + 1, acc)
}

/// originsOf : string -> [Stmt] -> Origins
/// The export sites an importer's `indexWith` resolves its imports to.
export let originsOf = (path: string, stmts: [Ast.Stmt]) =>
  originsFrom(path, stmts, 0, emptyOrigins)

// --- single-file value index ---

let importSpans = (stmts: [Ast.Stmt]) =>
  stmts
    |> Array.flatMap(s => switch s {
      | Ast.SImport(names, _, _) => names |> Array.map(n => n.span.start)
      | Ast.SImportNs(alias, _, _) => [alias.span.start]
      | _ => []
    })

/// index : [Stmt] -> [Occurrence]
/// This file's value bindings only: no imports, prelude, types, ctors or
/// fields. Declaration spans are the identity.
export let index = (stmts: [Ast.Stmt]) =>
  let imports = importSpans(stmts) in
  let noPrelude = { origins: emptyOrigins, members: #{} } in
    indexWith("", emptyOrigins, noPrelude, stmts).occurrences
      |> Array.filter(o =>
        o.space == "value" && !Array.contains(o.defStart, imports))
      |> Array.map(o =>
        {
          name: o.name,
          defStart: o.defStart,
          defEnd: o.defEnd,
          start: o.start,
          end: o.end,
          role: o.role
        })

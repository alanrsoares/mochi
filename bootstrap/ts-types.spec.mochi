import { assertEq, test } from "@mochi/test"
import {
  RowEmpty,
  TySingleton,
  rExtend,
  rVar,
  tArrow,
  tCon,
  tLit,
  tPrim,
  tRecord,
  tUnion,
  tVar
} from "./types.mochi"
import {
  genericNames,
  plainEnv,
  recsEnv,
  rowShapeKey,
  schemeRender,
  tsEnv,
  tsOf
} from "./ts-types.mochi"

test("TS types render primitives, arrows, and tuples", () => {
  assertEq("number", tsOf(tPrim("number"), tsEnv(#{}, #{})));
  assertEq(
    "(a: number, b: string) => boolean",
    tsOf(
      tArrow(tPrim("number"), tArrow(tPrim("string"), tPrim("bool"))),
      tsEnv(#{}, #{})
    )
  );
  assertEq(
    "[number, string]",
    tsOf(tCon("tuple", [tPrim("number"), tPrim("string")]), tsEnv(#{}, #{}))
  )
})

test("TS types preserve a named open row", () =>
  let names = genericNames({ vars: [], rvars: [7], ty: tRecord(rVar(7)) }) in
    assertEq(
      "({ x: number } & A)",
      tsOf(tRecord(rExtend("x", tPrim("number"), rVar(7))), tsEnv(names, #{}))
    ))

test("TS types use generic names for type variables", () =>
  assertEq(
    "A[]",
    tsOf(
      tCon("Array", [tVar(3)]),
      tsEnv(genericNames({ vars: [3], rvars: [], ty: tVar(3) }), #{})
    )
  ))

// ---- record alias index (ADR 0092) -----------------------------------------

let span = rExtend(
  "start",
  tPrim("number"),
  rExtend("end", tPrim("number"), RowEmpty)
)

let spanIdx = #{ "end: number; start: number": "Span" }

test("a closed row matching the index renders as the declared alias", () =>
  assertEq("Span", tsOf(tRecord(span), tsEnv(#{}, spanIdx))))

test("the index key is field-order independent", () =>
  // `unify` extends a row in whatever order it met the fields, so the SAME
  // record type reaches `tsOf` under either spelling and both must fold.
  assertEq(
    "Span",
    tsOf(
      tRecord(
        rExtend(
          "end",
          tPrim("number"),
          rExtend("start", tPrim("number"), RowEmpty)
        )
      ),
      tsEnv(#{}, spanIdx)
    )
  ))

test("an OPEN row keeps its structure", () =>
  // `{ start; end } & A` is a row the alias only prefixes, not the alias.
  let names = genericNames({ vars: [], rvars: [7], ty: tRecord(rVar(7)) }) in
    assertEq(
      "({ start: number; end: number } & A)",
      tsOf(
        tRecord(
          rExtend(
            "start",
            tPrim("number"),
            rExtend("end", tPrim("number"), rVar(7))
          )
        ),
        tsEnv(names, spanIdx)
      )
    ))

test("an empty index leaves every row structural", () =>
  assertEq(
    "{ start: number; end: number }",
    tsOf(tRecord(span), tsEnv(#{}, #{}))
  ))

test("rowShapeKey sorts fields and declines an open row", () => {
  assertEq(Some("end: number; start: number"), rowShapeKey(span, #{}));
  assertEq(None, rowShapeKey(rExtend("start", tPrim("number"), rVar(7)), #{}))
})

test("rowShapeKey keeps distinct literal unions apart", () => {
  assertEq(
    Some("k: \"x\" | \"y\""),
    rowShapeKey(rExtend("k", tUnion([tLit("x"), tLit("y")]), RowEmpty), #{})
  );
  assertEq(
    Some("n: 1 | 2"),
    rowShapeKey(
      rExtend(
        "n",
        tUnion([TySingleton("number", "1"), TySingleton("number", "2")]),
        RowEmpty
      ),
      #{}
    )
  )
})

test("rowShapeKey sorts a nested record", () =>
  let fwd = tCon(
    "Array",
    [
      tRecord(
        rExtend(
          "name",
          tPrim("string"),
          rExtend("fieldType", tPrim("string"), RowEmpty)
        )
      )
    ]
  ) in
  let rev = tCon(
    "Array",
    [
      tRecord(
        rExtend(
          "fieldType",
          tPrim("string"),
          rExtend("name", tPrim("string"), RowEmpty)
        )
      )
    ]
  ) in
    assertEq(
      rowShapeKey(rExtend("fields", fwd, RowEmpty), #{}),
      rowShapeKey(rExtend("fields", rev, RowEmpty), #{})
    ))

// ---- alias pins (ADR 0106) -------------------------------------------------

let locTok = rExtend(
  "tok",
  tPrim("string"),
  rExtend(
    "start",
    tPrim("number"),
    rExtend(
      "end",
      tPrim("number"),
      rExtend("doc", tCon("Option", [tVar(0)]), RowEmpty)
    )
  )
)

let locIdx = #{
  "doc: Option<string>; end: number; start: number; tok: string": "LocTok"
}

test("a generic field pins so the row prints as the alias", () =>
  let rendered = schemeRender(
    { vars: [0], rvars: [], ty: tRecord(locTok) },
    locIdx
  ) in
    assertEq("LocTok", tsOf(tRecord(locTok), rendered.env)))

test("a closed span of scheme variables pins to Span, the open parameter does not", () =>
  let ty = tArrow(
    tRecord(rExtend("start", tVar(1), rExtend("end", tVar(2), rVar(3)))),
    tRecord(rExtend("start", tVar(1), rExtend("end", tVar(2), RowEmpty)))
  ) in
  let rendered = schemeRender({ vars: [1, 2], rvars: [3], ty }, spanIdx) in
    assertEq(
      "(a: ({ start: number; end: number } & C)) => Span",
      tsOf(ty, rendered.env)
    ))

test("an open row alone does not pin its fields", () =>
  let ty = tRecord(
    rExtend("start", tVar(1), rExtend("end", tVar(2), rVar(3)))
  ) in
  let rendered = schemeRender({ vars: [1, 2], rvars: [3], ty }, spanIdx) in
    assertEq(0, Map.size(rendered.pins)))

test("two aliases that both explain a row pin nothing", () =>
  let ty = tRecord(rExtend("x", tVar(0), rExtend("y", tVar(1), RowEmpty))) in
  let rendered = schemeRender(
    { vars: [0, 1], rvars: [], ty },
    #{ "x: number; y: number": "NumPt", "x: string; y: string": "StrPt" }
  ) in
    assertEq(0, Map.size(rendered.pins)))

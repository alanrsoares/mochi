// bootstrap/ast.mochi — the one AST, shared by every pass (ticket 0013).
//
// Before the module driver landed, parser/check/infer/codegen/module each
// re-declared this block (the `_tag` runtime shape made the copies
// interchangeable under compile.mochi's opaque threading). Now they `import` the
// variant ctors from here and pattern-match them under the closed-world build.
//
// Only the VARIANT types are exported — importing a ctor (ENum, SLet, …) is how
// a module names the type. The record types (Span, Name, Field, …) are used
// structurally (`{ start, end }`, `r.name`), so they need no export; they live
// here only so the ctor field types resolve.

export type Span = { start: number, end: number }
type Name = { name: string, span: Span }

export type LamParam =
  | LPName(name: string, annot: Option<TypeExpr>)
  | LPRecord(fields: [string])
  | LPTuple(names: [string])
  | LPLabeled(name: string, annot: Option<TypeExpr>, optional: bool, defaultValue: Option<Expr>)
  // Source-authored parameters retain one exact span per bound name. Keeping
  // the legacy shapes inside the wrapper lets synthetic compiler parameters
  // remain spanless while editor-facing binders never need reconstructed text.
  | LPSpanned(param: LamParam, nameSpans: [Span])

type Field = { name: string, value: Expr }
type MapEntry = { key: Expr, value: Expr }
type MatchArm = { pattern: Pattern, guard: Option<Expr>, body: Expr }

// One `name = init` binder in a `loop (...)` head (ADR 0056).
type LoopParam = { name: string, nameSpan: Span, init: Expr }
type PatField = { label: string, pat: Pattern }

/// One slot in an Array / List / Set literal (ADR 0001).
export type SeqElem =
  | SEExpr(expr: Expr)
  | SESpread(expr: Expr)

export type Expr =
  | ENum(value: number, raw: string, span: Span)
  // `()` — the unit value, sole inhabitant of `unit` (ADR 0054). Emits `undefined`.
  | EUnit(span: Span)
  | EBool(value: bool, span: Span)
  | EStr(value: string, span: Span)
  | ERef(name: string, span: Span)
  // `origin` is sugar provenance (ADR 0011 §5): Some("jsx") when the parser
  // desugared JSX; None for ordinary calls — so a hand-written `h(...)` is
  // never mistaken for sugar.
  | ECall(fn: Expr, args: [Expr], origin: Option<string>, span: Span)
  | ELambda(params: [LamParam], body: Expr, span: Span)
  // `annot` is the optional `let x : T = v in b` binding annotation (ADR 0044),
  // kept in the AST so the formatter can print it back and infer can pin it.
  | ELetIn(name: string, nameSpan: Span, annot: Option<TypeExpr>, value: Expr, body: Expr, span: Span)
  | ELetBind(param: LamParam, paramSpan: Span, monad: string, value: Expr, body: Expr, span: Span)
  // `fast` distinguishes `a -> f(b)` from `a |> f`: both lower to a call, but the
  // fast pipe PREPENDS its left (ADR 0069) while `|>` is data-last. Kept in the
  // AST rather than desugared at parse time so the formatter can print it back.
  | EPipe(left: Expr, right: Expr, fast: bool, span: Span)
  | EDo(exprs: [Expr], span: Span)
  | ETernary(cond: Expr, thenE: Expr, elseE: Expr, span: Span)
  | EMatch(scrutinee: Expr, arms: [MatchArm], span: Span)
  | ERecord(fields: [Field], spread: Option<Expr>, span: Span)
  | EField(target: Expr, name: string, optional: bool, span: Span)
  | ETuple(elements: [Expr], span: Span)
  | EArr(elements: [SeqElem], span: Span)
  | EList(elements: [SeqElem], span: Span)
  | ESet(elements: [SeqElem], span: Span)
  | EMap(entries: [MapEntry], span: Span)
  // `loop (p = init, ...) { body }` / `recur(args)` — ADR 0056.
  | ELoop(params: [LoopParam], body: Expr, span: Span)
  | ERecur(args: [Expr], span: Span)
  | EInterp(parts: [InterpPart], span: Span)

export type InterpPart =
  | IPLit(value: string)
  | IPExpr(expr: Expr)

export type Pattern =
  | PWild(span: Span)
  // `()` — matches the sole inhabitant of `unit`, like any nullary variant ctor (ADR 0054).
  | PUnit(span: Span)
  | PBind(name: string, span: Span)
  | PAs(pat: Pattern, name: string, nameSpan: Span, span: Span)
  | PLit(value: number, raw: string, span: Span)
  | PBool(value: bool, span: Span)
  | PStr(value: string, span: Span)
  | PTuple(elems: [Pattern], span: Span)
  | PRecord(fields: [PatField], span: Span)
  // Bare `Circle(r)`, or `Alias.Circle(r)` after `import * as Alias` (ADR 0002).
  | PCtor(ctor: string, args: [Pattern], ns: Option<string>, span: Span)
  | PArr(elems: [Pattern], rest: Option<Pattern>, span: Span)
  | PList(elems: [Pattern], rest: Option<Pattern>, span: Span)
  | POr(alts: [Pattern], span: Span)

export type TypeExpr =
  | TyName(name: string, span: Span)
  | TyArrow(from: TypeExpr, to: TypeExpr, span: Span)
  | TyApp(ctor: string, args: [TypeExpr], span: Span)
  | TyTuple(elems: [TypeExpr], span: Span)
  | TyList(elem: TypeExpr, span: Span)
  // `Alias.Name` (nullary, `args: []`) or `Alias.Name b` (applied) — ADR 0046.
  // One variant covers both arities, unlike the TyName/TyApp split: a qualified
  // name is always a constructor reference, never a variable, so the
  // lowercase/uppercase branch that motivates the split cannot apply.
  | TyQual(alias: string, name: string, nameSpan: Span, args: [TypeExpr], span: Span)
  // `"rose"` / `"rose" | "amber"` in type position (ADR 0081).
  | TyLit(value: string, span: Span)
  | TyUnion(members: [TypeExpr], span: Span)

export type CtorField = { name: Option<string>, fieldType: TypeExpr }
type Ctor = { name: string, fields: [CtorField] }
export type AliasField = { name: string, fieldType: TypeExpr, optional: bool }

export type Stmt =
  | SLet(name: string, nameSpan: Span, annot: Option<TypeExpr>, value: Expr, exported: bool, doc: Option<string>, span: Span)
  | SType(name: string, params: [string], ctors: [Ctor], alias: Option<[AliasField]>, aliasType: Option<TypeExpr>, exported: bool, doc: Option<string>, span: Span)
  // `curried` marks a host written `a => b => c` rather than `(a, b) => c` — a
  // calling convention like `send`/`new`, not a property of the type (ADR 0064).
  | SExtern(name: string, nameSpan: Span, params: [string], typeExpr: TypeExpr, module: string, imported: string, curried: bool, exported: bool, doc: Option<string>, span: Span)
  | SImport(names: [Name], from: string, span: Span)
  // import * as Alias from "./mod" — whole module as a user namespace (ADR 0002).
  | SImportNs(alias: Name, from: string, span: Span)
  // A top-level expression statement. Must have type `()` (ADR 0087) — `test(…)`,
  // `log(msg)`, `do { … }` whose last expr is unit. Optional trailing semicolon.
  | SExpr(value: Expr, span: Span)
  // An unparsable region the parser skipped to recover (ADR 0045). `span` covers
  // every byte skipped, from the token that failed through the last one consumed
  // before the sync point. No message — diagnostics are the diagnostic channel —
  // and no bindings, so check/infer walk past it without cascading.
  | SError(span: Span)

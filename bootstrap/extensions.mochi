// bootstrap/extensions.mochi — thin LanguagePlugin seam for the self-host
// (Wave 8 / ADR 0011 §6, ADR 0109, ADR 0112). Parse, inferCall, format,
// formatDoc, dtsBinding and bindingType.
// Hooks are Result/(toks, pos) shaped — not an imperative ParserApi.
//
// resolvePlugins mirrors src/extensions.ts:
//   None            → builtins (default JSX on)
//   Some([])        → hard opt-out
//   Some([a, b, …]) → builtins prepended (a same-named caller plugin
//                     replaces one in place, ADR 0049), then caller list

import { jsxPlugin } from "./plugins/jsx.mochi"
import { preactPlugin } from "./plugins/preact.mochi"

export let DEFAULT_PLUGINS = [jsxPlugin]

/// Vendor adapters remain opt-in. Exporting Preact from the self-hosted graph
/// makes the reference implementation available to hosts without making hooks
/// part of the language's default surface.
export let PREACT_PLUGIN = preactPlugin

/// A caller plugin named like builtin `b` takes its slot (ADR 0049).
let shadowing = (ps, b) => switch Array.find(p => p.name == b.name, ps) {
  | Some(p) => p
  | None => b
}

/// `pluginsOpt` is Option [LanguagePlugin]: None = default, Some([]) = opt-out.
/// Otherwise builtins first, each replaced in place by a same-named caller
/// plugin (a hook-less stub disables it), then the rest of the caller list.
export let resolvePlugins = (pluginsOpt, builtins) => switch pluginsOpt {
  | None => builtins
  | Some(ps) => Array.length(ps) == 0
      ? []
      : Array.concat(
        Array.map(b => shadowing(ps, b), builtins),
        Array.filter(
          p => Array.length(Array.filter(b => b.name == p.name, builtins)) == 0,
          ps
        )
      )
}

export let resolvePluginsDefault = pluginsOpt =>
  resolvePlugins(pluginsOpt, DEFAULT_PLUGINS)

/// Collect parse hooks (skip plugins with None parse).
let parseHooksFrom = (plugins, i, acc) => switch Array.get(i, plugins) {
  | None => acc
  | Some({ parse }) => switch parse {
      | Some(hook) => plugins->parseHooksFrom(i + 1, Array.append(hook, acc))
      | None => plugins->parseHooksFrom(i + 1, acc)
    }
}
export let parseHooksOf = plugins => plugins->parseHooksFrom(0, [])

let inferHooksFrom = (plugins, i, acc) => switch Array.get(i, plugins) {
  | None => acc
  | Some(p) => switch p.inferCall {
      | Some(hook) => plugins->inferHooksFrom(i + 1, Array.append(hook, acc))
      | None => plugins->inferHooksFrom(i + 1, acc)
    }
}

export let inferCallHooksOf = plugins => plugins->inferHooksFrom(0, [])

/// First hook to claim wins. Ok(None) = fall through; Ok(Some((e, pos))) =
/// claimed; Err = parse diagnostic. `parseExpr` is (toks, pos) -> Result.
export let runParseHooks = (hooks, toks, pos, parseExpr) => switch hooks {
  | [] => Ok(None)
  | [hook, ...rest] => switch toks->hook(pos, parseExpr) {
      | Err(e) => Err(e)
      | Ok(v) => switch v {
          | None => rest->runParseHooks(toks, pos, parseExpr)
          | Some(claim) => Ok(Some(claim))
        }
    }
}

/// First hook to claim wins. Ok(None) = fall through to core call inference.
export let runInferCallHooks = (hooks, fn, args, origin, st, api) => switch hooks {
  | [] => Ok(None)
  | [hook, ...rest] => switch hook(fn, args, origin, st, api) {
      | Err(e) => Err(e)
      | Ok(v) => switch v {
          | None => rest->runInferCallHooks(fn, args, origin, st, api)
          | Some(claim) => Ok(Some(claim))
        }
    }
}

let formatHooksFrom = (plugins, i, acc) => switch Array.get(i, plugins) {
  | None => acc
  | Some(p) => switch p.format {
      | Some(hook) => plugins->formatHooksFrom(i + 1, Array.append(hook, acc))
      | None => plugins->formatHooksFrom(i + 1, acc)
    }
}

let formatDocHooksFrom = (plugins, i, acc) => switch Array.get(i, plugins) {
  | None => acc
  | Some(p) => switch p.formatDoc {
      | Some(hook) => plugins->formatDocHooksFrom(
          i + 1,
          Array.append(hook, acc)
        )
      | None => plugins->formatDocHooksFrom(i + 1, acc)
    }
}

/// Both kinds of format hook (ADR 0112): `rewrite` swaps a node for another
/// before layout, `layout` prints a node itself.
export let formatHooksOf = plugins =>
  {
    rewrite: plugins->formatHooksFrom(0, []),
    layout: plugins->formatDocHooksFrom(0, [])
  }

/// The format hooks a caller's `pluginsOpt` resolves to (builtins included).
export let formatHooksFor = pluginsOpt =>
  formatHooksOf(resolvePluginsDefault(pluginsOpt))

let dtsHooksFrom = (plugins, i, acc) => switch Array.get(i, plugins) {
  | None => acc
  | Some(p) => switch p.dtsBinding {
      | Some(hook) => plugins->dtsHooksFrom(i + 1, Array.append(hook, acc))
      | None => plugins->dtsHooksFrom(i + 1, acc)
    }
}

export let dtsHooksFor = pluginsOpt =>
  resolvePluginsDefault(pluginsOpt)->dtsHooksFrom(0, [])

/// First hook to claim wins: `Some(rewritten)` replaces the node for printing.
export let runFormatHooks = (hooks, e) => switch hooks {
  | [] => None
  | [hook, ...rest] => switch hook(e) {
      | Some(out) => Some(out)
      | None => rest->runFormatHooks(e)
    }
}

/// First hook to claim wins: `Some(doc)` is the node's layout.
export let runFormatDocHooks = (hooks, e, api) => switch hooks {
  | [] => None
  | [hook, ...rest] => switch hook(e, api) {
      | Some(doc) => Some(doc)
      | None => rest->runFormatDocHooks(e, api)
    }
}

/// First hook to claim wins: `Some(ts)` is the binding's declared type text.
export let runDtsHooks = (hooks, name, value, ty, api) => switch hooks {
  | [] => None
  | [hook, ...rest] => switch hook(name, value, ty, api) {
      | Some(ts) => Some(ts)
      | None => rest->runDtsHooks(name, value, ty, api)
    }
}

let bindingHooksFrom = (plugins, i, acc) => switch Array.get(i, plugins) {
  | None => acc
  | Some(p) => switch p.bindingType {
      | Some(hook) => plugins->bindingHooksFrom(i + 1, Array.append(hook, acc))
      | None => plugins->bindingHooksFrom(i + 1, acc)
    }
}

export let bindingHooksFor = pluginsOpt =>
  resolvePluginsDefault(pluginsOpt)->bindingHooksFrom(0, [])

/// First hook to claim wins: `Some(ts)` replaces the binding's TS type.
export let runBindingHooks = (hooks, value, ty, api) => switch hooks {
  | [] => None
  | [hook, ...rest] => switch hook(value, ty, api) {
      | Some(ts) => Some(ts)
      | None => rest->runBindingHooks(value, ty, api)
    }
}

// Ticket 0005 — the whole pipeline as one mochi function.
// lex → parse → check → infer → codegen, first Err short-circuits, Ok carries
// the emitted JS. Unlike the fixpoint harness (which composes only
// lex→parse→codegen), this runs check and infer as REAL gates: a duplicate
// declaration, a non-exhaustive switch, or a type error is rejected with its
// span and never reaches codegen. Passes are threaded opaquely (ticket 0002);
// the prelude tables come from the generated shim (ticket 0004).
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"
import { check } from "./check.mochi"
import { inferProgram, inferProgramTypes } from "./infer.mochi"
import { codegen } from "./codegen.mochi"
import { emitTsModule } from "./codegen-ts.mochi"
import { showType } from "./types.mochi"
import { widenLits } from "./schemes.mochi"

// Prelude tables from the standalone shim. builtins/namespaces carry the
// inferrer's Ty; compile never inspects them, so a polymorphic `a` lets them
// unify with whatever inferProgram expects (the opaque threading of 0002).
extern builtins : Map<string, a> = "./prelude.gen.mjs" "builtins"
extern namespaces : Map<string, Map<string, a> > = "./prelude.gen.mjs" "namespaces"
extern namespaceRuntime : Map<string, Map<string, string> > = "./prelude.gen.mjs" "namespaceRuntime"
extern preludeJsDefs : Map<string, string> = "./prelude.gen.mjs" "preludeJsDefs"
extern runtimeDeps : Map<string, [string]> = "./prelude.gen.mjs" "runtimeDeps"

// Type-check gate: strict inference, program passed through unchanged on success.
let typecheck = prog =>
  let? $env = prog->inferProgram(builtins, namespaces, false) in Ok(prog)

// lex -> parse -> check. Shared by both backends: the JS one adds the
// `typecheck` gate, the TS one re-runs inference for its span -> type table.
let frontend = lex >> Result.flatMap(parse) >> Result.flatMap(check)

// The front-end pipeline: lex -> parse -> check -> typecheck
let pipeline = frontend >> Result.flatMap(typecheck)

/// typedProgram : string -> Result (stmts, InferResult) Err — the AST *and* its
/// inference, for passes that print declarations (`dts.mochi`) rather than
/// answering span queries. `inferTypes` deliberately drops the AST.
export let typedProgram = src =>
  let? stmts = src->frontend() in
  let? r = stmts->inferProgramTypes(builtins, namespaces, false) in
    Ok((stmts, r))

/// inferTypes : string -> Result InferResult Err — strict typed-query seam
/// for host DX. Keeps the recorded span -> type table instead of discarding it.
export let inferTypes = src =>
  let? stmts = src->frontend() in
  let? r = stmts->inferProgramTypes(builtins, namespaces, false) in
    Ok(
      {
        env: r.env,
        types: r.types
          |> map(hit =>
            {
              span: hit.span,
              ty: hit.ty,
              display: hit.ty->widenLits()->showType()
            }),
        aliases: r.aliases,
        letParams: r.letParams
      }
    )

/// compile : string -> Result string Err
export let compile = src =>
  let? prog = src->pipeline() in
    Ok(prog->codegen(#{}, true, namespaceRuntime, preludeJsDefs, runtimeDeps))

// A single file resolves no imports, so it has no imported ctor keys and no
// cross-module import lines. Annotated (ADR 0044): a bare `#{}` here would
// generalize and leave the emitted TS a `Map<string, unknown>` against
// `emitTsModule`'s pinned key type.
let noImportedKeys : Map<string, [string]> = #{}

/// compileTs : string -> Result string Err — the SAME railway, but the typed
/// TypeScript backend (ADR 0026 / 0090). Inference runs through
/// `inferProgramTypes` so the emitter gets the span -> type table its
/// annotation hooks are driven from, not just the final env.
export let compileTs = (src, runtimeImport) =>
  let? stmts = src->frontend() in
  let? r = stmts->inferProgramTypes(builtins, namespaces, false) in
    Ok(
      stmts->emitTsModule(
        r.env,
        r.types,
        r.letParams,
        r.aliases,
        noImportedKeys,
        [],
        namespaceRuntime,
        preludeJsDefs,
        runtimeDeps,
        runtimeImport
      )
    )

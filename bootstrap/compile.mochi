// Ticket 0005 — the whole pipeline as one mochi function.
// lex → parse → check → infer → codegen, first Err short-circuits, Ok carries
// the emitted JS. Unlike the fixpoint harness (which composes only
// lex→parse→codegen), this runs check and infer as REAL gates: a duplicate
// declaration, a non-exhaustive switch, or a type error is rejected with its
// span and never reaches codegen. Passes are threaded opaquely (ticket 0002);
// the prelude tables come from the generated shim (ticket 0004).
import { lex } from "./lexer.mochi"
import { parseRecovering } from "./parser.mochi"
import { checkAll } from "./check.mochi"
import { inferProgramWith, inferProgramTypesWith } from "./infer.mochi"
import { codegenWith, jsGenOpts } from "./codegen.mochi"
import * as Infer from "./infer.mochi"
import { emitTsModuleWith, flatHostType } from "./codegen-ts.mochi"
import { bindingHooksFor } from "./extensions.mochi"
import { showType } from "./types.mochi"
import { widenLits } from "./schemes.mochi"
import * as Schemes from "./schemes.mochi"
import { indexWith } from "./symbols.mochi"

// Prelude tables from the standalone shim. builtins/namespaces carry the
// inferrer's Ty; compile never inspects them, so a polymorphic `a` lets them
// unify with whatever inferProgram expects (the opaque threading of 0002).
extern builtins : Map<string, a> = "./prelude.gen.mjs" "builtins"
extern namespaces : Map<string, Map<string, a>> = "./prelude.gen.mjs" "namespaces"
extern namespaceRuntime : Map<string, Map<string, string>> = "./prelude.gen.mjs" "namespaceRuntime"
extern preludeJsDefs : Map<string, string> = "./prelude.gen.mjs" "preludeJsDefs"
extern runtimeDeps : Map<string, [string]> = "./prelude.gen.mjs" "runtimeDeps"

/// Runtime annotation from the same prelude signatures and printer as host FFI.
export let runtimeAnnotation = (name, arity) =>
  let ty = switch Map.get(name, builtins) {
    | Some(t) => Some(t)
    | None => namespaceRuntime
        |> Map.keys
        |> Array.reduce(
          (found, ns) =>
            let members = Map.get(ns, namespaceRuntime)
              |> Option.unwrapOr(#{}) in
              members
                |> Map.keys
                |> Array.reduce(
                  (acc, key) =>
                    Map.get(key, members) == Some(name)
                      ? Map.get(ns, namespaces) |> Option.flatMap(Map.get(key))
                      : acc,
                  found
                ),
          None
        )
  } in
    ty |> Option.map(t => flatHostType(t, arity))

/// Caller-supplied knobs: `open` selects open-world inference (host globals
/// resolve to fresh vars), `runtime` inlines the prelude helpers a program
/// uses, `docs` keeps `///` comments in the emitted text, and `moduleExt` is
/// the suffix rewritten onto relative import paths — `.js` for the CLI,
/// `.mochi` for Vite, so sibling modules re-enter its plugin. Ports the
/// non-plugin `CompileOptions` from `src/compile/compile.ts`.
/// `strictEntry` only reaches the module-graph drivers (`module.mochi`); a
/// single file is always its own entry, so honouring the directive here would
/// make the flag mean "ignore the directive", which no caller wants.
/// `plugins` is the host's plugin list (ADR 0109): None = builtins (JSX on),
/// Some([]) = hard opt-out, Some(ps) = builtins then `ps`.
type Opts = {
  open: bool,
  runtime: bool,
  docs: bool,
  moduleExt: string,
  strictEntry: bool,
  plugins: Option<[Infer.HostPlugin]>
}

/// The default every arity-preserving entrypoint below passes: strict
/// inference, docstrings retained.
export let defaultOpts : Opts = {
  open: false,
  runtime: true,
  docs: true,
  moduleExt: ".js",
  strictEntry: false,
  plugins: None
}

// First non-space, non-tab character at or after `i`.
let afterBlanks = (s, i) => switch Str.get(i, s) {
  | Some(" ") => s->afterBlanks(i + 1)
  | Some("\t") => s->afterBlanks(i + 1)
  | other => other
}

/// The `"use open"` file-local directive (`src/compile/open-mode.ts`). A file
/// that intentionally reaches for host globals opts itself in, so a graph can
/// mix strict modules with one adapter without an all-or-nothing caller flag.
export let openDirective = src =>
  let t = Str.trim(src) in
    Str.startsWith(
      "\"use open\"",
      t
    ) && switch t->afterBlanks(10) {
      | None => true
      | Some("\n") => true
      | Some("r") => true
      | _ => false
    }

/// The directive wins over the caller's default; it never turns open off.
export let openMode = (src, requested) => requested || openDirective(src)

// Type-check gate: inference under `open`, program passed through unchanged.
// One diagnostic shape for every stage. Lex/parse/check carry no help or
// suggestions; infer fills those. `kind` is what the host maps onto Diagnostic.
type Suggestion = {
  title: string,
  start: number,
  end: number,
  replaceWith: string
}
let noSuggestions : [Suggestion] = []
type StageErr = { message: string, start: number, end: number }
type Stamped = {
  kind: string,
  message: string,
  start: number,
  end: number,
  help: Option<string>,
  suggestions: [Suggestion]
}
let stampStage : string -> StageErr -> Stamped = (kind, e) =>
  {
    kind,
    message: e.message,
    start: e.start,
    end: e.end,
    help: None,
    suggestions: noSuggestions
  }
let stampType = e =>
  {
    kind: "type",
    message: e.message,
    start: e.start,
    end: e.end,
    help: e.help,
    suggestions: e.suggestions
  }

let typecheckWith = (prog, open, plugins: Option<[Infer.HostPlugin]>) =>
  prog->inferProgramWith(builtins, namespaces, open, plugins)
    |> Result.map(_ => prog)
    |> Result.mapErr(es => es |> map(stampType))

// lex -> parse -> check. Parse keeps every recovering diagnostic (source
// order); `checkAll` collects every independent checker finding. Shared by
// both backends.
let frontend = (src, plugins: Option<[Infer.HostPlugin]>) => switch lex(src) {
  | Err(e) => Err([stampStage("lex", e)])
  | Ok(tokens) => let parsed = parseRecovering(tokens, plugins) in
      switch parsed.diagnostics {
        | [] => checkAll(parsed.stmts)
            |> Result.mapErr(es => es |> map(e => stampStage("check", e)))
        | ds => Err(ds |> map(e => stampStage("parse", e)))
      }
}

// The front-end pipeline: lex -> parse -> check -> typecheck
let pipelineWith = (src, open, plugins: Option<[Infer.HostPlugin]>) =>
  let? stmts = src->frontend(plugins) in stmts->typecheckWith(open, plugins)

/// typedProgram : string -> Result (stmts, InferResult) Err — the AST *and* its
/// inference, for passes that print declarations (`dts.mochi`) rather than
/// answering span queries. `inferTypes` deliberately drops the AST.
export let typedProgramWith = (src, opts: Opts) =>
  let? stmts = src->frontend(opts.plugins) in
    stmts->inferProgramTypesWith(
      builtins,
      namespaces,
      openMode(src, opts.open),
      opts.plugins
    )
      |> Result.map(r => (stmts, r))
      |> Result.mapErr(es => es |> map(stampType))

export let typedProgram = src => src->typedProgramWith(defaultOpts)

// The span table a typed query returns: every recorded node, with its type
// rendered once for display.
let typedQuery = (src, stmts, opts: Opts) =>
  stmts->inferProgramTypesWith(
    builtins,
    namespaces,
    openMode(src, opts.open),
    opts.plugins
  )
    |> Result.map(r =>
      {
        env: r.env,
        types: r.types
          |> map(hit =>
            {
              span: hit.span,
              ty: hit.ty,
              display: hit.ty->widenLits()->showType(),
              sym: hit.sym
            }),
        aliases: r.aliases,
        letParams: r.letParams
      })
    |> Result.mapErr(es => es |> map(stampType))

/// inferTypes : string -> Result InferResult Err — strict typed-query seam
/// for host DX. Keeps the recorded span -> type table instead of discarding it.
export let inferTypesWith = (src, opts: Opts) =>
  let? stmts = src->frontend(opts.plugins) in typedQuery(src, stmts, opts)

/// The typed query over the statements a recovering parse keeps, its parse
/// diagnostics dropped (ADR 0120). Completion is most wanted mid-edit, when a
/// hole elsewhere in the buffer would fail `inferTypesWith`. Mirrors
/// src/compile.ts's `toTypedProgramRecovering`.
export let inferTypesRecoveringWith = (src, opts: Opts) => switch lex(src) {
  | Err(e) => Err([stampStage("lex", e)])
  | Ok(tokens) => let parsed = parseRecovering(tokens, opts.plugins) in
      checkAll(parsed.stmts)
        |> Result.mapErr(es => es |> map(e => stampStage("check", e)))
        |> Result.flatMap(stmts => typedQuery(src, stmts, opts))
}

export let inferTypes = src => src->inferTypesWith(defaultOpts)

/// The declared type a recorded type names, for go-to-type (ADR 0119).
export let nominalTypeName = (ty, aliases) =>
  Schemes.nominalTypeName(ty, aliases)

/// The symbol index (ADR 0118) in the synchronous bundle, which the browser
/// loads too: hover resolves a builtin reference to its prelude docstring
/// through it (#103). module.mochi's `symbolIndex` is the same query.
export let symbolIndexSync = (path, origins, prelude, stmts) =>
  indexWith(path, origins, prelude, stmts)

/// The JS a checked program emits under `opts`. Shared with `dts.mochi`'s
/// `compileTargetsWith`, which prints every target from one inference.
export let emitJsWith = (stmts, opts: Opts) =>
  stmts->codegenWith(
    #{},
    opts.runtime,
    namespaceRuntime,
    preludeJsDefs,
    runtimeDeps,
    { ...jsGenOpts, docs: opts.docs, moduleExt: opts.moduleExt }
  )

/// compileWith : string -> Opts -> Result string Err
export let compileWith = (src, opts: Opts) =>
  src->pipelineWith(openMode(src, opts.open), opts.plugins)
    |> Result.map(prog => prog->emitJsWith(opts))

/// compile : string -> Result string Err
export let compile = src => src->compileWith(defaultOpts)

// A single file resolves no imports, so it has no imported ctor keys and no
// cross-module import lines. Annotated (ADR 0044): a bare `#{}` here would
// generalize and leave the emitted TS a `Map<string, unknown>` against
// `emitTsModule`'s pinned key type.
let noImportedKeys : Map<string, [string]> = #{}

/// The typed TypeScript a single file emits from its inference result `r`.
/// Shared with `dts.mochi`'s `compileTargetsWith`.
export let emitTsWith = (stmts, r, runtimeImport, opts: Opts) =>
  stmts->emitTsModuleWith(
    r.env,
    r.types,
    r.letParams,
    r.aliases,
    noImportedKeys,
    [],
    namespaceRuntime,
    preludeJsDefs,
    runtimeDeps,
    runtimeImport,
    opts.docs,
    bindingHooksFor(opts.plugins)
  )

/// compileTs : string -> Result string Err — the SAME railway, but the typed
/// TypeScript backend (ADR 0026 / 0090). Inference runs through
/// `inferProgramTypes` so the emitter gets the span -> type table its
/// annotation hooks are driven from, not just the final env.
export let compileTsWith = (src, runtimeImport, opts: Opts) =>
  let? stmts = src->frontend(opts.plugins) in
    stmts->inferProgramTypesWith(
      builtins,
      namespaces,
      openMode(src, opts.open),
      opts.plugins
    )
      |> Result.map(r => stmts->emitTsWith(r, runtimeImport, opts))
      |> Result.mapErr(es => es |> map(stampType))

export let compileTs = (src, runtimeImport) =>
  src->compileTsWith(runtimeImport, defaultOpts)

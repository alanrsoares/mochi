// bootstrap/infer.mochi — Hindley-Milner type inference, in mochi. Ports
// src/types.ts + src/unify.ts + src/infer.ts into one file (Slice E, part 2).
// test/bootstrap-infer.spec.ts (once written) diffs alpha-normalized schemes
// against the TS inferrer on every .mochi file in the repo.
//
// PORTING ORDER (biggest unknown first): (a) types.ts warm-up — Ty/Row shape
// + showType, DONE below. (b) unify.ts — St-threaded resolve/zonk/occurs/
// unify/unifyRows, DONE below. (c) infer.ts — Algorithm W, generalize/
// instantiate, stronglyConnected (Tarjan SCC), NOT YET PORTED.
//
// Locked design decisions (see mochi-roadmap memory for full rationale —
// do not re-derive, just implement):
// 1. One standalone file, no cross-file modules until Slice F.
// 2. Subst becomes threaded `St = { tv: Map number Ty, rv: Map number Row,
//    next: number }` — every fresh-var mint AND every unify call returns a
//    new St. Fresh-var minting (types.ts's `Fresh`) is folded into St here,
//    not ported as a separate type.
// 3. Prelude type tables are NOT reimplemented — the differential harness
//    feeds TS preludeEnv/preludeNamespaces in as runtime args.
// 4. SKIP AliasDef/foldAliases + hover's Ctx.record callback (display/
//    tooling only). KEEP semantic alias expansion in typeExprToType (affects
//    what a type unifies against — that's semantics, ported in section c).
// 5. Harness compares per-name scheme STRINGS with alpha-normalized var ids.
// 6. Corpus = TS-check-passing files, open:true + namespaces threaded;
//    strict-mode error cases get their own targeted cases.

import {
  TyVar,
  TyCon,
  TyFn,
  TyRecord,
  RowEmpty,
  RowVar,
  RowExtend,
  tCon,
  tArrow,
  tRecord,
  tPrim,
  tTuple,
  tUnit,
  tLit,
  rVar,
  rExtend,
  showType,
  mkSt,
  recordAt,
  noteLet,
  noteUse,
  freshVar,
  freshRowVar,
  resolve,
  zonk,
  occurs,
  unify,
  unifyRows
} from "./types.mochi"

// ============================================================
// (c) infer.ts — Algorithm W. AST via namespace import (ADR 0002).
//
// Name collision vs section (a): the surface syntax `TypeExpr` needs the
// SAME ctor names bootstrap/parser.mochi actually emits at runtime
// (TyName/TyArrow/TyApp/TyTuple/TyList) — each .mochi file compiles to an
// independent module with literal baked-in `_tag` strings, so this file's
// pattern matches must agree with parser.mochi's tags, not just its own
// internal type decl. That leaves no free `TyArrow` for section (a)'s HM
// `Ty` type, so its arrow constructor is `TyFn` here instead.
// ============================================================

import * as Ast from "./ast.mochi"

// Record the selected `let?` helper on the AST node so codegen can lower
// without a separate type table (ADR 0079). Parser tags `let?` as Result;
// infer rewrites Option when the value's head constructor is Option.
extern setLetBindMonad : a -> string -> () = set "monad"
import {
  inferCallHooksOf,
  resolvePluginsDefault,
  runInferCallHooks
} from "./extensions.mochi"
import { builtinDeclsFor } from "./ctors.mochi"
import {
  mono,
  tNumber,
  tBool,
  tString,
  generalize,
  instantiate,
  typeExprToType,
  typeExprListToType,
  ctorScheme,
  isUpperStart,
  freeInType
} from "./schemes.mochi"
import { stronglyConnected } from "./scc.mochi"

// One chunk of a "…${a}…" interpolation (ADR 0023): a literal run, or a
// parsed hole expression.

// --- span extractors (TS reads `.span` directly) ---

/// Exported for the TS backend: hooks look node types up by span.
export let exprSpan = e => switch e {
  | Ast.ENum(_, _, sp) => sp
  | Ast.EUnit(sp) => sp
  | Ast.EBool(_, sp) => sp
  | Ast.EStr(_, sp) => sp
  | Ast.ERef(_, sp) => sp
  | Ast.ECall(_, _, _, sp) => sp
  | Ast.ELambda(_, _, sp) => sp
  | Ast.ELetIn(_, _, _, _, sp) => sp
  | Ast.ELetBind(_, _, _, _, _, sp) => sp
  | Ast.EPipe(_, _, sp) => sp
  | Ast.EDo(_, sp) => sp
  | Ast.ETernary(_, _, _, sp) => sp
  | Ast.EMatch(_, _, sp) => sp
  | Ast.ELoop(_, _, sp) => sp
  | Ast.ERecur(_, sp) => sp
  | Ast.ERecord(_, _, sp) => sp
  | Ast.EField(_, _, sp) => sp
  | Ast.ETuple(_, sp) => sp
  | Ast.EArr(_, sp) => sp
  | Ast.EList(_, sp) => sp
  | Ast.ESet(_, sp) => sp
  | Ast.EMap(_, sp) => sp
  | Ast.EInterp(_, sp) => sp
}

let patSpan = p => switch p {
  | Ast.PWild(sp) => sp
  | Ast.PUnit(sp) => sp
  | Ast.PBind(_, sp) => sp
  | Ast.PAs(_, _, _, sp) => sp
  | Ast.PLit(_, _, sp) => sp
  | Ast.PBool(_, sp) => sp
  | Ast.PStr(_, sp) => sp
  | Ast.PTuple(_, sp) => sp
  | Ast.PRecord(_, sp) => sp
  | Ast.PCtor(_, _, _, sp) => sp
  | Ast.PArr(_, _, sp) => sp
  | Ast.PList(_, _, sp) => sp
  | Ast.POr(_, sp) => sp
}

// --- inference-time error + context. unify.ts's span-less TypeErr becomes a
// spanned IErr only at the `u()` seam below (mirrors src/infer.ts's `u`) ---

type IErr = { message: string, start: number, end: number }
// src/ast.ts's TypeExpr nodes carry `span` as a plain field, so TS just writes
// `s.annot.span`; a mochi variant needs the accessor. Kept local (parser.mochi has
// its own copy) because the differential harness evaluates each bootstrap module
// standalone — a cross-module VALUE reference would be undefined there.
let annotSpan = t => switch t {
  | Ast.TyName(_, sp) => sp
  | Ast.TyArrow(_, _, sp) => sp
  | Ast.TyApp(_, _, sp) => sp
  | Ast.TyTuple(_, sp) => sp
  | Ast.TyList(_, sp) => sp
  | Ast.TyQual(_, _, _, _, sp) => sp
  | Ast.TyLit(_, sp) => sp
  | Ast.TyUnion(_, sp) => sp
}

let typeErr = (msg, sp) => { message: msg, start: sp.start, end: sp.end }

let u = (a, b, st, sp) => switch unify(a, b, st) {
  | Ok(newSt) => Ok(newSt)
  | Err(e) => Err(typeErr(e.message, sp))
}

// Scheme machinery lives in schemes.mochi (ticket 0030).

// --- lambda-param binding. TS mutates `env` in place and returns just the
// param's `Type`; here each binder threads (env, st) and returns them back
// alongside the type it produced ---

let bindParamNamesFrom = (names, env, st) => switch names {
  | [] => ([], env, st)
  | [n, ...rest] => let (t, st1) = freshVar(st) in
    let (restTs, env2, st2) = bindParamNamesFrom(
      rest,
      Map.set(n, mono(t), env),
      st1
    ) in
      (Array.prepend(t, restTs), env2, st2)
}

let bindParamFieldsFrom = (fields, env, row, st) => switch fields {
  | [] => (row, env, st)
  | [f, ...rest] => let (ft, st1) = freshVar(st) in
      bindParamFieldsFrom(
        rest,
        Map.set(f, mono(ft), env),
        rExtend(f, ft, row),
        st1
      )
}

let bindParam = (p, env, st) => switch p {
  | Ast.LPName(name, _) => let (t, st1) = freshVar(st) in
      (t, Map.set(name, mono(t), env), st1)
  | Ast.LPTuple(names) => let (elems, env1, st1) = bindParamNamesFrom(
      names,
      env,
      st
    ) in
      (tTuple(elems), env1, st1)
  | Ast.LPRecord(fields) => let (rowBase, st1) = freshRowVar(st) in
    let (row, env1, st2) = bindParamFieldsFrom(fields, env, rowBase, st1) in
      (tRecord(row), env1, st2)
}

let bindParamsFrom = (params, env, st) => switch params {
  | [] => ([], env, st)
  | [p, ...rest] => let (t, env1, st1) = bindParam(p, env, st) in
    let (restTs, env2, st2) = bindParamsFrom(rest, env1, st1) in
      (Array.prepend(t, restTs), env2, st2)
}

// Lambda parameter annotations constrain the fresh parameter type before the
// body is inferred. One `vars` map shares lowercase type variables across a
// lambda's parameter annotations, matching the TS backend.
let constrainParamAnnotsFrom = (ctx, params, paramTypes, vars, st) => switch params {
  | [] => Ok(st)
  | [param, ...rest] => switch paramTypes {
      | [] => Ok(st)
      | [paramT, ...restTypes] => switch param {
          | Ast.LPName(_, Some(te)) => let (annotT, vars1, st1) = typeExprToType(
              te,
              vars,
              st,
              ctx.aliasMap,
              Set.fromArray([])
            ) in
            let? st2 = u(paramT, annotT, st1, annotSpan(te)) in
              ctx->constrainParamAnnotsFrom(rest, restTypes, vars1, st2)
          | _ => ctx->constrainParamAnnotsFrom(rest, restTypes, vars, st)
        }
    }
}

// ============================================================
// inferExpr — Algorithm W over Expr. Every helper threads and returns
// `st: St` alongside its result (env only changes locally, on the ctx
// passed to a sub-inference call — never mutated in place).
// ============================================================

let arrowChain = (paramTypes, resultT) => switch paramTypes {
  | [] => tArrow(tUnit, resultT)
  | [p] => tArrow(p, resultT)
  | [p, ...rest] => tArrow(p, arrowChain(rest, resultT))
}

let ctxWithEnv = (ctx, env) =>
  {
    env,
    open: ctx.open,
    ns: ctx.ns,
    aliasMap: ctx.aliasMap,
    plugins: ctx.plugins,
    loopStack: ctx.loopStack,
    letOwner: ctx.letOwner
  }

// Enter a scope where `letOwner` also carries the bindings a group / a `let …
// in` just introduced (ADR 0035): name -> the value span its scheme came from.
// This is the identity src/infer.ts gets for free from its `Map<Scheme, …>` —
// scoped exactly like `env`, so a shadowing rebind takes over the annotation.
let ctxWithLets = (ctx, env, letOwner) =>
  {
    env,
    open: ctx.open,
    ns: ctx.ns,
    aliasMap: ctx.aliasMap,
    plugins: ctx.plugins,
    loopStack: ctx.loopStack,
    letOwner
  }

// Enter a loop body: params bound in env, frame pushed innermost-FIRST
// (`recur` reads the head — nearest enclosing loop, ADR 0056).
let ctxWithLoop = (ctx, env, frame, letOwner) =>
  {
    env,
    open: ctx.open,
    ns: ctx.ns,
    aliasMap: ctx.aliasMap,
    plugins: ctx.plugins,
    loopStack: Array.prepend(frame, ctx.loopStack),
    letOwner
  }

// loop params: inits infer in the OUTER ctx; each binds monomorphic —
// `recur` rebinds them, so generalizing would let iterations disagree. Each
// init span is an ADR 0035 candidate: the lowered `let name = init;` declaration
// takes the same annotation a `let … in` IIFE param does.
let inferLoopParamsFrom = (ctx, params, i, envAcc, frameAcc, ownerAcc, st) => switch Array.get(i, params) {
  | None => Ok((frameAcc, envAcc, ownerAcc, st))
  | Some(p) => let? (t, st1) = ctx->inferExpr(p.init, st) in
    let sp = exprSpan(p.init) in
      ctx->inferLoopParamsFrom(
        params,
        i + 1,
        Map.set(p.name, mono(t), envAcc),
        Array.append(t, frameAcc),
        Map.set(p.name, sp, ownerAcc),
        noteLet(sp, st1)
      )
}

let unifyRecurArgsFrom = (ctx, args, frame, i, st) => switch Array.get(i, args) {
  | None => Ok(st)
  | Some(a) => let? (at, st1) = ctx->inferExpr(a, st) in
      switch Array.get(i, frame) {
        | None => ctx->unifyRecurArgsFrom(args, frame, i + 1, st1)
        | Some(pt) => let? st2 = u(at, pt, st1, exprSpan(a)) in
            ctx->unifyRecurArgsFrom(args, frame, i + 1, st2)
      }
}

// recur types as a fresh var (bottom-like) after unifying its args with the
// nearest frame's param types.
let inferRecur = (ctx, args, sp, st) => switch ctx.loopStack {
  | [] => Err(typeErr("'recur' is only legal inside a loop body", sp))
  | [frame, ..._] => let? st1 = ctx->unifyRecurArgsFrom(args, frame, 0, st) in
    let (t, st2) = freshVar(st1) in Ok((t, st2))
}

let inferCallArgs = (ctx, fnT, args, st, callSpan) => switch args {
  | [] => Ok((fnT, st))
  | [arg, ...rest] => let? (argT, st1) = ctx->inferExpr(arg, st) in
    let (resultT, st2) = freshVar(st1) in
    let? st3 = u(fnT, tArrow(argT, resultT), st2, exprSpan(arg)) in
      ctx->inferCallArgs(resultT, rest, st3, callSpan)
}

let inferNormalCall = (ctx, fn, args, st) =>
  let? (fnT, st1) = ctx->inferExpr(fn, st) in
    switch args {
      | [] => let (resultT, st2) = freshVar(st1) in
        let? st3 = u(fnT, tArrow(tUnit, resultT), st2, exprSpan(fn)) in
          Ok((resultT, st3))
      | _ => ctx->inferCallArgs(fnT, args, st1, exprSpan(fn))
    }

let inferTernary = (ctx, cond, thenE, elseE, st) =>
  let? (condT, st1) = ctx->inferExpr(cond, st) in
  let? st2 = u(condT, tBool, st1, exprSpan(cond)) in
  let? (thenT, st3) = ctx->inferExpr(thenE, st2) in
  let? (elseT, st4) = ctx->inferExpr(elseE, st3) in
  let? st5 = u(thenT, elseT, st4, exprSpan(elseE)) in Ok((thenT, st5))

// Shared tail of `let?` / `let!`: bind `param` to the payload, then unify the
// body against `mkBody(resT)` (Option b / Result b e / Task b e).
let inferBindBody = (ctx, param, paramSpan, body, payloadT, mkBody, st) =>
  let (paramT, bodyEnv, st1) = bindParam(param, ctx.env, st) in
  let? st2 = u(paramT, payloadT, st1, paramSpan) in
  let? (bodyT, st3) = ctxWithEnv(ctx, bodyEnv)->inferExpr(body, st2) in
  let (resT, st4) = freshVar(st3) in
  let wantBody = mkBody(resT) in
  let? st5 = u(bodyT, wantBody, st4, exprSpan(body)) in Ok((wantBody, st5))

// Two-slot bind (`Result a e` / `Task a e`): value `M a e`, body `M b e`.
let inferTwoSlotBind = (ctx, param, paramSpan, value, body, valT, ctor, st) =>
  let (payloadT, st1) = freshVar(st) in
  let (errT, st2) = freshVar(st1) in
  let? st3 = u(valT, tCon(ctor, [payloadT, errT]), st2, exprSpan(value)) in
    ctx->inferBindBody(
      param,
      paramSpan,
      body,
      payloadT,
      resT => tCon(ctor, [resT, errT]),
      st3
    )

// `let?` dispatches Option vs Result from the resolved head of `value`
// (ADR 0079). Unresolved tyvar defaults to Result. `let!` stays Task-only.
let inferQuestionBind = (ctx, bind, param, paramSpan, value, body, valT, st) => switch resolve(valT, st) {
  | TyVar(_) => let $written = setLetBindMonad(bind, "Result") in
      ctx->inferTwoSlotBind(param, paramSpan, value, body, valT, "Result", st)
  | TyCon(name, _) => name == "Option"
      ? let $written = setLetBindMonad(bind, "Option") in
      let (payloadT, st1) = freshVar(st) in
      let? st2 = u(valT, tCon("Option", [payloadT]), st1, exprSpan(value)) in
        ctx->inferBindBody(
          param,
          paramSpan,
          body,
          payloadT,
          resT => tCon("Option", [resT]),
          st2
        )
      : name == "Result"
      ? let $written = setLetBindMonad(bind, "Result") in
        ctx->inferTwoSlotBind(param, paramSpan, value, body, valT, "Result", st)
      : Err(
        typeErr(
          "let? requires Option or Result, got ${showType(zonk(valT, st))}",
          exprSpan(value)
        )
      )
  | _ => Err(
      typeErr(
        "let? requires Option or Result, got ${showType(zonk(valT, st))}",
        exprSpan(value)
      )
    )
}

let inferLetBind = (ctx, bind, param, paramSpan, monad, value, body, st) =>
  let? (valT, st1) = ctx->inferExpr(value, st) in
    monad == "Task"
      ? ctx->inferTwoSlotBind(param, paramSpan, value, body, valT, "Task", st1)
      : ctx->inferQuestionBind(bind, param, paramSpan, value, body, valT, st1)

let inferRecordRow = (ctx, fields, st) => switch fields {
  | [] => Ok((RowEmpty, st))
  | [f, ...rest] =>
    // Field VALUES infer last-to-first (matching src/infer.ts's reverse
    // loop) so side effects on shared open rows via field access land in
    // the same order — row DISPLAY order still follows declaration order.
    let? (restRow, st1) = ctx->inferRecordRow(rest, st) in
    let? (ft, st2) = ctx->inferExpr(f.value, st1) in
      Ok((rExtend(f.name, ft, restRow), st2))
}

// Rebuild a closed row (ending `RowEmpty`) onto a different tail — reuses the
// (label, fieldType) pairs a record literal already inferred rather than
// re-inferring field values a second time. Used by the update-typing case
// below to turn the literal's closed row into the open `req` row a `...base`
// must unify against (ADR 0021).
let rWithTail = (row, tail) => switch row {
  | RowEmpty => tail
  | RowVar(id) => rVar(id)
  | RowExtend(label, fieldType, rest) => rExtend(
      label,
      fieldType,
      rWithTail(rest, tail)
    )
}

// duck-typed record field access: target's type unifies against an open row
// with `name` in it, unless target is a bare namespace ref (`List.map`) —
// then it's a qualified lookup into ctx.ns, not row inference.
let inferFieldAccess = (ctx, target, name, sp, st) =>
  let? (targetT, st1) = ctx->inferExpr(target, st) in
  let (fieldT, st2) = freshVar(st1) in
  let (restRow, st3) = freshRowVar(st2) in
  let? st4 = u(targetT, tRecord(rExtend(name, fieldT, restRow)), st3, sp) in
    Ok((fieldT, st4))

let inferNsField = (ctx, tname, name, sp, st) => switch Map.get(name, Map.getOr(#{}, tname, ctx.ns)) {
  | Some(sc) => let (t, st1) = instantiate(sc, st) in Ok((t, st1))
  | None => Err(typeErr("'${tname}' has no member '${name}'", sp))
}

// Every hole of a "…${x}…" unifies with `string` (ADR 0023) — no implicit
// `show`. Literal chunks carry no type information to infer.
let inferInterpParts = (ctx, parts, st) => switch parts {
  | [] => Ok(st)
  | [Ast.IPLit(_), ...rest] => ctx->inferInterpParts(rest, st)
  | [Ast.IPExpr(ex), ...rest] => let? (t, st1) = ctx->inferExpr(ex, st) in
    let? st2 = u(t, tString, st1, exprSpan(ex)) in
      ctx->inferInterpParts(rest, st2)
}

let inferTupleElems = (ctx, elements, st) => switch elements {
  | [] => Ok(([], st))
  | [el, ...rest] => let? (t, st1) = ctx->inferExpr(el, st) in
    let? (restTs, st2) = ctx->inferTupleElems(rest, st1) in
      Ok((Array.prepend(t, restTs), st2))
}

let seqElemExpr = el => switch el {
  | Ast.SEExpr(e) => e
  | Ast.SESpread(e) => e
}

let inferSeqSlotsElems = (ctx, con, elem, elements, st) => switch elements {
  | [] => Ok(st)
  | [slot, ...rest] => let ex = seqElemExpr(slot) in
    let? (et, st1) = ctx->inferExpr(ex, st) in
    let want = switch slot {
      | Ast.SEExpr(_) => elem
      | Ast.SESpread(_) => tCon(con, [elem])
    } in
    let? st2 = u(want, et, st1, exprSpan(ex)) in
      ctx->inferSeqSlotsElems(con, elem, rest, st2)
}
let inferSeqSlots = (ctx, con, elements, st) =>
  let (elem, st1) = freshVar(st) in
  let? st2 = ctx->inferSeqSlotsElems(con, elem, elements, st1) in
    Ok((tCon(con, [elem]), st2))

let inferMapEntries = (ctx, k, v, entries, st) => switch entries {
  | [] => Ok(st)
  | [ent, ...rest] => let? (kt, st1) = ctx->inferExpr(ent.key, st) in
    let? st2 = u(k, kt, st1, exprSpan(ent.key)) in
    let? (vt, st3) = ctx->inferExpr(ent.value, st2) in
    let? st4 = u(v, vt, st3, exprSpan(ent.value)) in
      ctx->inferMapEntries(k, v, rest, st4)
}
let inferMapExpr = (ctx, entries, st) =>
  let (k, st1) = freshVar(st) in
  let (v, st2) = freshVar(st1) in
  let? st3 = ctx->inferMapEntries(k, v, entries, st2) in
    Ok((tCon("Map", [k, v]), st3))

let mergeBindingMapsFrom = (keys, src, dest) => switch keys {
  | [] => dest
  | [k, ...rest] => switch Map.get(k, src) {
      | Some(v) => mergeBindingMapsFrom(rest, src, Map.set(k, v, dest))
      | None => mergeBindingMapsFrom(rest, src, dest)
    }
}
// later (rightmost/innermost) binding wins on a name collision, matching
// TS's mutable `bindings.set` overwrite order
let mergeBindingMaps = (dest, src) =>
  mergeBindingMapsFrom(Map.keys(src), src, dest)

let mergeEnvBindingsFrom = (keys, bindings, env) => switch keys {
  | [] => env
  | [k, ...rest] => switch Map.get(k, bindings) {
      | Some(t) => mergeEnvBindingsFrom(
          rest,
          bindings,
          Map.set(k, mono(t), env)
        )
      | None => mergeEnvBindingsFrom(rest, bindings, env)
    }
}
let mergeEnvBindings = (bindings, env) =>
  mergeEnvBindingsFrom(Map.keys(bindings), bindings, env)

let inferArms = (ctx, scrutT, resultT, arms, st) => switch arms {
  | [] => Ok(st)
  | [arm, ...rest] => let? (patT, bindings, st1) = ctx->inferPat(
      arm.pattern,
      st
    ) in
    let? st2 = u(scrutT, patT, st1, patSpan(arm.pattern)) in
    let armCtx = ctxWithEnv(ctx, mergeEnvBindings(bindings, ctx.env)) in
    let? st3 = switch arm.guard {
      | None => Ok(st2)
      | Some(g) => let? (guardT, stg) = armCtx->inferExpr(g, st2) in
          u(tBool, guardT, stg, exprSpan(g))
    } in
    let? (bodyT, st4) = armCtx->inferExpr(arm.body, st3) in
    let? st5 = u(resultT, bodyT, st4, exprSpan(arm.body)) in
      ctx->inferArms(scrutT, resultT, rest, st5)
}
let inferMatch = (ctx, scrutinee, arms, st) =>
  let? (scrutT, st1) = ctx->inferExpr(scrutinee, st) in
  let (resultT, st2) = freshVar(st1) in
  let? st3 = ctx->inferArms(scrutT, resultT, arms, st2) in Ok((resultT, st3))

/// Recording wrapper over `inferExprRaw` (mirrors src/infer.ts's `infer`):
/// every expression node's inferred type lands in `st.recorded`, keyed by span,
/// so the TS backend can annotate lambda params and empty literals (ADR 0090).
let inferExpr = (ctx, e, st) =>
  let? (t, st1) = ctx->inferExprRaw(e, st) in
    Ok((t, recordAt(exprSpan(e), t, st1)))

let inferExprRaw = (ctx, e, st) => switch e {
  | Ast.ENum(_, _, _) => Ok((tNumber, st))
  | Ast.EUnit(_) => Ok((tUnit, st))
  | Ast.EBool(_, _) => Ok((tBool, st))
  | Ast.EStr(value, _) => Ok((tLit(value), st))
  | Ast.ERef(name, sp) => switch Map.get(name, ctx.env) {
      | Some(sc) => let (t, st1) = instantiate(sc, st) in
          Ok((
            t,
            switch Map.get(name, ctx.letOwner) {
              | Some(vsp) => noteUse(vsp, t, st1)
              | None => st1
            }
          ))
      | None => ctx.open
          ? let (t, st1) = freshVar(st) in Ok((t, st1))
          : Err(typeErr("unbound variable '${name}'", sp))
    }
  | Ast.ELambda(params, body, _) => let (paramTypes, bodyEnv, st1) = bindParamsFrom(
      params,
      ctx.env,
      st
    ) in
    let? st2 = ctx->constrainParamAnnotsFrom(params, paramTypes, #{}, st1) in
    let? (bodyT, st3) = ctxWithEnv(ctx, bodyEnv)->inferExpr(body, st2) in
      Ok((arrowChain(paramTypes, bodyT), st3))
  | Ast.ELetIn(name, _nameSpan, value, body, _span) => switch value {
      | Ast.ELambda(_, _, _) =>
        // Adjacent lambda locals share the top-level SCC machinery (ADR 0067):
        // pre-bind monomorphically, infer dependency-first, then generalize.
        let lets = localLetsFrom(e) in
        let idxOf = idxOfMap(lets) in
        let tail = localTail(e) in
        let? (localCtx, localSt) = ctx->processGroupsFrom(
          stronglyConnected(adjOf(lets, idxOf)),
          lets,
          st
        ) in
          localCtx->inferExpr(tail, localSt)
      | _ => let? (valT, st1) = ctx->inferExpr(value, st) in
        let sc = generalize(ctx.env, valT, st1, true) in
        let vsp = exprSpan(value) in
        let $ctx = ctxWithLets(
          ctx,
          Map.set(name, sc, ctx.env),
          Map.set(name, vsp, ctx.letOwner)
        ) in
          $ctx->inferExpr(body, noteLet(vsp, st1))
    }
  | Ast.ELetBind(param, paramSpan, monad, value, body, _) => ctx->inferLetBind(
      e,
      param,
      paramSpan,
      monad,
      value,
      body,
      st
    )
  | Ast.ECall(fn, args, origin, _) => let api = {
      inferExpr: (e, st0) => ctx->inferExpr(e, st0),
      unify: u
    } in
    let? claimed = runInferCallHooks(
      inferCallHooksOf(ctx.plugins),
      fn,
      args,
      origin,
      st,
      api
    ) in
      switch claimed {
        | Some(r) => Ok(r)
        | None => ctx->inferNormalCall(fn, args, st)
      }
  | Ast.EPipe(left, right, sp) => ctx->inferExpr(
      Ast.ECall(right, [left], None, sp),
      st
    )
  | Ast.EDo(exprs, _) => ctx->inferDo(exprs, st)
  | Ast.ETernary(cond, thenE, elseE, _) => ctx->inferTernary(
      cond,
      thenE,
      elseE,
      st
    )
  | Ast.ERecord(fields, spread, sp) => switch spread {
      | None => let? (row, st1) = ctx->inferRecordRow(fields, st) in
          Ok((tRecord(row), st1))
      | Some(spreadExpr) =>
        // Update (`{ ...base, f: v }`): the base must already carry each listed
        // field at its value's type (extra base fields flow through the fresh
        // tail). Result type = base type — fields are replaced in-kind, so a
        // wrong-typed value or a field absent from a closed base fails to unify.
        let? (row, st1) = ctx->inferRecordRow(fields, st) in
        let? (baseT, st2) = ctx->inferExpr(spreadExpr, st1) in
        let (tailVar, st3) = freshRowVar(st2) in
        let? st4 = u(baseT, tRecord(rWithTail(row, tailVar)), st3, sp) in
          Ok((baseT, st4))
    }
  | Ast.EField(target, name, sp) => switch target {
      | Ast.ERef(tname, _) => Map.has(tname, ctx.ns) && !Map.has(tname, ctx.env)
          ? ctx->inferNsField(tname, name, sp, st)
          : ctx->inferFieldAccess(target, name, sp, st)
      | _ => ctx->inferFieldAccess(target, name, sp, st)
    }
  | Ast.ETuple(elements, _) => let? (elems, st1) = ctx->inferTupleElems(
      elements,
      st
    ) in
      Ok((tTuple(elems), st1))
  | Ast.EArr(elements, _) => ctx->inferSeqSlots("Array", elements, st)
  | Ast.EList(elements, _) => ctx->inferSeqSlots("List", elements, st)
  | Ast.ESet(elements, _) => ctx->inferSeqSlots("Set", elements, st)
  | Ast.EMap(entries, _) => ctx->inferMapExpr(entries, st)
  | Ast.EMatch(scrutinee, arms, _) => ctx->inferMatch(scrutinee, arms, st)
  | Ast.ELoop(params, body, _) => let? (frame, bodyEnv, bodyOwner, st1) = ctx->inferLoopParamsFrom(
      params,
      0,
      ctx.env,
      [],
      ctx.letOwner,
      st
    ) in
      ctxWithLoop(ctx, bodyEnv, frame, bodyOwner)->inferExpr(body, st1)
  | Ast.ERecur(args, sp) => ctx->inferRecur(args, sp, st)
  | Ast.EInterp(parts, _) => let? st1 = ctx->inferInterpParts(parts, st) in
      Ok((tString, st1))
}

let inferDo = (ctx, exprs, st) => switch exprs {
  | [] => Err(typeErr("internal: empty do block", { start: 0, end: 0 }))
  | [last] => ctx->inferExpr(last, st)
  | [first, ...rest] => let? (_, st1) = ctx->inferExpr(first, st) in
      ctx->inferDo(rest, st1)
}

// ============================================================
// inferPat — Algorithm W over Pattern. Every case returns
// (Ty, Map string Ty, St): the pattern's type, the names it binds
// (monomorphic — never generalized, matching a match-arm's scope), and
// the threaded state.
// ============================================================

let inferPatRecordFrom = (ctx, fields, row, bindings, st) => switch fields {
  | [] => Ok((row, bindings, st))
  | [f, ...rest] => let? (subT, subBindings, st1) = ctx->inferPat(f.pat, st) in
      ctx->inferPatRecordFrom(
        rest,
        rExtend(f.label, subT, row),
        mergeBindingMaps(bindings, subBindings),
        st1
      )
}
let inferPatRecord = (ctx, fields, st) =>
  let (rowBase, _st1) = freshRowVar(st) in
  let? (row, bindings, st2) = ctx->inferPatRecordFrom(
    fields,
    rowBase,
    #{},
    st
  ) in
    Ok((tRecord(row), bindings, st2))

// peel one arrow off the constructor's (instantiated) scheme per arg,
// resolving through `st` since instantiate may have left it behind a TyVar
let inferPatCtorArgs = (ctx, ctor, curT, args, st, bindings, sp) => switch args {
  | [] => Ok((curT, bindings, st))
  | [argPat, ...rest] => switch resolve(curT, st) {
      | TyFn(fromT, toT) => let? (subT, subBindings, st1) = ctx->inferPat(
          argPat,
          st
        ) in
        let? st2 = u(fromT, subT, st1, patSpan(argPat)) in
          ctx->inferPatCtorArgs(
            ctor,
            toT,
            rest,
            st2,
            mergeBindingMaps(bindings, subBindings),
            sp
          )
      | _ => Err(
          typeErr("constructor '${ctor}' applied to too many arguments", sp)
        )
    }
}

let inferPatTupleFrom = (ctx, elems, st) => switch elems {
  | [] => Ok(([], #{}, st))
  | [ep, ...rest] => let? (t, bindings, st1) = ctx->inferPat(ep, st) in
    let? (restTs, restBindings, st2) = ctx->inferPatTupleFrom(rest, st1) in
      Ok((
        Array.prepend(t, restTs),
        mergeBindingMaps(restBindings, bindings),
        st2
      ))
}
let inferPatTuple = (ctx, elems, st) =>
  let? (elemTs, bindings, st1) = ctx->inferPatTupleFrom(elems, st) in
    Ok((tTuple(elemTs), bindings, st1))

let inferSeqPatElems = (ctx, elem, elems, st) => switch elems {
  | [] => Ok((#{}, st))
  | [ep, ...rest] => let? (subT, subBindings, st1) = ctx->inferPat(ep, st) in
    let? st2 = u(elem, subT, st1, patSpan(ep)) in
    let? (restBindings, st3) = ctx->inferSeqPatElems(elem, rest, st2) in
      Ok((mergeBindingMaps(restBindings, subBindings), st3))
}
let inferSeqPat = (ctx, con, elems, restPat, st) =>
  let (elem, st1) = freshVar(st) in
  let seqT = tCon(con, [elem]) in
  let? (bindings, st2) = ctx->inferSeqPatElems(elem, elems, st1) in
    switch restPat {
      | None => Ok((seqT, bindings, st2))
      | Some(r) => let? (subT, subBindings, st3) = ctx->inferPat(r, st2) in
        let? st4 = u(subT, seqT, st3, patSpan(r)) in
          Ok((seqT, mergeBindingMaps(bindings, subBindings), st4))
    }

/// Pattern-side analogue of `inferExpr` — records every pattern node's span
/// and type, so a pattern-bound param can be annotated by span.
let inferPat = (ctx, p, st) =>
  let? (t, bindings, st1) = ctx->inferPatRaw(p, st) in
    Ok((t, bindings, recordAt(patSpan(p), t, st1)))

let inferPatRaw = (ctx, p, st) => switch p {
  | Ast.PAs(pat, name, _, _) => let? (t, bindings, st1) = ctx->inferPat(
      pat,
      st
    ) in
      Ok((t, Map.set(name, t, bindings), st1))
  | Ast.PWild(_) => let (t, st1) = freshVar(st) in Ok((t, #{}, st1))
  | Ast.PUnit(_) => Ok((tUnit, #{}, st))
  | Ast.PLit(_, _, _) => Ok((tNumber, #{}, st))
  | Ast.PBool(_, _) => Ok((tBool, #{}, st))
  | Ast.PStr(value, _) => Ok((tLit(value), #{}, st))
  | Ast.PBind(name, _) => let (t, st1) = freshVar(st) in
      Ok((t, Map.set(name, t, #{}), st1))
  | Ast.PRecord(fields, _) => ctx->inferPatRecord(fields, st)
  | Ast.PCtor(ctor, args, ns, sp) => switch ns {
      | Some(alias) => switch Map.get(ctor, Map.getOr(#{}, alias, ctx.ns)) {
          | None => Err(typeErr("'${alias}' has no member '${ctor}'", sp))
          | Some(sc) => let (curT, st1) = instantiate(sc, st) in
              ctx->inferPatCtorArgs(ctor, curT, args, st1, #{}, sp)
        }
      | None => switch Map.get(ctor, ctx.env) {
          | None => Err(typeErr("unknown constructor '${ctor}'", sp))
          | Some(sc) => let (curT, st1) = instantiate(sc, st) in
              ctx->inferPatCtorArgs(ctor, curT, args, st1, #{}, sp)
        }
    }
  | Ast.PTuple(elems, _) => ctx->inferPatTuple(elems, st)
  | Ast.PArr(elems, rest, _) => ctx->inferSeqPat("Array", elems, rest, st)
  | Ast.PList(elems, rest, _) => ctx->inferSeqPat("List", elems, rest, st)
  | Ast.POr(alts, sp) => ctx->inferOrPat(alts, sp, st)
}

// Every alternative of `A | B | …` describes the same scrutinee, so their
// types unify; and (guaranteed by check.mochi) they bind the same names, whose
// types unify too. The arm's binder env is the FIRST alt's (unified) —
// mirrors src/infer.ts's inferOrPat exactly.
let unifyOrPatBinding = (name, altBindings, bindings, st, sp) => switch Map.get(name, bindings) {
  | None => Ok(st)
  | Some(prevT) => switch Map.get(name, altBindings) {
      | None => Ok(st)
      | Some(ty) => u(prevT, ty, st, sp)
    }
}
let unifyOrPatBindings = (names, altBindings, bindings, st, sp) => switch names {
  | [] => Ok(st)
  | [name, ...rest] => let? st1 = unifyOrPatBinding(
      name,
      altBindings,
      bindings,
      st,
      sp
    ) in
      unifyOrPatBindings(rest, altBindings, bindings, st1, sp)
}
let inferOrPatAlts = (ctx, alts, i, t, bindings, st) => switch Array.get(i, alts) {
  | None => Ok(st)
  | Some(alt) => let? (altT, altBindings, st1) = ctx->inferPat(alt, st) in
    let? st2 = u(t, altT, st1, patSpan(alt)) in
    let? st3 = unifyOrPatBindings(
      Map.keys(altBindings),
      altBindings,
      bindings,
      st2,
      patSpan(alt)
    ) in
      ctx->inferOrPatAlts(alts, i + 1, t, bindings, st3)
}
let inferOrPat = (ctx, alts, sp, st) => switch alts {
  | [] => Err(typeErr("or-pattern needs at least one alternative", sp))
  | [first, ...rest] => let? (t, bindings, st1) = ctx->inferPat(first, st) in
    let? st2 = ctx->inferOrPatAlts(rest, 0, t, bindings, st1) in
      Ok((t, bindings, st2))
}

// Surface-type lowering lives in schemes.mochi (ticket 0030).

// ============================================================
// Top-level `let` dependency graph: which names a pattern binds (excluded
// from an arm body's free references), and which names an expression
// references free (minus its own locally-bound names) — the edges of the
// graph that groups mutually-recursive top-level `let`s for Slice-order
// inference, below.
// ============================================================

let patternBindsOpt = rest => switch rest {
  | Some(r) => patternBinds(r)
  | None => []
}
let patternBinds = p => switch p {
  | Ast.PAs(pat, name, _, _) => Array.append(name, patternBinds(pat))
  | Ast.PBind(name, _) => [name]
  | Ast.PRecord(fields, _) => fields |> Array.flatMap(f => patternBinds(f.pat))
  | Ast.PCtor(_, args, _, _) => args |> Array.flatMap(patternBinds)
  | Ast.PTuple(elems, _) => elems |> Array.flatMap(patternBinds)
  | Ast.PArr(elems, rest, _) => Array.concat(
      elems |> Array.flatMap(patternBinds),
      patternBindsOpt(rest)
    )
  | Ast.PList(elems, rest, _) => Array.concat(
      elems |> Array.flatMap(patternBinds),
      patternBindsOpt(rest)
    )
  | Ast.POr(alts, _) => switch Array.head(alts) {
      | Some(first) => patternBinds(first)
      | None => []
    }
  | _ => []
}

let addAllFrom = (names, set) => switch names {
  | [] => set
  | [n, ...rest] => addAllFrom(rest, Set.add(n, set))
}

let paramBound = (p, bound) => switch p {
  | Ast.LPName(name, _) => Set.add(name, bound)
  | Ast.LPTuple(names) => addAllFrom(names, bound)
  | Ast.LPRecord(fields) => addAllFrom(fields, bound)
}
let lambdaBound = (params, bound) => switch params {
  | [] => bound
  | [p, ...rest] => lambdaBound(rest, paramBound(p, bound))
}

let loopBound = (params, bound) =>
  Array.reduce((b, p) => Set.add(p.name, b), bound, params)

let loopInitRefsFrom = (params, i, bound, acc) => switch Array.get(i, params) {
  | None => acc
  | Some(p) => loopInitRefsFrom(
      params,
      i + 1,
      bound,
      freeRefs(p.init, bound, acc)
    )
}

let freeRefsList = (es, bound, acc) => switch es {
  | [] => acc
  | [e, ...rest] => freeRefsList(rest, bound, freeRefs(e, bound, acc))
}
let freeRefsFields = (fields, bound, acc) => switch fields {
  | [] => acc
  | [f, ...rest] => freeRefsFields(rest, bound, freeRefs(f.value, bound, acc))
}
let freeRefsEntries = (entries, bound, acc) => switch entries {
  | [] => acc
  | [ent, ...rest] => freeRefsEntries(
      rest,
      bound,
      freeRefs(ent.value, bound, freeRefs(ent.key, bound, acc))
    )
}
let freeRefsInterpParts = (parts, bound, acc) => switch parts {
  | [] => acc
  | [Ast.IPLit(_), ...rest] => freeRefsInterpParts(rest, bound, acc)
  | [Ast.IPExpr(ex), ...rest] => freeRefsInterpParts(
      rest,
      bound,
      freeRefs(ex, bound, acc)
    )
}
let freeRefsArms = (arms, bound, acc) => switch arms {
  | [] => acc
  | [arm, ...rest] => let armBound = addAllFrom(
      patternBinds(arm.pattern),
      bound
    ) in
    let acc1 = switch arm.guard {
      | Some(g) => freeRefs(g, armBound, acc)
      | None => acc
    } in
      freeRefsArms(rest, bound, freeRefs(arm.body, armBound, acc1))
}

// Collect the free variable references in an expression, minus the locally
// bound ones (lambda params, pattern binds). `bound`/`acc` are threaded
// (not mutated) — TS's in-place `Set` mutation becomes explicit pass-through.
let freeRefs = (e, bound, acc) => switch e {
  | Ast.ENum(_, _, _) => acc
  | Ast.EUnit(_) => acc
  | Ast.EBool(_, _) => acc
  | Ast.EStr(_, _) => acc
  | Ast.ERef(name, _) => Set.has(name, bound) ? acc : Set.add(name, acc)
  | Ast.ECall(fn, args, _, _) => freeRefsList(
      args,
      bound,
      freeRefs(fn, bound, acc)
    )
  | Ast.ELambda(params, body, _) => freeRefs(
      body,
      lambdaBound(params, bound),
      acc
    )
  | Ast.ELetIn(name, _, value, body, _) => let valueBound = switch value {
      | Ast.ELambda(_, _, _) => Set.add(name, bound)
      | _ => bound
    } in
    let acc1 = freeRefs(value, valueBound, acc) in
      freeRefs(body, Set.add(name, bound), acc1)
  | Ast.ELetBind(param, _, _, value, body, _) => let acc1 = freeRefs(
      value,
      bound,
      acc
    ) in
      freeRefs(body, paramBound(param, bound), acc1)
  | Ast.EPipe(left, right, _) => freeRefs(
      right,
      bound,
      freeRefs(left, bound, acc)
    )
  | Ast.EDo(exprs, _) => freeRefsList(exprs, bound, acc)
  | Ast.ETernary(cond, thenE, elseE, _) => freeRefs(
      elseE,
      bound,
      freeRefs(thenE, bound, freeRefs(cond, bound, acc))
    )
  | Ast.EMatch(scrutinee, arms, _) => freeRefsArms(
      arms,
      bound,
      freeRefs(scrutinee, bound, acc)
    )
  | Ast.ELoop(params, body, _) => freeRefs(
      body,
      loopBound(params, bound),
      loopInitRefsFrom(params, 0, bound, acc)
    )
  | Ast.ERecur(args, _) => freeRefsList(args, bound, acc)
  | Ast.ERecord(fields, spread, _) => freeRefsFields(
      fields,
      bound,
      switch spread { | Some(s) => freeRefs(s, bound, acc) | None => acc }
    )
  | Ast.EField(target, _, _) => freeRefs(target, bound, acc)
  | Ast.ETuple(elements, _) => freeRefsList(elements, bound, acc)
  | Ast.EArr(elements, _) => freeRefsList(
      elements |> map(seqElemExpr),
      bound,
      acc
    )
  | Ast.EList(elements, _) => freeRefsList(
      elements |> map(seqElemExpr),
      bound,
      acc
    )
  | Ast.ESet(elements, _) => freeRefsList(
      elements |> map(seqElemExpr),
      bound,
      acc
    )
  | Ast.EMap(entries, _) => freeRefsEntries(entries, bound, acc)
  | Ast.EInterp(parts, _) => freeRefsInterpParts(parts, bound, acc)
}

// Tarjan SCC lives in scc.mochi (ticket 0030).

// ============================================================
// inferProgram — the shared inference core (TS's `run`). Builtins/namespaces
// arrive pre-built (`Map string Ty` / `Map string (Map string Ty)`) — the
// differential harness converts TS's `preludeEnv`/`preludeNamespaces` into
// these shapes rather than this file reimplementing the prelude tables
// (locked decision 3). Dropped vs TS: hover recording (`record`/`TypeAt`),
// `imports` (cross-module env seeding — Slice F), and `AliasDef` display
// templates (decision 4) — this file only needs an alias's structural
// row for typeExprToType, never its display-fold form.
// ============================================================

// Builtin variant decls (Option/Result) live ONCE in ctors.mochi — the
// shared constructor-knowledge module; `builtinDeclsFor` applies the
// type-name-shadow rule so all passes share one shadowing semantics.

let seedBuiltinsFrom = (keys, builtins, env, st) => switch keys {
  | [] => env
  | [n, ...rest] => switch Map.get(n, builtins) {
      | Some(t) => seedBuiltinsFrom(
          rest,
          builtins,
          Map.set(n, generalize(env, t, st, true), env),
          st
        )
      | None => seedBuiltinsFrom(rest, builtins, env, st)
    }
}
// Builtins are generalized, not monomorphic: a prelude type carrying type
// vars (`map : (a -> b) -> [a] -> [b]`) becomes a scheme that instantiates
// fresh at each use site. Monomorphic builtins (`add : number -> ...`) have
// no free vars, so generalizing them is a no-op.
let seedBuiltins = (builtins, env, st) =>
  seedBuiltinsFrom(Map.keys(builtins), builtins, env, st)

let seedNsMembersFrom = (keys, members, env, st, acc) => switch keys {
  | [] => acc
  | [m, ...rest] => switch Map.get(m, members) {
      | Some(t) => seedNsMembersFrom(
          rest,
          members,
          env,
          st,
          Map.set(m, generalize(env, t, st, true), acc)
        )
      | None => seedNsMembersFrom(rest, members, env, st, acc)
    }
}
let seedNsFrom = (nsNames, namespaces, env, st, acc) => switch nsNames {
  | [] => acc
  | [nsName, ...rest] => switch Map.get(nsName, namespaces) {
      | Some(members) => seedNsFrom(
          rest,
          namespaces,
          env,
          st,
          Map.set(
            nsName,
            seedNsMembersFrom(Map.keys(members), members, env, st, #{}),
            acc
          )
        )
      | None => seedNsFrom(rest, namespaces, env, st, acc)
    }
}
// qualified-namespace members (`List.map`, ...): generalize each like a
// builtin, so a use site instantiates it fresh. Resolved in the `Ast.EField`
// case (`inferNsField`, above) against the env as it stood right after
// builtins were seeded — matching TS's `run`.
let seedNs = (namespaces, env, st) =>
  seedNsFrom(Map.keys(namespaces), namespaces, env, st, #{})

// `import * as Alias` namespaces (ADR 0002): each alias's members are
// already-generalized Schemes (published by the dep module), so they overlay
// directly onto the qualified-lookup table — no re-generalizing, unlike the
// prelude's `Type` members above.
let seedNsImportsFrom = (aliases, nsImports, ns) => switch aliases {
  | [] => ns
  | [alias, ...rest] => switch Map.get(alias, nsImports) {
      | Some(members) => seedNsImportsFrom(
          rest,
          nsImports,
          Map.set(alias, members, ns)
        )
      | None => seedNsImportsFrom(rest, nsImports, ns)
    }
}
let seedNsImports = (nsImports, ns) =>
  seedNsImportsFrom(Map.keys(nsImports), nsImports, ns)

let aliasMapFrom = (stmts, acc) => switch stmts {
  | [] => acc
  | [s, ...rest] => switch s {
      | Ast.SType(name, params, _, Some(fields), _, _, _, _) => aliasMapFrom(
          rest,
          Map.set(name, { params, fields, expr: None }, acc)
        )
      | Ast.SType(name, params, _, _, Some(te), _, _, _) => aliasMapFrom(
          rest,
          Map.set(name, { params, fields: [], expr: Some(te) }, acc)
        )
      | _ => aliasMapFrom(rest, acc)
    }
}

let registerCtorsFrom = (ctors, typeName, params, aliasMap, env, st) => switch ctors {
  | [] => (env, st)
  | [c, ...rest] => let (sc, st1) = ctorScheme(
      typeName,
      params,
      c,
      st,
      aliasMap
    ) in
      registerCtorsFrom(
        rest,
        typeName,
        params,
        aliasMap,
        Map.set(c.name, sc, env),
        st1
      )
}
// constructors first, so `let`s (in any order after their type) can use them
let registerUserCtorsFrom = (stmts, aliasMap, env, st) => switch stmts {
  | [] => (env, st)
  | [s, ...rest] => switch s {
      | Ast.SType(name, params, ctors, _, _, _, _, _) => let (env1, st1) = registerCtorsFrom(
          ctors,
          name,
          params,
          aliasMap,
          env,
          st
        ) in
          registerUserCtorsFrom(rest, aliasMap, env1, st1)
      | _ => registerUserCtorsFrom(rest, aliasMap, env, st)
    }
}

let registerBuiltinCtorGroup = (ctors, typeName, params, aliasMap, env, st) => switch ctors {
  | [] => (env, st)
  | [c, ...rest] => Map.has(c.name, env)
      ? registerBuiltinCtorGroup(rest, typeName, params, aliasMap, env, st)
      : let (sc, st1) = ctorScheme(typeName, params, c, st, aliasMap) in
        registerBuiltinCtorGroup(
          rest,
          typeName,
          params,
          aliasMap,
          Map.set(c.name, sc, env),
          st1
        )
}
// unless the program already declared its own type of that name — a user
// redeclaration wins, so `Map.get : ... -> Option v` and a hand-written
// Some/None still type-check against whichever one is in scope.
let registerBuiltinCtorsFrom = (decls, aliasMap, env, st) => switch decls {
  | [] => (env, st)
  | [d, ...rest] => let (env1, st1) = registerBuiltinCtorGroup(
      d.ctors,
      d.name,
      d.params,
      aliasMap,
      env,
      st
    ) in
      registerBuiltinCtorsFrom(rest, aliasMap, env1, st1)
}

// externs next — their declared type is authoritative; generalize so a
// polymorphic signature (e.g. `a -> a`) instantiates fresh at each use site.
let registerExternsFrom = (stmts, aliasMap, env, st) => switch stmts {
  | [] => (env, st)
  | [s, ...rest] => switch s {
      | Ast.SExtern(name, _, params, typeExpr, _, _, _, _, _, _) => let (vars, st0) = Array.reduce(
          ((vs, s), param) =>
            let (v, s1) = freshVar(s) in (Map.set(param, v, vs), s1),
          (#{}, st),
          params
        ) in
        let (t, _, st1) = typeExprToType(
          typeExpr,
          vars,
          st0,
          aliasMap,
          Set.fromArray([])
        ) in
          registerExternsFrom(
            rest,
            aliasMap,
            Map.set(name, generalize(env, t, st1, false), env),
            st1
          )
      | _ => registerExternsFrom(rest, aliasMap, env, st)
    }
}

let letsOfFrom = stmts => switch stmts {
  | [] => []
  | [s, ...rest] => switch s {
      | Ast.SLet(_, _, _, _, _, _, _) => Array.prepend(s, letsOfFrom(rest))
      | _ => letsOfFrom(rest)
    }
}

// Convert an adjacent lambda-local chain to the same lightweight SLet shape
// top-level SCC inference already consumes. `ELetIn` has no `export`/doc/annot.
let localLetsFrom = e =>
  // Dogfood ADR 0067: this private collector recurses without becoming a
  // bootstrap module binding. Its lambda RHS makes `collect` self-scoped.
  let collect = (current, acc) => switch current {
    | Ast.ELetIn(name, nameSpan, value, body, span) => switch value {
        | Ast.ELambda(_, _, _) => collect(
            body,
            Array.append(
              Ast.SLet(name, nameSpan, None, value, false, None, span),
              acc
            )
          )
        | _ => acc
      }
    | _ => acc
  } in
    collect(e, [])

let localTail = e => switch e {
  | Ast.ELetIn(_, _, Ast.ELambda(_, _, _), body, _) => localTail(body)
  | _ => e
}

let idxOfFrom = (lets, i0, acc0) =>
  loop (i = i0, acc = acc0) {
    switch Array.get(i, lets) {
      | None => acc
      | Some(Ast.SLet(name, _, _, _, _, _, _)) => recur(
          i + 1,
          Map.set(name, i, acc)
        )
      | Some(_) => recur(i + 1, acc)
    }
  }
let idxOfMap = lets => idxOfFrom(lets, 0, #{})

let depsOf = (letStmt, idxOf) => switch letStmt {
  | Ast.SLet(_, _, _, value, _, _, _) => Set.toArray(
      freeRefs(value, Set.fromArray([]), Set.fromArray([]))
    )
      |> Array.flatMap(r => switch Map.get(r, idxOf) {
        | Some(j) => [j]
        | None => []
      })
  | _ => []
}
let adjOf = (lets, idxOf) => lets |> map(s => depsOf(s, idxOf))

let groupOfFrom = (idxs, lets) => switch idxs {
  | [] => []
  | [i, ...rest] => switch Array.get(i, lets) {
      | Some(s) => Array.prepend(s, groupOfFrom(rest, lets))
      | None => groupOfFrom(rest, lets)
    }
}

// Pre-bind every member of a mutually-recursive group (monomorphic) BEFORE
// inferring any body, so mutual references resolve to these bindings —
// recursion is soundly typed.
let preBindGroupFrom = (group, env, st) => switch group {
  | [] => (env, st)
  | [s, ...rest] => switch s {
      | Ast.SLet(name, _, _, _, _, _, _) => let (v, st1) = freshVar(st) in
          preBindGroupFrom(rest, Map.set(name, mono(v), env), st1)
      | _ => preBindGroupFrom(rest, env, st)
    }
}

let inferGroupFrom = (ctx, group, st) => switch group {
  | [] => Ok((#{}, st))
  | [s, ...rest] => switch s {
      | Ast.SLet(name, _, annot, value, _, _, span) => let? (t, st1) = ctx->inferExpr(
          value,
          st
        ) in
          switch Map.get(name, ctx.env) {
            | Some(selfSc) => let? st2 = u(selfSc.ty, t, st1, span) in
              // Binding annotation (`let x : T = v`, ADR 0044 / 0081): pin to
              // the declared type before generalize, so a lit against a union
              // keeps the union instead of widening to `string`.
              let? (pinned, st3) = switch annot {
                | Some(te) => let (at, _, stA) = typeExprToType(
                    te,
                    #{},
                    st2,
                    ctx.aliasMap,
                    Set.fromArray([])
                  ) in
                    u(t, at, stA, annotSpan(te)) |> Result.map(stB => (at, stB))
                | None => Ok((t, st2))
              } in
              let? (restTypes, st4) = ctx->inferGroupFrom(rest, st3) in
                Ok((Map.set(name, pinned, restTypes), st4))
            | None => Err(
                typeErr("internal: missing self-binding for '${name}'", span)
              )
          }
      | _ => ctx->inferGroupFrom(rest, st)
    }
}

let dropGroupFrom = (group, env) => switch group {
  | [] => env
  | [s, ...rest] => switch s {
      | Ast.SLet(name, _, _, _, _, _, _) => dropGroupFrom(
          rest,
          Map.delete(name, env)
        )
      | _ => dropGroupFrom(rest, env)
    }
}
// generalize against the OUTER env — drop the mono self-bindings first, else
// the group's own type vars look env-bound and stay ungeneralized.
// Monomorphic recursion within the group, polymorphic use afterwards.
let generalizeGroupFrom = (group, bodyTypes, env, st) => switch group {
  | [] => env
  | [s, ...rest] => switch s {
      | Ast.SLet(name, _, annot, _, _, _, _) => switch Map.get(name, bodyTypes) {
          | Some(t) => let widen = switch annot {
              | None => true
              | Some(_) => false
            } in
              generalizeGroupFrom(
                rest,
                bodyTypes,
                Map.set(name, generalize(env, t, st, widen), env),
                st
              )
          | None => generalizeGroupFrom(rest, bodyTypes, env, st)
        }
      | _ => generalizeGroupFrom(rest, bodyTypes, env, st)
    }
}

// Register a generalized group's bindings as ADR 0035 candidates: name -> value
// span in `letOwner` (so a later group's / the tail's references note their
// instantiation), plus the span itself in `st`. `$`-prefixed synthetic
// destructure temps are skipped — they are excluded from annotation anyway.
let noteGroupLets = (group, letOwner, st) => switch group {
  | [] => (letOwner, st)
  | [s, ...rest] => switch s {
      | Ast.SLet(name, _, _, value, _, _, _) when !Str.startsWith("$", name) => let sp = exprSpan(
          value
        ) in
          noteGroupLets(rest, Map.set(name, sp, letOwner), noteLet(sp, st))
      | _ => noteGroupLets(rest, letOwner, st)
    }
}

// `let`s, grouped into mutually-recursive components (SCCs of the reference
// graph) and inferred group-by-group in dependency-first order.
let processGroupsFrom = (ctx, sccs, lets, st) => switch sccs {
  | [] => Ok((ctx, st))
  | [comp, ...restSccs] => let group = groupOfFrom(comp, lets) in
    let (preEnv, st1) = preBindGroupFrom(group, ctx.env, st) in
    let preCtx = ctxWithEnv(ctx, preEnv) in
    let? (bodyTypes, st2) = preCtx->inferGroupFrom(group, st1) in
    let finalEnv = generalizeGroupFrom(
      group,
      bodyTypes,
      dropGroupFrom(group, preEnv),
      st2
    ) in
    let (finalOwner, st3) = noteGroupLets(group, ctx.letOwner, st2) in
      ctxWithLets(
        ctx,
        finalEnv,
        finalOwner
      )->processGroupsFrom(restSccs, lets, st3)
}

// Top-level expression statements after every let is generalized (ADR 0087).
// Must unify with `()`.
let inferExprStmtsFrom = (ctx, stmts, st) => switch stmts {
  | [] => Ok(st)
  | [s, ...rest] => switch s {
      | Ast.SExpr(value, span) => let? (t, st1) = ctx->inferExpr(value, st) in
        let? st2 = u(t, tUnit, st1, span) in ctx->inferExprStmtsFrom(rest, st2)
      | _ => ctx->inferExprStmtsFrom(rest, st)
    }
}

// Seed each import's already-generalized scheme into the env, so a reference to
// an imported name types with its real (possibly polymorphic) scheme instead of
// an open-world fresh var. A module's own `let` (inferred later, in the SCCs)
// shadows an import of the same name.
let seedImportsFrom = (keys, imports, env) => switch keys {
  | [] => env
  | [k, ...rest] => switch Map.get(k, imports) {
      | Some(sc) => seedImportsFrom(rest, imports, Map.set(k, sc, env))
      | None => seedImportsFrom(rest, imports, env)
    }
}

// inferProgram threaded with `imports` (a Map of name -> Scheme published by dep
// modules) and `nsImports` (`import * as Alias` -> Alias's export schemes,
// ADR 0002). Mirrors src/infer.ts's `inferProgramTypes({ imports, nsImports })`;
// returns the final env so the module driver can extract this module's export
// schemes.
// The record aliases an importer can name as `Alias.T` (C5 slice d, ADR 0046),
// pre-seeded into the local alias map under `"Alias.T"` keys — a dot cannot occur
// in a type name, so these never shadow a local alias. `quals` is the alias →
// dep-type-scope map the module driver threads in; an alias absent from it (plain
// single-file infer) simply contributes nothing, and its qualified names then
// lower nominally. schemes.mochi's `TyQual` arm reads these keys.
let qualAliasSeedFrom = (names, alias, from, acc) => switch names {
  | [] => acc
  | [n, ...rest] => qualAliasSeedFrom(
      rest,
      alias,
      from,
      switch Map.get(n, from) {
        | Some(info) => Map.set("${alias}.${n}", info, acc)
        | None => acc
      }
    )
}

let qualAliasSeed = (stmts, quals, acc) => switch stmts {
  | [] => acc
  | [s, ...rest] => qualAliasSeed(
      rest,
      quals,
      switch s {
        | Ast.SImportNs(alias, _, _) => switch Map.get(alias.name, quals) {
            | Some(dep) => qualAliasSeedFrom(
                Map.keys(dep.aliases),
                alias.name,
                dep.aliases,
                acc
              )
            | None => acc
          }
        | _ => acc
      }
    )
}

/// Zonk every recorded node type against the FINAL state and restore source
/// order (`recordAt` prepends). Mirrors src/infer.ts: types are only resolved
/// once the whole program's substitution is settled, and later records win when
/// two nodes share a span.
let zonkRecorded = (recorded, st) =>
  Array.reverse(recorded) |> map(r => { span: r.span, ty: zonk(r.ty, st) })

/// A type with no free type OR row vars — the only kind worth annotating from:
/// a generic position has nowhere to bind letters at a `const` / IIFE param.
let isConcrete = t =>
  let f = freeInType(t) in Set.size(f.tv) == 0 && Set.size(f.rv) == 0

// Every use agrees, concretely, with the first one. Hand-rolled rather than an
// `Array.filter` count so a disagreeing use short-circuits the rest.
let allSameConcreteFrom = (shown, uses, i) => switch Array.get(i, uses) {
  | None => true
  | Some(t) => isConcrete(t) && showType(t) == shown
      ? allSameConcreteFrom(shown, uses, i + 1)
      : false
}

let allSameConcrete = (shown, uses) => allSameConcreteFrom(shown, uses, 0)

/// Resolve `letParams` for TS emit (ADR 0035): a noted `let` is annotated only
/// when its body instantiated it at ONE fully-concrete type. Uses zonk against
/// the FINAL state, like `zonkRecorded` — a use recorded mid-inference is still
/// full of unsolved vars.
let resolveLetParamsFrom = (keys, st) => switch keys {
  | [] => []
  | [k, ...rest] => let tail = resolveLetParamsFrom(rest, st) in
    let uses = Map.getOr([], k, st.letUses) |> map(t => zonk(t, st)) in
      switch Array.get(0, uses) {
        | None => tail
        | Some(first) => allSameConcrete(showType(first), uses)
            ? switch Map.get(k, st.letSpans) {
              | Some(span) => Array.prepend({ span, ty: first }, tail)
              | None => tail
            }
            : tail
      }
}

let resolveLetParams = st => resolveLetParamsFrom(Map.keys(st.letSpans), st)

/// Full inference result — the metadata the TS backend needs on top of `env`
/// (ADR 0090), including `letParams` (ADR 0035).
let runInferImports = (stmts, builtins, namespaces, openMode, imports, nsImports, quals, pluginsOpt) =>
  let plugins = resolvePluginsDefault(pluginsOpt) in
  let st0 = mkSt(1000) in
  let env0 = seedBuiltins(builtins, #{}, st0) in
  let ns0 = seedNsImports(nsImports, seedNs(namespaces, env0, st0)) in
  let aliasMap = aliasMapFrom(stmts, qualAliasSeed(stmts, quals, #{})) in
  let (env1, st1) = registerUserCtorsFrom(stmts, aliasMap, env0, st0) in
  let (env2, st2) = registerBuiltinCtorsFrom(
    builtinDeclsFor(stmts),
    aliasMap,
    env1,
    st1
  ) in
  let (env3, st3) = registerExternsFrom(stmts, aliasMap, env2, st2) in
  let env4 = seedImportsFrom(Map.keys(imports), imports, env3) in
  let lets = letsOfFrom(stmts) in
  let idxOf = idxOfMap(lets) in
  let sccs = stronglyConnected(adjOf(lets, idxOf)) in
    switch processGroupsFrom({ env: env4, open: openMode, ns: ns0, aliasMap, plugins, loopStack: [], letOwner: #{} }, sccs, lets, st3) {
      | Ok((finalCtx, st4)) => switch finalCtx->inferExprStmtsFrom(stmts, st4) {
          | Ok(st5) => Ok(
              {
                env: finalCtx.env,
                types: zonkRecorded(st5.recorded, st5),
                aliases: aliasMap,
                letParams: resolveLetParams(st5)
              }
            )
          | Err(e) => Err(e)
        }
      | Err(e) => Err(e)
    }

/// Env-only view — the shape every existing caller (compile.mochi,
/// module.mochi) and the TS parity oracle expect.
export let inferProgramImports = (stmts, builtins, namespaces, openMode, imports, nsImports, quals, pluginsOpt) =>
  runInferImports(
    stmts,
    builtins,
    namespaces,
    openMode,
    imports,
    nsImports,
    quals,
    pluginsOpt
  )
    |> Result.map(r => r.env)

// The slice of a dep's type scope inference needs: its transparent record
// aliases, so a qualified `D.Pair number` still expands (aliases are
// structural, ADR 0005). Named so these single-file wrappers can pin their
// empty map (ADR 0044) — an unannotated `#{}` generalizes and leaves the
// emitted TS a `Map<string, unknown>`. Structural, so module.mochi's richer
// `{ types, aliases }` scope still fits.
type QualAliasField = { name: string, fieldType: Ast.TypeExpr }

type QualAliasInfo = {
  params: [string],
  fields: [QualAliasField],
  expr: Option<Ast.TypeExpr>
}

type QualScope = { aliases: Map<string, QualAliasInfo> }

let emptyQuals : Map<string, QualScope> = #{}

export let inferProgram = (stmts, builtins, namespaces, openMode) =>
  inferProgramImports(
    stmts,
    builtins,
    namespaces,
    openMode,
    #{},
    #{},
    emptyQuals,
    None
  )

/// The imports-aware full result — what the TS GRAPH driver needs (ADR 0090).
/// `inferProgramImports` throws away everything but `env`; a module in a graph
/// still has to annotate from its span -> type table, so the driver calls this
/// instead and reads `env` off the record itself.
export let inferProgramImportsTypes = (stmts, builtins, namespaces, openMode, imports, nsImports, quals, pluginsOpt) =>
  runInferImports(
    stmts,
    builtins,
    namespaces,
    openMode,
    imports,
    nsImports,
    quals,
    pluginsOpt
  )

/// Like `inferProgram`, but also returns the span -> type map and alias scope
/// the TS backend drives annotation from (ADR 0090).
export let inferProgramTypes = (stmts, builtins, namespaces, openMode) =>
  runInferImports(
    stmts,
    builtins,
    namespaces,
    openMode,
    #{},
    #{},
    emptyQuals,
    None
  )

export let inferProgramWith = (stmts, builtins, namespaces, openMode, pluginsOpt) =>
  inferProgramImports(
    stmts,
    builtins,
    namespaces,
    openMode,
    #{},
    #{},
    emptyQuals,
    pluginsOpt
  )

// The schemes a module PUBLISHES: exported let/extern bindings and the ctors of
// exported types, pulled from the final inference env by name. Mirrors
// src/module.ts's `exportsOf`; feeds an importer's `imports` for
// inferProgramImports. Names absent from the env (should not happen post-infer)
// are skipped.
let takeScheme = (name, env, acc) => switch Map.get(name, env) {
  | Some(sc) => Map.set(name, sc, acc)
  | None => acc
}
let exportCtorsInto = (ctors, i, env, acc) => switch Array.get(i, ctors) {
  | None => acc
  | Some(c) => exportCtorsInto(ctors, i + 1, env, takeScheme(c.name, env, acc))
}
let exportedSchemesFrom = (stmts, i0, env, acc0) =>
  loop (i = i0, acc = acc0) {
    switch Array.get(i, stmts) {
      | None => acc
      | Some(Ast.SLet(name, _, _, _, true, _, _)) => recur(
          i + 1,
          takeScheme(name, env, acc)
        )
      | Some(Ast.SExtern(name, _, _, _, _, _, _, true, _, _)) => recur(
          i + 1,
          takeScheme(name, env, acc)
        )
      | Some(Ast.SType(_, _, ctors, _, _, true, _, _)) => recur(
          i + 1,
          exportCtorsInto(ctors, 0, env, acc)
        )
      | Some(_) => recur(i + 1, acc)
    }
  }
export let exportedSchemes = (stmts, env) =>
  exportedSchemesFrom(stmts, 0, env, #{})

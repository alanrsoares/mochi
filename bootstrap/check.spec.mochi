import { assertEq, ok, test, testEach } from "@mochi/test"
import { check, checkAll } from "./check.mochi"
import { lex } from "./lexer.mochi"
import { parse } from "./parser.mochi"

let checkSrc = src => lex(src) |> Result.flatMap(parse) |> Result.flatMap(check)

test("an exhaustive variant switch is accepted", () => switch checkSrc("type Light = Red | Green\nlet go = light => switch light { | Red => 1 | Green => 2 }") {
  | Ok(_) => true |> ok
  | Err(_) => false |> ok
})

test("a catch-all makes a variant switch exhaustive", () => switch checkSrc("type Light = Red | Green | Blue\nlet go = light => switch light { | Red => 1 | _ => 0 }") {
  | Ok(_) => true |> ok
  | Err(_) => false |> ok
})

test("checker aggregates independent match diagnostics", () => switch lex("type C = | A | B\nlet f = c => switch c { | A => 1 }\nlet g = c => switch c { | B => 2 }") {
  | Err(_) => false |> ok
  | Ok(tokens) => switch parse(tokens) {
      | Err(_) => false |> ok
      | Ok(stmts) => switch checkAll(stmts) {
          | Ok(_) => false |> ok
          | Err(errors) => Array.length(errors) == 2 |> ok
        }
    }
})

test("checker aggregates independent loop diagnostics", () => switch lex("let f = recur(0)\nlet g = loop (n = 0) { recur(n) + 1 }\nlet h = loop (x = 0, x = 1) { x }") {
  | Err(_) => false |> ok
  | Ok(tokens) => switch parse(tokens) {
      | Err(_) => false |> ok
      | Ok(stmts) => switch checkAll(stmts) {
          | Ok(_) => false |> ok
          | Err(errors) => Array.length(errors) == 3 |> ok
        }
    }
})

test("checker aggregates declaration diagnostics", () => switch lex("let List = 1\ntype Box a = | Thing(b)\ntype Crate a = | Item(c)") {
  | Err(_) => false |> ok
  | Ok(tokens) => switch parse(tokens) {
      | Err(_) => false |> ok
      | Ok(stmts) => switch checkAll(stmts) {
          | Ok(_) => false |> ok
          | Err(errors) => Array.length(errors) == 3 |> ok
        }
    }
})

testEach("checker rejects invalid declarations and switches", [
  {
    label: "missing variant arm",
    src: "type Light = Red | Green\nlet go = light => switch light { | Red => 1 }",
    want: "non-exhaustive"
  },
  {
    label: "duplicate type",
    src: "type Thing = One\ntype Thing = Two",
    want: "duplicate type 'Thing'"
  },
  {
    label: "unknown constructor",
    src: "let f = value => switch value { | Missing => 1 | _ => 0 }",
    want: "unknown constructor 'Missing'"
  },
  {
    label: "reserved prelude name",
    src: "let Str = 1",
    want: "'Str' is a reserved collection namespace"
  },
  {
    label: "undeclared constructor type variable",
    src: "type Box a = Item(a, b)",
    want: "unknown type parameter 'b'"
  },
  {
    label: "recur outside a loop",
    src: "let f = x => recur(x)",
    want: "only legal inside a loop"
  },
  {
    label: "recur outside tail position",
    src: "let f = loop (i = 0) { recur(i) + 1 }",
    want: "tail position"
  },
  {
    label: "recur has loop arity",
    src: "let f = loop (a = 0, b = 0) { a > 9 ? a : recur(a + 1) }",
    want: "takes 2 arguments"
  },
  {
    label: "loop params cannot repeat",
    src: "let f = loop (a = 0, a = 1) { a }",
    want: "duplicate loop param"
  },
  {
    label: "let-in cannot shadow a loop param",
    src: "let f = loop (a = 0) { let a = 1 in a > 0 ? a : recur(a) }",
    want: "shadows a loop param"
  },
  {
    label: "recur belongs to the nearest loop",
    src: "let f = loop (a = 0, b = 0) { loop (c = 0) { c > 9 ? c : recur(a, b) } }",
    want: "takes 1 argument"
  },
  {
    label: "lambda is a loop boundary",
    src: "let f = loop (i = 0) { map(x => recur(x), [1]) }",
    want: "only legal inside a loop"
  }
], row => switch checkSrc(row.src) {
  | Err(e) => e.message |> Str.contains(row.want) |> ok
  | Ok(_) => false |> ok
})

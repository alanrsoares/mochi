// bootstrap/types.mochi — the HM type machinery (ports src/types.ts + src/unify.ts).
// Split out of infer.mochi (ticket 0013): Ty/Row + constructors, the St-threaded
// resolve/zonk/occurs/unify/unifyRows core, and showType. infer.mochi imports the
// ctors + entry points it needs; gen-prelude compiles THIS file (self-contained,
// no AST dependency) to lower the prelude tables to mochi Ty.

// ---- Ty / Row: applied type constructors + row-polymorphic records ----
//
// `TyCon(name, args)` is a type constructor *applied*: primitive nullary
// (`TyCon("number", [])`), generic (`TyCon("List", [a])`), nesting
// arbitrarily (`TyCon("Task", [TyCon("Option", [a])])`). Unification
// recurses through `args` — deep generics fall out free.
//
// `Row` is zero-or-more labelled fields ending in either `RowEmpty` (closed
// — exactly these fields) or `RowVar` (open — "these fields, possibly
// more"). Open rows give structural/duck typing: `p.x` accepts any record
// with an `x` field.

export type Ty =
  | TyVar(id: number)
  | TyCon(name: string, args: [Ty])
  | TyFn(from: Ty, to: Ty)
  | TyRecord(row: Row)
  // String (and later number) singletons + finite unions (ADR 0012 / 0081).
  // Not `TyLit`/`TyUnion`: those names belong to TypeExpr (same reason HM
  // arrows are `TyFn` rather than `TyArrow`).
  | TySingleton(base: string, value: string)
  | TyOneOf(members: [Ty])

export type Row =
  | RowEmpty
  | RowVar(id: number)
  | RowExtend(label: string, fieldType: Ty, optional: bool, rest: Row)

export let tVar = id => TyVar(id)
export let tCon = (name, args) => TyCon(name, args)
export let tArrow = (fromT, toT) => TyFn(fromT, toT)
export let tRecord = row => TyRecord(row)
export let tPrim = name => TyCon(name, [])
export let tLit = value => TySingleton("string", value)

let typeEq = (a, b) => switch a {
  | TyVar(aid) => switch b { | TyVar(bid) => aid == bid | _ => false }
  | TyCon(aname, aargs) => switch b {
      | TyCon(bname, bargs) => aname == bname && Array.length(
          aargs
        ) == Array.length(bargs) && typeEqList(aargs, bargs, 0)
      | _ => false
    }
  | TyFn(af, at) => switch b {
      | TyFn(bf, bt) => typeEq(af, bf) && typeEq(at, bt)
      | _ => false
    }
  | TyRecord(arow) => switch b {
      | TyRecord(brow) => rowEq(arow, brow)
      | _ => false
    }
  | TySingleton(abase, aval) => switch b {
      | TySingleton(bbase, bval) => abase == bbase && aval == bval
      | _ => false
    }
  | TyOneOf(am) => switch b {
      | TyOneOf(bm) => Array.length(
          am
        ) == Array.length(bm) && allMembersIn(am, bm, 0)
      | _ => false
    }
}

let typeEqList = (as_, bs, i) => switch Array.get(i, as_) {
  | None => true
  | Some(a) => switch Array.get(i, bs) {
      | None => false
      | Some(b) => typeEq(a, b) && typeEqList(as_, bs, i + 1)
    }
}

let memberEqIn = (t, xs, i) => switch Array.get(i, xs) {
  | None => false
  | Some(x) => typeEq(t, x) ? true : memberEqIn(t, xs, i + 1)
}

let allMembersIn = (am, bm, i) => switch Array.get(i, am) {
  | None => true
  | Some(m) => memberEqIn(m, bm, 0) && allMembersIn(am, bm, i + 1)
}

let rowEq = (a, b) => switch a {
  | RowEmpty => switch b { | RowEmpty => true | _ => false }
  | RowVar(aid) => switch b { | RowVar(bid) => aid == bid | _ => false }
  | RowExtend(al, at, ao, ar) => switch b {
      | RowExtend(bl, bt, bo, br) => al == bl && ao == bo && typeEq(
          at,
          bt
        ) && rowEq(ar, br)
      | _ => false
    }
}

let flattenUnionFrom = (members, acc, i) => switch Array.get(i, members) {
  | None => acc
  | Some(t) => switch t {
      | TyOneOf(ms) => flattenUnionFrom(
          members,
          flattenUnionFrom(ms, acc, 0),
          i + 1
        )
      | _ => flattenUnionFrom(
          members,
          memberEqIn(t, acc, 0) ? acc : Array.append(t, acc),
          i + 1
        )
    }
}

/// Finite union. Flattens nested unions, dedupes, unwraps a singleton.
export let tUnion = members =>
  let flat = flattenUnionFrom(members, [], 0) in
    switch flat {
      | [] => tPrim("string")
      | [only] => only
      | _ => TyOneOf(flat)
    }

// tuple: applied constructor under a reserved, unspeakable name (lowercase
// "tuple" — user types are always Uppercase). Arity is arg count, so
// `(a, b)` and `(a, b, c)` are distinct types that never unify.
let TUPLE = "tuple"
export let tTuple = elems => TyCon(TUPLE, elems)

/// The one-inhabitant type (ADR 0054), also the nullary-function domain (ADR
/// 0014): surface `() => T` and the call `f()` both use `unit -> T`. `unit` is an
/// ordinary primitive type name and `()` is its literal — value, type, pattern.
export let UNIT = "unit"
export let tUnit = TyCon(UNIT, [])
export let isUnit = t => switch t {
  | TyCon(name, args) => name == UNIT && Array.length(args) == 0
  | _ => false
}

export let rVar = id => RowVar(id)
export let rExtend = (label, fieldType, rest) =>
  RowExtend(label, fieldType, false, rest)
export let rField = (label, fieldType, rest, optional) =>
  RowExtend(label, fieldType, optional, rest)

// ---- pretty-printer (errors + tests) ----

let showTypeArgs = args => Str.join(", ", args |> map(showType))

/// `unit` renders as its literal `()` in every position (ADR 0054), which also
/// covers the nullary-arrow domain: `unit -> T` prints `() -> T` (ADR 0014).
export let showType = t => switch t {
  | TyVar(id) => "'t${show(id)}"
  | TyCon(name, args) => switch args {
      | [elem] when name == "Array" => "[${showType(elem)}]"
      | [] when name == UNIT => "()"
      | _ => name == TUPLE
          ? "(${showTypeArgs(args)})"
          : Array.length(args) == 0
          ? name
          : "${name}<${showTypeArgs(args)}>"
    }
  | TyFn(from, to) => let fromS = switch from {
      | TyFn(_, _) => "(${showType(from)})"
      | _ => showType(from)
    } in
      "${fromS} -> ${showType(to)}"
  | TyRecord(row) => showRow(row)
  | TySingleton(base, value) => base == "string" ? show(value) : value
  | TyOneOf(members) => Str.join(" | ", members |> map(showType))
}

/// walk a row to its tail, collecting `label: type` field strings on the way
let showRowFields = row => switch row {
  | RowExtend(label, fieldType, optional, rest) => let (fields, tailId) = showRowFields(
      rest
    ) in
      (
        Array.prepend(
          "${label}${optional ? "?" : ""}: ${showType(fieldType)}",
          fields
        ),
        tailId
      )
  | RowVar(id) => ([], Some(id))
  | RowEmpty => ([], None)
}

let showRow = row =>
  let (fields, tailId) = showRowFields(row) in
  let tail = switch tailId {
    | Some(id) => "${Array.length(fields) == 0 ? "" : " "}| 'r${show(id)}"
    | None => ""
  } in
    Array.length(fields) == 0 && tail == ""
      ? "{}"
      : "{ ${Str.join(", ", fields)}${tail} }"

// ---- generic index-loop helpers (early-exit `for` loops from the TS
// originals; same style as bootstrap/check.mochi's firstSome/allOf/someOf) ----

let someOfFrom = (f, xs, i) => switch Array.get(i, xs) {
  | None => false
  | Some(x) => f(x) ? true : someOfFrom(f, xs, i + 1)
}
let someOf = (f, xs) => someOfFrom(f, xs, 0)

// ---- St: threaded substitution + fresh-var counter ----

/// TS's `Subst` (mutable Map pair) + `Fresh` (mutable counter) become one
/// immutable, threaded `St` — every fresh-var mint AND every unify call
/// returns a NEW St rather than mutating in place. Type vars and row vars
/// draw from the same `next` counter so ids never collide across the two
/// maps (mirrors types.ts's original Fresh).
/// Inferred type at a source span. Structural on purpose: types.mochi stays
/// AST-free (gen-prelude compiles it standalone), so ast.mochi's `Span` fits
/// this shape rather than being imported.
export type SpanAt = { start: number, end: number }

export type TypeAt = { span: SpanAt, ty: Ty }

/// `recorded` accumulates one entry per inferred Expr/Pattern node, newest
/// first (prepend is O(1)); `inferProgramImports` reverses it once so later
/// records win when two nodes share a span, matching src/infer.ts.
///
/// `letSpans` / `letUses` are the ADR 0035 side-channel: every `let`'s VALUE
/// span, plus each type its body instantiated that binding at. src/infer.ts
/// keys both on the `Scheme` OBJECT (a JS `Map` over identities); Mochi has no
/// reference identity, so the key is the value span's `"start:end"` instead —
/// unique per binding by construction, and the same string the TS backend's
/// `spanKey` builds when it looks the annotation back up.
export type St = {
  tv: Map<number, Ty>,
  rv: Map<number, Row>,
  next: number,
  recorded: [TypeAt],
  letSpans: Map<string, SpanAt>,
  letUses: Map<string, [Ty]>
}
export type TypeErr = { message: string }

export let mkSt : number -> St = start =>
  { tv: #{}, rv: #{}, next: start, recorded: [], letSpans: #{}, letUses: #{} }

/// Prepend an inferred node type onto the threaded record log.
export let recordAt = (span, t, st: St) =>
  { ...st, recorded: Array.prepend({ span, ty: t }, st.recorded) }

let spanKeyOf = sp => "${show(sp.start)}:${show(sp.end)}"

/// Register a `let`'s value span as an ADR 0035 annotation candidate. Resets its
/// use list, mirroring src/infer.ts's `noteLet` (a re-noted scheme starts over).
export let noteLet = (span, st: St) =>
  let k = spanKeyOf(span) in
    {
      ...st,
      letSpans: Map.set(k, span, st.letSpans),
      letUses: Map.set(k, [], st.letUses)
    }

/// Record one instantiation of a noted `let`. A span that was never noted (a
/// builtin, an import, a lambda param) is not a candidate and is dropped.
export let noteUse = (span, t, st: St) =>
  let k = spanKeyOf(span) in
    switch Map.get(k, st.letUses) {
      | None => st
      | Some(uses) => {
          ...st,
          letUses: Map.set(k, Array.append(t, uses), st.letUses)
        }
    }
export let fail = message => Err({ message })

export let freshVar = st => (tVar(st.next), { ...st, next: st.next + 1 })
export let freshRowVar = st => (rVar(st.next), { ...st, next: st.next + 1 })

// ---- resolution: follow a variable chain one level to a head ----

export let resolve = (t, st: St) => switch t {
  | TyVar(id) => switch Map.get(id, st.tv) {
      | Some(next) => resolve(next, st)
      | None => t
    }
  | _ => t
}

let resolveRow = (r, st: St) => switch r {
  | RowVar(id) => switch Map.get(id, st.rv) {
      | Some(next) => resolveRow(next, st)
      | None => r
    }
  | _ => r
}

/// Fully apply the substitution ("zonk") — for display and assertions.
export let zonk = (t, st: St) => switch resolve(t, st) {
  | TyVar(id) => tVar(id)
  | TyCon(name, args) => tCon(name, args |> map(a => zonk(a, st)))
  | TyFn(from, to) => tArrow(zonk(from, st), zonk(to, st))
  | TyRecord(row) => tRecord(zonkRow(row, st))
  | TySingleton(base, value) => TySingleton(base, value)
  | TyOneOf(members) => tUnion(members |> map(m => zonk(m, st)))
}

let zonkRow = (row, st: St) => switch resolveRow(row, st) {
  | RowExtend(label, fieldType, optional, rest) => rField(
      label,
      zonk(fieldType, st),
      zonkRow(rest, st),
      optional
    )
  | r => r
}

// ---- occurs checks ----

export let occurs = (id, t, st: St) => switch resolve(t, st) {
  | TyVar(rid) => rid == id
  | TyCon(_, args) => someOf(a => occurs(id, a, st), args)
  | TyFn(from, to) => occurs(id, from, st) || occurs(id, to, st)
  | TyRecord(row) => occursRow(id, row, st)
  | TySingleton(_, _) => false
  | TyOneOf(members) => someOf(m => occurs(id, m, st), members)
}

let occursRow = (id, row, st: St) => switch resolveRow(row, st) {
  | RowExtend(_, fieldType, _, rest) => occurs(
      id,
      fieldType,
      st
    ) || occursRow(id, rest, st)
  | _ => false
}

export let rowVarOccurs = (id, row, st: St) => switch resolveRow(row, st) {
  | RowVar(rid) => rid == id
  | RowExtend(_, fieldType, _, rest) => rowVarOccursInType(
      id,
      fieldType,
      st
    ) || rowVarOccurs(id, rest, st)
  | RowEmpty => false
}

let rowVarOccursInType = (id, t, st: St) => switch resolve(t, st) {
  | TyVar(_) => false
  | TyCon(_, args) => someOf(a => rowVarOccursInType(id, a, st), args)
  | TyFn(from, to) => rowVarOccursInType(
      id,
      from,
      st
    ) || rowVarOccursInType(id, to, st)
  | TyRecord(row) => rowVarOccurs(id, row, st)
  | TySingleton(_, _) => false
  | TyOneOf(members) => someOf(m => rowVarOccursInType(id, m, st), members)
}

// ---- unification ----
//
// Arity hint (CRITIQUE §4.4): a function type on exactly one side almost
// always means a curried call got the wrong number of arguments. Say so
// instead of a baffling raw `X with A -> B` mismatch.

let isArrowT = t => switch t { | TyFn(_, _) => true | _ => false }

let isCollection = name =>
  name == "Array" || name == "List" || name == "Set" || name == "Map"

let isTupleT = t => switch t { | TyCon(name, _) => name == TUPLE | _ => false }

// `((a, b)) =>` vs `(a, b) =>` — extra parens are a tuple param (ADR 0083).
let tupleParenMsg = (a, b, shown) =>
  isTupleT(a) != isTupleT(b)
    ? "${shown} — ((a, b)) => takes one tuple; (a, b) => takes two arguments"
    : shown

// Array vs List/Set/Map (and List vs Set, …) — name the qualified fix (ADR 0080).
let collectionUnifyMsg = (aname, bname, shown) =>
  aname == bname || !isCollection(aname) || !isCollection(bname)
    ? shown
    : let other = aname == "Array" ? bname : bname == "Array" ? aname : "" in
    let hint = other == "List"
      ? "unqualified map/filter/length expect Array; use List.map"
      : other == "Set"
      ? "unqualified map/filter/length expect Array; convert with Set.toArray or use Set.*"
      : other == "Map"
      ? "unqualified map/filter/length expect Array; use Map.*"
      : "${aname} and ${bname} are distinct collections" in
      "${shown} — ${hint}"

let unifyMismatch = (ra, rb) =>
  isArrowT(ra) != isArrowT(rb)
    ? let (fn, val) = isArrowT(ra) ? (ra, rb) : (rb, ra) in
      fail(
        tupleParenMsg(
          ra,
          rb,
          "cannot unify ${showType(ra)} with ${showType(rb)} — a function (${showType(fn)}) was used where a ${showType(val)} was expected; a call may be missing an argument"
        )
      )
    : fail(
      tupleParenMsg(ra, rb, "cannot unify ${showType(ra)} with ${showType(rb)}")
    )

let unifyArgs = (as_, bs, i, st: St) => switch Array.get(i, as_) {
  | None => Ok(st)
  | Some(a) => switch Array.get(i, bs) {
      | None => Ok(st)
      | Some(b) => unify(a, b, st)
          |> Result.flatMap(s1 => unifyArgs(as_, bs, i + 1, s1))
    }
}

let isPrimT = (t, name) => switch t {
  | TyCon(n, args) => n == name && Array.length(args) == 0
  | _ => false
}

let isLitOnlyUnion = members => switch members {
  | [] => true
  | [TySingleton(_, _), ...rest] => isLitOnlyUnion(rest)
  | _ => false
}

let widenLitBindingsFrom = (ids, lit, st: St) => switch ids {
  | [] => st
  | [id, ...rest] => switch Map.get(id, st.tv) {
      | Some(t) => switch resolve(t, st) {
          | TySingleton(base, value) => switch lit {
              | TySingleton(lbase, lvalue) => base == lbase && value == lvalue
                  ? widenLitBindingsFrom(
                    rest,
                    lit,
                    { ...st, tv: Map.set(id, tPrim(base), st.tv) }
                  )
                  : widenLitBindingsFrom(rest, lit, st)
              | _ => widenLitBindingsFrom(rest, lit, st)
            }
          | _ => widenLitBindingsFrom(rest, lit, st)
        }
      | None => widenLitBindingsFrom(rest, lit, st)
    }
}

let widenLitBindings = (lit, st: St) =>
  widenLitBindingsFrom(Map.keys(st.tv), lit, st)

let litInUnionFrom = (lit, members, i, st: St) => switch Array.get(i, members) {
  | None => fail(
      "cannot unify ${showType(lit)} with ${showType(TyOneOf(members))}"
    )
  | Some(m) => switch m {
      | TySingleton(base, value) => switch lit {
          | TySingleton(lbase, lvalue) => base == lbase && value == lvalue
              ? Ok(st)
              : litInUnionFrom(lit, members, i + 1, st)
          | _ => litInUnionFrom(lit, members, i + 1, st)
        }
      | _ => switch unify(lit, m, st) {
          | Ok(st1) => Ok(st1)
          | Err(_) => litInUnionFrom(lit, members, i + 1, st)
        }
    }
}

let unifyMemberAgainstUnionFrom = (member, members, i, st: St) => switch member {
  | TySingleton(_, _) => litInUnionFrom(member, members, 0, st)
  | _ => unifyConcreteAgainstUnionFrom(member, members, i, st)
}

/// Split so `fail` sits beside `Ok` in one match (tsc-clean Result, ADR 0026).
let unifyConcreteAgainstUnionFrom = (member, members, i, st: St) => switch Array.get(i, members) {
  | None => fail(
      "cannot unify ${showType(member)} with ${showType(TyOneOf(members))}"
    )
  | Some(m) => switch unify(member, m, st) {
      | Ok(st1) => Ok(st1)
      | Err(_) => unifyConcreteAgainstUnionFrom(member, members, i + 1, st)
    }
}

let unifyUnionMembersFrom = (members, u, i, st: St) => switch Array.get(i, members) {
  | None => Ok(st)
  | Some(m) => switch u {
      | TyOneOf(ums) => unifyMemberAgainstUnionFrom(m, ums, 0, st)
          |> Result.flatMap(s1 => unifyUnionMembersFrom(members, u, i + 1, s1))
      | _ => Ok(st)
    }
}

let unifyLitUnion = (a, b, st: St) => switch a {
  | TySingleton(abase, aval) => switch b {
      | TySingleton(bbase, bval) => abase == bbase && aval == bval
          ? Ok(st)
          : abase == bbase
          ? Ok(widenLitBindings(b, widenLitBindings(a, st)))
          : fail("cannot unify ${showType(a)} with ${showType(b)}")
      | TyOneOf(members) => litInUnionFrom(a, members, 0, st)
      | _ => isPrimT(b, abase)
          ? Ok(st)
          : fail("cannot unify ${showType(a)} with ${showType(b)}")
    }
  | TyOneOf(amembers) => switch b {
      | TySingleton(_, _) => litInUnionFrom(b, amembers, 0, st)
      | TyOneOf(bmembers) => unifyUnionMembersFrom(amembers, b, 0, st)
          |> Result.flatMap(s1 => unifyUnionMembersFrom(bmembers, a, 0, s1))
      | _ => isLitOnlyUnion(amembers)
          ? fail("cannot unify ${showType(a)} with ${showType(b)}")
          : unifyMemberAgainstUnionFrom(b, amembers, 0, st)
    }
  | _ => switch b {
      | TySingleton(bbase, _) => isPrimT(a, bbase)
          ? Ok(st)
          : fail("cannot unify ${showType(a)} with ${showType(b)}")
      | TyOneOf(bmembers) => isLitOnlyUnion(bmembers)
          ? fail("cannot unify ${showType(a)} with ${showType(b)}")
          : unifyMemberAgainstUnionFrom(a, bmembers, 0, st)
      | _ => fail("cannot unify ${showType(a)} with ${showType(b)}")
    }
}

export let unify = (a, b, st: St) =>
  let ra = resolve(a, st) in
  let rb = resolve(b, st) in
    switch ra {
      | TyVar(aid) => switch rb {
          | TyVar(bid) => aid == bid ? Ok(st) : bindVar(aid, rb, st)
          | _ => bindVar(aid, rb, st)
        }
      | TyCon(aname, aargs) => switch rb {
          | TyVar(bid) => bindVar(bid, ra, st)
          | TyCon(bname, bargs) => aname == bname && Array.length(
              aargs
            ) == Array.length(bargs)
              ? unifyArgs(aargs, bargs, 0, st)
              : fail(
                tupleParenMsg(
                  ra,
                  rb,
                  collectionUnifyMsg(
                    aname,
                    bname,
                    "cannot unify ${showType(ra)} with ${showType(rb)}"
                  )
                )
              )
          | TySingleton(_, _) => unifyLitUnion(ra, rb, st)
          | TyOneOf(_) => unifyLitUnion(ra, rb, st)
          | _ => unifyMismatch(ra, rb)
        }
      | TyFn(afrom, ato) => switch rb {
          | TyVar(bid) => bindVar(bid, ra, st)
          | TyFn(bfrom, bto) => unify(afrom, bfrom, st)
              |> Result.flatMap(s1 => unify(ato, bto, s1))
          | TySingleton(_, _) => unifyLitUnion(ra, rb, st)
          | TyOneOf(_) => unifyLitUnion(ra, rb, st)
          | _ => unifyMismatch(ra, rb)
        }
      | TyRecord(arow) => switch rb {
          | TyVar(bid) => bindVar(bid, ra, st)
          | TyRecord(brow) => unifyRows(arow, brow, st)
          | TySingleton(_, _) => unifyLitUnion(ra, rb, st)
          | TyOneOf(_) => unifyLitUnion(ra, rb, st)
          | _ => unifyMismatch(ra, rb)
        }
      | TySingleton(_, _) => switch rb {
          | TyVar(bid) => bindVar(bid, ra, st)
          | _ => unifyLitUnion(ra, rb, st)
        }
      | TyOneOf(_) => switch rb {
          | TyVar(bid) => bindVar(bid, ra, st)
          | _ => unifyLitUnion(ra, rb, st)
        }
    }

let bindVar = (id, t, st: St) =>
  occurs(id, t, st)
    ? fail("infinite type: 't${show(id)} occurs in ${showType(zonk(t, st))}")
    : Ok({ ...st, tv: Map.set(id, t, st.tv) })

// ---- row unification ----

/// Bring `label` to the head of a row, extending an open tail if needed.
/// Returns the field's type, optionality, the remaining row, and state.
let rewriteRow = (row, label, st: St) => switch resolveRow(row, st) {
  | RowEmpty => fail("record missing field '${label}'")
  | RowExtend(rlabel, rtype, ropt, rrest) => rlabel == label
      ? Ok((rtype, ropt, rrest, st))
      : rewriteRow(rrest, label, st)
        |> Result.map(((subType, subOpt, subRest, subSt)) =>
          (subType, subOpt, rField(rlabel, rtype, subRest, ropt), subSt))
  | RowVar(rid) => let (freshT, st1) = freshVar(st) in
    let (freshTail, st2) = freshRowVar(st1) in
      Ok((
        freshT,
        false,
        freshTail,
        { ...st2, rv: Map.set(rid, rExtend(label, freshT, freshTail), st2.rv) }
      ))
}

/// both rows extend: pull a's label out of b, unify the field types, recurse
export let unifyRows = (r1, r2, st: St) =>
  let a = resolveRow(r1, st) in
  let b = resolveRow(r2, st) in
    switch a {
      | RowEmpty => switch b {
          | RowEmpty => Ok(st)
          | RowVar(bid) => bindRowVar(bid, a, st)
          | RowExtend(label, _, _, _) => fail("record missing field '${label}'")
        }
      | RowVar(aid) => bindRowVar(aid, b, st)
      | RowExtend(alabel, atype, aopt, arest) => switch b {
          | RowEmpty => fail("record has extra field '${alabel}'")
          | RowVar(bid) => bindRowVar(bid, a, st)
          | RowExtend(_, _, _, _) => rewriteRow(b, alabel, st)
              |> Result.flatMap(((btype, bopt, brest, s1)) =>
                aopt == bopt
                  ? unify(atype, btype, s1)
                    |> Result.flatMap(s2 => unifyRows(arest, brest, s2))
                  : fail(
                    aopt
                      ? "record field '${alabel}' is optional but required on the other side"
                      : "record field '${alabel}' is required but optional on the other side"
                  ))
        }
    }

let bindRowVar = (id, row, st: St) => switch resolveRow(row, st) {
  | RowVar(rid) when rid == id => Ok(st)
  | r => rowVarOccurs(id, r, st)
      ? fail("infinite record type")
      : Ok({ ...st, rv: Map.set(id, r, st.rv) })
}

/// Directional record check: `actual` may be used where `expected` is required
/// (ADR 0098). Missing optional expected fields are allowed; a required actual
/// field satisfies an optional expected one; the reverse is not.
export let fits = (actual, expected, st: St) =>
  let ra = resolve(actual, st) in
  let rb = resolve(expected, st) in
    switch ra {
      | TyVar(aid) => bindVar(aid, rb, st)
      | _ => switch rb {
          | TyVar(bid) => bindVar(bid, ra, st)
          | TyRecord(erow) => switch ra {
              | TyRecord(arow) => fitsRows(arow, erow, st)
              | _ => unify(actual, expected, st)
            }
          | _ => unify(actual, expected, st)
        }
    }

let fitsRows = (actual, expected, st: St) =>
  let exp = resolveRow(expected, st) in
  let act = resolveRow(actual, st) in
    switch exp {
      | RowVar(eid) => bindRowVar(eid, act, st)
      | RowEmpty => switch act {
          | RowEmpty => Ok(st)
          | RowVar(aid) => bindRowVar(aid, exp, st)
          | RowExtend(label, _, _, _) => fail(
              "record has extra field '${label}'"
            )
        }
      | RowExtend(elabel, etype, eopt, erest) => let rw = rewriteRow(
          act,
          elabel,
          st
        ) in
          switch rw {
            | Err(_) => eopt
                ? fitsRows(act, erest, st)
                : fail("record missing field '${elabel}'")
            | Ok(hit) => let (htype, hopt, hrest, s1) = hit in
                hopt && !eopt
                  ? fail(
                    "record field '${elabel}' is required but missing or optional"
                  )
                  : unify(htype, etype, s1)
                    |> Result.flatMap(s2 => fitsRows(hrest, erest, s2))
          }
    }

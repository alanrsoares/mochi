{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "test/**/*.ts",
      "*.ts",
      "scripts/**/*.ts",
      "apps/docs/src/**/*.ts",
      "apps/docs/src/**/*.tsx",
      "apps/docs/*.ts",
      "packages/*/src/**/*.ts",
      "examples/snake/src/**/*.ts",
      "examples/snake/src/**/*.tsx",
      "examples/snake/*.ts",
      "bootstrap/seed/**/*.ts",
      "!packages/compiler/src/prelude/js-defs.gen.ts"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 50
          }
        }
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useImportType": "error",
        "noParameterAssign": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error"]
          }
        }
      },
      "nursery": {
        "useSortedClasses": {
          "level": "on",
          "options": {
            "attributes": ["className"],
            "functions": ["clsx", "cva", "tw", "tw.*"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!biome/plugins/**", "!packages/compiler/src/prelude/runtime.ts"],
      "plugins": ["./biome/plugins/no-promise-result.grit"]
    },
    {
      "includes": [
        "**",
        "!biome/plugins/**",
        "!packages/compiler/src/prelude/runtime.ts",
        "!bootstrap/seed/**"
      ],
      "plugins": ["./biome/plugins/no-inline-struct-type.grit"]
    },
    {
      "includes": [
        "**",
        "!test/**",
        "!**/*.spec.ts",
        "!biome/plugins/**",
        "!packages/compiler/src/prelude/runtime.ts"
      ],
      "plugins": [
        "./biome/plugins/prefer-immutable-arrays.grit",
        "./biome/plugins/prefer-immutable-objects.grit"
      ]
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/docs/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/compiler/src/prelude/runtime.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["bootstrap/seed/**"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "noUselessContinue": "off",
            "noExcessiveCognitiveComplexity": "off",
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ]
}

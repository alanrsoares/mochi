#!/usr/bin/env bash
# Warn when only ONE of the two formatters changed in the commits being pushed.
#
# packages/dx/src/format.ts is the shipped formatter (scripts/fmt.ts and the CLI
# import it); bootstrap/format.mochi is the self-hosted port. test/bootstrap-
# format.spec.ts diffs them, but only over single-line expression output — comment
# placement, statement layout and blank lines are not compared yet, so drift there
# is invisible to the gate. This is the stopgap until whole-file parity lands.
#
# WARNS ONLY, never blocks: a one-sided change is often correct (a TS-side bug fix
# lands first, a port follows). The point is that it is a deliberate choice.
set -euo pipefail

TS_SIDE="packages/dx/src/format.ts"
MOCHI_SIDE="bootstrap/format.mochi"

range="${1:-}"
if [ -z "$range" ]; then
  if git rev-parse --verify -q '@{push}' >/dev/null 2>&1; then
    range="@{push}..HEAD"
  elif git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    range="$(git merge-base origin/main HEAD)..HEAD"
  else
    exit 0 # nothing to compare against — first push of a fresh clone
  fi
fi

files="$(git diff --name-only "$range" 2>/dev/null || true)"
[ -n "$files" ] || exit 0

touched_ts=0
touched_mochi=0
grep -qxF "$TS_SIDE" <<<"$files" && touched_ts=1
grep -qxF "$MOCHI_SIDE" <<<"$files" && touched_mochi=1

if [ "$touched_ts" -eq "$touched_mochi" ]; then
  exit 0 # both or neither
fi

if [ "$touched_ts" -eq 1 ]; then
  changed="$TS_SIDE"; other="$MOCHI_SIDE"
else
  changed="$MOCHI_SIDE"; other="$TS_SIDE"
fi

cat >&2 <<MSG
formatter drift: $changed changed, $other did not ($range).

  The two formatters are ported by hand and only partly diffed —
  test/bootstrap-format.spec.ts compares single-line expression output, not
  comments, statement layout or blank lines. Port the change, or push knowing
  the gate will not catch the divergence.

  Warning only; the push continues.
MSG

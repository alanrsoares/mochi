#!/usr/bin/env bash
# Fail closed if a forbidden attribution trailer survived prepare-commit-msg.
# Same policy as AGENTS.md / .githooks/prepare-commit-msg — universal agents.
set -euo pipefail
msg_file="${1:?commit message file}"

if grep -E \
  -e '^[[:space:]]*Co-[Aa]uthored-[Bb]y:' \
  -e '^[[:space:]]*Made-with:[[:space:]]*Cursor' \
  -e '^[[:space:]]*Made with Cursor' \
  -e '^[[:space:]]*Generated (by|with)\b' \
  -e '^[[:space:]]*🤖' \
  -e '^[[:space:]]*AI assisted\b' \
  -e '^[[:space:]]*[Vv]ia (Claude|Cursor|Copilot)\b' \
  "$msg_file" >/dev/null; then
  echo "commit-msg: refused — tool/agent attribution trailer in message." >&2
  echo "  Strip Co-Authored-By / Made with … / Generated by … (see AGENTS.md)." >&2
  echo "  Enforcement: .githooks/prepare-commit-msg + .githooks/commit-msg" >&2
  exit 1
fi
